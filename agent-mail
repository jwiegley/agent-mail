    requests = "".join(json.dumps(m) + "\n" for m in (
        {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-11-25", "capabilities": {}, "clientInfo": {"name": "t", "version": "1"}}},
        {"jsonrpc": "2.0", "method": "notifications/initialized"},
        {"jsonrpc": "2.0", "id": 2, "method": "tools/list"},
        {"jsonrpc": "2.0", "id": 3, "method": "ping"}))
    p = subprocess.run([sys.executable, "-I", SCRIPT, "mcp", "--dir", d, "--name", "t"], input=requests, capture_output=True, text=True, timeout=MCP_DEADLINE)
    got = json_lines(p.stdout)
    t.ok(p.returncode == 0 and got is not None and [m.get("id") for m in got] == [1, 2, 3], "the subprocess server writes only JSON lines and exits 0 at EOF")
    driver = ("import importlib.machinery, importlib.util, sys\n"
              "loader = importlib.machinery.SourceFileLoader('am', sys.argv[1])\n"
              "m = importlib.util.module_from_spec(importlib.util.spec_from_loader('am', loader))\n"
              "loader.exec_module(m)\n"
              "real = m.McpServer.handle\n"
              "def noisy(self, msg):\n"
              "    print('STRAY PRINT')\n"
              "    return real(self, msg)\n"
              "m.McpServer.handle = noisy\n"
              "sys.exit(m.main(['mcp', '--dir', sys.argv[2], '--name', 't']))\n")
    noisy = subprocess.run([sys.executable, "-I", "-c", driver, SCRIPT, d], input=requests, capture_output=True, text=True, timeout=MCP_DEADLINE)
    stray_print_in_stderr = "STRAY PRINT" in noisy.stderr
    t.ok(stray_print_in_stderr and json_lines(noisy.stdout) is not None and len(json_lines(noisy.stdout)) == 3,
         "a stray print reaches stderr, never the protocol stream")
    loose = os.path.join(t.root, "loose-run")
    os.mkdir(loose)
    os.chmod(loose, 0o755)  # open to others, so making the reader lock fails at start
    call = {"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": "receive", "arguments": {"me": "t"}}}
    with mcp_process(d, "t", {**os.environ, "AGENT_MAIL_RUNTIME_DIR": loose}) as proc:
        refused = ask_line(proc, call)["result"]
