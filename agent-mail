    t.ok(getattr(t.raises(subscribe, d, "pi", st, s, "fleet", backlog=21, now=now), "code", None) == "bad_argument", "a backlog is at most 20")
    ids = [parse_msg(os.path.basename(t.post(d, "fleet", "nix", f"post {i}", stamp=now - 3600 + i * 60))).id for i in range(5)]
    subscribe(d, "pi", st, s, "fleet", backlog=2, now=now)
    t.ok(set(st["seen"]["+fleet"]) == set(ids[:3]), "backlog 2 leaves exactly the two newest of five earlier posts unread")
    pinned_ops = load_settings({"channels": ["ops:wake"]}, {}, "pi")
    t.ok(getattr(t.raises(unsubscribe, st, pinned_ops, "ops"), "code", None) == "pinned", "a pinned channel cannot be unsubscribed")
    t.ok(effective_subs(load_state(d, "fresh"), pinned_ops, now) == {"ops": {"wake": True, "pinned": True, "since": now - 86400}},
         "a pinned channel with no state starts 24 hours back")
    touch_member(d, "pi", effective_subs(st, s, now), now)
    c = next(c for c in list_channels(d, now) if c["name"] == "fleet")
    t.ok(c["posts_7d"] == 5 and c["subscribers"] == ["pi"], "lists posts in the last 7 days and published subscribers")
    unsubscribe(st, s, "fleet")
    t.ok("fleet" not in st["subs"] and "+fleet" not in st["seen"], "unsubscribe drops the channel and its seen set")


def section_receive(t):
    d = t.box()
    s = load_settings({}, {}, "pi")
    t.at(time.time() + 10)

    def sink(text):
        pass

    t.direct(d, "pi", "nix", "first")
    t.direct(d, "pi", "nix", "second")
    writes = []
    out = receive(d, "pi", s, writes.append)
    lines = out.splitlines()
    m = re.fullmatch(r"agent-mail \[([0-9a-f]{8})\]: 2 item\(s\) for pi \(bound name pi@\S+\): direct pi_\S+; direct pi_\S+", lines[0])
    t.ok(m is not None and writes == [out], "the list line comes first and names every item")
    tok = m.group(1) if m else "-"
    t.ok(lines[1] == BANNER.format(token=tok), "the banner follows the list line")
    t.ok(re.fullmatch(rf"=== agent-mail \[{tok}\]: begin 1/2 direct id=pi_\S+ from=nix \(asserted\) copy=\S+/\.pi-read/pi_\S+\.txt ===", lines[2]) is not None,
         "a begin line carries position, kind, id, sender and copy")
    t.ok(f"=== agent-mail [{tok}]: end 2/2 ===" in lines, "an end line closes each item")
    t.mk(os.path.join(d, "pi_20261030T000800.000000Z_from-nix_00000008.txt"), "From: x@elsewhere\nTo: pi\n\n\x1b[2Jhi\n")
    out = receive(d, "pi", s, sink)
    t.ok("from=nix (asserted; header says x)" in out, "a From header that disagrees with the file name is called out")
    t.ok("\nhi\n" in out and "\x1b" not in out, "receive prints sanitized text")
    t.mk(os.path.join(d, f".pi-claimed-{os.getpid()}-{HOSTTAG}-pi_20261030T000900.000000Z_from-nix_00000009.txt"), "stranded\n")
    t.ok("stranded" in receive(d, "pi", s, sink), "a claim with this pid that the process does not hold is delivered at once")
    t.ok(len(load_state(d, "pi")["last_batch"]["ids"]) == 1, "commit records the last batch")
    inflight = t.direct(d, "pi", "nix", "in flight")
    held = collect(d, "pi", s, load_state(d, "pi"), MAX_BYTES, clock())
    again = receive(d, "pi", s, sink)
    put_back(held)
    t.ok(len(held.items) == 1 and "in flight" not in again and os.path.exists(inflight) and "in flight" in receive(d, "pi", s, sink),
         "a claim this process holds in flight is not taken again")
    msg = t.direct(d, "pi", "nix", "kept")
    before = load_state(d, "pi")["last_batch"]

    def broken_write(text):
        raise BrokenPipeError()

    t.ok(getattr(t.raises(receive, d, "pi", s, broken_write), "code", None) == "output_failed" and os.path.exists(msg)
         and load_state(d, "pi")["last_batch"] == before, "a failed write puts the claim back and changes no state")


def section_posts(t):
    T0 = time.time() + 3600  # every file written below is settled under this clock
    t.at(T0)

    def sink(text):
        pass

    def opts(name, *pinned):
        return load_settings({"channels": list(pinned)} if pinned else {}, {}, name)

    def subscribed(d, name, *chs):
        st = load_state(d, name)
        for ch in chs:
            subscribe(d, name, st, opts(name), ch, now=clock())
        save_state(d, name, st)

    def pid_of(path):
        return parse_msg(os.path.basename(path)).id

    s = opts("a")
    d = t.box()
    create_channel(d, "fleet", "fleet-wide notices")
    for name in ("a", "b", "pi"):
        subscribed(d, name, "fleet")
    pid = pid_of(t.post(d, "fleet", "nix", "FIRST-POST"))
    t.ok(pid in receive(d, "a", s, sink) and pid in receive(d, "b", s, sink), "two subscribers each get a post")
    t.ok(pid not in receive(d, "a", s, sink), "a post is delivered once per reader")
    t.ok(pid not in receive(d, "c", s, sink), "a non-subscriber gets nothing")
    own = pid_of(t.post(d, "fleet", "pi", "MY-OWN-POST"))
    t.ok(own not in receive(d, "pi", s, sink), "a sender does not receive its own post")
    t.post(d, "fleet", "nix", "SECOND-POST", stamp=T0 + 60)
    receive(d, "a", s, sink)
    t.post(d, "fleet", "nix", "LATE-ARRIVAL", stamp=T0 - 120)
    t.ok("LATE-ARRIVAL" in receive(d, "a", s, sink), "a late arrival stamped before posts already read is still delivered")

    m = t.box("margin")
    create_channel(m, "fleet", "p")
    subscribed(m, "a", "fleet")
    t.post(m, "fleet", "nix", "MARGIN-NINE", stamp=T0 - 540)
    t.post(m, "fleet", "nix", "MARGIN-ELEVEN", stamp=T0 - 660)
    out = receive(m, "a", s, sink)
    t.ok("MARGIN-NINE" in out and "MARGIN-ELEVEN" not in out, "since keeps a 10-minute margin")

    gone = t.post(d, "fleet", "nix", "TO-BE-DELETED")
    receive(d, "a", s, sink)
    kept = pid_of(gone) in load_state(d, "a")["seen"]["+fleet"]
    os.unlink(gone)
    receive(d, "a", s, sink)
    t.ok(kept and pid_of(gone) not in load_state(d, "a")["seen"]["+fleet"], "a seen id leaves only once its file is gone")

    lost = t.box("lost")
    create_channel(lost, "fleet", "p")
    t.post(lost, "fleet", "nix", "HOURS-23", stamp=T0 - 23 * 3600)
    t.post(lost, "fleet", "nix", "HOURS-25", stamp=T0 - 25 * 3600)
    out = receive(lost, "r", opts("r", "fleet"), sink)
    t.ok("HOURS-23" in out and "HOURS-25" not in out and out.count("cursor rebuilt; older posts are in +fleet/") == 1
         and "cursor rebuilt" not in receive(lost, "r", opts("r", "fleet"), sink), "lost state replays 24 hours once, with a notice")

    cp = t.post(d, "fleet", "nix", "ORIGINAL-TEXT")
    out = receive(d, "a", s, sink)
    found = re.search(rf"id={pid_of(cp)} from=nix \(asserted\) copy=(\S+) ===", out)
    with open(cp) as f:
        original = f.read()
    t.mk(cp, "CHANGED-TEXT\n")
    with open(found.group(1) if found else os.devnull) as f:
        t.ok(found is not None and f.read() == original, "the archive copy does not follow a changed original")

    bpath = t.direct(d, "all", "nix", "BROADCAST-ONE")
    bid = pid_of(bpath)
    t.ok(bid in receive(d, "a", s, sink) and bid in receive(d, "b", s, sink) and os.path.exists(bpath) and bid not in receive(d, "a", s, sink),
         "each reader reads a broadcast once and nobody claims it")

    fair = t.box("fair")
    create_channel(fair, "fleet", "p")
    subscribed(fair, "r", "fleet")
    for i in range(12):
        t.post(fair, "fleet", "nix", f"FAIR-{i}", stamp=T0 + i)
    first, second = receive(fair, "r", s, sink), receive(fair, "r", s, sink)
    t.ok(first.count(" begin ") == 10 and second.count(" begin ") == 2, "10 posts per sender per channel per receive")
    for i in range(4):
        t.direct(fair, "all", "nix", f"BROADCAST-{i}", stamp=T0 + i)
    b1, b2 = receive(fair, "r", s, sink), receive(fair, "r", s, sink)
    t.ok(b1.count("broadcast id=") == 3 and b2.count("broadcast id=") == 1, "3 broadcasts per sender per receive")
    misfiled = t.mk(os.path.join(fair, "+fleet", "other_20261030T000000.000000Z_from-x_0000000f.txt"), "misfiled\n")
    conflict = t.mk(os.path.join(fair, "+fleet", "fleet_20261030T000000.000000Z_from-x_0000000e.sync-conflict-20261031-000000-ABCDEFG.txt"), "x\n")
    o1, o2 = receive(fair, "r", s, sink), receive(fair, "r", s, sink)
    t.ok(o1.count("misfiled") == 1 and "misfiled" not in o2 and os.path.exists(misfiled), "a misfiled post is reported once and left alone")
    t.ok("sync-conflict" in o1 and "sync-conflict" not in o2 and os.path.exists(conflict), "a conflict copy is reported once and never delivered")

    k = t.box("kinds")
    create_channel(k, "a", "p")
    create_channel(k, "b", "p")
    subscribed(k, "r", "b", "a")
    t.direct(k, "all", "nix", "KIND-BROADCAST")
    t.post(k, "b", "nix", "KIND-B")
    t.post(k, "a", "nix", "KIND-A")
    t.direct(k, "r", "nix", "KIND-DIRECT")
    kinds = re.findall(r" begin \d+/\d+ (direct|post \+\w+|broadcast) id=", receive(k, "r", s, sink))
    t.ok(kinds == ["direct", "post +a", "post +b", "broadcast"], "direct mail, then posts by channel, then broadcasts")
    t.post(k, "a", "nix", "UNSEEN")
    seen_before = load_state(k, "r")["seen"]
    copies_before = sorted(os.listdir(os.path.join(k, ".r-read")))

    def broken(text):
        raise BrokenPipeError()

    code_out = getattr(t.raises(receive, k, "r", s, broken), "code", None)
    t.ok(code_out == "output_failed" and load_state(k, "r")["seen"] == seen_before and sorted(os.listdir(os.path.join(k, ".r-read"))) == copies_before,
         "a failed write changes no seen set and copies nothing")
    t.mk(member_path(d, "a"), json.dumps({"v": 2, "name": "a", "host": "h2", "checked": utc(T0 - 60), "subs": ["fleet"]}))
    t.ok("another reader of a appears active on h2" in receive(d, "a", s, sink), "warns when the member record shows another host")
    t.mk(member_path(d, "a"), json.dumps({"v": 2, "name": "a", "host": "h3", "checked": utc(T0 + 30), "subs": ["fleet"]}))
    t.ok("another reader of a appears active on h3" in receive(d, "a", s, sink), "a record stamped a little ahead by another host's clock still warns")

    # Review Focus 3: bytes that are not UTF-8, or not printable, in names and bodies.
    raw = t.box("bytes")
    create_channel(raw, "fleet", "p")
    subscribed(raw, "r", "fleet")
    try:
        bad_name_path = os.path.join(os.fsencode(raw), b"+fleet", b"fleet_\xff.txt")
        t.mk(bad_name_path, "odd\n")
        expect = "\\xff"
    except OSError:  # APFS refuses names that are not UTF-8; use control characters instead
        bad_name_path = t.mk(os.path.join(raw, "+fleet", "fleet_\n‮.txt"), "odd\n")
        expect = "\\x0a\\xe2\\x80\\xae"
    t.mk(os.path.join(raw, "+fleet", f"fleet_{utc(T0, micro=True)}_from-nix_0000abcd.txt"), b"From: nix@h\nTo: +fleet\n\nok \xff\xfe end\n")
    out_bad = receive(raw, "r", s, sink)
    t.ok(expect in out_bad and os.path.exists(bad_name_path), "a name with invalid UTF-8 is escaped and left in place")
    t.ok("ok �� end" in out_bad, "invalid UTF-8 in a body is replaced")

    # Review Focus 4: a large backlog after a host was away.
    big = t.box("backlog")
    create_channel(big, "c1", "p")
    create_channel(big, "c2", "p")
    ids300 = [pid_of(t.post(big, ch, sender, f"BACKLOG-{i}", stamp=T0 - 3600 + i))
              for i in range(50) for sender in ("s1", "s2", "s3") for ch in ("c1", "c2")]
    delivered, outs = [], []
    for _ in range(40):
        out = receive(big, "r", opts("r", "c1", "c2"), sink)
        got = re.findall(r" begin \d+/\d+ post \+c[12] id=(\S+) ", out)
        if not got:
            break
        delivered += got
        outs.append(out)
    t.ok(sorted(delivered) == sorted(ids300) and all(len(o.encode()) <= 12000 + 8192 for o in outs), "a 300-post backlog from three senders arrives exactly once")

    # Review Focus 5: a subscribed channel deleted, or replaced by a symlink.
    g = t.box("gone")
    create_channel(g, "a", "p")
    create_channel(g, "b", "p")
    subscribed(g, "r", "a", "b")
    os.unlink(os.path.join(g, "+b", CHANNEL_MARKER))
    os.rmdir(os.path.join(g, "+b"))
    t.post(g, "a", "nix", "STILL-DELIVERED")
    o_gone, o_again = receive(g, "r", s, sink), receive(g, "r", s, sink)
    t.ok(o_gone.count("subscribed channel +b is missing") == 1 and "+b is missing" not in o_again and "STILL-DELIVERED" in o_gone,
         "a deleted channel is reported once and receive goes on")
    elsewhere = os.path.join(t.root, "elsewhere")
    os.mkdir(elsewhere, 0o700)
    t.mk(os.path.join(elsewhere, CHANNEL_MARKER), "a channel behind a symlink\n")
    t.mk(os.path.join(elsewhere, f"a_{utc(T0, micro=True)}_from-nix_0000beef.txt"), "SECRET\n")
    os.rename(os.path.join(g, "+a"), os.path.join(t.root, "a-real"))
    os.symlink(elsewhere, os.path.join(g, "+a"))
    t.ok("SECRET" not in receive(g, "r", s, sink), "a channel replaced by a symlink is never read")


def section_retention(t):
    T0 = time.time()
    t.at(T0)

    def sink(text):
        pass

    s = load_settings({}, {}, "a")
    d = t.box()
    create_channel(d, "fleet", "fleet-wide notices")
    create_channel(d, "other", "a channel a does not read")
    st = load_state(d, "a")
