    corrupt(path + ".bak")
    t.ok(load_state(d, "pi")["_rebuilt"], "losing both marks the state rebuilt")
    state = load_state(d, "pi")
    t.ok(remember(state, "k0") and not remember(state, "k0") and all(remember(state, f"k{i}") for i in range(1, 600))
         and len(state["reported"]) == 500 and remember(state, "k0"), "remember is true the first time and keeps the last 500 keys")

    now = time.time()
    for i in range(20):
        note_send(d, "pi", "+fleet", f"b{i}", now)
    e = t.raises(note_send, d, "pi", "+fleet", "b20", now)
    t.ok(getattr(e, "code", None) == "rate_limited" and utc(now + 3600)[:13] in e.message, "the 21st post in an hour names when posting is allowed again")
    t.ok(t.raises(note_send, d, "pi", "all", "x", now) is None and getattr(t.raises(note_send, d, "pi", "all", "y", now + 60), "code", None) == "rate_limited",
         "one broadcast per 15 minutes")
    note_send(d, "pi", "nix", "same", now)
    t.ok(getattr(t.raises(note_send, d, "pi", "nix", "same", now + 599), "code", None) == "duplicate"
         and t.raises(note_send, d, "pi", "nix", "same", now + 601) is None, "an identical body to one target waits 10 minutes")

    member = os.path.join(d, ".agent-mail", "members", "pi.json")

    def mtime_after(when, subs=()):
        touch_member(d, "pi", list(subs), when)
        st = os.stat(member)
        return st.st_ino, st.st_mtime_ns

    first = mtime_after(now)
    t.ok(mtime_after(now + 299) == first and mtime_after(now + 300) != first, "presence is rewritten at most every 300 s")
    touch_member(d, "pi", ["fleet"], now + 301)
    t.ok(members(d)["pi"]["subs"] == ["fleet"], "a subscription change rewrites the member record at once")
    os.makedirs(os.path.join(d, ".agent-mail-presence"), 0o700, exist_ok=True)
    legacy = t.mk(os.path.join(d, ".agent-mail-presence", "nix"), "")
    os.utime(legacy, (now - 50, now - 50))
    t.ok(last_checked(d, "nix") == os.stat(legacy).st_mtime, "last_checked falls back to the v1 presence file")

    def snapshot(top):
        return sorted((os.path.relpath(os.path.join(folder, f), top), open(os.path.join(folder, f), "rb").read())
                      for folder, _, files in os.walk(top) for f in files)

    for n, (case, kind) in enumerate(((".agent-mail", "a symlink"), (".agent-mail/members", "a symlink"),
                                      (".agent-mail-presence", "a symlink"), (".agent-mail-presence", "not a directory"))):
        unsafe = t.box(f"unsafe{n}")
        outside = os.path.join(t.root, f"outside{n}")
