def json_lines(text):
    """The JSON value of each line of TEXT, or None when a line is not JSON."""
    try:
        return [json.loads(line) for line in text.splitlines()]
    except ValueError:
        return None


MCP_DEADLINE = 60  # seconds; guards a hang, not speed: at 10 a suite beside another at a load average above 100 timed out once, and passed alone


@contextlib.contextmanager
def mcp_process(d, name, env):
    """Test only: agent-mail mcp for NAME on mailbox D, a subprocess with environment ENV, to
    ask through ask_line. On exit its input is closed, and it is killed after MCP_DEADLINE seconds."""
    proc = subprocess.Popen([sys.executable, "-I", SCRIPT, "mcp", "--dir", d, "--name", name], stdin=subprocess.PIPE,
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=env)
    try:
        yield proc
    finally:
        proc.stdin.close()
        try:
            proc.wait(timeout=MCP_DEADLINE)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
        proc.stdout.close()


def ask_line(proc, msg, timeout=MCP_DEADLINE):
    """Write one request to an agent-mail mcp subprocess and return its parsed answer line."""
    proc.stdin.write((json.dumps(msg) + "\n").encode())
    proc.stdin.flush()
    if not select.select([proc.stdout], [], [], timeout)[0]:
        raise TestFailed(f"the mcp subprocess gave no answer to {msg.get('method')} within {timeout} s")
    return json.loads(proc.stdout.readline())


