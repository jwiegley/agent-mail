def traffic_retention_checks(t):
    """The send log's prune, in section retention."""
    T0 = time.time()
    t.at(T0)
    s = load_settings({}, {}, "a")
    d = t.box("traffic-prune")
    where = log_on(d)
    old = planted(d, "b", "c", T0 - 7 * 86400 - 60)
    young = planted(d, "b", "c", T0 - 7 * 86400 + 600)
    linked = f"b_{utc(T0 - 30 * 86400, micro=True)}_from-c_0000000a.json"
    os.symlink(os.path.join(where, f"{young}.json"), os.path.join(where, linked))
    old_dir = f"b_{utc(T0 - 30 * 86400, micro=True)}_from-c_0000000b.json"
    os.mkdir(os.path.join(where, old_dir))
    tmp = f".b_{utc(T0 - 30 * 86400, micro=True)}_from-c_0000000c.json.tmp"
    for name in (".hidden", tmp, "notes.txt", f"b_{utc(T0 - 30 * 86400, micro=True)}_from-c_0000000d.txt"):
        t.mk(os.path.join(where, name), "")
    t.ok(prune_due(d, "a", s, load_state(d, "a"), T0), "the hourly pass runs")
    left = set(os.listdir(where))
    t.ok(f"{old}.json" not in left and {f"{young}.json", TRAFFIC_MARKER, ".hidden", linked, old_dir, tmp, "notes.txt"} <= left
         and len(left) == 8,
         "the hourly pass deletes records more than 7 days past their stamp, and keeps younger records, the marker, other hidden names, symlinks, "
         "directories and names that are not records")
    d = t.box("traffic-prune-ahead")
    where = log_on(d)
    ahead = planted(d, "b", "c", T0 + 30 * 86400)
    ctime = os.lstat(os.path.join(where, f"{ahead}.json")).st_ctime
    kept = prune_traffic(d, ctime + 7 * 86400 - 60) == 0 and os.path.exists(os.path.join(where, f"{ahead}.json"))
    t.ok(kept and prune_traffic(d, ctime + 7 * 86400 + 60) == 1 and not os.path.exists(os.path.join(where, f"{ahead}.json")),
         "a record stamped more than 24 hours ahead goes 7 days after its ctime")

    d = t.box("traffic-off-prune")
    where = log_on(d)
    fresh = planted(d, "b", "c", T0)
    t.ok(prune_traffic(d, T0 + 6 * 3600) == 0, "while the marker is there, a record is kept for its 7 days")
    os.unlink(os.path.join(where, TRAFFIC_MARKER))
    ctime = os.lstat(os.path.join(where, f"{fresh}.json")).st_ctime
    kept = prune_traffic(d, ctime + TRAFFIC_OFF_KEEP - 60) == 0 and os.path.exists(os.path.join(where, f"{fresh}.json"))
    t.ok(kept and prune_traffic(d, ctime + TRAFFIC_OFF_KEEP + 60) == 1 and record_files(d) == [],
         "with the marker absent, the pass keeps a record that has been on this host less than an hour, and deletes it after the hour")
    t.ok(os.path.isdir(where) and os.listdir(where) == [], "the pass leaves .agent-mail/traffic in place when it empties")
    d = t.box("traffic-odd-marker")
    where = log_on(d)
    os.unlink(os.path.join(where, TRAFFIC_MARKER))
    os.mkdir(os.path.join(where, TRAFFIC_MARKER), 0o700)
    odd = planted(d, "b", "c", T0)
    fifo = f"b_{utc(T0 - 30 * 86400, micro=True)}_from-c_0000000e.json"
    os.mkfifo(os.path.join(where, fifo), 0o600)
    ctime = os.lstat(os.path.join(where, f"{odd}.json")).st_ctime
    t.ok(prune_traffic(d, ctime + TRAFFIC_OFF_KEEP + 60) == 1 and record_files(d) == [fifo] and os.path.isdir(os.path.join(where, TRAFFIC_MARKER)),
         "a marker that is not a regular file is no marker: the pass sweeps records after their hour; and it never removes a FIFO named as a record")
    bare = t.box("traffic-none")
    prune_traffic(bare, T0)
    receive(bare, "a", s, lambda text: None)
    t.ok(not os.path.lexists(os.path.join(bare, TRAFFIC_DIR)), "neither the pass nor a receive creates .agent-mail/traffic or its marker")
    d = t.box("traffic-receive-prunes")
    log_on(d)
    stale = planted(d, "b", "c", T0 - 8 * 86400)
    receive(d, "a", s, lambda text: None)
    t.ok(f"{stale}.json" not in record_files(d), "a reader's hourly pass, through receive, prunes the send log")
    t.at(None)


def section_traffic(t):
    """The send log's reader, agent-mail traffic: order and window, names, the checks of each record, coverage, the two forms,
    the off log, the refusals, and that it writes nothing."""
    T0 = time.time()
    t.at(T0)
    d = t.box()
    where = log_on(d)
    create_channel(d, "fleet", "fleet-wide notices")
    stamps = [T0 - 5 * 3600, T0 - 3 * 3600, T0 - 3 * 3600, T0 - 1800, T0 - 30 * 3600]
    ids = [planted(d, "nix", "pi", stamps[0]), planted(d, "+fleet", "nix", stamps[1], via="mcp"), planted(d, "pi", "omlx", stamps[2]),
           planted(d, "all", "pi", stamps[3]), planted(d, "nix", "pi", stamps[4])]
    report, code, err = traffic_json(t, d)
    t.ok(code == 0 and err == "" and [row["id"] for row in report["rows"]] == sorted(ids[:4], key=lambda i: (i.split("_")[1], i)),
         "traffic lists the records of the last 24 hours by default, in (utc, id) order")
    t.ok([row["id"] for row in traffic_json(t, d, "--hours", "2")[0]["rows"]] == [ids[3]]
         and [row["id"] for row in traffic_json(t, d, "--since", utc(T0 - 31 * 3600))[0]["rows"]][0] == ids[4]
         and [row["id"] for row in traffic_json(t, d, "--since", utc(T0 - 4 * 3600, micro=True))[0]["rows"]] == sorted(ids[1:4], key=lambda i: (i.split("_")[1], i)),
         "--hours and --since, in either standard form, set where the rows start")
    whole = math.floor(T0 - 8 * 3600)
    inside = planted(d, "nix", "pi", whole + 0.3)
    floored = traffic_json(t, d, "--since", utc(whole + 0.5, micro=True))[0]
    t.ok(floored["since"] == utc(whole) and [row["id"] for row in floored["rows"]][0] == inside,
         "--since is read to the second, as the report shows it: a record stamped earlier in that second is in the window")
    os.unlink(os.path.join(where, f"{inside}.json"))
    t.ok([row["id"] for row in traffic_json(t, d, "--name", "omlx")[0]["rows"]] == [ids[2]]
         and sorted(row["id"] for row in traffic_json(t, d, "--name", "nix", "--name", "all")[0]["rows"]) == sorted([ids[0], ids[1], ids[3]])
         and [row["id"] for row in traffic_json(t, d, "--name", "+fleet")[0]["rows"]] == [ids[1]],
         "--name keeps the rows from or to that name, +channel or all, and can be given more than once")
    t.ok(report["rows"][0] == {"utc": ids[0].split("_")[1], "host": HOST, "from": "pi", "to": "nix", "id": ids[0], "subject": "a subject", "in_reply_to": None, "via": "cli"},
         "a row is the record less v")

    bad = t.box("traffic-bad")
    where = log_on(bad)
    good = planted(bad, "nix", "pi", T0 - 60, in_reply_to=ids[0])
    trailing = planted(bad, "nix", "pi", T0 - 61, subject="x" * 199 + " ")
    malformed = {
        "not JSON": b"not json\n", "not UTF-8": b'{"v":1}\xff\n', "nested past the decoder": b"[" * 2000 + b"]" * 2000 + b"\n",
        "v 2": {"v": 2}, "v true": {"v": True}, "v as text": {"v": "1"}, "an id unlike its name": {"id": "nix_20261106T000000.000000Z_from-pi_00000000"},
        "to unlike the id": {"to": "omlx"}, "a post's to unlike the id": "post", "a broadcast's to as a channel": "plus-all",
        "a post to a reserved name": "plus-root", "utc unlike the id": {"utc": "20261106T000000.000000Z"},
        "from unlike the id": {"from": "omlx"}, "a blank subject": {"subject": "   "}, "an empty subject": {"subject": ""},
        "a subject clean_line would change": {"subject": "two  spaces"}, "a subject with a tab": {"subject": "a\tb"},
        "a subject with two final spaces": {"subject": "x" * 198 + "  "}, "a subject over 200 characters": {"subject": "x" * 201},
        "a subject that is not text": {"subject": 5}, "an in_reply_to that is no id": {"in_reply_to": "x"}, "a host with a capital": {"host": "Hera"},
        "a host over 64 characters": {"host": "h" * 65}, "a via of another kind": {"via": "web"}, "a key more": {"extra": 1}, "a key less": "less",
        "two lines": "two", "no final newline": "unended", "a JSON array": "array",
    }
    for what, change in malformed.items():
        if change == "post":
            planted(bad, "+fleet", "pi", T0 - 120, change={"to": "+ingest"})
        elif change == "less":
            planted(bad, "nix", "pi", T0 - 120, raw=record_text({"v": 1, "utc": utc(T0 - 120, micro=True), "host": HOST, "from": "pi", "to": "nix",
                                                                  "subject": "s", "in_reply_to": None, "via": "cli"}).encode())
        elif change == "plus-all":
            planted(bad, "all", "pi", T0 - 120, change={"to": "+all"})
        elif change == "plus-root":
            planted(bad, "root", "pi", T0 - 120, change={"to": "+root"})
        elif change == "array":
            planted(bad, "nix", "pi", T0 - 120, raw=b"[1]\n")
        elif change == "two":
            planted(bad, "nix", "pi", T0 - 120, raw=b'{"v":1}\n{"v":1}\n')
        elif change == "unended":
            ident = planted(bad, "nix", "pi", T0 - 120)
            data = record_bytes(bad, ident)
            t.mk(os.path.join(where, f"{ident}.json"), data[:-1])
        elif isinstance(change, dict):
            planted(bad, "nix", "pi", T0 - 120, change=change)
        else:
            planted(bad, "nix", "pi", T0 - 120, raw=change)
    oversized = planted(bad, "nix", "pi", T0 - 130, subject="s" * 200, raw=b" " * (RECORD_MAX - 1) + b"\n" + b"x")
    os.symlink(os.path.join(where, f"{good}.json"), os.path.join(where, f"nix_{utc(T0 - 140, micro=True)}_from-pi_0000000e.json"))
    linked = planted(bad, "nix", "pi", T0 - 150)
    os.link(os.path.join(where, f"{linked}.json"), os.path.join(t.root, "a-second-link"))
    os.mkfifo(os.path.join(where, f"nix_{utc(T0 - 160, micro=True)}_from-pi_0000000f.json"), 0o600)
    os.mkdir(os.path.join(where, f"nix_{utc(T0 - 170, micro=True)}_from-pi_00000010.json"), 0o700)
    future = planted(bad, "nix", "pi", T0 + FUTURE + 600)
    report, code, err = traffic_json(t, bad)
    t.ok(code == 0 and sorted(row["id"] for row in report["rows"]) == sorted([good, trailing])
         and report["skipped"] == {"malformed": len(malformed), "not_regular": 4, "oversized": 1, "future": 1},
         f"traffic skips and counts each malformed record ({', '.join(malformed)}), each one over 4,096 bytes, each symlink, hard link, FIFO "
         f"or directory, and each stamped more than 24 hours ahead, and keeps the good ones (got {report['skipped']})")
    t.ok(all(os.path.exists(os.path.join(where, f"{ident}.json")) for ident in (oversized, future, linked)) and len(os.listdir(where)) == len(malformed) + 9,
         "and it deletes, moves and changes none of them")
    human = t.run(["--dir", bad, "traffic"])[0].splitlines()
    t.ok(f"skipped: {len(malformed)} malformed, 4 not a regular file of yours that can be opened, 1 over 4,096 bytes, 1 stamped more than 24 hours ahead" in human
         and not any(line.startswith("skipped:") for line in t.run(["--dir", d, "traffic"])[0].splitlines()),
         "the human form counts the records it skipped, by kind, and has no skipped line when it skipped none")
    good_text, real_loads = record_bytes(bad, good).decode("utf-8"), json.loads

    def too_deep(text, *args, **kwargs):
        if text == good_text:
            raise RecursionError("maximum recursion depth exceeded while decoding a JSON object")
        return real_loads(text, *args, **kwargs)

    json.loads = too_deep
    try:
        deep = traffic_report(bad, T0 - 86400, T0)
    except RecursionError:
        deep = None
    finally:
        json.loads = real_loads
    t.ok(deep is not None and good not in [row["id"] for row in deep["rows"]] and deep["skipped"]["malformed"] == len(malformed) + 1,
