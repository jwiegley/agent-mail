            os.symlink(os.path.join(here, TRAFFIC_MARKER), os.path.join(here, f"nix_{utc(T0, micro=True)}_from-pi_00000011.json"))
        elif name == "conflict":
            t.mk(os.path.join(here, f"nix_{utc(T0, micro=True)}_from-pi_00000012.sync-conflict-20261106-000000-ABCDEFG.json"), "")
        else:
            t.mk(os.path.join(here, f".nix_{utc(T0, micro=True)}_from-pi_00000013.json.tmp"), "")
        cases.append((what, box, said))
    for what, box, said in cases:
