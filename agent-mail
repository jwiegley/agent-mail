    # Two senders of one name, one body: the first holds its window's flock while it writes.
    entered, gate, outcomes = [], threading.Event(), []
    real_write_new = write_new

    def gated(fd, file, data):
        entered.append(file)
        gate.wait(10)
        return real_write_new(fd, file, data)

    def twin():
        try:
            outcomes.append(send(d, "twin", "nix", "s", "ONE BODY FROM TWO SENDERS", s).id)
