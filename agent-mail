ISOLATED = ("AGENT_MAIL_", "AGENTDECK_")


def isolated_keys():
    return [k for k in os.environ if k.startswith(ISOLATED) or k in ("CLAUDE_JOB_DIR", "HOME")]


def run_section(fn):
    """Run one section in a fresh temporary HOME and runtime directory, with no
    AGENT_MAIL_*, AGENTDECK_* or CLAUDE_JOB_DIR variable, and restore them after."""
    saved = {k: os.environ.pop(k) for k in isolated_keys()}
    try:
        with tempfile.TemporaryDirectory() as root:
            os.environ["HOME"] = root
            run = os.path.join(root, "run")
            os.mkdir(run, 0o700)
            os.environ["AGENT_MAIL_RUNTIME_DIR"] = run
            t = T(root)
            try:
                fn(t)
            finally:
                t.restore()
            return t.checks
    finally:
        for k in isolated_keys():
            del os.environ[k]
        os.environ.update(saved)


def self_test(names=()):
    known = dict(SECTIONS)
    unknown = [n for n in names if n not in known]
    if unknown:
        raise MailError("bad_argument", f"no self-test section {unknown[0]!r}; the sections are {', '.join(known)}")
    total = 0
    try:
        for name, fn in SECTIONS:
            if not names or name in names:
                total += run_section(fn)
    except TestFailed as e:
        print(f"agent-mail self-test FAILED: {e}", file=sys.stderr)
        return 1
    print(f"agent-mail self-test: {total} checks passed")
    return 0


