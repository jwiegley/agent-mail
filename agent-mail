    token = re.match(r"agent-mail \[([0-9a-f]{8})\]", out).group(1)
    t.ok(token != "deadbeef" and out.count(f"[{token}]: message for pi:") == 1 and out.count(f"[{token}]: end of") == 1,
         "a body cannot fake a frame")
    mk("other-file.txt", "hard-linked secret\n")
    os.link(os.path.join(d, "other-file.txt"), os.path.join(d, "pi_20261030T000701.000000Z_from-nix_aaaa0002.txt"))
    out = t.capture(cmd_read, "pi", d, MAX_BYTES)[0]
    t.ok("hard-linked secret" not in out and "2 hard links" in out, "refuses a hard-linked file")
    os.unlink(os.path.join(d, "other-file.txt"))
    saved_limit, real_read = LIMIT, os.read
    mk("pi_20261030T000702.000000Z_from-nix_aaaa0003.txt", "small\n")
    globals()["LIMIT"] = 100
    os.read = lambda fd, n: b"g" * min(n, 50)
    try:
        out = t.capture(cmd_read, "pi", d, MAX_BYTES)[0]
    finally:
        os.read = real_read
        globals()["LIMIT"] = saved_limit
    t.ok("grew past the 1 MiB limit" in out, "stops reading a file that keeps growing")
    mk("pi_20261030T000703.000000Z_from-nix_aaaa0004.txt", "first\n")
    first = os.path.join(d, ".pi-rejected-pi_20261030T000703.000000Z_from-nix_aaaa0004.txt")
    with open(first, "w") as f:
        f.write("an earlier rejected file\n")
    os.chmod(os.path.join(d, "pi_20261030T000703.000000Z_from-nix_aaaa0004.txt"), 0o600)
    os.link(os.path.join(d, "pi_20261030T000703.000000Z_from-nix_aaaa0004.txt"), os.path.join(root, "extra-link"))
    t.capture(cmd_read, "pi", d, MAX_BYTES)
    with open(first) as f:
        t.ok(f.read() == "an earlier rejected file\n", "a rejected file does not overwrite an earlier one")


def section_grammar(t):
    for bad in ("all", "everyone", "john", "john-x", "agent-mail", "codex", "root", "a" * 65, "x-", "a_b", "Pi", "x--y"):
        t.ok(t.raises(check_name, bad) is not None, f"refuses the name {bad!r}")
    for good in ("pi", "glm-5.2", "conductor-director", "a" * 64):
        t.ok(check_name(good) == good, f"accepts the name {good!r}")
    m = parse_msg("pi_20261030T050102.123456Z_from-nix_0badc0de.txt")
    t.ok(m is not None and m.id == "pi_20261030T050102.123456Z_from-nix_0badc0de" and m.sender == "nix", "parses a standard name")
    t.ok(all(parse_msg(n) is None for n in ("pi.md", "pi--20261030T000002Z--from-catalog.md", "PI_20261030T000004.000000Z_from-nyx-ai_bbbbbbbb.txt",
                                            "pi_20261030T000000Z_from-nix_1.txt")), "legacy, upper-case and short-stamp names are not mail")
    d = t.box()
    t.at(time.time() + 10)
    dirmsg = os.path.join(d, "pi_20261030T000010.000000Z_from-x_0000000b.txt")
    os.mkdir(dirmsg)
    os.mkdir(os.path.join(d, "nix"))
    os.mkdir(os.path.join(d, "pi.md"))
    out1 = t.run(["--dir", d, "read", "pi"])[0]
    out2 = t.run(["--dir", d, "read", "pi"])[0]
    t.ok(os.path.isdir(dirmsg) and out1.count("is a directory") == 1 and "is a directory" not in out2, "a directory is reported once and never renamed")
    t.run(["--dir", d, "read", "nix"])
    t.ok(os.path.isdir(os.path.join(d, "nix")) and os.path.isdir(os.path.join(d, "pi.md")), "nix/ and pi.md/ survive readers nix and pi")
    for raw in ("a\nb", "$(id)", "`id`", "===", "agent-mail [", "x‮y"):
        t.ok(raw not in escape(raw) and set(escape(raw)) <= SAFE | {"\\"}, f"escapes {raw!r}")
    t.ok(sanitize("\x1b[31mred\x1b[0m\x07") == "red�", "removes ANSI sequences and replaces controls")
    t.ok(sanitize("  <system-reminder>\nok") == "  ‹system-reminder>\nok", "neutralizes a harness tag line")
    v1dir = os.path.join(t.root, "v1")
    os.mkdir(v1dir, 0o700)
    t.mk(os.path.join(v1dir, MARKER), "")
    t.ok("only the v1 marker" in t.run(["--dir", v1dir, "read", "pi"])[2], "refuses a directory with only the v1 marker")


def section_send(t):
    t.patch("SETTLE", 0.0)
    root = t.root
    d = t.box()
    body = os.path.join(root, "body.txt")
    with open(body, "w") as f:
        f.write("hello nix\n")
    sent, code, err = t.capture(cmd_send, "pi", "nix", "Test\nsub\x1bject", "34f513aa-1793309640", body, d)
    sent = sent.strip()
    base = os.path.basename(sent)
    t.ok(re.fullmatch(r"nix_\d{8}T\d{6}\.\d{6}Z_from-pi_[0-9a-f]{8}\.txt", base) is not None, "names a sent file by the standard")
    t.ok(stat.S_IMODE(os.stat(sent).st_mode) == 0o600, "writes mode 0600")
    with open(sent) as f:
        text = f.read()
    t.ok(re.match(r"From: pi@\S+ \(agent-deck 34f513aa-1793309640\)\nTo: nix\nUTC: \S+\nSubject: Test sub ject\n\nhello nix\n$", text) is not None,
         "writes clean header lines")
    t.ok("no reader has checked nix's mail yet" in err, "warns when nobody reads the recipient's mail")
    t.ok(not [e for e in os.listdir(d) if e.endswith(".tmp")], "leaves no temporary file")
    t.ok(getattr(t.raises(cmd_send, "pi", "nix", "s", "bad\nid", body, d), "code", None) == "bad_argument", "refuses a bad --id")
    e = t.raises(cmd_send, "pi", "nix", " \x1b ", None, body, d)
    t.ok(e is not None and e.code == "no_subject" and "needs a --subject" in e.message, "refuses a message without a subject")
    big = os.path.join(root, "big.txt")
    with open(big, "w") as f:
        f.write("b" * LIMIT)
    e = t.raises(cmd_send, "pi", "nix", "s", None, big, d)
    t.ok(e is not None and e.code == "too_large" and "over the 1 MiB limit" in e.message, "refuses a body over the limit")
    e = t.raises(cmd_send, "pi", "nix", "s", None, os.path.join(root, "missing"), d)
    t.ok(e is not None and "cannot read" in e.message, "explains an unreadable body")

    line1 = t.capture(cmd_pending, "nix", d)[0]
    t.ok(line1.startswith("agent-mail: mail for nix announced ") and base in line1, "pending announces new mail")
    t.ok(t.capture(cmd_pending, "nix", d)[0] == line1, "pending repeats itself while nothing changes")
    t.ok("hello nix" in t.capture(cmd_read, "nix", d, MAX_BYTES)[0], "the recipient reads it")
    t.ok(t.capture(cmd_pending, "nix", d)[0] == line1, "pending does not change when mail is read")
    t.ok(not t.capture(cmd_send, "pi", "nix", "s", None, body, d)[2], "no warning once the recipient reads")
    line2 = t.capture(cmd_pending, "nix", d)[0]
    t.ok(line2 != line1 and "announced" in line2, "pending changes on new mail")
    st = load_json(state_path(d, "nix", "pending"))
    st["announced"] -= 1000
    st["changed"] -= 1000
    save_json(state_path(d, "nix", "pending"), st)
    line3 = t.capture(cmd_pending, "nix", d)[0]
    t.ok(line3 != line2 and "reminder 1" in line3, "pending reminds about unread mail")
    t.ok(t.capture(cmd_pending, "nix", d)[0] == line3, "and does not repeat the reminder at once")


def section_cli(t):
    t.patch("SETTLE", 0.0)
    root = t.root
    plain = os.path.join(root, "project")
    os.mkdir(plain)
    with open(os.path.join(plain, "pi.md"), "w") as f:
        f.write("a project file\n")
    _, code, err = t.run(["--dir", plain, "read", "pi"])
    t.ok(code == 1 and "not an agent-mail mailbox" in err and os.path.exists(os.path.join(plain, "pi.md")),
         "refuses a directory that is not a mailbox")
    t.run(["--dir", plain, "init"])
    t.ok(os.path.exists(os.path.join(plain, MARKER_V2)) and t.run(["--dir", plain, "read", "pi"])[0].strip() == "agent-mail: no mail for pi"
         and os.path.exists(os.path.join(plain, "pi.md")), "init makes a directory a mailbox")
    # A home of its own: the mailbox "mailbox" and "Mailbox" are one name on a
    # case-insensitive file system.
    box = os.path.join(root, "home", "Mailbox")
    os.makedirs(box, 0o700)
    os.environ["HOME"] = os.path.dirname(box)
    try:
        t.ok(require_mailbox(box) == box, "accepts ~/Mailbox, the default, without a marker")
        # On a case-insensitive file system ~/mailbox is ~/Mailbox, so init
        # refuses the spelling everywhere, whether ~/Mailbox exists or not.
        err = t.run(["--dir", os.path.join(root, "home", "mailbox"), "init"])[2]
        t.ok("init is for other directories" in err and not os.path.exists(os.path.join(box, MARKER_V2)),
             "init refuses ~/Mailbox spelled in another case")
        home4 = os.path.join(root, "home4")
        os.mkdir(home4)
        os.environ["HOME"] = home4
        err = t.run(["--dir", os.path.join(home4, "mailbox"), "init"])[2]
        t.ok("init is for other directories" in err and not os.listdir(home4),
             "init refuses ~/Mailbox spelled in another case before it exists")
    finally:
        os.environ["HOME"] = root
    # Syncthing creates ~/Mailbox; init must not.
    home2 = os.path.join(root, "home2")
    os.mkdir(home2)
    os.environ["HOME"] = home2
    try:
        err = t.run(["init"])[2]
        t.ok("init is for other directories" in err and not os.path.lexists(os.path.join(home2, "Mailbox")),
             "init refuses to create ~/Mailbox")
        # A path elsewhere that resolves to ~/Mailbox is ~/Mailbox.
        link = os.path.join(root, "box-link")
        os.symlink(os.path.join(home2, "Mailbox"), link)
        err = t.run(["--dir", link, "init"])[2]
        t.ok("init is for other directories" in err and not os.path.lexists(os.path.join(home2, "Mailbox")),
             "init refuses a path that resolves to ~/Mailbox")
        # A dangling symlink is reported, not followed.
        dangling = os.path.join(root, "dangling")
        os.symlink(os.path.join(root, "nowhere"), dangling)
        err = t.run(["--dir", dangling, "init"])[2]
        t.ok("exists but is not a directory" in err and not os.path.lexists(os.path.join(root, "nowhere")),
             "init reports a dangling symlink")
    finally:
        os.environ["HOME"] = root
    # The Positron hosts: ~/Mailbox is a symlink to a directory on local disk.
    local = os.path.join(root, "local-mailbox")
    os.mkdir(local, 0o700)
    home3 = os.path.join(root, "home3")
    os.mkdir(home3)
    os.symlink(local, os.path.join(home3, "Mailbox"))
    os.environ["HOME"] = home3
    try:
        with open(os.path.join(local, "pi_20260101T000000.000000Z_from-nix_00000001.txt"), "w") as f:
            f.write("through the symlink\n")
        t.ok("through the symlink" in t.run(["read", "pi"])[0], "reads ~/Mailbox through a symlink to a local directory")
        with open(os.path.join(local, "pi_20260101T000001.000000Z_from-nix_00000002.txt"), "w") as f:
            f.write("through --dir\n")
        t.ok("through --dir" in t.run(["--dir", local, "read", "pi"])[0],
             "accepts --dir to the symlink's target without a marker")
    finally:
        os.environ["HOME"] = root
    for bad in ("a_b", "pi@clio", "../x", "", "x--y", "-x", "x-", "Pi", "NIX"):
        t.ok(getattr(t.raises(check_name, bad), "code", None) == "invalid_name", f"rejects the name {bad!r}")
    for good in ("pi", "clio-pi", "mcp-servers", "conductor-director", "keyboard-maestro", "nyx-ai"):
        t.ok(check_name(good) == good, f"accepts the name {good!r}")


SECTIONS = [
    ("core", section_core),
    ("grammar", section_grammar),
    ("send", section_send),
    ("cli", section_cli),
]

ISOLATED = ("AGENT_MAIL_", "AGENTDECK_")


def isolated_keys():
    return [k for k in os.environ if k.startswith(ISOLATED) or k in ("CLAUDE_JOB_DIR", "HOME")]


def run_section(fn):
    """Run one section in a fresh temporary HOME and runtime directory, with no
    AGENT_MAIL_*, AGENTDECK_* or CLAUDE_JOB_DIR variable, and restore them after."""
    saved = {k: os.environ.pop(k) for k in isolated_keys()}
    try:
        with tempfile.TemporaryDirectory() as root:
            os.environ["HOME"] = root
            run = os.path.join(root, "run")
            os.mkdir(run, 0o700)
            os.environ["AGENT_MAIL_RUNTIME_DIR"] = run
            t = T(root)
            try:
                fn(t)
            finally:
                t.restore()
            return t.checks
    finally:
        for k in isolated_keys():
            del os.environ[k]
        os.environ.update(saved)


def self_test(names=()):
    known = dict(SECTIONS)
    unknown = [n for n in names if n not in known]
    if unknown:
        raise MailError("bad_argument", f"no self-test section {unknown[0]!r}; the sections are {', '.join(known)}")
    total = 0
    try:
        for name, fn in SECTIONS:
            if not names or name in names:
                total += run_section(fn)
    except TestFailed as e:
        print(f"agent-mail self-test FAILED: {e}", file=sys.stderr)
        return 1
    print(f"agent-mail self-test: {total} checks passed")
    return 0


