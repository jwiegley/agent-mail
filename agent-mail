    touch_member(d, "pv", [], now - 100)
    pv = legacy_presence(d, "pv")
    t.ok(os.path.isfile(pv) and abs(os.stat(pv).st_mtime - (now - 100)) < 0.01, "the v1 presence file is touched with the member record, at the reader's time")
    t.patch("SETTLE", 0.0)
    local = t.box("hostlocal")
    send(local, "nix", "pi", "s", "mail for pi to announce and read", load_settings({}, {}, "nix"))
    send(local, "pi", "nix", "s", "a send leaves a window", load_settings({}, {}, "pi"))
    t.run(["--dir", local, "pending", "pi"])
    t.run(["--dir", local, "read", "pi"])
    inside = sorted(os.path.relpath(os.path.join(folder, f), local) for folder, _, files in os.walk(local) for f in files if f.endswith(".json"))
    here = os.path.join(t.root, ".local", "state", "agent-mail") + os.sep
    t.ok(inside == [os.path.join(".agent-mail", "members", "pi.json")]
         and all(os.path.isfile(state_file(local, "pi", x)) and state_file(local, "pi", x).startswith(here) for x in ("", ".send", ".pending")),
         "reader state, the send window and pending's state stay on this host, outside the mailbox")
    arch = t.box("archive-link")
    away = os.path.join(t.root, "archive-elsewhere")
    os.mkdir(away, 0o700)
    os.symlink(away, os.path.join(arch, ".pi-read"))
    waiting = t.direct(arch, "pi", "nix", "stays home")
    out, code, err = t.run(["--dir", arch, "read", "pi"])
    report, flagged, _ = t.run(["--dir", arch, "doctor", "pi"])
    t.ok(code == 1 and ".pi-read is a symlink" in err and not out and os.path.exists(waiting) and not os.listdir(away)
         and flagged == 1 and ".pi-read is a symlink" in report, "a symlinked archive directory is refused before anything is claimed, and doctor names it")
    os.unlink(os.path.join(arch, ".pi-read"))
    batch = collect(arch, "pi", load_settings({}, {}, "pi"), load_state(arch, "pi"), MAX_BYTES, clock())
    os.symlink(away, os.path.join(arch, ".pi-read"))
    e = t.raises(commit, arch, "pi", batch, load_state(arch, "pi"), clock())
    t.ok(len(batch.items) == 1 and getattr(e, "code", None) == "unsafe_mailbox" and not os.listdir(away),
         "commit moves nothing through an archive directory swapped for a symlink after collect")


def section_channels(t):
    d = t.box()
    now = time.time()
    s = load_settings({}, {}, "pi")

    def marker_text(d, ch):
        with open(os.path.join(d, f"+{ch}", CHANNEL_MARKER)) as f:
            return f.read().rstrip("\n")

    t.ok(create_channel(d, "fleet", "fleet-wide notices") == os.path.join(d, "+fleet") and marker_text(d, "fleet") == "fleet-wide notices",
         "creates +fleet with its purpose")
    t.ok(getattr(t.raises(create_channel, d, "fleet", "again"), "code", None) == "channel_exists", "a channel is created once")
    touch_member(d, "nix", [], now)
    t.ok(getattr(t.raises(create_channel, d, "nix", "p"), "code", None) == "name_taken", "a channel cannot take a session's name")
    t.ok(getattr(t.raises(create_channel, d, "all", "p"), "code", None) == "reserved_name", "a channel cannot take a reserved name")
    t.ok(getattr(t.raises(create_channel, d, "ops", " \x1b "), "code", None) == "bad_argument" and not os.path.lexists(os.path.join(d, "+ops")),
         "a channel needs a purpose")
    elsewhere = os.path.join(t.root, "elsewhere")
    os.mkdir(elsewhere)
    t.mk(os.path.join(elsewhere, CHANNEL_MARKER), "a marker behind a symlink\n")
    os.symlink(elsewhere, os.path.join(d, "+evil"))
    os.mkdir(os.path.join(d, "+bare"))
    t.ok([c["name"] for c in list_channels(d, now)] == ["fleet"] and getattr(t.raises(channel_dir, d, "evil"), "code", None) == "no_such_channel",
         "a symlink or a directory without the marker is not a channel")
    st = load_state(d, "pi")
    t.ok(getattr(t.raises(subscribe, d, "pi", st, s, "nope"), "code", None) == "no_such_channel", "subscribing to a missing channel fails")
    many = load_state(d, "many")
    for i in range(20):
        create_channel(d, f"c{i}", "one of twenty")
        subscribe(d, "many", many, s, f"c{i}", now=now)
    twenty_first = t.raises(subscribe, d, "many", many, s, "fleet", now=now)
    t.ok(getattr(twenty_first, "code", None) == "too_many_subscriptions", "at most 20 subscriptions")
    t.ok(getattr(t.raises(subscribe, d, "pi", st, s, "fleet", backlog=21, now=now), "code", None) == "bad_argument", "a backlog is at most 20")
    ids = [parse_msg(os.path.basename(t.post(d, "fleet", "nix", f"post {i}", stamp=now - 3600 + i * 60))).id for i in range(5)]
    subscribe(d, "pi", st, s, "fleet", backlog=2, now=now)
    t.ok(set(st["seen"]["+fleet"]) == set(ids[:3]), "backlog 2 leaves exactly the two newest of five earlier posts unread")
    subscribe(d, "pi", st, s, "fleet", write=True, now=now)
    t.ok(effective_subs(st, s, now)["fleet"]["write"] is True, "subscribe with write marks the channel a write target")
    subscribe(d, "pi", st, s, "fleet", wake=True, now=now)
    t.ok(effective_subs(st, s, now)["fleet"] == {**effective_subs(st, s, now)["fleet"], "wake": True, "write": True}, "subscribing again changes only the attributes named")
    subscribe(d, "pi", st, s, "fleet", write=False, now=now)
    t.ok(effective_subs(st, s, now)["fleet"]["write"] is False and effective_subs(st, s, now)["fleet"]["wake"] is True, "write false clears the target and leaves wake alone")
    pinned_ops = load_settings({"channels": ["ops:wake"]}, {}, "pi")
    create_channel(d, "ops", "ops notices")
    subscribe(d, "pi", st, pinned_ops, "ops", write=True, now=now)
    t.ok(effective_subs(st, pinned_ops, now)["ops"] == {"wake": True, "write": True, "pinned": True, "since": now - 86400}, "a pinned channel takes write without touching its cursor")
    t.ok(st["subs"]["ops"]["wake"] is False, "a pinned channel's wake is not copied into the state")
    st["subs"]["fleet"] = {"since": now, "wake": False}
    t.ok(effective_subs(st, s, now)["fleet"]["write"] is False, "a 2.1 subscription without write loads as not a target")
    st["subs"]["fleet"] = {"since": now, "wake": False, "write": "yes"}
    t.ok(effective_subs(st, s, now)["fleet"]["write"] is False, "write is a target only when it is exactly true")
    subscribe(d, "pi", st, s, "c0", write=True, now=now)
    subscribe(d, "pi", st, s, "c1", now=now)
    t.ok(effective_subs(st, s, now)["c0"]["write"] is True and effective_subs(st, s, now)["c1"]["write"] is False,
         "a new subscription takes write as given, false by default")
    t.ok(getattr(t.raises(unsubscribe, st, pinned_ops, "ops"), "code", None) == "pinned", "a pinned channel cannot be unsubscribed")
    t.ok(effective_subs(load_state(d, "fresh"), pinned_ops, now) == {"ops": {"wake": True, "write": False, "pinned": True, "since": now - 86400}},
         "a pinned channel with no state starts 24 hours back")
    touch_member(d, "pi", effective_subs(st, s, now), now)
    c = next(c for c in list_channels(d, now) if c["name"] == "fleet")
    t.ok(c["posts_7d"] == 5 and c["subscribers"] == ["pi"], "lists posts in the last 7 days and published subscribers")
    t.ok(c["last_post"] == parse_msg(f"{ids[-1]}.txt").utc, "the last post is shown as the newest post's own stamp")
    unsubscribe(st, s, "fleet")
    t.ok("fleet" not in st["subs"] and "+fleet" not in st["seen"], "unsubscribe drops the channel and its seen set")
    lone = load_state(d, "lone")
    subscribe(d, "lone", lone, s, "c0", write=True, now=now)
    t.ok(write_targets(lone, s, now) == ["c0"], "a write subscription is the sender's one target")
    unsubscribe(lone, s, "c0")
    t.ok(write_targets(lone, s, now) == ["fleet"], "unsubscribe drops a write target with its subscription, and the default channel takes over")
    old = load_state(d, "old")
    old["subs"]["fleet"] = {"since": now, "wake": False}  # as 2.1 wrote it, with no write key
    save_state(d, "old", old)
    kept = load_state(d, "old")
    t.ok(kept["subs"]["fleet"].get("write", False) is False and effective_subs(kept, s, now)["fleet"]["write"] is False,
         "a 2.1 subscription record survives a save and a load without gaining write")
    st2 = load_state(d, "pi2")
    subscribe(d, "pi2", st2, s, "fleet", write=True, now=now)
    subscribe(d, "pi2", st2, s, "c1", wake=True, now=now)
    save_state(d, "pi2", st2)
    listing = channels_text(d, "pi2", s, now)
    t.ok("+fleet (you, quiet, write):" in listing and "+c1 (you, wake):" in listing and "\nposts go to: +fleet\n" in listing,
         "channels marks write targets and says where posts go")
    t.ok("\nposts go to: +fleet (the default channel; no write targets)\n" in channels_text(d, "pi", s, now), "with no targets channels names the default channel")
    t.ok("posts go to" not in channels_text(d, None, s, now), "without a name channels says nothing about posts")
    shown = listing.splitlines()
    t.ok(shown[-3].startswith("known sessions") and shown[-2] == "posts go to: +fleet" and shown[-1].startswith("bound name pi2; "),
         "the posts line follows the known sessions and comes right before the binding line")
    st3 = load_state(d, "pi3")
    for ch in ("c1", "c0", "ops"):
        subscribe(d, "pi3", st3, pinned_ops, ch, write=True, now=now)
    save_state(d, "pi3", st3)
    several = channels_text(d, "pi3", pinned_ops, now)
    t.ok("+ops (you, wake, write) (pinned):" in several and "\nposts go to: +c0, +c1, +ops\n" in several,
         "channels lists every write target in name order, a pinned channel among them")
    t.ok("\nposts go to: +c1 (the default channel; no write targets)\n" in channels_text(d, "pi", dataclasses.replace(s, default_channel="c1"), now),
         "with no targets channels names the default channel the settings give")

    # A peer can plant a post stamped as late as a stamp can be; as a float it rounds past
    # the year 9999 that utc() can show, so the listing must show the stamp's own text.
    late = t.box("late")
    create_channel(late, "fleet", "fleet-wide notices")
    t.post(late, "fleet", "nix", "AN-ORDINARY-POST")
    t.mk(os.path.join(late, "+fleet", "fleet_99991231T235959.999999Z_from-nix_0000000a.txt"), "stamped as late as a stamp can be\n")
    try:
        out, code, err = t.run(["--dir", late, "channels"])
    except ValueError as e:
        out, code, err = "", None, f"ValueError: {e}"
    t.ok(code == 0 and err == "" and "; last post 99991231T235959.999999Z; " in out,
         "the CLI's channels shows a post stamped in the year 9999 by its own stamp instead of failing")
    request = {"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": "channels", "arguments": {}}}
    answer = t.serve_lines(t.server(late, "pi"), [json.dumps(request)])[0]
    t.ok("error" not in answer and "; last post 99991231T235959.999999Z; " in answer["result"]["content"][0]["text"],
         "the MCP channels tool answers it normally, not with -32603")

    # A peer's member record may be 64 KiB and its host is shown, so one record could fill the 8 KB, and the cut would take every other
    # session out of the listing with it. The known sessions show at most 64 characters of a host and 32 of a checked stamp, then [cut].
    crowded = t.box("crowded")
    create_channel(crowded, "fleet", "fleet-wide notices")
    touch_member(crowded, "nix", [], now)
    stamp, fine, euro = utc(now), utc(now, micro=True), chr(0x20AC)  # the euro sign is three UTF-8 bytes, and each byte shows as four characters
    acute = chr(0xE9)  # an accented letter, two bytes
    for peer, host, checked in (("far", "h" * 9000, stamp), ("edge", "e" * 64, stamp), ("over", "o" * 65, stamp), ("wide", euro * 40, stamp),
                                ("wider", acute * 65, stamp), ("shifted", "s" + acute * 64, stamp), ("micro", "m", fine), ("stamped", "x", "9" * 500)):
        t.mk(member_path(crowded, peer), json.dumps({"v": 2, "name": peer, "host": host, "checked": checked, "subs": []}))
    mine = load_state(crowded, "pi")
    subscribe(crowded, "pi", mine, s, "fleet", write=True, now=now)
    save_state(crowded, "pi", mine)
    text = channels_text(crowded, "pi", s, now)
    rows = text.splitlines()
    t.ok(rows[-2] == "posts go to: +fleet" and rows[-1].startswith("bound name pi; "),
         "a peer's very long host does not hide the session's own lines: where its posts go, then its binding")

    def roster_of(listing_text):
        """The entries of the known sessions line, in order; one empty entry when the listing has no such line."""
        line = next((r for r in listing_text.splitlines() if r.startswith("known sessions")), "")
        return line.partition("): ")[2].split("; ")

    # A host shows as the escaped characters that fit in 64, never part of a \xNN, then [cut]. Forty euro signs, 480 characters escaped, show 16
    # units: five signs and the first byte of a sixth. Sixty-five accented letters show 16 units too. With an ASCII letter in front the units no
    # longer end at 64, so the last one that would be split is dropped, and 61 characters show.
    euro_shown, acute_shown = "\\xe2\\x82\\xac", "\\xc3\\xa9"
    wide_shown = euro_shown * 5 + "\\xe2[cut]"
    wider_shown = acute_shown * 8 + "[cut]"
    shifted_shown = "s" + acute_shown * 7 + "\\xc3[cut]"
    t.ok(roster_of(text) == [f"edge on {'e' * 64}, checked {stamp}", f"far on {'h' * 64}[cut], checked {stamp}", f"micro on m, checked {fine}",
                             f"nix on {escape(HOST)}, checked {stamp}", f"over on {'o' * 64}[cut], checked {stamp}", f"shifted on {shifted_shown}, checked {stamp}",
                             f"wide on {wide_shown}, checked {stamp}", f"wider on {wider_shown}, checked {stamp}"],
         "a peer's 9000-character host leaves every session in the known sessions: a host of 64 characters whole, a longer one as the escaped characters "
         "that fit in 64 then [cut], never part of an escape, a stamp whole, and a record whose stamp is 500 characters, which member_at refuses, not listed")
    t.ok("[... the rest is cut" not in text, "the long host no longer forces the cut at 8 KB")
    # A record may repeat a channel in its subscriptions: 3000 times is 27 KB, within member_at's 64 KiB. The channel's line lists the record once,
    # so that one record cannot fill the 8 KB that way either.
    repeated = t.box("repeated")
    create_channel(repeated, "fleet", "fleet-wide notices")
    touch_member(repeated, "nix", [], now)
    t.mk(member_path(repeated, "dup"), json.dumps({"v": 2, "name": "dup", "host": "d", "checked": stamp, "subs": ["fleet"] * 3000}))
    many_subs = channels_text(repeated, "pi", s, now)
    t.ok(roster_of(many_subs) == [f"dup on d, checked {stamp}", f"nix on {escape(HOST)}, checked {stamp}"] and "[... the rest is cut" not in many_subs,
         "a record that repeats a channel 3000 times in its subscriptions does not hide the other sessions: every known session is listed and nothing is cut")
    t.ok(next((r for r in many_subs.splitlines() if r.startswith("+fleet")), "").endswith("subscribers listed: dup"),
         "and the channel's line lists that record once")
    # member_at takes only a stamp for checked, at most 23 characters, so a real record reaches the 32-character bound only when its stamp's
    # escaped form is longer (Unicode digits); the bound itself is checked with members standing in for a record with a longer one.
    real_members = members
    t.patch("members", lambda d: {"far": {"v": 2, "name": "far", "host": "x", "checked": "9" * 500, "subs": []},
                                  "nix": {"v": 2, "name": "nix", "host": "y", "checked": stamp, "subs": []}})
    unchecked = channels_text(crowded, "pi", s, now)
    t.patch("members", real_members)
    t.ok(roster_of(unchecked) == [f"far on x, checked {'9' * 32}[cut]", f"nix on y, checked {stamp}"],
         "a checked stamp of 500 characters that gets past member_at is shown as its first 32 characters then [cut], and the next session is listed")
    # Forty channels of 270 bytes each, so that the cut falls between channel lines, at limits from one that is under the session's
    # own lines up to nearly 9000. A listing's size depends on the host's name, so no limit here may depend on where a line ends.
    forty = t.box("forty")
    for i in range(40):
        create_channel(forty, f"t{i:02d}", "x" * 200)
    real_max, marker = CHANNELS_MAX, "[... the rest is cut at 8 KB]"
    own = "\n".join(channels_text(forty, "pi", s, now).splitlines()[-2:])
    cuts = {}
    for limit in range(100, 9000, 700):
        t.patch("CHANNELS_MAX", limit)
        cuts[limit] = channels_text(forty, "pi", s, now)
    t.patch("CHANNELS_MAX", real_max)
    floor = len(f"\n{marker}\n{own}".encode())
    t.ok(cuts[100] == f"\n{marker}\n{own}" and 100 < floor,
         "a limit smaller than the session's own lines leaves the marker and those lines, nothing else")
    t.ok(all(len(out.encode()) <= limit and out.endswith(f"\n{marker}\n{own}") and all(r.endswith("subscribers listed: none") for r in out.splitlines()[1:-3])
             for limit, out in cuts.items() if limit >= floor),
         "whatever the limit, the text fits in it when the marker and the session's own lines do, and the cut leaves whole channel lines")
    full = channels_text(forty, "pi", s, now)
    rows = full.splitlines()
    t.ok(full.endswith(f"\n{marker}\n{own}") and len(full.encode()) <= CHANNELS_MAX
         and rows[0].startswith("agent-mail (bound name pi@") and rows[1].startswith("+t00: "),
         "at 8 KB the cut takes the channels that do not fit, says so before the session's own lines, keeps the first channels above it and fits")
    t.patch("CHANNELS_MAX", 10 ** 6)
    every = channels_text(forty, "pi", s, now).splitlines()
    t.patch("CHANNELS_MAX", real_max)
    fit = len(rows) - 4  # the header, the marker and the session's own two lines are the rest
    t.ok(0 < fit < 40 and len(("\n".join(rows[:-3] + [every[1 + fit]]) + f"\n{marker}\n{own}").encode()) > CHANNELS_MAX,
         "the cut drops no more channel lines than it must: with the next one the text would not fit in 8 KB")
    bare = channels_text(forty, None, s, now).splitlines()
    t.ok(bare[-2] == marker and bare[-1].startswith("bound name none; ") and not any(r.startswith("posts go to") for r in bare),
         "without a name the binding line is still last after the cut, and there is no posts line")
    # The room is the limit less the marker and the session's own lines, in bytes. A line that ends where the room ends fits, and is kept: the
    # cut drops only a line the room ends inside. So when the room ends at the end of a channel line the cut keeps the lines up to it, with a
    # byte less of room the lines before it, and with a byte more the lines up to it again. The second box has purposes of three-byte
    # characters, which keeps the bytes of the room and the characters of the text apart.
    accents = t.box("accents")
    for i in range(6):
        create_channel(accents, f"u{i}", euro * 60)

    def misses(box, ks):
        """The (box, k, offset) cases where the cut of BOX's listing is not the lines that fit, with the room ending OFFSET bytes from the end of
        channel line K."""
        t.patch("CHANNELS_MAX", 10 ** 6)
        whole = channels_text(box, "pi", s, now).splitlines()
        t.patch("CHANNELS_MAX", real_max)
        rest = f"\n{marker}\n" + "\n".join(whole[-2:])
        found = []
        for k in ks:
            end = len("\n".join(whole[:1 + k]).encode())
            for offset, lines in ((-1, k - 1), (0, k), (1, k)):
                t.patch("CHANNELS_MAX", end + offset + len(rest.encode()))
                if channels_text(box, "pi", s, now) != "\n".join(whole[:1 + lines]) + rest:
                    found.append((os.path.basename(box), k, offset))
        t.patch("CHANNELS_MAX", real_max)
        return found

    wrong = misses(forty, (1, 20, 40)) + misses(accents, (1, 3, 6))
    t.ok(not [w for w in wrong if w[2] == 0],
         f"a channel line that ends exactly where the room ends is kept, and the next one is not; wrong at {[w for w in wrong if w[2] == 0]}")
    t.ok(not [w for w in wrong if w[2] != 0],
         f"with a byte less of room that line is dropped, and with a byte more it is kept and the next one is not; wrong at {[w for w in wrong if w[2] != 0]}")
    t.patch("CHANNELS_MAX", 20 + len(f"\n{marker}\n{own}".encode()))  # a room that ends inside the first line
    inside = channels_text(forty, "pi", s, now)
    t.patch("CHANNELS_MAX", real_max)
    t.ok(inside == f"\n{marker}\n{own}", "when the room ends inside the first line, the cut keeps none of it: the marker and the session's own lines are all that is left")
    # Many ordinary member records make the roster itself the cause of a cut. The known sessions are one line, so when it does not fit it goes
    # whole, and the session's own two lines stay last. A hundred records fit, so it is their number that does it.
    busy = t.box("busy")
    create_channel(busy, "fleet", "fleet-wide notices")
    os.makedirs(os.path.join(busy, ".agent-mail", "members"), 0o700)

    def add_sessions(first, last):
        for i in range(first, last):
            peer = f"s{i:03d}"
            t.mk(member_path(busy, peer), json.dumps({"v": 2, "name": peer, "host": "h", "checked": stamp, "subs": []}))

    add_sessions(0, 100)
    hundred = channels_text(busy, "pi", s, now)
    t.ok(len(roster_of(hundred)) == 100 and marker not in hundred, "a hundred ordinary records are all listed, with no cut")
    add_sessions(100, 300)
    rows = channels_text(busy, "pi", s, now).splitlines()
    t.ok(len(rows) == 5 and rows[1].startswith("+fleet: ") and rows[2] == marker and rows[3].startswith("posts go to: ") and rows[4].startswith("bound name pi; "),
         "three hundred push the known sessions past 8 KB and that one line goes whole: the cut says so, and the session's own two lines stay last")


def section_receive(t):
    d = t.box()
    s = load_settings({}, {}, "pi")
    t.at(time.time() + 10)

    def sink(text):
        pass

    t.direct(d, "pi", "nix", "first")
    t.direct(d, "pi", "nix", "second")
    writes = []
    out = receive(d, "pi", s, writes.append)
    lines = out.splitlines()
    m = re.fullmatch(r"agent-mail \[([0-9a-f]{8})\]: 2 item\(s\) for pi \(bound name pi@\S+\): direct pi_\S+; direct pi_\S+", lines[0])
    t.ok(m is not None and writes == [out], "the list line comes first and names every item")
    tok = m.group(1) if m else "-"
    t.ok(lines[1] == BANNER.format(token=tok), "the banner follows the list line")
    t.ok(re.fullmatch(rf"=== agent-mail \[{tok}\]: begin 1/2 direct id=pi_\S+ from=nix \(asserted\) copy=\S+/\.pi-read/pi_\S+\.txt ===", lines[2]) is not None,
         "a begin line carries position, kind, id, sender and copy")
    t.ok(f"=== agent-mail [{tok}]: end 2/2 ===" in lines, "an end line closes each item")
    t.mk(os.path.join(d, "pi_20261030T000800.000000Z_from-nix_00000008.txt"), "From: x@elsewhere\nTo: pi\n\n\x1b[2Jhi\n")
    out = receive(d, "pi", s, sink)
    t.ok("from=nix (asserted; header says x)" in out, "a From header that disagrees with the file name is called out")
    t.ok("\nhi\n" in out and "\x1b" not in out, "receive prints sanitized text")
    t.mk(os.path.join(d, f".pi-claimed-{os.getpid()}-{HOSTTAG}-pi_20261030T000900.000000Z_from-nix_00000009.txt"), "stranded\n")
    t.ok("stranded" in receive(d, "pi", s, sink), "a claim with this pid that the process does not hold is delivered at once")
    t.ok(len(load_state(d, "pi")["last_batch"]["ids"]) == 1, "commit records the last batch")
    inflight = t.direct(d, "pi", "nix", "in flight")
    held = collect(d, "pi", s, load_state(d, "pi"), MAX_BYTES, clock())
    again = receive(d, "pi", s, sink)
    put_back(held)
    t.ok(len(held.items) == 1 and "in flight" not in again and os.path.exists(inflight) and "in flight" in receive(d, "pi", s, sink),
         "a claim this process holds in flight is not taken again")
    msg = t.direct(d, "pi", "nix", "kept")
    before = load_state(d, "pi")["last_batch"]

    def broken_write(text):
        raise BrokenPipeError()

    t.ok(getattr(t.raises(receive, d, "pi", s, broken_write), "code", None) == "output_failed" and os.path.exists(msg)
         and load_state(d, "pi")["last_batch"] == before, "a failed write puts the claim back and changes no state")


def section_posts(t):
    T0 = time.time() + 3600  # every file written below is settled under this clock
    t.at(T0)

    def sink(text):
        pass

    def opts(name, *pinned):
        return load_settings({"channels": list(pinned)} if pinned else {}, {}, name)

    def subscribed(d, name, *chs):
        st = load_state(d, name)
        for ch in chs:
            subscribe(d, name, st, opts(name), ch, now=clock())
        save_state(d, name, st)

    def pid_of(path):
        return parse_msg(os.path.basename(path)).id

    s = opts("a")
    d = t.box()
    create_channel(d, "fleet", "fleet-wide notices")
    for name in ("a", "b", "pi"):
        subscribed(d, name, "fleet")
    pid = pid_of(t.post(d, "fleet", "nix", "FIRST-POST"))
    t.ok(pid in receive(d, "a", s, sink) and pid in receive(d, "b", s, sink), "two subscribers each get a post")
    t.ok(pid not in receive(d, "a", s, sink), "a post is delivered once per reader")
    t.ok(pid not in receive(d, "c", s, sink), "a non-subscriber gets nothing")
    own = pid_of(t.post(d, "fleet", "pi", "MY-OWN-POST"))
    t.ok(own not in receive(d, "pi", s, sink), "a sender does not receive its own post")
    t.post(d, "fleet", "nix", "SECOND-POST", stamp=T0 + 60)
    receive(d, "a", s, sink)
    t.post(d, "fleet", "nix", "LATE-ARRIVAL", stamp=T0 - 120)
    t.ok("LATE-ARRIVAL" in receive(d, "a", s, sink), "a late arrival stamped before posts already read is still delivered")

    m = t.box("margin")
    create_channel(m, "fleet", "p")
    subscribed(m, "a", "fleet")
    t.post(m, "fleet", "nix", "MARGIN-NINE", stamp=T0 - 540)
    t.post(m, "fleet", "nix", "MARGIN-ELEVEN", stamp=T0 - 660)
    out = receive(m, "a", s, sink)
    t.ok("MARGIN-NINE" in out and "MARGIN-ELEVEN" not in out, "since keeps a 10-minute margin")

    gone = t.post(d, "fleet", "nix", "TO-BE-DELETED")
    receive(d, "a", s, sink)
    kept = pid_of(gone) in load_state(d, "a")["seen"]["+fleet"]
    os.unlink(gone)
    receive(d, "a", s, sink)
    t.ok(kept and pid_of(gone) not in load_state(d, "a")["seen"]["+fleet"], "a seen id leaves only once its file is gone")

    lost = t.box("lost")
    create_channel(lost, "fleet", "p")
    t.post(lost, "fleet", "nix", "HOURS-23", stamp=T0 - 23 * 3600)
    t.post(lost, "fleet", "nix", "HOURS-25", stamp=T0 - 25 * 3600)
    out = receive(lost, "r", opts("r", "fleet"), sink)
    t.ok("HOURS-23" in out and "HOURS-25" not in out and out.count("cursor rebuilt; older posts are in +fleet/") == 1
         and "cursor rebuilt" not in receive(lost, "r", opts("r", "fleet"), sink), "lost state replays 24 hours once, with a notice")

    cp = t.post(d, "fleet", "nix", "ORIGINAL-TEXT")
    out = receive(d, "a", s, sink)
    found = re.search(rf"id={pid_of(cp)} from=nix \(asserted\) copy=(\S+) ===", out)
    with open(cp) as f:
        original = f.read()
    t.mk(cp, "CHANGED-TEXT\n")
    with open(found.group(1) if found else os.devnull) as f:
        t.ok(found is not None and f.read() == original, "the archive copy does not follow a changed original")

    bpath = t.direct(d, "all", "nix", "BROADCAST-ONE")
    bid = pid_of(bpath)
    t.ok(bid in receive(d, "a", s, sink) and bid in receive(d, "b", s, sink) and os.path.exists(bpath) and bid not in receive(d, "a", s, sink),
         "each reader reads a broadcast once and nobody claims it")

    fair = t.box("fair")
    create_channel(fair, "fleet", "p")
    subscribed(fair, "r", "fleet")
    for i in range(12):
        t.post(fair, "fleet", "nix", f"FAIR-{i}", stamp=T0 + i)
    first, second = receive(fair, "r", s, sink), receive(fair, "r", s, sink)
    t.ok(first.count(" begin ") == 10 and second.count(" begin ") == 2, "10 posts per sender per channel per receive")
    for i in range(4):
        t.direct(fair, "all", "nix", f"BROADCAST-{i}", stamp=T0 + i)
    b1, b2 = receive(fair, "r", s, sink), receive(fair, "r", s, sink)
    t.ok(b1.count("broadcast id=") == 3 and b2.count("broadcast id=") == 1, "3 broadcasts per sender per receive")
    misfiled = t.mk(os.path.join(fair, "+fleet", "other_20261030T000000.000000Z_from-x_0000000f.txt"), "misfiled\n")
    conflict = t.mk(os.path.join(fair, "+fleet", "fleet_20261030T000000.000000Z_from-x_0000000e.sync-conflict-20261031-000000-ABCDEFG.txt"), "x\n")
    o1, o2 = receive(fair, "r", s, sink), receive(fair, "r", s, sink)
    t.ok(o1.count("misfiled") == 1 and "misfiled" not in o2 and os.path.exists(misfiled), "a misfiled post is reported once and left alone")
    t.ok("sync-conflict" in o1 and "is a Syncthing conflict copy, never mail; left in place" in o1 and "sync-conflict" not in o2 and os.path.exists(conflict),
         "a conflict copy is reported once, as a conflict copy, and never delivered")

    k = t.box("kinds")
    create_channel(k, "a", "p")
    create_channel(k, "b", "p")
    subscribed(k, "r", "b", "a")
    t.direct(k, "all", "nix", "KIND-BROADCAST")
    t.post(k, "b", "nix", "KIND-B")
    t.post(k, "a", "nix", "KIND-A")
    t.direct(k, "r", "nix", "KIND-DIRECT")
    kinds = re.findall(r" begin \d+/\d+ (direct|post \+\w+|broadcast) id=", receive(k, "r", s, sink))
    t.ok(kinds == ["direct", "post +a", "post +b", "broadcast"], "direct mail, then posts by channel, then broadcasts")
    t.post(k, "a", "nix", "UNSEEN")
    seen_before = load_state(k, "r")["seen"]
    copies_before = sorted(os.listdir(os.path.join(k, ".r-read")))

    def broken(text):
        raise BrokenPipeError()

    code_out = getattr(t.raises(receive, k, "r", s, broken), "code", None)
    t.ok(code_out == "output_failed" and load_state(k, "r")["seen"] == seen_before and sorted(os.listdir(os.path.join(k, ".r-read"))) == copies_before,
         "a failed write changes no seen set and copies nothing")
    t.mk(member_path(d, "a"), json.dumps({"v": 2, "name": "a", "host": "h2", "checked": utc(T0 - 60), "subs": ["fleet"]}))
    t.ok("another reader of a appears active on h2" in receive(d, "a", s, sink), "warns when the member record shows another host")
    t.mk(member_path(d, "a"), json.dumps({"v": 2, "name": "a", "host": "h3", "checked": utc(T0 + 30), "subs": ["fleet"]}))
    t.ok("another reader of a appears active on h3" in receive(d, "a", s, sink), "a record stamped a little ahead by another host's clock still warns")
    t.mk(member_path(d, "a"), json.dumps({"v": 2, "name": "a", "host": "h4", "checked": utc(T0 - 601), "subs": ["fleet"]}))
    t.ok("another reader" not in receive(d, "a", s, sink), "a member record another host checked over 600 s ago does not warn")
    t.mk(member_path(d, "a"), json.dumps({"v": 2, "name": "a", "host": "h2", "checked": utc(T0 - 60), "subs": ["fleet"]}))
    out, code, _ = t.capture(cmd_watch, "a", d, 0.01, False, MAX_BYTES, 1)
    t.ok(code is None and out == "", "a quiet pass of the claiming watch prints nothing, even with a duplicate-reader warning to give")
    # A peer's member record named for the reader may carry a host of 60 KB, which both warnings show. Each shows at most 64 characters of
    # the escaped host, then [cut], so that neither grows with it.
    ghost = t.box("ghost")
    os.makedirs(os.path.join(ghost, ".agent-mail", "members"), 0o700)
    t.mk(member_path(ghost, "a"), json.dumps({"v": 2, "name": "a", "host": "h" * 60000, "checked": utc(T0 - 60), "subs": []}))
    heard = receive(ghost, "a", s, sink)
    t.ok(f"agent-mail: another reader of a appears active on {'h' * 64}[cut]\n" in heard and len(heard.encode()) < 300,
         "receive shows at most 64 characters of a peer's host in its duplicate-reader warning, then [cut], and a 60 KB host does not make it long")
    report = doctor(ghost, "a", s)[0]
    t.ok(f"finding: another reader of a appears active on {'h' * 64}[cut]" in report.splitlines() and len(report.encode()) < 1000,
         "doctor shows the same bounded host in its finding, and a 60 KB host does not make its report long")
    # A host is a peer's text, so both warnings escape it: a newline in it cannot break a warning into two lines.
    t.mk(member_path(ghost, "a"), json.dumps({"v": 2, "name": "a", "host": "a\nb", "checked": utc(T0 - 60), "subs": []}))
    warned = receive(ghost, "a", s, sink).splitlines()
    t.ok("agent-mail: another reader of a appears active on a\\x0ab" in warned and "b" not in warned,
         "receive escapes a peer's host in its duplicate-reader warning, so a newline in it does not break the warning into two lines")
    findings = doctor(ghost, "a", s)[0].splitlines()
    t.ok("finding: another reader of a appears active on a\\x0ab" in findings and "b" not in findings,
         "doctor escapes the same host in its finding, so a newline in it does not break the finding into two lines")
    # A host of 40 euro signs is 480 characters escaped. Both warnings show the 16 units that fit in 64 characters, then [cut].
    t.mk(member_path(ghost, "a"), json.dumps({"v": 2, "name": "a", "host": chr(0x20AC) * 40, "checked": utc(T0 - 60), "subs": []}))
    units = "\\xe2\\x82\\xac" * 5 + "\\xe2[cut]"
    t.ok(f"agent-mail: another reader of a appears active on {units}" in receive(ghost, "a", s, sink).splitlines(),
         "receive shows a host of 40 euro signs as the 16 escape units that fit in 64 characters, then [cut]")
    t.ok(f"finding: another reader of a appears active on {units}" in doctor(ghost, "a", s)[0].splitlines(),
         "doctor shows that host the same way")
    big_post = t.post(d, "fleet", "nix", "x" * POST_LIMIT)
    out = receive(d, "a", s, sink)
    t.ok(f"{os.path.basename(big_post)} in +fleet was not read: " in out and f"over the {POST_LIMIT}-byte limit for posts" in out and os.path.exists(big_post),
         "an oversize post is skipped with a notice and left in place")

    # Review Focus 3: bytes that are not UTF-8, or not printable, in names and bodies.
    raw = t.box("bytes")
    create_channel(raw, "fleet", "p")
    subscribed(raw, "r", "fleet")
    try:
        bad_name_path = os.path.join(os.fsencode(raw), b"+fleet", b"fleet_\xff.txt")
        t.mk(bad_name_path, "odd\n")
        expect = "\\xff"
    except OSError:  # APFS refuses names that are not UTF-8; use control characters instead
        bad_name_path = t.mk(os.path.join(raw, "+fleet", "fleet_\n‮.txt"), "odd\n")
        expect = "\\x0a\\xe2\\x80\\xae"
    t.mk(os.path.join(raw, "+fleet", f"fleet_{utc(T0, micro=True)}_from-nix_0000abcd.txt"), b"From: nix@h\nTo: +fleet\n\nok \xff\xfe end\n")
    out_bad = receive(raw, "r", s, sink)
    t.ok(expect in out_bad and os.path.exists(bad_name_path), "a name with invalid UTF-8 is escaped and left in place")
    t.ok("ok �� end" in out_bad, "invalid UTF-8 in a body is replaced")

    # Review Focus 4: a large backlog after a host was away.
    big = t.box("backlog")
    create_channel(big, "c1", "p")
    create_channel(big, "c2", "p")
    ids300 = [pid_of(t.post(big, ch, sender, f"BACKLOG-{i}", stamp=T0 - 3600 + i))
              for i in range(50) for sender in ("s1", "s2", "s3") for ch in ("c1", "c2")]
    delivered, outs = [], []
    for _ in range(40):
        out = receive(big, "r", opts("r", "c1", "c2"), sink)
        got = re.findall(r" begin \d+/\d+ post \+c[12] id=(\S+) ", out)
        if not got:
            break
        delivered += got
        outs.append(out)
    t.ok(sorted(delivered) == sorted(ids300) and all(len(o.encode()) <= 12000 + 8192 for o in outs), "a 300-post backlog from three senders arrives exactly once")

    # Review Focus 5: a subscribed channel deleted, or replaced by a symlink.
    g = t.box("gone")
    create_channel(g, "a", "p")
    create_channel(g, "b", "p")
    subscribed(g, "r", "a", "b")
    os.unlink(os.path.join(g, "+b", CHANNEL_MARKER))
    os.rmdir(os.path.join(g, "+b"))
    t.post(g, "a", "nix", "STILL-DELIVERED")
    o_gone, o_again = receive(g, "r", s, sink), receive(g, "r", s, sink)
    t.ok(o_gone.count("subscribed channel +b is missing") == 1 and "+b is missing" not in o_again and "STILL-DELIVERED" in o_gone,
         "a deleted channel is reported once and receive goes on")
    elsewhere = os.path.join(t.root, "elsewhere")
    os.mkdir(elsewhere, 0o700)
    t.mk(os.path.join(elsewhere, CHANNEL_MARKER), "a channel behind a symlink\n")
    t.mk(os.path.join(elsewhere, f"a_{utc(T0, micro=True)}_from-nix_0000beef.txt"), "SECRET\n")
    os.rename(os.path.join(g, "+a"), os.path.join(t.root, "a-real"))
    os.symlink(elsewhere, os.path.join(g, "+a"))
    t.ok("SECRET" not in receive(g, "r", s, sink), "a channel replaced by a symlink is never read")


def section_retention(t):
    T0 = time.time()
    t.at(T0)

    def sink(text):
        pass

    s = load_settings({}, {}, "a")
    d = t.box()
    create_channel(d, "fleet", "fleet-wide notices")
    create_channel(d, "other", "a channel a does not read")
    st = load_state(d, "a")
    subscribe(d, "a", st, s, "fleet", now=T0)
    save_state(d, "a", st)
    p0 = t.post(d, "fleet", "nix", "DAY-0", stamp=T0)
    p2 = t.post(d, "fleet", "nix", "DAY-2", stamp=T0 + 2 * 86400)
    t.mk(os.path.join(d, "+fleet", "notes.txt"), "notes\n")
    t.mk(os.path.join(d, "+fleet", ".hidden"), "hidden\n")
    old_in_unsubscribed = t.post(d, "other", "nix", "OLD-OTHER", stamp=T0 - 40 * 86400)
    t.at(T0 + 31 * 86400)
    receive(d, "a", s, sink)
    t.ok(not os.path.exists(p0) and os.path.exists(p2), "posts older than 30 days are pruned and younger ones kept")
    planted_old = t.post(d, "fleet", "nix", "PLANTED-OLD", stamp=T0 - 86400)
    t.at(T0 + 31 * 86400 + 600)
    receive(d, "a", s, sink)
    t.ok(os.path.exists(planted_old), "pruning runs at most once an hour")
    fut = t.post(d, "fleet", "nix", "FUTURE-POST", stamp=clock() + 2 * 86400)
    t.ok("FUTURE-POST" not in receive(d, "a", s, sink) and os.path.exists(fut), "a post stamped over 24 hours ahead is never delivered")
    t.at(os.stat(fut).st_ctime + 30 * 86400 + 3601)
    receive(d, "a", s, sink)
    t.ok(not os.path.exists(fut), "and is deleted once its ctime is 30 days old")
    t.ok(os.path.exists(os.path.join(d, "+fleet", "notes.txt")) and os.path.exists(os.path.join(d, "+fleet", ".hidden")),
