    "max_bytes": ("max_bytes", "max_bytes", "AGENT_MAIL_MAX_BYTES", MAX_BYTES),
    "allow_broadcast": ("allow_broadcast", None, None, True),
    "default_channel": ("default_channel", "default_channel", "AGENT_MAIL_DEFAULT_CHANNEL", "fleet"),
    "direct_days": ("direct_days", None, None, DIRECT_DAYS),
