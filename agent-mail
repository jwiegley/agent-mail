        t.mk(os.path.join(outside, "members", "pi.json"), "precious\n")
        if case == ".agent-mail/members":
            os.mkdir(os.path.join(unsafe, ".agent-mail"), 0o700)
        if kind == "a symlink":
            os.symlink(os.path.join(outside, "members") if case.endswith("members") else outside, os.path.join(unsafe, case))
        else:
            t.mk(os.path.join(unsafe, case), "not a directory\n")
        waiting = t.direct(unsafe, "pi", "nix", "still here")
        before = snapshot(outside)
        e = t.raises(touch_member, unsafe, "pi", [], now)
        out, code, err = t.run(["--dir", unsafe, "read", "pi"])
        report, flagged, _ = t.run(["--dir", unsafe, "doctor", "pi"])
        t.ok(getattr(e, "code", None) == "unsafe_mailbox" and code == 1 and f"{case} is {kind}" in err and not out
             and os.path.exists(waiting) and snapshot(outside) == before and flagged == 1 and f"{case} is {kind}" in report,
             f"{case} as {kind} is refused before anything is claimed, doctor names it, and nothing outside the mailbox is written")
    members_dir = os.path.join(d, ".agent-mail", "members")
    renamed, real_rename = [], os.rename

    def failing_rename(src, dst, **kw):
        renamed.append(src)
        raise OSError(errno.EIO, "injected")

    os.rename = failing_rename
    try:
        touch_member(d, "pi", ["other"], now + 302)
    finally:
        os.rename = real_rename
    t.ok(renamed == [f".pi.json.{os.getpid()}.tmp"] and not [e for e in os.listdir(members_dir) if e.endswith(".tmp")],
         "the member record's temporary name carries the pid, and a failed rename leaves no temporary file behind")
    foreign = {"v": 2, "name": "pi", "host": "elsewhere", "checked": utc(now + 400), "subs": ["ops"]}
    t.mk(member, json.dumps(foreign))
    touch_member(d, "pi", ["fleet"], now + 460)
    kept = read_member(d, "pi")["host"] == "elsewhere"
    touch_member(d, "pi", ["fleet"], now + 701)
    replaced = read_member(d, "pi")["host"] == HOST
    t.mk(member, json.dumps({**foreign, "checked": utc(now + 800)}))
    touch_member(d, "pi", ["fleet"], now + 700)
    t.ok(kept and replaced and read_member(d, "pi")["host"] == "elsewhere",
         "a pass leaves another host's fresh record for the name alone, even stamped a little ahead, and rewrites it once it is 300 s old")
    a, b = ReaderLock(d, "pi"), ReaderLock(d, "pi")
    t.ok(a.acquire() and not b.acquire() and b.holder == f"{os.getpid()}@{HOST}", "a second lock on one name fails, even inside one process")
    a.release()
    t.ok(b.acquire(), "the lock passes on once released")
    os.unlink(b.path)
    c = ReaderLock(d, "pi")
    t.ok(c.acquire() and not b.revalidate() and c.revalidate(), "a lock whose file was replaced revalidates against the new file")
    c.release()
    run = os.environ["AGENT_MAIL_RUNTIME_DIR"]
