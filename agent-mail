]})
TOOLS = json.loads(TOOLS_JSON)["tools"]
MAX_LINE = 8 << 20


NO_IDENTITY = "agent-mail has no session name: set AGENT_MAIL_NAME or start the server with --name; agent-deck sessions get one automatically"
CHANNELS_MAX = 8000
PEER_HOST_MAX, PEER_STAMP_MAX = 64, 32  # characters shown of a peer's host (known sessions, duplicate-reader warnings) and of its checked stamp (known sessions)


class BadArguments(Exception):
    """A tools/call with an unknown tool or arguments its schema refuses: JSON-RPC -32602."""


def check_args(name, args):
    """Refuse arguments that the tool's static schema does not allow."""
    tool = next((t for t in TOOLS if t["name"] == name), None)
    if tool is None:
        raise BadArguments(f"unknown tool {clean_line(str(name))[:60]!r}")
    if not isinstance(args, dict):
        raise BadArguments("arguments must be an object")
    schema = tool["inputSchema"]
    for key in args:
        if key not in schema["properties"]:
            raise BadArguments(f"{name} takes no argument {clean_line(str(key))[:40]!r}")
    for key in schema["required"]:
        if key not in args:
            raise BadArguments(f"{name} needs {key}")
    for key, value in args.items():
        spec = schema["properties"][key]
        if spec["type"] == "string":
            good = isinstance(value, str)
        elif spec["type"] == "boolean":
            good = isinstance(value, bool)
        else:
            good = isinstance(value, int) and not isinstance(value, bool) and spec.get("minimum", value) <= value <= spec.get("maximum", value)
        if not good:
            limits = f" from {spec['minimum']} to {spec['maximum']}" if "minimum" in spec else ""
            raise BadArguments(f"{name}: {key} must be a {spec['type']}{limits}")


def fs_type(d):
    """The file system type of D's mount, from /proc/self/mountinfo on Linux; None elsewhere."""
    try:
        with open("/proc/self/mountinfo", encoding="utf-8", errors="replace") as f:
            lines = f.readlines()
    except OSError:
        return None
    real, best, kind = os.path.realpath(d), "", None
    for line in lines:
        left, sep, right = line.partition(" - ")
        fields = left.split()
        if not sep or len(fields) < 5 or not right.split():
            continue
        mount = re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), fields[4])
        if (real == mount or real.startswith(mount.rstrip("/") + "/")) and len(mount) >= len(best):
            best, kind = mount, right.split()[0]
    return kind


def clip(text, limit):
    """TEXT escaped as a notice shows it, or, when that is longer than LIMIT characters, the escaped
    characters that fit in LIMIT, never part of an escape, then [cut]."""
    shown = escape(text)
    if len(shown) <= limit:
        return shown
    kept = shown[:limit]
    # SAFE has no backslash, so each one in the escaped text begins a four-character \xNN: one in the last three characters is cut short.
    start = kept.rfind("\\", max(limit - 3, 0))
    return (kept if start == -1 else kept[:start]) + "[cut]"


def channels_text(d, name, settings, now):
    """The channels tool's text, which the CLI's channels also prints: each channel with its
    purpose, recent posts and listed subscribers, NAME's marks (wake or quiet, write, pinned),
    the known sessions (from peer-written member records, so approximate), where NAME's posts
    go, then the binding, the host, the watch backend and whether the mailbox is on NFS. At
    most 8 KB: a peer can make the channels and the known sessions long, so when the text would
    pass that, they are cut at a line and a marker says so, and NAME's own lines, where its
    posts go and its binding, follow the marker whole. No one member record can fill that: the
    known sessions show at most 64 characters of a peer's host and 32 of its checked stamp, each
    then [cut], and a channel's line lists a record once however often the record repeats it."""
    state = load_state(d, name) if name else None
    subs = effective_subs(state, settings, now) if name else {}
    chans = list_channels(d, now)
    lines = [(f"agent-mail (bound name {name}@{HOST}): " if name else "agent-mail: ") + f"{len(chans)} channel(s)"]
    for c in chans:
        mark = ""
        if c["name"] in subs:
            sub = subs[c["name"]]
            mark = f" (you, {'wake' if sub['wake'] else 'quiet'}{', write' if sub['write'] else ''})" + (" (pinned)" if sub["pinned"] else "")
        lines.append(f"+{c['name']}{mark}: {c['purpose']}; {c['posts_7d']} post(s) in 7 days; last post {c['last_post'] or 'none'}; "
                     f"subscribers listed: {', '.join(c['subscribers']) or 'none'}")
    known = members(d)
    # A peer wrote each record. member_at bounds its size and takes checked only as a stamp, but puts no limit on host, so the line
    # bounds both, and list_channels lists a record once for a channel: one record cannot push every other session into the cut below.
    lines.append("known sessions (approximate; member records are written by peers): "
                 + ("; ".join(f"{n} on {clip(r['host'], PEER_HOST_MAX)}, checked {clip(clean_line(r['checked']), PEER_STAMP_MAX)}"
                              for n, r in sorted(known.items())) or "none"))
    own = []
    if name:
        has_targets = any(sub["write"] for sub in subs.values())
        own.append("posts go to: " + ", ".join(f"+{ch}" for ch in write_targets(state, settings, now))
                   + ("" if has_targets else " (the default channel; no write targets)"))
    kind = fs_type(d)
    nfs = "not checked" if kind is None else f"{'yes' if kind.startswith('nfs') else 'no'} ({escape(kind)})"
    own.append(f"bound name {name or 'none'}; host {HOST}; watch backend {probe_backend('auto')}; mailbox on NFS: {nfs}")
    text, tail = "\n".join(lines), "\n".join(own)
    if len(text.encode()) + 1 + len(tail.encode()) > CHANNELS_MAX:
        cut = "\n[... the rest is cut at 8 KB]"
        room = max(CHANNELS_MAX - len(cut.encode()) - 1 - len(tail.encode()), 0)
        data = text.encode()
        kept = data[:room]
        if data[room:room + 1] not in (b"", b"\n"):  # the room ends inside a line, which does not fit; a line that ends at the room does
            kept = kept.rpartition(b"\n")[0]
        text = kept.decode("utf-8", "ignore") + cut
    return text + "\n" + tail


def archived_item(d, name, ident, max_bytes):
    """An item rebuilt from NAME's own archive copy of message IDENT, for reread."""
    m = parse_msg(f"{ident}.txt")
    if m is None:
        raise MailError("invalid_id", f"{echo(ident, escaped=True)} is not a message id")
    fd = open_owned_dir(archive_dir(d, name))
    if fd is None:
        raise MailError("not_in_archive", f"{name} has no archive yet; copies are kept 7 days")
    try:
        found = []
        for entry in os.listdir(fd):
            if entry == f"{ident}.txt" or entry.startswith(f"{ident}.txt."):
                with contextlib.suppress(OSError):
                    found.append((os.stat(entry, dir_fd=fd, follow_symlinks=False).st_ctime, entry))
        if not found:
            raise MailError("not_in_archive", f"{ident} is not in {name}'s archive; copies are kept 7 days")
        entry = max(found)[1]
        try:
            text, st = read_file(entry, dir_fd=fd)
        except (Rejected, Changed, OSError) as e:
            raise MailError("not_in_archive", f"the copy of {ident} cannot be read ({e})") from None
    finally:
        os.close(fd)
    path = os.path.join(archive_dir(d, name), entry)
    shown = text
    if len(text.rstrip().encode("utf-8")) > max_bytes:
        shown = f"{text.encode('utf-8')[:EXCERPT].decode('utf-8', errors='ignore')}\n[... {st.st_size} bytes in all; the whole message is at {path}]"
    kind = "broadcast" if m.to == "all" else "direct" if m.to == name else "post"
    return Item(kind, m.id, entry, path, None, m.to if kind == "post" else None, m.sender, shown, st.st_size, header_from(text), path)


def rpc_result(mid, result):
    return {"jsonrpc": "2.0", "id": mid, "result": result}


def rpc_error(mid, code, message):
    return {"jsonrpc": "2.0", "id": mid, "error": {"code": code, "message": message}}


class McpServer:
    """One session's MCP server: JSON-RPC over stdio for one bound name, single-threaded,
    with static instructions and tools, text results only, and no resources, prompts or
    notifications. lock is None for a background job, which never reads mail, and when
    making the lock failed at start; lock_error is then that failure."""

    def __init__(self, settings, identity, lock, problem=None, lock_error=None):
        self.settings, self.identity, self.lock, self.problem = settings, identity, lock, problem
        self.lock_error = lock_error
        self.first = True
        self.last_receive = None

    def handle(self, msg):
        """(response, action after a successful write, action after a failed write) for one
        parsed message; the response is None for a notification."""
        if not isinstance(msg, dict):
            return rpc_error(None, -32600, "a request is one JSON object; batches are not accepted"), None, None
        mid, method = msg.get("id"), msg.get("method")
        if self.first and isinstance(method, str):
            self.first = False
            params = msg.get("params") if isinstance(msg.get("params"), dict) else {}
            log(f"mcp {self.identity.name or '(no name)'}: first request {clean_line(method)[:60]} "
                f"protocolVersion {clean_line(str(params.get('protocolVersion')))[:40]}")
        if not isinstance(method, str) or msg.get("jsonrpc") != "2.0":
            return (rpc_error(mid, -32600, "not a JSON-RPC 2.0 request"), None, None) if "id" in msg else (None, None, None)
        if "id" not in msg:
            if method == "notifications/cancelled" and isinstance(msg.get("params"), dict):
                self.cancelled(msg["params"].get("requestId"))
            return None, None, None
        params = msg.get("params") or {}
        if not isinstance(params, dict):
            return rpc_error(mid, -32602, "params must be an object"), None, None
        if method == "initialize":
            asked = params.get("protocolVersion")
            return rpc_result(mid, {"protocolVersion": asked if asked in VERSIONS else VERSIONS[0],
                                    "capabilities": {"tools": {"listChanged": False}},
                                    "serverInfo": {"name": "agent-mail", "version": VERSION}, "instructions": INSTRUCTIONS}), None, None
        if method == "ping":
            return rpc_result(mid, {}), None, None
        if method == "tools/list":
            return rpc_result(mid, {"tools": TOOLS}), None, None
        if method == "tools/call":
            name, args = params.get("name"), params.get("arguments") or {}
            try:
                check_args(name, args)
                text, done, failed = getattr(self, f"tool_{name}")(args, mid)
            except BadArguments as e:
                return rpc_error(mid, -32602, str(e)), None, None
            except MailError as e:
                return rpc_result(mid, {"content": [{"type": "text", "text": f"agent-mail: {e.code}: {e.message}"}], "isError": True}), None, None
            return rpc_result(mid, {"content": [{"type": "text", "text": text}], "isError": False}), done, failed
        return rpc_error(mid, -32601, f"method not found: {clean_line(method)[:80]}"), None, None

    def close(self):
        if self.lock is not None:
            self.lock.release()

    # ---- the seven tools ----

    def head(self):
        return f"agent-mail (bound name {self.identity.name}@{HOST}): "

    def ready(self, need_name=True):
        """The mailbox for this call, or the MailError that stops it: no name, a settings
        error, or a mailbox that is missing now (the server keeps running)."""
        if need_name and not self.identity.name:
            raise MailError("no_identity", NO_IDENTITY + (f" ({self.identity.problem})" if self.identity.problem else ""))
        if self.problem is not None:
            raise self.problem
        return require_mailbox(self.settings.dir)

    def reader(self):
        """Hold the reader lock for this call: revalidated when held, taken when free. A lock
        that could not be made at start (an unsafe runtime directory) is made again here,
        and while it still cannot be, its error is the reason given."""
        if self.lock is None and self.lock_error is not None:
            try:
                self.lock, self.lock_error = ReaderLock(self.settings.dir, self.identity.name), None
            except MailError as e:
                self.lock_error = e
                raise MailError("not_reader", f"this server cannot take the reader lock for {self.identity.name}: {e.message}") from None
        if self.lock is None:
            raise MailError("not_reader", "this server runs inside a Claude background job, which never reads mail")
        if not (self.lock.revalidate() if self.lock.held else self.lock.acquire()):
            raise MailError("not_reader", f"another reader of {self.identity.name} holds its lock ({clean_line(self.lock.holder or 'unknown')}); "
                                          "this server can send but not receive")

    def cancelled(self, rid):
        """A cancel naming the last answered receive marks that batch possibly unseen."""
        if rid is None or rid != self.last_receive or self.lock is None or not self.lock.held or self.settings is None:
            return
        try:
            d = require_mailbox(self.settings.dir)
            state = load_state(d, self.identity.name)
            if state.get("last_batch", {}).get("ids"):
                state["last_batch"]["possibly_unseen"] = True
                save_state(d, self.identity.name, state)
        except (MailError, OSError) as e:
            log(f"mcp {self.identity.name}: cannot mark a cancelled receive: {getattr(e, 'message', e)}")

    def tool_send(self, args, mid):
        """With to, one message to it. Without to, or with an empty one, a post to each of the
        session's write targets, else to the default channel; the answer has a line for each."""
        d = self.ready()
        name = self.identity.name
        instance = os.environ.get("AGENTDECK_INSTANCE_ID")
        ident = instance if instance and IDENT.fullmatch(instance) else None
        if args.get("to"):
            posted = [(args["to"], send(d, name, args["to"], args["subject"], args["body"], self.settings, in_reply_to=args.get("in_reply_to"), ident=ident,
                                        via="mcp"))]
        else:
            posted = [(f"+{ch}", r) for ch, r in send_default(d, name, args["subject"], args["body"], self.settings, load_state(d, name),
                                                              in_reply_to=args.get("in_reply_to"), ident=ident, via="mcp")]
        lines = []
        for target, r in posted:
            if isinstance(r, MailError):
                lines.append(f"agent-mail: warning: not sent to {target}: {r.code}: {r.message}")
            else:
                lines += [f"sent {r.id} to {target}"] + [f"agent-mail: warning: {w}" for w in r.warnings]
        # The head says "agent-mail", so a first line that is a refusal drops its own prefix, as pending's line does.
        return self.head() + "\n".join(lines).removeprefix("agent-mail: "), None, None

    def tool_receive(self, args, mid):
        d = self.ready()
        name = self.identity.name
        check_me(args["me"], name)
        self.reader()
        now = clock()
        state = load_state(d, name)
        prune_due(d, name, self.settings, state, now)
        last = state.get("last_batch") or {}
        batch = collect(d, name, self.settings, state, args.get("max_bytes", self.settings.max_bytes), now)
        text = delivery_text(batch, name, "call receive again", binding=True)
        if last.get("possibly_unseen"):
            text += f"\nagent-mail: your receive at {utc(last['at'])} may not have reached you; call reread with last=true and your me"

        def done():
            commit(d, name, batch, state, now)
            if batch.items:
                self.last_receive = mid

        return text, done, lambda: put_back(batch)

    def tool_pending(self, args, mid):
        d = self.ready()
        return self.head() + pending_line(d, self.identity.name, self.settings, "human").removeprefix("agent-mail: "), None, None

    def tool_subscribe(self, args, mid):
        d = self.ready()
        self.reader()
        name, ch, now = self.identity.name, bare(args["channel"]), clock()
        state = load_state(d, name)
        sub = subscribe(d, name, state, self.settings, ch, wake=args.get("wake"), backlog=args.get("backlog", 0), write=args.get("write"), now=now)
        save_subscriptions(d, name, state, self.settings, now)
        return self.head() + subscription_text(d, name, ch, sub), None, None

    def tool_unsubscribe(self, args, mid):
        d = self.ready()
        self.reader()
        name, ch, now = self.identity.name, bare(args["channel"]), clock()
        state = load_state(d, name)
        was = unsubscribe(state, self.settings, ch)
        save_subscriptions(d, name, state, self.settings, now)
        listed = sorted(n for n, record in members(d).items() if ch in record["subs"])
        return (self.head() + f"+{ch}: {name} {'unsubscribed' if was else 'was not subscribed'}; subscribers listed: {', '.join(listed) or 'none'}"), None, None

    def tool_channels(self, args, mid):
        return channels_text(self.ready(need_name=False), self.identity.name, self.settings, clock()), None, None

    def tool_reread(self, args, mid):
        """Mail already delivered is still mail: the me check and the reader lock apply as
        they do to receive, so a wrong name, a background job or a second server sees nothing."""
        d = self.ready()
        name = self.identity.name
        check_me(args["me"], name)
        self.reader()
        if args.get("last"):
            ids = (load_state(d, name).get("last_batch") or {}).get("ids") or []
            if not ids:
                raise MailError("not_in_archive", f"nothing has been delivered to {name} yet")
        elif "id" in args:
            ids = [args["id"]]
        else:
            raise BadArguments("reread needs id, or last=true")
        items = [archived_item(d, name, i, self.settings.max_bytes) for i in ids]
        return render(Batch(items, [], [], 0, 0, 0, []), name, f"{name}@{HOST}"), None, None


def serve(reader, writer, server):
    """Answer newline-delimited JSON-RPC from READER (bytes) on WRITER (bytes): one JSON
    line per response, flushed at once, until EOF, then 0. A line over 8 MiB gets -32600,
    one that is not JSON gets -32700, and the loop goes on. A response's after-write
    action runs only once its line is written and flushed; if the write fails, the other
    action runs and the server stops."""
    while True:
        line = reader.readline(MAX_LINE + 1)
        if not line:
            return 0
        done = failed = None
        if len(line) > MAX_LINE and not line.endswith(b"\n"):
            while line and not line.endswith(b"\n"):
                line = reader.readline(MAX_LINE + 1)
            response = rpc_error(None, -32600, "a request line is limited to 8 MiB")
        elif not line.strip():
            continue
        else:
            try:
                msg = json.loads(line)
            except (ValueError, RecursionError):
                response = rpc_error(None, -32700, "parse error: each line holds one JSON value")
            else:
                try:
                    response, done, failed = server.handle(msg)
                except Exception as e:  # one bad request never ends the loop
                    log(f"mcp: internal error: {type(e).__name__}: {e}")
                    response = rpc_error(msg.get("id") if isinstance(msg, dict) else None, -32603, "internal error; see the agent-mail log")
        if response is None:
            continue
        try:
            writer.write(json.dumps(response).encode() + b"\n")
            writer.flush()
        except (OSError, ValueError):
            if failed:
                try:
                    failed()
                except Exception as e:
                    log(f"mcp: putting a batch back failed: {type(e).__name__}: {e}")
            return 0
        if done:
            try:
                done()
            except Exception as e:  # the answer is out; a failed commit is redelivered later
                log(f"mcp: committing a batch failed: {type(e).__name__}: {e}")


def run_mcp(a):
    """agent-mail mcp [--name NAME] [--dir DIR] [--max-bytes N]: one session's stdio server.

    The name and settings are resolved once, and an error is kept for the tools instead of
    ending the server, because Claude does not restart a failed server. Descriptor 1 is
    duplicated for the protocol, then pointed at stderr with sys.stdout, so a stray print
    never reaches the protocol stream.
    """
    home = os.path.expanduser("~")
    identity = resolve_identity(a.name, os.environ, home)
    flags = {k: v for k, v in (("dir", a.mcp_dir or a.dir), ("max_bytes", a.max_bytes)) if v is not None}
    settings = problem = None
    try:
        settings = load_settings(flags, os.environ, identity.name)
    except MailError as e:
        problem = e
    protocol = os.fdopen(os.dup(1), "wb")
    os.dup2(2, 1)
    sys.stdout = sys.stderr

    def stop(signum, frame):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    lock = lock_error = None
    if identity.name and settings is not None and not background_job(os.environ, os.getppid(), home):
        try:
            lock = ReaderLock(settings.dir, identity.name)
            lock.acquire()
        except MailError as e:
            log(f"mcp {identity.name}: {e.message}")
            lock, lock_error = None, e
    server = McpServer(settings, identity, lock, problem, lock_error)
    try:
        return serve(sys.stdin.buffer, protocol, server)
    finally:
        server.close()


# ---- doctor ----

# nix's .stignore lines for ~/Mailbox (decision 10); (?d).DS_Store is written on the Macs only.
STIGNORE = (".*-claimed-*", ".*-read", ".*-rejected-*", ".*.tmp", "(?d).nfs*", "(?d).DS_Store")


def doctor(d, name, settings):
    """A read-only report on the mailbox D, one line per fact, and the number of findings
    (problems worth acting on). It writes nothing: no state, no member record, no log.
    Its roster of the direct mail waiting for each name comes from names and lstat alone,
    opening no file, and counts as the prune does; so does its line on the send log
    (traffic_doctor)."""
    now = clock()
    lines, findings = [], []

    def finding(text):
        findings.append(text)
        lines.append(f"finding: {text}")

    if not os.path.isdir(d):
        finding(f"mailbox {d} does not exist")
        return "\n".join([f"agent-mail doctor: {len(findings)} finding(s)"] + lines), len(findings)
    is_default = os.path.realpath(d) == os.path.realpath(os.path.expanduser(DEFAULT_DIR))
    if is_default:
        lines.append(f"mailbox {d}: ~/Mailbox, which needs no marker")
    elif os.path.isfile(os.path.join(d, MARKER_V2)):
        lines.append(f"mailbox {d}: marked with {MARKER_V2}")
    else:
        finding(f"mailbox {d} has no {MARKER_V2}, so agent-mail refuses it; run agent-mail init there")
    for problem in mailbox_problems(d, name):
        finding(problem)
    kind = fs_type(d)
    nfs = kind is not None and kind.startswith("nfs")
    lines.append(f"file system: {escape(kind)}" if kind is not None else "file system: not checked (no /proc/self/mountinfo here)")
    backend = probe_backend("auto")
    if nfs:
        lines.append(f"watch: notify=auto would use {backend}, but the mailbox is on NFS, where those events miss other hosts' writes; "
                     f"polling every {settings.poll:g} s covers them")
    else:
        lines.append(f"watch: notify=auto would use {backend}" + (" (native events, with polling underneath)" if backend in ("kqueue", "inotify") else ""))
    if is_default:
        want = [line for line in STIGNORE if line != "(?d).DS_Store" or sys.platform == "darwin"]
        try:
            have = {line.strip() for line in read_small(os.path.join(d, ".stignore")).decode("utf-8", "replace").splitlines()}
        except OSError:
            finding("~/Mailbox has no readable .stignore, so Syncthing would carry claims, archives and temporary files")
        else:
            for line in want:
                if line not in have:
                    finding(f"missing from .stignore: {line}")
    entries = sorted(os.listdir(d))
    for e in entries:
        if ".sync-conflict-" in e:
            finding(f"Syncthing conflict copy, never mail: {escape(e)}")
        elif not e.startswith((".", "+")) and parse_msg(e) is None:
            what = " (a directory)" if stat.S_ISDIR(os.lstat(os.path.join(d, e)).st_mode) else ""
            finding(f"legacy or nonstandard name at the top level, never mail: {escape(e)}{what}")
    # The roster of waiting direct mail, from names and lstat alone: no file is opened. It
    # counts as the prune judges (prunable, expired), so the two agree, and sets apart the
    # entries with mail names that the prune never removes. The oldest stamp is shown as
    # its name gives it: a float can round past the year 9999 that utc() can show.
    waiting, never = collections.defaultdict(list), collections.Counter()
    for e in entries:
        m = parse_msg(e)
        if m is None or m.to == "all":
            continue
        try:
            st = os.lstat(os.path.join(d, e))
        except OSError:
            continue
        if prunable(st):
            waiting[m.to].append((m, st))
        else:
            never[m.to] += 1
    for to in sorted(waiting.keys() | never.keys()):
        found = waiting.get(to, [])
        text = f"direct mail for {to}: {len(found)} waiting"
        if found:
            past = sum(1 for m, st in found if expired(m, st, now, settings.direct_days * 86400))
            text += f", oldest {min(m.utc for m, _ in found)}, {past} past the {settings.direct_days}-day window"
        if never[to]:
            text += f", and {never[to]} the prune never removes (not regular files of yours)"
        lines.append(text)
    for e in entries:
        if not e.startswith("+"):
            continue
        try:
            fd = open_channel(d, e[1:])
        except MailError:
            finding(f"{escape(e)} is not a channel: not a channel name, a symlink, someone else's, or without its marker")
            continue
        try:
            for entry in sorted(os.listdir(fd)):
                path = f"{escape(e)}/{escape(entry)}"
                if entry.startswith("."):
                    continue
                if ".sync-conflict-" in entry:
                    finding(f"Syncthing conflict copy, never mail: {path}")
                    continue
                m = parse_msg(entry)
                if m is None:
                    finding(f"not named as a post: {path}")
                elif m.to != e[1:]:
                    finding(f"misfiled: {path} is not named for {escape(e)}")
                else:
                    with contextlib.suppress(OSError):
                        why = post_problem(m, os.stat(entry, dir_fd=fd, follow_symlinks=False), "post", now)
                        if why:
                            finding(f"invalid post {path}: {why}")
        finally:
            os.close(fd)
    traffic_doctor(d, now, lines, finding, findings)
    if name:
        record = read_member(d, name)
        if record is not None and record["host"] != HOST and abs(now - parse_utc(record["checked"])) < DUPLICATE_READER:
            finding(f"another reader of {name} appears active on {clip(record['host'], PEER_HOST_MAX)}")
    if settings.paused or os.path.exists(os.path.expanduser(PAUSE_PATH)):
        finding(f"paused: {PAUSE_PATH} exists, so this host sends nothing and rings no doorbell")
    else:
        lines.append("paused: no")
    config = os.environ.get("AGENT_MAIL_CONFIG") or os.path.expanduser(CONFIG_PATH)
    lines.append(f"config: {config} ({'read' if os.path.isfile(config) else 'absent, so the defaults apply'})")
    return "\n".join([f"agent-mail doctor: {len(findings)} finding(s)"] + lines), len(findings)


def traffic_doctor(d, now, lines, finding, findings):
    """doctor's part on the send log, from names and lstat alone, opening no record: one line of
    information, send log: off, off with the records left for the prune, or on with its records and
    the newest stamp; and a finding (through FINDING, unless FINDINGS already holds the same text) for
    a log directory that is a symlink or not a directory on the way, a marker that is not a regular
    file of ours, an entry that is not a hidden name and is not named as a record, is not a regular
    file of ours, is hard-linked or is over RECORD_MAX bytes, a Syncthing conflict copy, and a hidden
    temporary file more than STALE_TMP seconds old, which keeps Syncthing from deleting the directory
    on this host. None of it is in mailbox_problems, so a broken log never stops a receive."""
    try:
        fd = open_meta(d, TRAFFIC_DIR)
    except MailError as e:
        text = unsafe_log(d, e)
        if text not in findings:
            finding(text)
        return
    except OSError as e:
        if e.filename != os.path.basename(TRAFFIC_DIR):  # .agent-mail itself cannot be opened, which 2.3's doctor reports nothing for either
            lines.append(f"send log: not checked (.agent-mail cannot be opened: {e.strerror or type(e).__name__})")
            return
        finding(f"{TRAFFIC_DIR}, the send log, cannot be read: {e.strerror or type(e).__name__}")
        return
    if fd is None:
        lines.append("send log: off")
        return
    records, newest = 0, None
    try:
        try:
            marker = os.stat(TRAFFIC_MARKER, dir_fd=fd, follow_symlinks=False)
        except FileNotFoundError:
            marker = None
        on = marker is not None and stat.S_ISREG(marker.st_mode) and marker.st_uid == os.getuid()
        if marker is not None and not on:
            finding(f"{TRAFFIC_DIR}/{TRAFFIC_MARKER}, the send log's marker, is not a regular file of yours, so the log is off")
        for entry in sorted(os.listdir(fd)):
            path = f"{TRAFFIC_DIR}/{escape(entry)}"
            try:
                st = os.stat(entry, dir_fd=fd, follow_symlinks=False)
            except FileNotFoundError:
                continue
            if ".sync-conflict-" in entry:
                finding(f"Syncthing conflict copy, never a record: {path}")
            elif entry.startswith("."):
                if entry.endswith(".tmp") and now - st.st_ctime > STALE_TMP:
                    finding(f"temporary file more than an hour old: {path}; a send died while writing it, and while it is there Syncthing "
                            f"cannot delete {TRAFFIC_DIR} on this host")
            elif record_name(entry) is None:
                finding(f"not named as a record: {path}")
            elif not prunable(st):
                finding(f"not a regular file of yours, never a record: {path}")
            elif st.st_nlink != 1:
                finding(f"hard-linked, never a record: {path}")
            elif st.st_size > RECORD_MAX:
                finding(f"over {RECORD_MAX} bytes, never a record: {path}")
            else:
                records += 1
                m = record_name(entry)
                if m.stamp - now <= FUTURE:
                    newest = max(newest or "", m.utc)
    except OSError as e:
        finding(f"{TRAFFIC_DIR}, the send log, cannot be read: {e.strerror or type(e).__name__}")
        return
    finally:
        os.close(fd)
    if on:
        lines.append(f"send log: on, {records} records" + (f", newest {newest}" if newest else ""))
    else:
        lines.append(f"send log: off, {records} records left for the prune" if records else "send log: off")


def stdout_write(text):
    if sys.stdout is None:  # descriptor 1 was closed when Python started
        raise OSError(errno.EBADF, "standard output is closed")
    sys.stdout.write(text)
    sys.stdout.flush()


def emit(write, text):
    """Write front-end text after any claims are settled; a failure is output_failed."""
    try:
        (write or stdout_write)(text)
    except OSError:
        raise MailError("output_failed", "the output failed") from None


def hold_reader(d, name):
    """Take NAME's reader lock for this command, or refuse with not_reader (status 4)."""
    lock = ReaderLock(d, name)
    if not lock.acquire():
        raise MailError("not_reader", f"another reader of {name} holds its lock ({clean_line(lock.holder or 'unknown')}); if that is your MCP server, "
                                      f"use its receive and subscribe tools, and run agent-mail watch {name} --doorbell to be woken")
    return lock


def cmd_read(name, d, max_bytes, write=None, settings=None):
    if settings is None:
        settings = load_settings({}, os.environ, name)
    lock = hold_reader(d, name)
    try:
        out = receive(d, name, settings, write or stdout_write, max_bytes)
    finally:
        lock.release()
    return EXIT_STATUS["stuck"] if out.batch.stuck else 0


def cmd_watch(name, d, interval, forever, max_bytes, max_polls=None, parent=None, write=None, settings=None):
    write = write or stdout_write
    if settings is None:
        settings = load_settings({}, os.environ, name)
    polls = 0
    lock = hold_reader(d, name)
    waiter = Waiter(lambda: watch_dirs(d, name, settings), interval, settings.notify)
    try:
        while True:
            if parent is not None and not alive(parent):
                emit(write, f"agent-mail: process {parent}, which started the watcher for {name}, has gone; the watcher has stopped without reading\n")
                return 1
            if not os.path.isdir(d):
                emit(write, f"agent-mail: mailbox {d} is missing; the watcher for {name} has stopped\n")
                return 1
            out = receive(d, name, settings, write, max_bytes, idle=False)
            if out and not forever:
                emit(write, f"agent-mail: the watcher for {name} has exited after this delivery; start it again\n")
                return 0
            polls += 1
            if max_polls is not None and polls >= max_polls:
                return None
            waiter.wait(out.batch.settle)
    finally:
        waiter.close()
        lock.release()


def subscription_text(d, name, ch, sub):
    listed = sorted(n for n, record in members(d).items() if ch in record["subs"])
    how = ("wake" if sub["wake"] else "quiet") + (", write" if sub["write"] else "") + (", pinned" if sub["pinned"] else "")
    return f"+{ch}: {name} subscribes, {how}; subscribers listed: {', '.join(listed) or 'none'}"


def cmd_subscribe(name, d, ch, wake, backlog, settings, write=None, write_target=None):
    """write is the output function, as in every cmd_*; write_target sets or clears the
    channel's write flag, and None leaves it as it is."""
    lock = hold_reader(d, name)
    try:
        now = clock()
        state = load_state(d, name)
        sub = subscribe(d, name, state, settings, ch, wake=wake, backlog=backlog, write=write_target, now=now)
        save_subscriptions(d, name, state, settings, now)
        emit(write, subscription_text(d, name, ch, sub) + "\n")
    finally:
        lock.release()
    return 0


def cmd_unsubscribe(name, d, ch, settings, write=None):
    lock = hold_reader(d, name)
    try:
        now = clock()
        state = load_state(d, name)
        was = unsubscribe(state, settings, ch)
        save_subscriptions(d, name, state, settings, now)
        emit(write, f"+{ch}: {name} unsubscribed\n" if was else f"+{ch}: {name} was not subscribed\n")
    finally:
        lock.release()
    return 0


def cmd_channel_create(d, ch, purpose, write=None):
    create_channel(d, ch, purpose)
    emit(write, f"+{ch}\n")
    return 0


def cmd_channels(d, name, settings, write=None):
    emit(write, channels_text(d, name, settings, clock()) + "\n")
    return 0


def cmd_pending(name, d, write=None, fmt="loop", settings=None):
    """The CLI's pending: one line in the chosen form, json included. The default is loop, so
    the pi-loop lines already running keep their announce-and-remind behaviour."""
    if settings is None:
        settings = load_settings({}, os.environ, name)
    now = clock()
    touch_member(d, name, effective_subs(load_state(d, name), settings, now), now)
    line = pending_line(d, name, settings, fmt)
    if line:
        emit(write, line + "\n")
    return 0


def run_doorbell(a):
    """watch [NAME] --doorbell. Without NAME the name resolves as the MCP server resolves it.
    Every refusal goes to the log, so stdout carries ring lines only and stderr stays empty."""
    try:
        if a.name:
            name = check_name(a.name)
        else:
            ident = resolve_identity(None, os.environ, os.path.expanduser("~"))
            if ident.name is None:
                log(f"doorbell: no session name: {ident.problem}")
                return 1
            name = ident.name
        s = cli_settings(a, name)
        return doorbell(require_mailbox(s.dir), name, s, a.parent if a.parent is not None else os.getppid(), a.forever)
    except MailError as e:
        log(f"doorbell: {e.message}")
        return 1


def run_pending(a):
    """pending [NAME]. Without NAME the name resolves as the MCP server resolves it, as for
    watch --doorbell; an explicit empty NAME is refused, as it was before NAME became optional.
    With --format json, each refusal on the way (the name, the settings, the mailbox, the scan)
    is one JSON object on stdout, naming the name once it was resolved or passed its check, and
    stderr stays empty; anything unforeseen is the refusal internal_error, which names only the
    exception's type (its text can hold a file name) while the log gets the details. The other
    formats, and a failed output, leave refusals to main."""
    name = None
    try:
        if a.name is not None:
            name = check_name(a.name)
        else:
            ident = resolve_identity(None, os.environ, os.path.expanduser("~"))
            if ident.name is None:
                raise MailError("no_identity", ident.problem)
            name = ident.name
        s = cli_settings(a, name)
        return cmd_pending(name, require_mailbox(s.dir), fmt=a.format, settings=s)
    except MailError as e:
        if a.format != "json" or e.code == "output_failed":
            raise
        emit(None, json.dumps({"v": 1, "agent_mail": VERSION, "name": name, "error": e.code, "problem": e.message}) + "\n")
        return EXIT_STATUS.get(e.code, 1)
    except Exception as e:
        if a.format != "json":
            raise
        log(f"pending for {name or 'an unresolved name'}: internal error: {type(e).__name__}: {e}")
        emit(None, json.dumps({"v": 1, "agent_mail": VERSION, "name": name, "error": "internal_error",
                               "problem": f"{type(e).__name__}; see the agent-mail log"}) + "\n")
        return 1


def clean_line(text):
    return " ".join("".join(" " if unicodedata.category(ch)[0] == "C" else ch for ch in text).split())


def cmd_send(sender, to, subject, ident, src, d, write=None, settings=None, in_reply_to=None):
    """The CLI's send: the body comes from FILE, or standard input when FILE is "-" or
    omitted; prints the new file's path, and each warning on stderr. With no TO, or an empty
    one, it posts to the write targets saved in the sender's state on this host, read without
    the reader lock (a read, not a claim), else to the default channel: one path for each post
    written, and on stderr one warning for each target that refused it."""
    if not os.path.isdir(d):
        raise MailError("mailbox_missing", f"mailbox {d} does not exist")
    if not subject or not clean_line(subject):
        raise MailError("no_subject", "a message needs a --subject")
    try:
        if src in (None, "-"):
            body = sys.stdin.read()
        else:
            with open(src, encoding="utf-8") as f:
                body = f.read()
    except (OSError, UnicodeDecodeError) as e:
        raise MailError("unreadable_body", f"cannot read the message body: {e}") from None
    if settings is None:
        settings = load_settings({}, os.environ, sender)
    if not to:
        posted = [(f"+{ch}", r) for ch, r in send_default(d, sender, subject, body, settings, load_state(d, sender), in_reply_to=in_reply_to, ident=ident)]
    else:
        posted = [(to, send(d, sender, to, subject, body, settings, in_reply_to=in_reply_to, ident=ident))]
    for target, r in posted:
        if isinstance(r, MailError):
            print(f"agent-mail: warning: not sent to {target}: {r.code}: {r.message}", file=sys.stderr)
            continue
        emit(write, f"{r.path}\n")
        for warning in r.warnings:
            print(f"agent-mail: warning: {warning}", file=sys.stderr)
    return 0


def pid_arg(text):
    """A --parent must name one process: 0 would mean the process group and a negative value every process we may signal."""
    pid = int(text)
    if pid < 1:
        raise argparse.ArgumentTypeError("a process id of 1 or more")
    return pid


