class MailError(Exception):
    """A refusal or failure. The core raises it and never prints or exits; a front end
    maps .code (snake_case) to an exit status or a tool error and shows .message."""

    def __init__(self, code, message=None):
        super().__init__(message or code)
        self.code = code
        self.message = message or code.replace("_", " ")


_CLOCK = None  # injected by the self-test only


def clock():
    """The current time for every time-based decision."""
    return time.time() if _CLOCK is None else _CLOCK


def require_mailbox(d):
    """Refuse a directory that is not a mailbox, so a wrong --dir cannot claim project files."""
    if not os.path.isdir(d):
        raise MailError("mailbox_missing", f"mailbox {d} does not exist")
    default = os.path.realpath(os.path.expanduser(DEFAULT_DIR))
    if os.path.realpath(d) == default or os.path.isfile(os.path.join(d, MARKER_V2)):
        return d
    if os.path.isfile(os.path.join(d, MARKER)):
        raise MailError("not_mailbox", f"{d} is not an agent-mail 2 mailbox: it has only the v1 marker; run agent-mail init there")
    raise MailError("not_mailbox", f"{d} is not an agent-mail mailbox (it has no {MARKER_V2}); check --dir and $AGENT_MAIL_DIR, or run init there")


def cmd_init(d, write=None):
    default = os.path.realpath(os.path.expanduser(DEFAULT_DIR))
    real = os.path.realpath(d)
    # realpath neither folds case nor sees through a macOS firmlink or a bind
    # mount, so compare the parents as files and the names without case; that
    # holds whether ~/Mailbox exists yet or not.
    parents = os.path.dirname(real), os.path.dirname(default)
    same_parent = all(map(os.path.isdir, parents)) and os.path.samefile(*parents)
    if real == default or (same_parent and os.path.basename(real).casefold() == os.path.basename(default).casefold()):
        raise MailError("init_refused", f"{DEFAULT_DIR} is the Syncthing folder, which Syncthing creates; init is for other directories")
    try:
        os.makedirs(d, mode=0o700, exist_ok=True)
    except FileExistsError:
        raise MailError("not_a_directory", f"{d} exists but is not a directory")
    marker = os.path.join(d, MARKER_V2)
    if not os.path.exists(marker):
        os.close(os.open(marker, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600))
    emit(write, f"{d}\n")
    return 0


NAME_KINDS = {"session": "mailbox name", "sender": "sender name", "channel": "channel name"}


def grammatical(name):
    return NAME_RE.fullmatch(name) is not None and len(name) <= 64 and not name.endswith("-")


def check_name(name, kind="session"):
    """Return NAME when it follows the grammar and is not reserved; kind shapes the message."""
    what = NAME_KINDS[kind]
    if not grammatical(name):
        hint = " (for sessions on several hosts, share one mailbox directory)" if "@" in name else ""
        if name != name.lower() and grammatical(name.lower()):
            hint = f" (names are lower case: use {name.lower()!r})"
        raise MailError("invalid_name", f"invalid {what} {echo(name)}{hint}")
    if name in RESERVED or name.startswith(RESERVED_PREFIX):
        raise MailError("reserved_name", f"the {what} {name!r} is reserved")
    return name


Msg = collections.namedtuple("Msg", "to utc sender uniq id stamp")


def parse_msg(entry):
    """The message an entry's name denotes, or None when the name is not standard.

    stamp is the name's UTC time in epoch seconds.
    """
    m = MSG_RE.fullmatch(entry)
    if not m or not (grammatical(m.group("to")) and grammatical(m.group("from"))):
        return None
    u = m.group("utc")  # YYYYMMDDTHHMMSS.ffffffZ, built directly: strptime is slow on every scan
    try:
        when = datetime.datetime(int(u[0:4]), int(u[4:6]), int(u[6:8]), int(u[9:11]), int(u[11:13]), int(u[13:15]), int(u[16:22]),
                                 tzinfo=datetime.timezone.utc)
    except ValueError:
        return None
    return Msg(m.group("to"), m.group("utc"), m.group("from"), m.group("uniq"), entry[:-len(".txt")], when.timestamp())


def escape(text):
    """TEXT for a notice: each byte of its UTF-8 form outside SAFE becomes \\xNN."""
    try:
        data = text.encode("utf-8", "surrogateescape")
    except UnicodeEncodeError:
        data = text.encode("utf-8", "surrogatepass")
    return "".join(chr(b) if chr(b) in SAFE else f"\\x{b:02x}" for b in data)


ECHO_MAX = 64  # characters of a caller's value that a refusal shows


def echo(value, escaped=False):
    """A caller's VALUE, quoted, for a refusal: at most its first ECHO_MAX characters, escaped
    as notices are when ESCAPED, then its length when it was longer, so that no refusal
    grows with its input."""
    text = str(value)
    shown = repr(escape(text[:ECHO_MAX]) if escaped else text[:ECHO_MAX])
    return shown if len(text) <= ECHO_MAX else f"{shown}... ({len(text)} characters)"


ANSI_RE = re.compile(r"\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07\x1b\n]*(?:\x07|\x1b\\)?|[@-Z\\-_])")
# C0 and C1 controls other than tab and newline, and the bidi controls that can reorder text.
CONTROL_RE = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f\u200e\u200f\u202a-\u202e\u2066-\u2069]")
TAG_LINE_RE = re.compile(r"^([ \t]*)<(?=/?(?:system-reminder|channel|command-output)(?:[\s>/]|$))", re.IGNORECASE | re.MULTILINE)


def sanitize(text):
    """Printed text: ANSI sequences removed, control and bidi characters replaced by U+FFFD,
    and the "<" of a line that opens or closes a harness tag replaced by U+2039."""
    text = CONTROL_RE.sub("\ufffd", ANSI_RE.sub("", text))
    return TAG_LINE_RE.sub("\\1\u2039", text)


