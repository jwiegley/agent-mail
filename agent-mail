    out, code, err = t.capture(cmd_send, "pi", None, "s", "34f513aa-1793309640", from_cli, d, settings=s, in_reply_to=asked)
    t.ok(code == 0 and [os.path.dirname(p) for p in out.splitlines()] == [os.path.join(d, "+b")]
         and "agent-mail: warning: not sent to +a: no_such_channel: there is no channel +a" in err and "not sent to +b" not in err
