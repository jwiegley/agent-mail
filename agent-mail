        t.at(T0)
        found = [line for line in text.splitlines() if line.startswith("finding: ") and said in line]
        t.ok(len(found) == 1 and n >= 1, f"doctor finds {what} in the send log (got {text.splitlines()[1:]})")
    plain_n = doctor(t.box("traffic-doctor-empty"), None, s)[1]
    shut = t.box("traffic-doctor-shut")
    here = log_on(shut)
    os.chmod(here, 0o000)
    try:
        text, n = doctor(shut, None, s)
    finally:
        os.chmod(here, 0o700)
    t.ok(f"finding: {TRAFFIC_DIR}, the send log, cannot be read: {os.strerror(errno.EACCES)}" in text.splitlines() and n == plain_n + 1,
         "doctor finds a log directory that cannot be opened")
    closed = t.box("traffic-doctor-closed")
    log_on(closed)
    touch_member(closed, "nix", [], clock())
    os.chmod(os.path.join(closed, ".agent-mail"), 0o000)
    try:
        r = send(closed, "pi", "nix", "into a closed metadata tree", "body", s)
        text, n = doctor(closed, None, s)
    finally:
        os.chmod(os.path.join(closed, ".agent-mail"), 0o700)
    t.ok(os.path.exists(r.path) and record_files(closed) == []
         and r.warnings == [f"this send was not recorded in the send log (.agent-mail cannot be opened, so whether the log is on cannot be told: "
                            f"{os.strerror(errno.EACCES)}); the message itself was sent"]
         and n == plain_n and f"send log: not checked (.agent-mail cannot be opened: {os.strerror(errno.EACCES)})" in text.splitlines(),
         "with .agent-mail unreadable, whether the log is on cannot be told: a send warns that it was not recorded (design 5.2, step 3), "
         "and doctor adds no finding, only a line that it could not check, as 2.3 reports nothing there")
    away = t.box("traffic-doctor-away")
    os.mkdir(os.path.join(t.root, "agent-mail-elsewhere"), 0o700)
    os.symlink(os.path.join(t.root, "agent-mail-elsewhere"), os.path.join(away, ".agent-mail"))
    said = f"{os.path.join(away, '.agent-mail')} is a symlink"
    t.ok(sum(said in line for line in doctor(away, None, s)[0].splitlines() if line.startswith("finding: ")) == 1,
         "a symlinked .agent-mail, which mailbox_problems already reports, is one finding, not a second for the send log")
    ahead = t.box("traffic-doctor-ahead")
    log_on(ahead)
    near = planted(ahead, "nix", "pi", T0 - 10)
    planted(ahead, "nix", "pi", T0 + 300 * 86400)
    t.ok(f"send log: on, 2 records, newest {near.split('_')[1]}" in doctor(ahead, None, s)[0].splitlines(),
         "doctor's newest stamp leaves out a record stamped more than 24 hours ahead")
    young = t.box("traffic-doctor-young-tmp")
    here = log_on(young)
    t.mk(os.path.join(here, f".nix_{utc(T0, micro=True)}_from-pi_00000014.json.tmp"), "")
    t.ok(doctor(young, None, s)[1] == doctor(t.box("traffic-doctor-plain"), None, s)[1], "a temporary file less than an hour old is no finding")
    t.ok(".agent-mail/traffic" not in " ".join(mailbox_problems(linked)), "a broken log directory is not among mailbox_problems, so it never stops a receive")
    t.at(None)


def traffic_sync_checks(t):
    """The send log across hosts, in section sync, with FakeSync's replicas 7 seconds apart."""
    root = os.path.join(t.root, "traffic-sync")
    os.mkdir(root, 0o700)
    fs = FakeSync(root, 3)
    fs.now = time.time()
    s = load_settings({}, {}, "a")

    def sync():
        fs.step()
        fs.step()

    with fs.on(0) as r0:
        log_on(r0)
    sync()
    sent = []
    for i in (2, 0, 1):
        with fs.on(i) as r:
            sent.append(send(r, f"s{i}", "b", f"from replica {i}", f"body {i}", s))
    with fs.on(0) as r0:
        t.mk(os.path.join(r0, TRAFFIC_DIR, f".b_{utc(clock(), micro=True)}_from-s0_00000015.json.tmp"), "half a record\n")
    sync()
    same = all(record_files(fs.replica(i)) == sorted(f"{r.id}.json" for r in sent) for i in range(3))
    whole = all(record_bytes(fs.replica(i), r.id) == record_bytes(fs.replica(0), r.id) for i in (1, 2) for r in sent)
    t.ok(same and whole and not any(e.endswith(".tmp") for e in os.listdir(os.path.join(fs.replica(2), TRAFFIC_DIR))),
         "a record written on one replica reaches the others whole, and a temporary record file stays on its host")
    orders = []
    for i in range(3):
        with fs.on(i) as r:
            orders.append([row["id"] for row in traffic_report(r, clock() - 3600, clock())["rows"]])
    t.ok(orders[0] == orders[1] == orders[2] == [sent[1].id, sent[2].id, sent[0].id] and [row["host"] for row in traffic_report(fs.replica(0), 0, fs.now + 60)["rows"]] == ["h0", "h1", "h2"],
         "records written on replicas 7 seconds apart read back in (utc, id) order on each, each with its own host")
    with fs.on(1) as r1:
        os.unlink(os.path.join(r1, TRAFFIC_DIR, f"{sent[0].id}.json"))
    sync()
    t.ok(not any(os.path.exists(os.path.join(fs.replica(i), TRAFFIC_DIR, f"{sent[0].id}.json")) for i in range(3)), "a record pruned on one replica leaves every replica")

    fs.offline(2, True)
    with fs.on(0) as r0:
        os.unlink(os.path.join(r0, TRAFFIC_DIR, TRAFFIC_MARKER))
    with fs.on(2) as r2:
        late = send(r2, "s2", "b", "sent while cut off", "late body", s)
    sync()
    t.ok(f"{late.id}.json" in record_files(fs.replica(2)) and not any(os.path.exists(os.path.join(fs.replica(i), TRAFFIC_DIR, TRAFFIC_MARKER)) for i in (0, 1)),
         "a replica cut off from the marker's removal still records")
    fs.offline(2, False)
    sync()
    with fs.on(2) as r2:
        after = send(r2, "s2", "b", "sent once back", "later body", s)
    sync()
    arrived = all(f"{late.id}.json" in record_files(fs.replica(i)) for i in range(3))
    off_everywhere = all(not os.path.exists(os.path.join(fs.replica(i), TRAFFIC_DIR, TRAFFIC_MARKER)) for i in range(3))
    t.ok(arrived and off_everywhere and not any(f"{after.id}.json" in record_files(fs.replica(i)) for i in range(3))
         and all(not traffic_report(fs.replica(i), 0, fs.now)["on"] for i in range(3)),
         "back online, that replica records no more, its late record reaches the others without the marker, and the log stays off on every replica")
    old = time.time() - 2 * TRAFFIC_OFF_KEEP
    os.utime(os.path.join(fs.replica(0), TRAFFIC_DIR, f"{late.id}.json"), (old, old))  # Syncthing keeps the writer's mtime
    ctime = os.lstat(os.path.join(fs.replica(0), TRAFFIC_DIR, f"{late.id}.json")).st_ctime
    kept = prune_traffic(fs.replica(0), ctime + 600) == 0
    pruned = prune_traffic(fs.replica(0), ctime + TRAFFIC_OFF_KEEP + 60)
    sync()
    t.ok(kept and pruned >= 1 and not any(record_files(fs.replica(i)) for i in range(3)), "and the prune deletes the late record after its hour, on every replica")

    with fs.on(0) as r0:
        t.mk(os.path.join(r0, TRAFFIC_DIR, TRAFFIC_MARKER), "")
    fs.step()
    fs.queue[2] = [change for change in fs.queue[2] if os.path.basename(change[1]) != TRAFFIC_MARKER]  # the marker is late to replica 2
    fs.step()
    with fs.on(1) as r1:
        early = send(r1, "s1", "b", "ahead of the marker", "early body", s)
    sync()
    landed = os.path.join(fs.replica(2), TRAFFIC_DIR, f"{early.id}.json")
    before_marker = os.path.exists(landed) and not os.path.exists(os.path.join(fs.replica(2), TRAFFIC_DIR, TRAFFIC_MARKER))
    old = time.time() - 2 * TRAFFIC_OFF_KEEP
    os.utime(landed, (old, old))  # Syncthing keeps the writer's mtime, which a host catching up receives hours late
    with fs.on(2) as r2:
        survived = before_marker and prune_traffic(r2, os.lstat(landed).st_ctime + 600) == 0 and os.path.exists(landed)
    t.ok(before_marker and survived, "a record that reaches a replica before the marker survives that replica's prune")

    with fs.on(1) as r1:
        leftover = t.mk(os.path.join(r1, TRAFFIC_DIR, f".b_{utc(clock(), micro=True)}_from-s1_00000016.json.tmp"), "left by a send that died\n")
    with fs.on(0) as r0:
        os.unlink(os.path.join(r0, TRAFFIC_DIR, TRAFFIC_MARKER))
    sync()
    with fs.on(1) as r1:
        quiet = send(r1, "s1", "b", "after the marker went", "quiet body", s)
        t.at(os.lstat(leftover).st_ctime + 2 * STALE_TMP)
        text = doctor(r1, None, s)[0]
    t.ok(f"{quiet.id}.json" not in record_files(fs.replica(1)) and os.path.exists(leftover) and "temporary file more than an hour old" in text
         and "send log: off" in text,
         "with a left-over temporary record file on one replica, removing the marker turns the log off there too, and that replica's doctor reports the file")
    t.at(None)


