    finally:
        os.getuid = real_getuid
    t.ok(i.name is None and "not a regular file of ours" in (i.problem or ""), "a host-local identity file owned by another uid binds nothing")
    elsewhere = os.path.join(home, "elsewhere")
    stray_dir = os.path.join(elsewhere, "agent-deck", "runtime", "identity", "040aebf5-1792694875")
    os.makedirs(stray_dir, 0o700)
    stray = t.mk(os.path.join(stray_dir, "identity.md"), "- title: stray\n")
    i = resolve_identity(None, {"AGENTDECK_HOST_LOCAL_DATA_HOME": elsewhere, "AGENTDECK_IDENTITY_FILE": stray}, home)
    t.ok(i.name is None and "AGENTDECK_HOST_LOCAL_DATA_HOME" in (i.problem or "") and "ignored" in (i.problem or ""),
         "AGENTDECK_HOST_LOCAL_DATA_HOME pointing outside this host's data home grants no trust, and the problem says it was ignored")
    t.ok(resolve_identity(None, {"AGENTDECK_HOST_LOCAL_DATA_HOME": os.path.join(home, HOST_LOCAL_DATA_DIR, HOST), "AGENTDECK_IDENTITY_FILE": local}, home).name == "muse-spark",
         "AGENTDECK_HOST_LOCAL_DATA_HOME naming this host's data home changes nothing")
    t.ok(resolve_identity(None, {"AGENTDECK_INSTANCE_ID": "040aebf5-1792694875"}, home).name == "muse-spark",
         "a Pi session resolves its instance id through the host-local root too")
    i = resolve_identity(None, {"AGENTDECK_INSTANCE_ID": "1406c9d0-1793164687"}, home)
    t.ok(i.name is None and os.path.realpath(local_root) in (i.problem or "") and os.path.realpath(os.path.join(home, IDENTITY_DIR)) in (i.problem or ""),
         "an instance id known only to another host's data home names nothing, and the problem names both roots")
    i = resolve_identity(None, {"AGENTDECK_INSTANCE_ID": "040aebf5-1792694875", "AGENTDECK_HOST_LOCAL_DATA_HOME": elsewhere}, home)
    t.ok(i.name == "muse-spark", "a Pi session's lookup ignores a foreign AGENTDECK_HOST_LOCAL_DATA_HOME and uses the pinned root")
    other_home = os.path.join(home, HOST_LOCAL_DATA_DIR, "other-host")
    i = resolve_identity(None, {"AGENTDECK_HOST_LOCAL_DATA_HOME": other_home, "AGENTDECK_IDENTITY_FILE": foreign}, home)
    t.ok(i.name is None and "ignored" in (i.problem or "") and "\\x2f" not in (i.problem or "") and echo(other_home) in (i.problem or ""),
         "AGENTDECK_HOST_LOCAL_DATA_HOME naming another host's data home grants no trust, and the note shows the path readably and bounded")
    i = resolve_identity(None, {"AGENTDECK_HOST_LOCAL_DATA_HOME": other_home, "AGENTDECK_INSTANCE_ID": "1406c9d0-1793164687"}, home)
    t.ok(i.name is None and (i.problem or "").count("ignored") == 1, "nor for a Pi session's lookup, whose problem carries the note once")
    alias = os.path.join(home, "alias-hosts")
    os.symlink(os.path.join(home, HOST_LOCAL_DATA_DIR), alias)
    i = resolve_identity(None, {"AGENTDECK_HOST_LOCAL_DATA_HOME": os.path.join(alias, HOST), "AGENTDECK_IDENTITY_FILE": foreign}, home)
    t.ok(i.name is None and "ignored" not in (i.problem or ""), "a symlinked spelling of this host's data home is this host's data home, so no note")
    os.symlink(os.path.dirname(foreign), os.path.join(local_root, "602320d4-1793292303"))
    i = resolve_identity(None, {"AGENTDECK_INSTANCE_ID": "602320d4-1793292303"}, home)
    t.ok(i.name is None and "is not under" in (i.problem or ""),
         "an instance directory in the host-local root that links to another host's directory binds nothing, by real path")
    big_dir = os.path.join(home, IDENTITY_DIR, "0123abcd-2")
    os.makedirs(big_dir, 0o700)
    t.mk(os.path.join(big_dir, "identity.md"), "- title: big\n" + "x" * SMALL_FILE)
    i = resolve_identity(None, {"AGENTDECK_INSTANCE_ID": "0123abcd-2"}, home)
    t.ok(i.name is None and "size limit" in (i.problem or "") and os.path.realpath(os.path.join(home, IDENTITY_DIR)) in (i.problem or ""),
         "a Pi lookup reports the real reason for a file that exists, and names the root it is under")
    long_home = os.path.join(home, HOST_LOCAL_DATA_DIR, "o" * 80)
    i = resolve_identity(None, {"AGENTDECK_HOST_LOCAL_DATA_HOME": long_home, "AGENTDECK_IDENTITY_FILE": foreign}, home)
    t.ok(i.name is None and "characters)" in (i.problem or "") and "o" * 65 not in (i.problem or ""), "the note is cut at ECHO_MAX characters, whatever HOME's length")
    shut_dir = os.path.join(home, IDENTITY_DIR, "0123abcd-3")
    os.makedirs(shut_dir, 0o700)
    t.mk(os.path.join(shut_dir, "identity.md"), "- title: shut\n")
    os.chmod(shut_dir, 0)
    try:
        i = resolve_identity(None, {"AGENTDECK_INSTANCE_ID": "0123abcd-3"}, home)
    finally:
        os.chmod(shut_dir, 0o700)
    t.ok(os.getuid() == 0 or (i.name is None and "Permission denied" in (i.problem or "") and "neither" not in (i.problem or "")),
         "an instance directory that cannot be searched is reported as unreadable, not as missing")


def section_doorbell(t):
    T0 = time.time() + 3600
    t.at(T0)
    d = t.box()
    s = load_settings({}, {}, "pi")
    ppid, ppid2 = os.getpid(), os.getppid()

    def fake_waiter(box=None, backend=None):
        return Waiter(lambda: [box or d], 15, "auto", backend=backend or FakeBackend([]))

    t.direct(d, "pi", "nix", "RING-ONE")
    w1 = fake_waiter()
    out, code, err = t.capture(doorbell, d, "pi", s, ppid, False, waiter=w1)
    t.ok(re.fullmatch(RING_RE, out) is not None and code == 10 and err == "", "the doorbell prints exactly the ring line, exits 10 and keeps stderr empty")
    rung_at = clock()
    t.ok(t.capture(doorbell, d, "pi", s, ppid, False, waiter=w1, max_passes=2)[0] == "", "it rings once per id per slot")

    class Superseding(FakeBackend):
        def wait(self, timeout):
            start_bell(bell_path(d, "pi", ppid))  # a newer doorbell takes the slot meanwhile
            return super().wait(timeout)

    old = t.capture(doorbell, d, "pi", s, ppid, False, waiter=fake_waiter(backend=Superseding([])), max_passes=5)
    old_result = (old[1], old[0])
    t.ok(old_result == (0, ""), "a newer doorbell for the same slot silences the old one at its next wake")
    other_parent_out = t.capture(doorbell, d, "pi", s, ppid2, False, waiter=fake_waiter())[0]
    t.ok(re.fullmatch(RING_RE, other_parent_out) is not None, "a doorbell with another parent pid keeps its own slot")

    create_channel(d, "fleet", "fleet-wide notices")
    create_channel(d, "ops", "ops notices")
    st = load_state(d, "r")
    subscribe(d, "r", st, s, "fleet", now=clock())
    subscribe(d, "r", st, s, "ops", wake=True, now=clock())
    save_state(d, "r", st)
    t.post(d, "fleet", "nix", "QUIET-POST")
    quiet_out = t.capture(doorbell, d, "r", s, ppid, False, waiter=fake_waiter(), max_passes=1)[0]
    t.post(d, "ops", "nix", "WAKE-POST")
    wake_out = t.capture(doorbell, d, "r", s, ppid, False, waiter=fake_waiter(), max_passes=1)[0]
    t.ok(quiet_out == "" and re.fullmatch(RING_RE, wake_out) is not None and "(0 direct, 1 channel)" in wake_out, "a quiet post never rings and a wake post does")
    t.direct(d, "all", "nix", "A-BROADCAST")
    broadcast_out = t.capture(doorbell, d, "bc", s, ppid, False, waiter=fake_waiter(), max_passes=1)[0]
    t.direct(d, "pz", "nix", "PAUSED-DIRECT")
    paused_out = t.capture(doorbell, d, "pz", dataclasses.replace(s, paused=True), ppid, False, waiter=fake_waiter(), max_passes=1)[0]
    t.ok(broadcast_out == "" and paused_out == "", "a broadcast never rings, and a paused host never rings")

    def logged():
        try:
            with open(os.path.join(os.path.expanduser(STATE_DIR), "log"), encoding="utf-8") as f:
                return f.read()
        except FileNotFoundError:
            return ""

    superseding, before = Superseding([]), logged()
    superseded = t.capture(doorbell, d, "pi", s, ppid, False, waiter=fake_waiter(backend=superseding), max_passes=50)
    t.ok(superseded == ("", 0, "") and superseding.waits == 1 and "a newer doorbell took the slot" in logged()[len(before):],
         "a superseded doorbell exits 0 at its next wake, not when its passes run out")
    child = subprocess.Popen([sys.executable, "-I", "-c", "pass"])
    child.wait()
    t.direct(d, "orphan", "nix", "WAITS-FOR-A-DOORBELL-WHOSE-PARENT-HAS-GONE")
    before = logged()
    orphaned = t.capture(doorbell, d, "orphan", s, child.pid, False, waiter=fake_waiter(), max_passes=5)
    t.ok(not alive(child.pid) and orphaned == ("", 0, "") and f"process {child.pid} has gone" in logged()[len(before):],
         "a doorbell exits 0 without ringing when its parent has gone, though mail waits")
    t.ok(not os.path.lexists(bell_path(d, "orphan", child.pid)), "a doorbell whose parent has gone removes its slot")
    run = runtime_dir()
    gone = [bell_path(d, "x", child.pid), bell_path(t.box("other-box"), "y-2", child.pid), os.path.join(run, f"{'0' * 12}-z-{10 ** 30}.bell")]
    live = [bell_path(d, "x", ppid2), os.path.join(run, "notes.txt"), os.path.join(run, f"{dirkey(d)}-x.reader")]
    for path in gone + live:
        t.mk(path, "{}")
    swept = t.capture(doorbell, d, "sweeper", s, ppid, False, waiter=fake_waiter(), max_passes=1)
    t.ok(swept == ("", 0, "") and not any(os.path.lexists(p) for p in gone) and all(os.path.exists(p) for p in live),
         "a starting doorbell removes every slot whose parent has gone, a pid too large to exist included, and nothing else")
    huge = 10 ** 20
    out, code, err = t.run(["--dir", d, "watch", "pi", "--doorbell", "--parent", str(huge)])
    t.ok((code, out, err) == (0, "", "") and not os.path.lexists(bell_path(d, "pi", huge)),
         "a doorbell whose --parent is too large to be a pid stops as when its parent has gone, without a traceback")
    for bad in ("0", "-1"):
        out, code, err = t.run(["--dir", d, "watch", "pi", "--doorbell", "--parent", bad])
        t.ok(code == 2 and "1 or more" in err and out == "" and not os.path.lexists(bell_path(d, "pi", int(bad))),
             f"refuses --parent {bad}, which would name a process group rather than one process")

    class Scripted(FakeBackend):
        """Runs the next of its actions at each wait."""

        def __init__(self, actions):
            super().__init__([])
            self.actions = list(actions)

        def wait(self, timeout):
            if self.actions:
                self.actions.pop(0)()
            return super().wait(timeout)

    pause = os.path.expanduser(PAUSE_PATH)
    os.makedirs(os.path.dirname(pause), 0o700, exist_ok=True)

    def pause_then_mail():
        t.mk(pause, "")
        t.direct(d, "pausing", "nix", "ARRIVES-WHILE-THE-HOST-IS-PAUSED")

    scripted = Scripted([pause_then_mail, lambda: os.unlink(pause)])
    try:
        out_p, code_p, _ = t.capture(doorbell, d, "pausing", s, ppid, False, waiter=fake_waiter(backend=scripted), max_passes=5)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(pause)
    t.ok(re.fullmatch(RING_RE, out_p) is not None and code_p == 10 and scripted.waits == 2,
         "the pause file is checked on every pass: mail that came while it existed rings once it is gone")
    fifo_box = t.box("fifo")
    os.mkfifo(os.path.join(fifo_box, f"pf_{utc(T0 - 60, micro=True)}_from-nix_0000f1f0.txt"))
    fifo_out = t.capture(doorbell, fifo_box, "pf", s, ppid, False, waiter=fake_waiter(fifo_box), max_passes=1)
    t.ok(fifo_out == ("", 0, "") and pending_line(fifo_box, "pf", s, "context") == ""
         and pending_line(fifo_box, "pf", s, "human") == "agent-mail: no mail for pf",
         "only regular files ring: a FIFO with a mail name never rings, and pending does not count it")
    t.at(rung_at + 1799)
    early = t.capture(doorbell, d, "pi", s, ppid, False, waiter=fake_waiter(), max_passes=1)[0]
    t.ok(early == "", "the one reminder comes 30 minutes after a ring: none at 29 minutes 59 seconds")
    t.at(rung_at + 1801)
    reminder = t.capture(doorbell, d, "pi", s, ppid, False, waiter=fake_waiter(), max_passes=1)[0]
    second_reminder = t.capture(doorbell, d, "pi", s, ppid, False, waiter=fake_waiter(), max_passes=1)[0]
    t.ok(re.fullmatch(RING_RE, reminder) is not None and second_reminder == "", "one reminder after 30 minutes, once")
    t.at(T0)

    gone = t.box("gone")

    class Vanishing(FakeBackend):
        def wait(self, timeout):
            os.unlink(os.path.join(gone, MARKER_V2))
            os.rmdir(gone)
            return super().wait(timeout)

    o, c, e = t.capture(doorbell, gone, "pi", s, ppid, False, waiter=fake_waiter(gone, Vanishing([])), max_passes=5)
    vanished = (c, o, e)
    t.ok(vanished == (1, "", ""), "a doorbell whose mailbox disappears exits 1 with no output")

    p = t.box("pending")
    create_channel(p, "fleet", "fleet-wide notices")
    st = load_state(p, "pi")
    subscribe(p, "pi", st, s, "fleet", now=clock())
    st["last_batch"] = {"at": T0 - 600, "ids": ["x", "y", "z"], "possibly_unseen": False}
    save_state(p, "pi", st)
    stamp = utc(T0 - 600)
    t.direct(p, "pi", "nix", "PENDING-DIRECT")
    t.post(p, "fleet", "nix", "PENDING-POST-1")
    t.post(p, "fleet", "nix", "PENDING-POST-2")
    t.direct(p, "all", "nix", "PENDING-BROADCAST")
    t.ok(pending_line(p, "pi", s, "human") == f"agent-mail: for pi: 1 direct, 2 channel, 1 broadcast waiting; last delivery {stamp} (3 items)",
         "pending summarizes in one line")
    t.ok("_from-" not in pending_line(p, "pi", s, "loop") and pending_line(p, "pi", s, "loop").startswith("agent-mail: mail for pi announced "),
         "pending --format loop names no file")
    t.ok(pending_line(p, "nix", s, "context") == "" and re.fullmatch(RING_RE, pending_line(p, "pi", s, "context") + "\n") is not None,
         "pending --format context prints the ring line only when mail waits")
    t.ok(t.run(["frobnicate"])[1] == 2 and not re.search("peer mail is waiting", t.run(["frobnicate"])[0]), "an unknown subcommand never rings")
    out, code, err = t.run(["--dir", os.path.join(t.root, "missing"), "watch", "pi", "--doorbell"])
    t.ok((code, out, err) == (1, "", ""), "the CLI doorbell keeps a refusal off stdout and stderr")

    def files():
        """Every path under the section's root: a file's mtime and size, or None for a directory."""
        found = {}
        for folder, dirs, names in os.walk(t.root):
            for n in dirs + names:
                path = os.path.join(folder, n)
                st = os.lstat(path)
                found[path] = None if stat.S_ISDIR(st.st_mode) else (st.st_mtime_ns, st.st_size)
        return found

    writes = t.box("writes")
    t.direct(writes, "w", "nix", "RINGS-AND-WRITES-NOTHING-ELSE")
    before = files()
    rang = t.capture(doorbell, writes, "w", s, ppid, False, waiter=fake_waiter(writes), max_passes=3)[1]
    after = files()
    changed = {p for p in before.keys() | after.keys() if before.get(p, "missing") != after.get(p, "missing")}
    allowed = {bell_path(writes, "w", ppid), os.path.join(os.path.expanduser(STATE_DIR), "log")}
    t.ok(rang == 10 and bell_path(writes, "w", ppid) in changed and changed <= allowed,
         f"the doorbell writes nothing but its slot and the log; it also changed: {', '.join(sorted(changed - allowed))}")


def section_pending(t):
    """pending --format json, contract v1 (README section 9), and pending without NAME."""
    T0 = time.time() + 3600
    t.at(T0)
    d = t.box()
    s = load_settings({}, {}, "pi")
    for ch in ("fleet", "ops", "gone", "ci"):
        create_channel(d, ch, f"{ch} notices")
    st = load_state(d, "pi")
    subscribe(d, "pi", st, s, "fleet", now=clock())
    subscribe(d, "pi", st, s, "ops", wake=True, write=True, now=clock())
    subscribe(d, "pi", st, s, "gone", write=True, now=clock())
    st["last_batch"] = {"at": T0 - 600, "ids": ["x", "y", "z"], "possibly_unseen": True}
    save_state(d, "pi", st)
    os.rename(os.path.join(d, "+gone"), os.path.join(t.root, "gone-away"))  # a subscription whose channel has gone
    os.mkdir(os.path.join(d, "+fake"), 0o700)  # it will hold a post, but no marker: not a channel
    sent = [send(d, "wombat-sender", "pi", "SUBJECT-OF-A-DIRECT", "BODY-OF-A-DIRECT", s),
            send(d, "wombat-sender", "+fleet", "SUBJECT-OF-A-POST", "BODY-OF-A-POST", s),
            send(d, "numbat-sender", "+fleet", "SUBJECT-OF-ANOTHER-POST", "BODY-OF-ANOTHER-POST", s),
            send(d, "wombat-sender", "+ops", "SUBJECT-OF-A-WAKE-POST", "BODY-OF-A-WAKE-POST", s),
            send(d, "wombat-sender", "all", "SUBJECT-OF-A-BROADCAST", "BODY-OF-A-BROADCAST", s),
            send(d, "pi", "+fleet", "SUBJECT-OF-PI-OWN-POST", "BODY-OF-PI-OWN-POST", s),
            send(d, "pi", "all", "SUBJECT-OF-PI-OWN-BROADCAST", "BODY-OF-PI-OWN-BROADCAST", s)]
    files = [r.path for r in sent] + [t.post(d, "fake", "quokka-sender", "IN-A-DIRECTORY-THAT-IS-NOT-A-CHANNEL"),
                                      t.post(d, "fleet", "quokka-sender", "OLD-POST", stamp=T0 - 31 * 86400),
                                      t.direct(d, "away", "quokka-sender", "OLD-DIRECT", stamp=T0 - 15 * 86400)]
    pins = ["--channel", "ci:wake", "--channel", "fake"]
    printed = []

    def as_json(box, *argv):
        """pending --format json's one JSON object (None unless stdout is exactly one line of
        JSON), its status, its stderr and its stdout."""
        out, code, err = t.run(["--dir", box, "pending", *argv, "--format", "json"])
        printed.append(out)
        lines = json_lines(out) if out.endswith("\n") else None
        return (lines[0] if lines is not None and len(lines) == 1 else None), code, err, out

    def kind(value, *types):
        """True when VALUE's type is one of TYPES exactly: to isinstance, a bool is an int."""
        return type(value) in types

    obj, code, err, out = as_json(d, "pi", *pins)
    keys = ["v", "agent_mail", "name", "host", "paused", "direct", "broadcast", "channels", "write_targets", "default_channel", "ring", "last_delivery"]
    t.ok(isinstance(obj, dict) and list(obj) == keys and code == 0 and err == "",
         "pending --format json prints one line, one JSON object with the twelve fields in order, exits 0 and keeps stderr empty")
    channel_keys = ["name", "unread", "wake", "write", "pinned", "missing"]
    ring, last = obj["ring"], obj["last_delivery"]
    t.ok(kind(obj["v"], int) and obj["v"] == 1 and obj["agent_mail"] == VERSION and obj["name"] == "pi" and obj["host"] == HOST
         and kind(obj["paused"], bool) and kind(obj["direct"], int) and kind(obj["broadcast"], int) and kind(obj["channels"], list)
         and all(kind(c, dict) and list(c) == channel_keys and kind(c["name"], str) and kind(c["unread"], int)
                 and all(kind(c[k], bool) for k in channel_keys[2:]) for c in obj["channels"])
         and kind(obj["write_targets"], list) and all(kind(w, str) for w in obj["write_targets"]) and kind(obj["default_channel"], str)
         and kind(ring, dict) and list(ring) == ["digest", "direct", "channel"] and kind(ring["digest"], str)
         and re.fullmatch(r"[0-9a-f]{12}", ring["digest"]) is not None and kind(ring["direct"], int) and kind(ring["channel"], int)
         and kind(last, dict) and list(last) == ["at", "items", "possibly_unseen"] and kind(last["at"], str)
         and re.fullmatch(r"\d{8}T\d{6}Z", last["at"]) is not None and kind(last["items"], int) and kind(last["possibly_unseen"], bool),
         "each field has its type: v 1, agent_mail VERSION, name and host, booleans, counts, the channels' six fields, ring and last_delivery")
    t.ok(obj["channels"] == [
        {"name": "ci", "unread": 0, "wake": True, "write": False, "pinned": True, "missing": False},
        {"name": "fake", "unread": 0, "wake": False, "write": False, "pinned": True, "missing": True},
        {"name": "fleet", "unread": 2, "wake": False, "write": False, "pinned": False, "missing": False},
        {"name": "gone", "unread": 0, "wake": False, "write": True, "pinned": False, "missing": True},
        {"name": "ops", "unread": 1, "wake": True, "write": True, "pinned": False, "missing": False}],
         "channels lists every subscription, pins included, sorted by name, with its unread posts and its wake, write, pinned and "
         "missing marks; a channel that has gone and a directory that is not a channel are missing and count nothing")
    t.ok(obj["direct"] == 1 and obj["broadcast"] == 1 and obj["channels"][2]["unread"] == 2,
         "the session's own post and its own broadcast are not counted, nor a post older than the subscription")
    stamp = utc(T0 - 600)
    human = t.run(["--dir", d, "pending", "pi", "--format", "human", *pins])
    t.ok(human == (f"agent-mail: for pi: 1 direct, 3 channel, 1 broadcast waiting; last delivery {stamp} (3 items); your receive at {stamp} "
                   "may not have reached you; call reread with last=true and your me\n", 0, "")
         and (obj["direct"], sum(c["unread"] for c in obj["channels"]), obj["broadcast"]) == (1, 3, 1),
         "direct, the sum of the channels' unread counts and broadcast are human's direct, channel and broadcast counts")
    t.ok(obj["write_targets"] == ["gone", "ops"] and obj["default_channel"] == "fleet",
         "write_targets lists the subscriptions marked write, sorted, and default_channel names the default channel")
    t.ok(last == {"at": stamp, "items": 3, "possibly_unseen": True},
         "last_delivery gives the last batch's stamp, its item count and that it may not have reached the session")
    context = t.run(["--dir", d, "pending", "pi", "--format", "context", *pins])[0]
    rung = re.fullmatch(r"agent-mail: peer mail is waiting for pi \[([0-9a-f]{12})\] \((\d+) direct, (\d+) channel\)\. .*\n", context)
    t.ok(rung is not None and ring == {"digest": rung.group(1), "direct": int(rung.group(2)), "channel": int(rung.group(3))}
         and ring == {"digest": hashlib.sha256("\n".join(sorted([sent[0].id, sent[3].id])).encode()).hexdigest()[:12], "direct": 1, "channel": 1},
         "ring carries ring_line's digest and counts: the direct message and the wake channel's post, never the quiet posts")
    pause = os.path.expanduser(PAUSE_PATH)
    os.makedirs(os.path.dirname(pause), 0o700, exist_ok=True)
    t.mk(pause, "")
    try:
        paused = as_json(d, "pi", *pins)[0]
    finally:
        os.unlink(pause)
    t.ok(obj["paused"] is False and kind(paused, dict) and paused["paused"] is True and paused == {**obj, "paused": True},
