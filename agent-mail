    t.ok(getattr(t.raises(create_channel, d, "all", "p"), "code", None) == "reserved_name", "a channel cannot take a reserved name")
    t.ok(getattr(t.raises(create_channel, d, "ops", " \x1b "), "code", None) == "bad_argument" and not os.path.lexists(os.path.join(d, "+ops")),
