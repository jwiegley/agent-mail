            answer = ask_line(proc, {"jsonrpc": "2.0", "id": 2, "method": "tools/call",
                                     "params": {"name": "receive", "arguments": {"me": "jobber"}}})["result"]
        jobs[job] = (free, answer["isError"], answer["content"][0]["text"])
    t.ok(jobs[True][:2] == (True, True) and "background job" in jobs[True][2]
