    t.ok(os.path.exists(waiting_for_b) and load_state(d, "b")["seen"] == seen_before, "a writer that raises BrokenPipeError leaves claims in place and seen sets unchanged")
    n = t.server(d, None)
    t.ok("no_identity" in text(tool(n, "pending")) and not tool(n, "channels")["isError"], "without a name only channels works")
    t.ok(all(text(x).startswith("agent-mail (bound name b@") for x in (tool(b, "pending"), tool(b, "channels"))), "every result names the binding")
    t.ok(t.call(b, "tools/call", {"name": "frobnicate", "arguments": {}})["error"]["code"] == -32602
         and t.call(b, "tools/call", {"name": "receive", "arguments": {"me": "b", "extra": 1}})["error"]["code"] == -32602
         and t.call(b, "tools/call", {"name": "receive", "arguments": {"me": "b", "max_bytes": 999}})["error"]["code"] == -32602,
         "an unknown tool or bad arguments get -32602")
    tool(a, "send", to="b", subject="again", body="REREAD-BODY")
    first = tool(b, "receive", me="b")
    receive_id = t._ids
    m = re.match(r"agent-mail \[([0-9a-f]{8})\]", text(first))
    tok_first = m.group(1) if m else None
    again = tool(b, "reread", last=True)
    m = re.match(r"agent-mail \[([0-9a-f]{8})\]", text(again))
    tok_reread = m.group(1) if m else None
    t.ok(tok_first and tok_reread and tok_reread != tok_first and "REREAD-BODY" in text(again), "reread last re-renders the last batch with a fresh token")
    b.handle({"jsonrpc": "2.0", "method": "notifications/cancelled", "params": {"requestId": receive_id, "reason": "user pressed Esc"}})
    t.ok("may not have reached you; call reread with last=true" in text(tool(b, "pending")), "a cancelled receive is flagged on the next pending")
    old, new = t.server(d, "c"), t.server(d, "c")
    old.close()
    t.ok(not tool(new, "receive", me="c")["isError"], "a server refused at start takes the lock at its next receive once the holder exits")
    later = t.server(os.path.join(t.root, "later"), "e")
    t.ok("mailbox_missing" in text(tool(later, "pending")), "a missing mailbox fails each call without ending the server")
    os.mkdir(os.path.join(t.root, "later"), 0o700)
    t.mk(os.path.join(t.root, "later", MARKER_V2), "")
    t.ok("no mail for e" in text(tool(later, "pending")), "and the server recovers when the mailbox appears")
    t.ok("structuredContent" not in json.dumps(results), "no result carries structuredContent")


def section_send(t):
    t.patch("SETTLE", 0.0)
    root = t.root
    d = t.box()
    body = os.path.join(root, "body.txt")
    with open(body, "w") as f:
        f.write("hello nix\n")
    sent, code, err = t.capture(cmd_send, "pi", "nix", "Test\nsub\x1bject", "34f513aa-1793309640", body, d)
    sent = sent.strip()
    base = os.path.basename(sent)
    t.ok(re.fullmatch(r"nix_\d{8}T\d{6}\.\d{6}Z_from-pi_[0-9a-f]{8}\.txt", base) is not None, "names a sent file by the standard")
    t.ok(stat.S_IMODE(os.stat(sent).st_mode) == 0o600, "writes mode 0600")
    with open(sent) as f:
        text = f.read()
    t.ok(re.match(r"From: pi@\S+ \(agent-deck 34f513aa-1793309640\)\nTo: nix\nUTC: \S+\nSubject: Test sub ject\nX-Agent-Mail: 2\n\nhello nix\n$", text) is not None,
         "writes clean header lines")
    t.ok("no reader has checked nix's mail yet" in err, "warns when nobody reads the recipient's mail")
    t.ok(not [e for e in os.listdir(d) if e.endswith(".tmp")], "leaves no temporary file")
    t.ok(getattr(t.raises(cmd_send, "pi", "nix", "s", "bad\nid", body, d), "code", None) == "bad_argument", "refuses a bad --id")
    e = t.raises(cmd_send, "pi", "nix", " \x1b ", None, body, d)
    t.ok(e is not None and e.code == "no_subject" and "needs a --subject" in e.message, "refuses a message without a subject")
    big = os.path.join(root, "big.txt")
    with open(big, "w") as f:
        f.write("b" * LIMIT)
    e = t.raises(cmd_send, "pi", "nix", "s", None, big, d)
    t.ok(e is not None and e.code == "too_large" and "over the 1 MiB limit" in e.message, "refuses a body over the limit")
    e = t.raises(cmd_send, "pi", "nix", "s", None, os.path.join(root, "missing"), d)
    t.ok(e is not None and "cannot read" in e.message, "explains an unreadable body")

    line1 = t.capture(cmd_pending, "nix", d)[0]
    t.ok(re.fullmatch(r"agent-mail: mail for nix announced \d{8}T\d{6}Z \[[0-9a-f]{12}\]\n", line1) is not None and base not in line1,
         "pending announces new mail")
    t.ok(t.capture(cmd_pending, "nix", d)[0] == line1, "pending repeats itself while nothing changes")
    t.ok("hello nix" in t.capture(cmd_read, "nix", d, MAX_BYTES)[0], "the recipient reads it")
    t.ok(t.capture(cmd_pending, "nix", d)[0] == line1, "pending does not change when mail is read")
    again = t.mk(os.path.join(root, "again.txt"), "hello again, nix\n")
    t.ok(not t.capture(cmd_send, "pi", "nix", "s", None, again, d)[2], "no warning once the recipient reads")
    line2 = t.capture(cmd_pending, "nix", d)[0]
    t.ok(line2 != line1 and "announced" in line2, "pending changes on new mail")
    st = read_json(state_file(d, "nix", ".pending"))
    st["announced"] -= 1000
    st["changed"] -= 1000
    write_json(state_file(d, "nix", ".pending"), st)
    line3 = t.capture(cmd_pending, "nix", d)[0]
    t.ok(line3 != line2 and "reminder 1" in line3, "pending reminds about unread mail")
    t.ok(t.capture(cmd_pending, "nix", d)[0] == line3, "and does not repeat the reminder at once")

    s = load_settings({}, {}, "pi")
    no_broadcast, paused = dataclasses.replace(s, allow_broadcast=False), dataclasses.replace(s, paused=True)
    create_channel(d, "fleet", "fleet-wide notices")
    r = send(d, "pi", "+fleet", "ping", "hello", s)
    with open(r.path) as f:
        post_text = f.read()
    t.ok(re.fullmatch(r"fleet_\d{8}T\d{6}\.\d{6}Z_from-pi_[0-9a-f]{8}\.txt", os.path.basename(r.path)) is not None
         and os.path.dirname(r.path) == os.path.join(d, "+fleet"), "a post lands in its channel under the standard name")
    t.ok("To: +fleet\n" in post_text and "X-Agent-Mail: 2\n" in post_text, "a post carries To: +fleet and X-Agent-Mail: 2")
    t.ok(os.path.basename(send(d, "pi", "all", "s", "b", s).path).startswith("all_"), "a broadcast lands at the top level as all_")
    t.ok(getattr(t.raises(send, d, "pi", "+fleet", "s", "x" * 8192, s), "code", None) == "too_large", "a post over 8 KiB is refused")
    t.ok(getattr(t.raises(send, d, "nix", "all", "s", "x" * 4096, s), "code", None) == "too_large", "a broadcast over 4 KiB is refused")
    t.ok(getattr(t.raises(send, d, "pi", "all", "s", "b", no_broadcast), "code", None) == "broadcast_not_allowed", "allow_broadcast false refuses a broadcast")
    t.ok(getattr(t.raises(send, d, "pi", "nix", "s", "-----BEGIN OPENSSH PRIVATE KEY-----\nabc", s), "code", None) == "looks_like_secret",
         "refuses a private key block")
    t.ok(getattr(t.raises(send, d, "pi", "nix", "s", "token ghp_" + "a" * 36, s), "code", None) == "looks_like_secret", "refuses a GitHub token")
    t.ok(send(d, "pi", "nix", "s2", "commit " + "0b1c" * 10 + " and the word sk-ant in prose", s).id, "lets a git hash and prose through")
    t.ok(getattr(t.raises(send, d, "pi", "nix", "s", "b", paused), "code", None) == "paused", "a paused host does not send")
    t.ok(getattr(t.raises(send, d, "pi", "+nope", "s", "b", s), "code", None) == "no_such_channel", "a post to a missing channel is refused")
    t.ok("nobody lists +fleet yet; the post is kept 30 days" in r.warnings, "warns when nobody lists the channel")
    reply = send(d, "nix", "pi", "re: ping", "pong", s, in_reply_to=r.id)
    with open(reply.path) as f:
        reply_text = f.read()
    t.ok(f"\nIn-Reply-To: {r.id}\nX-Agent-Mail: 2\n\n" in reply_text
         and getattr(t.raises(send, d, "nix", "pi", "s", "other", s, in_reply_to="not an id"), "code", None) == "invalid_id",
         "In-Reply-To carries a message id and nothing else")


def section_cli(t):
    t.patch("SETTLE", 0.0)
    root = t.root
    plain = os.path.join(root, "project")
    os.mkdir(plain)
    with open(os.path.join(plain, "pi.md"), "w") as f:
        f.write("a project file\n")
    _, code, err = t.run(["--dir", plain, "read", "pi"])
    t.ok(code == 1 and "not an agent-mail mailbox" in err and os.path.exists(os.path.join(plain, "pi.md")),
         "refuses a directory that is not a mailbox")
    t.run(["--dir", plain, "init"])
    t.ok(os.path.exists(os.path.join(plain, MARKER_V2)) and t.run(["--dir", plain, "read", "pi"])[0].strip() == "agent-mail: no mail for pi"
         and os.path.exists(os.path.join(plain, "pi.md")), "init makes a directory a mailbox")
    # A home of its own: the mailbox "mailbox" and "Mailbox" are one name on a
    # case-insensitive file system.
    box = os.path.join(root, "home", "Mailbox")
    os.makedirs(box, 0o700)
    os.environ["HOME"] = os.path.dirname(box)
    try:
        t.ok(require_mailbox(box) == box, "accepts ~/Mailbox, the default, without a marker")
        # On a case-insensitive file system ~/mailbox is ~/Mailbox, so init
        # refuses the spelling everywhere, whether ~/Mailbox exists or not.
        err = t.run(["--dir", os.path.join(root, "home", "mailbox"), "init"])[2]
        t.ok("init is for other directories" in err and not os.path.exists(os.path.join(box, MARKER_V2)),
             "init refuses ~/Mailbox spelled in another case")
        home4 = os.path.join(root, "home4")
        os.mkdir(home4)
        os.environ["HOME"] = home4
        err = t.run(["--dir", os.path.join(home4, "mailbox"), "init"])[2]
        t.ok("init is for other directories" in err and not os.listdir(home4),
             "init refuses ~/Mailbox spelled in another case before it exists")
    finally:
        os.environ["HOME"] = root
    # Syncthing creates ~/Mailbox; init must not.
    home2 = os.path.join(root, "home2")
    os.mkdir(home2)
    os.environ["HOME"] = home2
    try:
        err = t.run(["init"])[2]
        t.ok("init is for other directories" in err and not os.path.lexists(os.path.join(home2, "Mailbox")),
             "init refuses to create ~/Mailbox")
        # A path elsewhere that resolves to ~/Mailbox is ~/Mailbox.
        link = os.path.join(root, "box-link")
        os.symlink(os.path.join(home2, "Mailbox"), link)
        err = t.run(["--dir", link, "init"])[2]
        t.ok("init is for other directories" in err and not os.path.lexists(os.path.join(home2, "Mailbox")),
             "init refuses a path that resolves to ~/Mailbox")
        # A dangling symlink is reported, not followed.
        dangling = os.path.join(root, "dangling")
        os.symlink(os.path.join(root, "nowhere"), dangling)
        err = t.run(["--dir", dangling, "init"])[2]
        t.ok("exists but is not a directory" in err and not os.path.lexists(os.path.join(root, "nowhere")),
             "init reports a dangling symlink")
    finally:
        os.environ["HOME"] = root
    # The Positron hosts: ~/Mailbox is a symlink to a directory on local disk.
    local = os.path.join(root, "local-mailbox")
    os.mkdir(local, 0o700)
    home3 = os.path.join(root, "home3")
    os.mkdir(home3)
    os.symlink(local, os.path.join(home3, "Mailbox"))
    os.environ["HOME"] = home3
    try:
        with open(os.path.join(local, "pi_20260101T000000.000000Z_from-nix_00000001.txt"), "w") as f:
            f.write("through the symlink\n")
        t.ok("through the symlink" in t.run(["read", "pi"])[0], "reads ~/Mailbox through a symlink to a local directory")
        with open(os.path.join(local, "pi_20260101T000001.000000Z_from-nix_00000002.txt"), "w") as f:
            f.write("through --dir\n")
        t.ok("through --dir" in t.run(["--dir", local, "read", "pi"])[0],
             "accepts --dir to the symlink's target without a marker")
    finally:
        os.environ["HOME"] = root
    for bad in ("a_b", "pi@clio", "../x", "", "x--y", "-x", "x-", "Pi", "NIX"):
        t.ok(getattr(t.raises(check_name, bad), "code", None) == "invalid_name", f"rejects the name {bad!r}")
    for good in ("pi", "clio-pi", "mcp-servers", "conductor-director", "keyboard-maestro", "nyx-ai"):
        t.ok(check_name(good) == good, f"accepts the name {good!r}")

    # Task 12: channels, subscriptions and the lock through the CLI.
    d = t.box("cli")
    t.run(["--dir", d, "channel", "create", "fleet", "--purpose", "fleet-wide notices; short posts that point to paths or commits"])
    t.run(["--dir", d, "subscribe", "pi", "fleet"])
    t.direct(d, "all", "nix", "CLI-BROADCAST")
    t.post(d, "fleet", "nix", "CLI-POST")
    t.direct(d, "pi", "nix", "CLI-DIRECT")
    out = t.run(["--dir", d, "read", "pi"])[0]
    t.ok(all(k in out for k in ("direct id=", "post +fleet id=", "broadcast id="))
         and out.index("direct id=") < out.index("post +fleet id=") < out.index("broadcast id="), "read delivers direct mail, posts and broadcasts in order")
    t.post(d, "fleet", "nix", "CLI-WAKE")
    watch_out = t.run(["--dir", d, "watch", "pi", "--poll", "1", "--max-polls", "3"])[0]
    t.ok("post +fleet" in watch_out and watch_out.rstrip().endswith("has exited after this delivery; start it again"), "watch wakes on a post in a subscribed channel")
    held = ReaderLock(d, "pi")
    held.acquire()
    try:
        out, code, err = t.run(["--dir", d, "subscribe", "pi", "fleet"])
        t.ok(code == 4 and "holds its lock" in err and f"{os.getpid()}@{HOST}" in err, "subscribe refuses while another reader holds the lock")
        t.ok(t.run(["--dir", d, "read", "pi"])[1] == 4, "read refuses while another reader holds the lock")
    finally:
        held.release()
    t.ok(t.run(["--dir", d, "channel", "create", "ops", "--purpose", "ops notices"])[0].strip() == "+ops", "channel create prints the channel")
    t.ok("ops notices" in t.run(["--dir", d, "channels"])[0], "channels lists the channel with its purpose")
    t.ok(t.run(["--dir", d, "watch", "pi", "--interval", "1", "--max-polls", "1"])[1] in (0, None), "watch still accepts --interval")
    t.run(["--dir", d, "subscribe", "pi", "+ops", "--wake"])
    listing = t.run(["--dir", d, "channels", "pi"])[0]
    t.ok("+ops" in listing and "you, wake" in listing and "you, quiet" in listing, "channels NAME marks that session's subscriptions")
    out = t.run(["--dir", d, "unsubscribe", "pi", "ops"])[0]
    t.ok("ops" not in load_state(d, "pi")["subs"] and "+ops" in out, "unsubscribe drops a subscription")


