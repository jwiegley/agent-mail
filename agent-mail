Identity = collections.namedtuple("Identity", "name source problem")
IDENTITY_DIR = os.path.join(".local", "share", "agent-deck", "runtime", "identity")
HOST_LOCAL_DATA_DIR = os.path.join(".local", "share", "agent-deck-hosts")
HOST_LOCAL_IDENTITY_DIR = os.path.join(HOST_LOCAL_DATA_DIR, HOST, "agent-deck", "runtime", "identity")
SMALL_FILE = 65536
TITLE_RE = re.compile(r"^- title:[ \t]*(.*?)[ \t]*$", re.MULTILINE)


def read_small(path, limit=SMALL_FILE):
    """The bytes of a regular file of ours, opened without following a symlink, at most
    LIMIT long; OSError for anything else."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_size > limit:
            raise OSError(errno.EPERM, "not a regular file of ours within the size limit")
        return os.read(fd, limit + 1)[:limit]
    finally:
        os.close(fd)


def identity_roots(home):
    """The directories an identity file may sit under, by real path: agent-deck's data home,
    and its host-local data home for this host (on a home directory shared over NFS,
    agent-deck keeps each host's runtime data under .local/share/agent-deck-hosts/<host>/,
    <host> being the short host name in lower case, as HOST is). Every host's directory is
    visible from every host, so only this host's counts."""
    return (os.path.realpath(os.path.join(home, IDENTITY_DIR)), os.path.realpath(os.path.join(home, HOST_LOCAL_IDENTITY_DIR)))


def ignored_data_home(env, roots):
    """A note for a refusal when AGENTDECK_HOST_LOCAL_DATA_HOME names anything but this
    host's data home, else None. The variable never widens trust; the note only says why
    a file it seems to point at did not count."""
    declared = env.get("AGENTDECK_HOST_LOCAL_DATA_HOME")
    if not declared or os.path.realpath(os.path.join(declared, "agent-deck", "runtime", "identity")) == roots[1]:
        return None
    shown = echo("/".join(escape(part) for part in declared.split("/")))
    return f" (AGENTDECK_HOST_LOCAL_DATA_HOME {shown} is not this host's data home and was ignored)"


def present(path):
    """True unless PATH is missing: a path that exists but cannot be looked at still
    counts, so that its refusal says why instead of calling it absent."""
    try:
        os.lstat(path)
    except (FileNotFoundError, NotADirectoryError):
        return False
    except OSError:
        return True
    return True


def identity_title(path, home):
    """The "- title:" value of an agent-deck identity file, and why not when it is None. The
    file counts only as a regular file (by lstat) of ours, at most 64 KiB, under one of the
    identity_roots by real path."""
    roots = identity_roots(home)
    try:
        st = os.lstat(path)
    except OSError as e:
        return None, f"cannot be read ({e.strerror})"
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
        return None, "is not a regular file of ours"
    real = os.path.realpath(path)
    if not any(os.path.commonpath([root, real]) == root for root in roots):
        return None, f"is not under {roots[0]} or {roots[1]}"
    try:
        m = TITLE_RE.search(read_small(path).decode("utf-8", "replace"))
    except OSError as e:
        return None, f"cannot be read ({e.strerror})"
    return (m.group(1), None) if m and m.group(1) else (None, "has no '- title:' line")


def bind_name(value, source):
    name = value.strip().lower()
    try:
        return Identity(check_name(name), source, None)
    except MailError as e:
        return Identity(None, source, f"{source} gives a name that binds nothing: {e.message}")


def resolve_identity(flag, env, home):
    """A session's name, resolved once: --name, AGENT_MAIL_NAME, AGENTDECK_TITLE, the
    "- title:" line of AGENTDECK_IDENTITY_FILE, then (for Pi, which agent-deck gives only
    an instance id) the same line of <root>/<AGENTDECK_INSTANCE_ID>/identity.md under the
    first of the identity_roots that holds a usable one.
    The first source present decides; a value that, lower-cased, fails the grammar or is
    reserved binds nothing, and problem says why."""
    for source, value in (("--name", flag), ("AGENT_MAIL_NAME", env.get("AGENT_MAIL_NAME")), ("AGENTDECK_TITLE", env.get("AGENTDECK_TITLE"))):
        if value:
            return bind_name(value, source)
    path = env.get("AGENTDECK_IDENTITY_FILE")
    if path:
        title, why = identity_title(path, home)
        if title:
            return bind_name(title, "AGENTDECK_IDENTITY_FILE")
        return Identity(None, "AGENTDECK_IDENTITY_FILE", f"AGENTDECK_IDENTITY_FILE {why}" + (ignored_data_home(env, identity_roots(home)) or ""))
    instance = env.get("AGENTDECK_INSTANCE_ID")
    if instance:
        if not IDENT.fullmatch(instance) or ".." in instance:
            return Identity(None, "AGENTDECK_INSTANCE_ID", f"AGENTDECK_INSTANCE_ID {escape(instance)!r} is not an agent-deck session id")
        roots = identity_roots(home)
        whys = []
        for root in roots:
            candidate = os.path.join(root, instance, "identity.md")
            title, why = identity_title(candidate, home)
            if title:
                return bind_name(title, "AGENTDECK_INSTANCE_ID")
            if present(candidate):
                whys.append(why if why.startswith("is not under") else f"{why} (under {root})")
        why = whys[0] if whys else f"is in neither {roots[0]} nor {roots[1]}"
        return Identity(None, "AGENTDECK_INSTANCE_ID", f"agent-deck's identity file for AGENTDECK_INSTANCE_ID {instance} {why}" + (ignored_data_home(env, roots) or ""))
    return Identity(None, None, "no source names this session")


def background_job(env, ppid, home):
    """True for a Claude background job: CLAUDE_JOB_DIR is set, unless the parent's session
    record (<$CLAUDE_CONFIG_DIR or ~/.claude>/sessions/<ppid>.json, ours, with that pid) says
    "kind": "interactive". This is agent-deck's rule for issue #2683, since the variable
    can leak into a foreground pane through tmux. A background job never takes the lock."""
    if not env.get("CLAUDE_JOB_DIR"):
        return False
    record = os.path.join(env.get("CLAUDE_CONFIG_DIR") or os.path.join(home, ".claude"), "sessions", f"{ppid}.json")
    try:
        data = json.loads(read_small(record).decode("utf-8"))
    except (OSError, ValueError):
        return True
    return not (isinstance(data, dict) and data.get("pid") == ppid and data.get("kind") == "interactive")


def check_me(me, bound):
    """Refuse with name_mismatch unless ME, lower-cased, is the bound name."""
    if not isinstance(me, str) or me.strip().lower() != bound:
        raise MailError("name_mismatch", f"me is {echo(me, escaped=True)}, but this server is bound to {bound}; pass your own agent-deck session name as me")


