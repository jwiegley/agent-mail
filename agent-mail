    for job in (True, False):
        with mcp_process(d, "jobber", {**plain, "CLAUDE_JOB_DIR": os.path.join(t.root, "job")} if job else plain) as proc:
            ask_line(proc, {"jsonrpc": "2.0", "id": 1, "method": "ping"})  # serving, so it has tried the lock
            probe = ReaderLock(d, "jobber")
