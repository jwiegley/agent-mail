#!/usr/bin/env -S python3 -I
"""agent-mail: a file mailbox between agent-deck sessions.

Mailbox: a directory, by default ~/Mailbox ($AGENT_MAIL_DIR or --dir overrides it).
Sessions on several hosts can share one mailbox when they share the directory: an NFS
home, a Syncthing folder, or one machine. Claims record their host (an 8-hex-digit tag),
so a reader checks a claim's PID only on the host that made it; a claim made on another
host is delivered again after 10 minutes. On NFS a new file can take up to a minute to
appear on another host; Syncthing's own temporary files are hidden names, so readers
ignore them. Each mailbox name still has exactly one reader, on one host.

Name: a session's mailbox name is its agent-deck title in lower case: lower-case letters,
digits, "." and "-", starting with a letter or digit, with no "_" and no "--", at most 64
characters and not ending in "-". These are reserved and name no session, sender or
channel: all, everyone, john, johnw, jwiegley, user, human, operator, owner, admin, root,
system, claude, anthropic, codex, agent-deck, agent-mail, and any name beginning with
"john-". Always pass the name explicitly; inherited environment variables can name another
session. Each mailbox name should have exactly one reader.

Message: a regular file named TO_UTC_from-FROM_UNIQUE.txt, for example
nix_20261030T050102.123456Z_from-pi_3f9a1c2e.txt, owned by you and mode 0600. It begins
with From, To, UTC and Subject header lines, then a blank line, then the body. A sender
writes it to a hidden file in the mailbox and renames it into place.

Ownership: a file is NAME's mail only when its whole name is in the standard form with NAME
before the first "_". So "pi" never takes "clio-pi", "pi-2", "pi.v2" or "pipeline" mail.
Older forms (pi.md, pi--..., pi-<stamp>...) and upper-case names are not mail: readers
leave them in place. Names starting with "." are never mail.

Receiving:
- A file is read once its inode has gone 2 seconds unchanged (ctime, which a sender cannot
  backdate), so a message still being written waits.
- It is claimed by renaming it to .NAME-claimed-PID-HOSTTAG-FILE, then printed between frame
  lines that carry a random token for that delivery, so a body cannot fake a frame. Afterwards it is
  moved to .NAME-read/FILE and kept for 7 days, so a reader whose output was cut can
  reopen it. A claim whose reader on this host has died, or that is 10 minutes old, is
  delivered again.
- One read prints a list of its messages first, then the messages, oldest first, up to
  about 12 KB (--max-bytes). A bigger message is shown in part, with the path of its
  copy. Mail not delivered stays waiting, and read says so.
- A file that changes while being read is put back for later.
- Symlinks, FIFOs, hard-linked files, other users' files and files over 1 MiB (or that
  grow past it while being read) are not read: they become .NAME-rejected-FILE and are
  reported once. A directory is never renamed: it is reported once and left in place.
- Printed text has ANSI sequences removed and control and bidi characters replaced, and a
  line that opens or closes a system-reminder, channel or command-output tag has its "<"
  replaced. Names in notices show every other byte than letters, digits and "._+-" as \\xNN.
- A file that cannot be claimed at all (for example, the mailbox is read-only to this
  reader) is reported once and left where it is; read exits with status 2.
- If printing fails, the claimed messages are put back.
- Reads, watch polls and pending runs record that NAME's mail was checked, at most once
  a minute, in .agent-mail-presence/NAME. send warns when the recipient's mail has not been checked
  for an hour, or ever; the message still waits for it.

Never pipe read or watch through head, tail, sed or grep: what they print is consumed.

Commands:
  send --from NAME --to NAME --subject TEXT [--id SESSION_ID] [FILE]
      Send FILE, or standard input when FILE is "-" or omitted.
  read NAME [--max-bytes N]
      Deliver NAME's waiting mail once; prints "agent-mail: no mail for NAME" when empty.
  watch NAME [--interval SECONDS] [--forever] [--max-bytes N] [--parent PID]
      Poll (default every 15 s). Exit after the first delivery, so a background task
      wakes its session once per batch; with --forever keep printing batches, for a
      streaming monitor. With --parent (in Claude Code, --parent $PPID), stop without
      reading once that process is gone, so a watcher outliving its session takes no mail.
  pending NAME
      One line for pi-loop's --cmd --on-change. It changes when new mail is ready to
      read, and again as a reminder while that mail stays unread. It does not change
      when mail is read.
  init
      Create the mailbox directory (mode 0700) and its .agent-mail-mailbox-v2 marker. Every
      mailbox other than ~/Mailbox needs the marker, so that a wrong --dir or
      $AGENT_MAIL_DIR cannot claim a project's files; a directory with only the v1 marker,
      .agent-mail-mailbox, is refused until init runs there. ~/Mailbox itself is refused,
      since Syncthing creates it.
  self-test [SECTION ...]
      Run the built-in checks, every section or the named ones, each in a fresh
      temporary home.
"""
import argparse
import collections
import contextlib
import datetime
import errno
import hashlib
import io
import json
import os
import re
import secrets
import socket
import stat
import sys
import tempfile
import time
import unicodedata

SETTLE = 2.0
CLAIM_STALE = 600.0
LIMIT = 1 << 20
MAX_BYTES = 12000
EXCERPT = 8000
KEEP_DAYS = 7
NAME_MAX = 255
REMIND_AFTER = 120.0
REMIND_EVERY = 300.0
PRESENCE_STALE = 3600.0
NAME_PAT = r"[a-z0-9](?:[a-z0-9.]|-(?!-))*"
NAME_RE = re.compile(NAME_PAT)
MSG_RE = re.compile(rf"(?P<to>{NAME_PAT})_(?P<utc>[0-9]{{8}}T[0-9]{{6}}\.[0-9]{{6}}Z)_from-(?P<from>{NAME_PAT})_(?P<uniq>[0-9a-f]{{8}})\.txt")
RESERVED = frozenset({"all", "everyone", "john", "johnw", "jwiegley", "user", "human", "operator", "owner", "admin",
                      "root", "system", "claude", "anthropic", "codex", "agent-deck", "agent-mail"})
RESERVED_PREFIX = "john-"
# The characters a name in a notice may show as they are. "_" joins the parts of every
# message name, so it is kept; every other byte is written as \xNN.
SAFE = frozenset("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._+-" "_")
MARKER = ".agent-mail-mailbox"
MARKER_V2 = ".agent-mail-mailbox-v2"
DEFAULT_DIR = "~/Mailbox"
HOST = socket.gethostname().split(".")[0].lower()
HOSTTAG = hashlib.sha256(HOST.encode()).hexdigest()[:8]
PRESENCE_EVERY = 60.0
IDENT = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}")
STAMP = re.compile(r"(\d{8}T\d{6})(?:\.(\d{6}))?Z")
EXIT_STATUS = {"stuck": 2, "output_failed": 3, "not_reader": 4}


class MailError(Exception):
    """A refusal or failure. The core raises it and never prints or exits; a front end
    maps .code (snake_case) to an exit status or a tool error and shows .message."""

    def __init__(self, code, message=None):
        super().__init__(message or code)
        self.code = code
        self.message = message or code.replace("_", " ")


_CLOCK = None  # injected by the self-test only


def clock():
    """The current time for every time-based decision."""
    return time.time() if _CLOCK is None else _CLOCK


def default_dir():
    return os.environ.get("AGENT_MAIL_DIR") or os.path.expanduser(DEFAULT_DIR)


def require_mailbox(d):
    """Refuse a directory that is not a mailbox, so a wrong --dir cannot claim project files."""
    if not os.path.isdir(d):
        raise MailError("mailbox_missing", f"mailbox {d} does not exist")
    default = os.path.realpath(os.path.expanduser(DEFAULT_DIR))
    if os.path.realpath(d) == default or os.path.isfile(os.path.join(d, MARKER_V2)):
        return d
    if os.path.isfile(os.path.join(d, MARKER)):
        raise MailError("not_mailbox", f"{d} is not an agent-mail 2 mailbox: it has only the v1 marker; run agent-mail init there")
    raise MailError("not_mailbox", f"{d} is not an agent-mail mailbox (it has no {MARKER_V2}); check --dir and $AGENT_MAIL_DIR, or run init there")


def cmd_init(d, write=None):
    default = os.path.realpath(os.path.expanduser(DEFAULT_DIR))
    real = os.path.realpath(d)
    # realpath neither folds case nor sees through a macOS firmlink or a bind
    # mount, so compare the parents as files and the names without case; that
    # holds whether ~/Mailbox exists yet or not.
    parents = os.path.dirname(real), os.path.dirname(default)
    same_parent = all(map(os.path.isdir, parents)) and os.path.samefile(*parents)
    if real == default or (same_parent and os.path.basename(real).casefold() == os.path.basename(default).casefold()):
        raise MailError("init_refused", f"{DEFAULT_DIR} is the Syncthing folder, which Syncthing creates; init is for other directories")
    try:
        os.makedirs(d, mode=0o700, exist_ok=True)
    except FileExistsError:
        raise MailError("not_a_directory", f"{d} exists but is not a directory")
    marker = os.path.join(d, MARKER_V2)
    if not os.path.exists(marker):
        os.close(os.open(marker, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600))
    emit(write, f"{d}\n")
    return 0


NAME_KINDS = {"session": "mailbox name", "sender": "sender name", "channel": "channel name"}


def grammatical(name):
    return NAME_RE.fullmatch(name) is not None and len(name) <= 64 and not name.endswith("-")


def check_name(name, kind="session"):
    """Return NAME when it follows the grammar and is not reserved; kind shapes the message."""
    what = NAME_KINDS[kind]
    if not grammatical(name):
        hint = " (for sessions on several hosts, share one mailbox directory)" if "@" in name else ""
        if name != name.lower() and grammatical(name.lower()):
            hint = f" (names are lower case: use {name.lower()!r})"
        raise MailError("invalid_name", f"invalid {what} {name!r}{hint}")
    if name in RESERVED or name.startswith(RESERVED_PREFIX):
        raise MailError("reserved_name", f"the {what} {name!r} is reserved")
    return name


Msg = collections.namedtuple("Msg", "to utc sender uniq id stamp")


def parse_msg(entry):
    """The message an entry's name denotes, or None when the name is not standard.

    stamp is the name's UTC time in epoch seconds.
    """
    m = MSG_RE.fullmatch(entry)
    if not m or not (grammatical(m.group("to")) and grammatical(m.group("from"))):
        return None
    try:
        when = datetime.datetime.strptime(m.group("utc"), "%Y%m%dT%H%M%S.%fZ").replace(tzinfo=datetime.timezone.utc)
    except ValueError:
        return None
    return Msg(m.group("to"), m.group("utc"), m.group("from"), m.group("uniq"), entry[:-len(".txt")], when.timestamp())


def escape(text):
    """TEXT for a notice: each byte of its UTF-8 form outside SAFE becomes \\xNN."""
    try:
        data = text.encode("utf-8", "surrogateescape")
    except UnicodeEncodeError:
        data = text.encode("utf-8", "surrogatepass")
    return "".join(chr(b) if chr(b) in SAFE else f"\\x{b:02x}" for b in data)


ANSI_RE = re.compile(r"\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07\x1b\n]*(?:\x07|\x1b\\)?|[@-Z\\-_])")
# C0 and C1 controls other than tab and newline, and the bidi controls that can reorder text.
CONTROL_RE = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f\u200e\u200f\u202a-\u202e\u2066-\u2069]")
TAG_LINE_RE = re.compile(r"^([ \t]*)<(?=/?(?:system-reminder|channel|command-output)(?:[\s>/]|$))", re.IGNORECASE | re.MULTILINE)


def sanitize(text):
    """Printed text: ANSI sequences removed, control and bidi characters replaced by U+FFFD,
    and the "<" of a line that opens or closes a harness tag replaced by U+2039."""
    text = CONTROL_RE.sub("\ufffd", ANSI_RE.sub("", text))
    return TAG_LINE_RE.sub("\\1\u2039", text)


def claim_name(name, original):
    return f".{name}-claimed-{os.getpid()}-{HOSTTAG}-{original}"


def parse_claim(name, entry):
    """For one of NAME's claims, (pid, host tag, original file name); otherwise None.

    The host tag is the first 8 hex digits of SHA-256 of the short host name. pid is None
    for a claim from the first agent-mail, which carried no PID, and the tag is None for
    one from before claims named their host.
    """
    prefix = f".{name}-claimed-"
    if not entry.startswith(prefix):
        return None
    rest = entry[len(prefix):]
    m = re.fullmatch(r"(\d+)-([0-9a-f]{8})-(.+)", rest, re.DOTALL)
    if m:
        return int(m.group(1)), m.group(2), m.group(3)
    m = re.fullmatch(r"(\d+)-(.+)", rest, re.DOTALL)
    if m:
        return int(m.group(1)), None, m.group(2)
    return None, None, rest


def utc(ts=None, micro=False):
    t = datetime.datetime.fromtimestamp(clock() if ts is None else ts, datetime.timezone.utc)
    return t.strftime("%Y%m%dT%H%M%S.%fZ" if micro else "%Y%m%dT%H%M%SZ")


def sort_key(entry, st):
    m = STAMP.search(entry)
    stamp = f"{m.group(1)}.{m.group(2) or '000000'}" if m else utc(st.st_mtime, micro=True)[:-1]
    return (stamp, entry)


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def too_long(name):
    return len(os.fsencode(name)) > NAME_MAX


def state_path(d, name, kind):
    key = hashlib.sha256(os.path.realpath(d).encode()).hexdigest()[:12]
    return os.path.join(os.path.expanduser("~/.cache/agent-mail"), f"{key}-{name}.{kind}")


def save_json(path, data):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f)
    os.replace(tmp, path)


def load_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (FileNotFoundError, ValueError):
        return None


def presence_path(d, name):
    return os.path.join(d, ".agent-mail-presence", name)


def touch_presence(d, name):
    # At most once a minute, so a shared (NFS or synced) mailbox is not rewritten on every poll.
    p = presence_path(d, name)
    try:
        if clock() - os.stat(p).st_mtime < PRESENCE_EVERY:
            return
    except OSError:
        pass
    try:
        # mkdir, not makedirs: a mailbox that has vanished must not be re-created here.
        with contextlib.suppress(FileExistsError):
            os.mkdir(os.path.dirname(p), 0o700)
        fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        os.close(fd)
        os.utime(p, None)
    except OSError:
        pass


class Rejected(Exception):
    pass


class Changed(Exception):
    pass


def read_file(path):
    # O_NONBLOCK keeps a FIFO from blocking the open; O_NOFOLLOW refuses a symlink.
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        raise
    except OSError as e:
        raise Rejected(f"cannot open it ({e.strerror}); symlinks are refused") from e
    try:
        before = os.fstat(fd)
        if not stat.S_ISREG(before.st_mode):
            raise Rejected("not a regular file")
        if before.st_uid != os.getuid():
            raise Rejected("owned by another user")
        if before.st_nlink > 1:
            raise Rejected(f"it has {before.st_nlink} hard links")
        if before.st_size > LIMIT:
            raise Rejected(f"{before.st_size} bytes, over the 1 MiB limit")
        chunks, total = [], 0
        while total <= LIMIT:
            chunk = os.read(fd, min(65536, LIMIT + 1 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        if total > LIMIT:
            raise Rejected("it grew past the 1 MiB limit while being read")
        after = os.fstat(fd)
        if (after.st_size, after.st_mtime_ns) != (before.st_size, before.st_mtime_ns):
            raise Changed()
        return b"".join(chunks).decode("utf-8", errors="replace"), before
    finally:
        os.close(fd)


def candidates(name, d, now):
    """NAME's deliverable entries, oldest first: settled mail and abandoned claims.

    Returns (entries, waiting, busy, dirs): entries are (sort key, entry, original, lstat);
    waiting counts mail still being written, busy counts claims a live reader holds, and
    dirs lists (entry, lstat) for directories with NAME's mail names, which are never moved.
    Only names in the standard form are NAME's mail.
    """
    found, waiting, busy, dirs = [], 0, 0, []
    try:
        entries = os.listdir(d)
    except (FileNotFoundError, NotADirectoryError):
        raise MailError("mailbox_missing", f"mailbox {d} does not exist") from None
    for entry in entries:
        claim = parse_claim(name, entry)
        if claim:
            pid, tag, original = claim
        elif entry.startswith("."):
            continue
        else:
            original = entry
        msg = parse_msg(original)
        if msg is None or msg.to != name:
            continue
        try:
            st = os.lstat(os.path.join(d, entry))
        except FileNotFoundError:
            continue
        if stat.S_ISDIR(st.st_mode):
            dirs.append((entry, st))
            continue
        if claim:
            local = tag in (None, HOSTTAG)
            if local and pid == os.getpid():
                continue
            # A reader on this host can be checked by PID. One on another host that shares
            # this directory cannot, so its claim stands until it is CLAIM_STALE old.
            held = alive(pid) if local and pid is not None else True
            if held and now - st.st_ctime < CLAIM_STALE:
                busy += 1
                continue
        elif 0 <= now - st.st_ctime < SETTLE:
            waiting += 1
            continue
        found.append((sort_key(original, st), entry, original, st))
    found.sort()
    return found, waiting, busy, dirs


def poll(name, d, max_bytes=MAX_BYTES):
    """Claim and read NAME's mail, oldest first, up to about max_bytes.

    Returns a dict: deliveries [(original, hold, text, fstat)]; notices [str] for files
    moved aside; stuck [(key, str)] for files that could not be claimed; dirs [(key, str)]
    for directories left in place; waiting (still being written, or changed while read);
    busy (held by a live reader); more (ready but left for the next read).
    """
    now = clock()
    found, waiting, busy, dirs = candidates(name, d, now)
    out = {"deliveries": [], "notices": [], "stuck": [], "waiting": waiting, "busy": busy, "more": 0,
           "dirs": [(f"dir:{st.st_ino}:{entry}", f"--- agent-mail: {escape(entry)} is a directory; left in place") for entry, st in dirs]}
    size = 0
    for i, (_, entry, original, st) in enumerate(found):
        # Only a message that will be printed counts against the cap, and a big one only
        # as the part of it that is shown.
        cost = min(st.st_size, EXCERPT) if stat.S_ISREG(st.st_mode) and st.st_size <= LIMIT else 0
        if out["deliveries"] and cost and size + cost > max_bytes:
            out["more"] = len(found) - i
            break
        path = os.path.join(d, entry)
        hold = os.path.join(d, claim_name(name, original))
        shown = os.path.join(d, escape(entry))
        if too_long(os.path.basename(hold)):
            out["stuck"].append((f"{st.st_ino}:{entry}:name", f"agent-mail: cannot claim {escape(entry)}: its name is too long; it is still at {shown}"))
            continue
        try:
            os.rename(path, hold)
        except FileNotFoundError:
            continue
        except OSError as e:
            out["stuck"].append((f"{st.st_ino}:{entry}:{e.errno}", f"agent-mail: cannot claim {escape(entry)} ({e.strerror}); it is still at {shown}"))
            continue
        try:
            text, fst = read_file(hold)
        except FileNotFoundError:
            continue
        except Changed:
            back = os.path.join(d, original)
            if not os.path.lexists(back):
                os.rename(hold, back)
            out["waiting"] += 1
            continue
        except Exception as e:
            rejected = os.path.join(d, f".{name}-rejected-{original}")
            if os.path.lexists(rejected):
                rejected = f"{rejected}.{secrets.token_hex(3)}"
            try:
                os.rename(hold, rejected)
                where = rejected
            except OSError:
                where = hold if os.path.lexists(hold) else path
            out["notices"].append(f"--- agent-mail: {escape(original)} was not read: {e}; it is now {os.path.join(d, escape(os.path.basename(where)))}")
            continue
        out["deliveries"].append((original, hold, text, fst))
        size += min(fst.st_size, EXCERPT)
    return out


def archive_dir(d, name):
    return os.path.join(d, f".{name}-read")


def prune(d, name, now):
    a = archive_dir(d, name)
    try:
        entries = os.listdir(a)
    except FileNotFoundError:
        return
    for entry in entries:
        p = os.path.join(a, entry)
        try:
            if now - os.lstat(p).st_ctime > KEEP_DAYS * 86400:
                os.unlink(p)
        except OSError:
            pass


def render(name, d, result, max_bytes):
    """The text one delivery prints: a list first, then each message, then notices."""
    deliveries = result["deliveries"]
    a = archive_dir(d, name)
    token = secrets.token_hex(4)
    lines = []
    if deliveries:
        head = f"agent-mail [{token}]: {len(deliveries)} message(s) for {name}: " + ", ".join(o for o, *_ in deliveries)
        if result["more"]:
            head += f"; {result['more']} more waiting, so run read again"
        lines.append(head)
    for original, _, text, fst in deliveries:
        copy = os.path.join(a, original)
        body = sanitize(text).rstrip()
        if len(body.encode("utf-8")) > max_bytes:
            cut = body.encode("utf-8")[:EXCERPT].decode("utf-8", errors="ignore")
            body = f"{cut}\n[... {fst.st_size} bytes in all; the whole message is at {copy}]"
        lines.append(
            f"=== agent-mail [{token}]: message for {name}: {original} ({fst.st_size} bytes, written {utc(fst.st_mtime)}; copy kept at {copy}) ===\n"
            f"{body}\n=== agent-mail [{token}]: end of {original} ==="
        )
    lines.extend(result["notices"])
    if deliveries and result["more"]:
        lines.append(f"agent-mail: {result['more']} more message(s) for {name} waiting; run read again")
    return "\n\n".join(lines)


def deliver(d, name, result, max_bytes, write):
    """Write a batch through write(text), then archive what was written.

    When write raises OSError, every claim goes back and MailError("output_failed") follows.
    """
    text = render(name, d, result, max_bytes)
    try:
        if text:
            write(text + "\n")
    except OSError:
        for original, hold, *_ in result["deliveries"]:
            back = os.path.join(d, original)
            try:
                if not os.path.lexists(back):
                    os.rename(hold, back)
            except OSError:
                pass
        raise MailError("output_failed", f"the output failed, so {len(result['deliveries'])} message(s) for {name} were put back") from None
    a = archive_dir(d, name)
    if result["deliveries"]:
        os.makedirs(a, mode=0o700, exist_ok=True)
    for original, hold, *_ in result["deliveries"]:
        dest = os.path.join(a, original)
        if os.path.lexists(dest):
            dest = f"{dest}.{secrets.token_hex(3)}"
        try:
            os.rename(hold, dest)
        except FileNotFoundError:
            pass


def remember_stuck(d, name, stuck):
    """Return the stuck notices not reported before by any reader, and remember them."""
    path = state_path(d, name, "stuck")
    seen = set(load_json(path) or [])
    fresh = [(k, msg) for k, msg in stuck if k not in seen]
    if fresh:
        save_json(path, sorted(seen | {k for k, _ in fresh})[-200:])
    return fresh


def stdout_write(text):
    if sys.stdout is None:  # descriptor 1 was closed when Python started
        raise OSError(errno.EBADF, "standard output is closed")
    sys.stdout.write(text)
    sys.stdout.flush()


def emit(write, text):
    """Write front-end text after any claims are settled; a failure is output_failed."""
    try:
        (write or stdout_write)(text)
    except OSError:
        raise MailError("output_failed", "the output failed") from None


def cmd_read(name, d, max_bytes, write=None):
    write = write or stdout_write
    if not os.path.isdir(d):
        raise MailError("mailbox_missing", f"mailbox {d} does not exist")
    touch_presence(d, name)
    prune(d, name, clock())
    result = poll(name, d, max_bytes)
    if not (result["deliveries"] or result["notices"]) and result["waiting"]:
        time.sleep(SETTLE + 0.2)
        result = poll(name, d, max_bytes)
    deliver(d, name, result, max_bytes, write)
    lines = []
    if not (result["deliveries"] or result["notices"]):
        if result["waiting"]:
            lines.append(f"agent-mail: nothing ready for {name} yet: {result['waiting']} message(s) still being written; read again shortly")
        elif result["busy"]:
            lines.append(f"agent-mail: nothing ready for {name}: {result['busy']} message(s) are being read by another reader of {name}")
        elif not result["stuck"]:
            lines.append(f"agent-mail: no mail for {name}")
    lines.extend(msg for _, msg in remember_stuck(d, name, result["dirs"]))
    remember_stuck(d, name, result["stuck"])
    lines.extend(msg for _, msg in result["stuck"])
    if lines:
        emit(write, "\n".join(lines) + "\n")
    return EXIT_STATUS["stuck"] if result["stuck"] else 0


def cmd_watch(name, d, interval, forever, max_bytes, max_polls=None, parent=None, write=None):
    write = write or stdout_write
    polls = 0
    while True:
        if parent is not None and not alive(parent):
            emit(write, f"agent-mail: process {parent}, which started the watcher for {name}, has gone; the watcher has stopped without reading\n")
            return 1
        if not os.path.isdir(d):
            emit(write, f"agent-mail: mailbox {d} is missing; the watcher for {name} has stopped\n")
            return 1
        touch_presence(d, name)
        prune(d, name, clock())
        result = poll(name, d, max_bytes)
        fresh = remember_stuck(d, name, result["dirs"]) + remember_stuck(d, name, result["stuck"])
        if result["deliveries"] or result["notices"] or fresh:
            deliver(d, name, result, max_bytes, write)
            for _, msg in fresh:
                emit(write, msg + "\n")
            if not forever:
                emit(write, f"agent-mail: the watcher for {name} has exited after this delivery; start it again\n")
                return 0
        polls += 1
        if max_polls is not None and polls >= max_polls:
            return None
        time.sleep(interval)


def cmd_pending(name, d, write=None):
    touch_presence(d, name)
    now = clock()
    found, _, _, _ = candidates(name, d, now)
    ident = [f"{e}:{st.st_ino}:{st.st_mtime_ns}:{st.st_ctime_ns}" for _, e, _, st in found]
    digest = hashlib.sha256("\n".join(sorted(ident)).encode()).hexdigest()[:12] if ident else None
    path = state_path(d, name, "pending")
    state = load_json(path)
    if state is None:
        try:
            with open(state_path(d, name, "last"), encoding="utf-8") as f:
                line = f.read().rstrip()
        except FileNotFoundError:
            line = ""
        state = {"line": line, "digest": None, "announced": 0, "changed": 0, "reminders": 0}
    if digest and digest != state["digest"]:
        names = ", ".join(original for _, _, original, _ in found)
        state.update(digest=digest, announced=now, changed=now, reminders=0,
                     line=f"agent-mail: mail for {name} announced {utc(now)} [{digest}]: {names}")
        save_json(path, state)
    elif digest and now - state["announced"] > REMIND_AFTER and now - state["changed"] > REMIND_EVERY:
        state["reminders"] += 1
        state["changed"] = now
        state["line"] = re.sub(r" \(still unread; reminder \d+\)$", "", state["line"]) + f" (still unread; reminder {state['reminders']})"
        save_json(path, state)
    if state["line"]:
        emit(write, state["line"] + "\n")
    return 0


def clean_line(text):
    return " ".join("".join(" " if unicodedata.category(ch)[0] == "C" else ch for ch in text).split())


def cmd_send(sender, to, subject, ident, src, d, write=None):
    if not os.path.isdir(d):
        raise MailError("mailbox_missing", f"mailbox {d} does not exist")
    if ident is not None and not IDENT.fullmatch(ident):
        raise MailError("bad_argument", f"invalid --id {ident!r}")
    try:
        if src in (None, "-"):
            body = sys.stdin.read()
        else:
            with open(src, encoding="utf-8") as f:
                body = f.read()
    except (OSError, UnicodeDecodeError) as e:
        raise MailError("unreadable_body", f"cannot read the message body: {e}") from None
    stamp = utc(micro=True)
    final = os.path.join(d, f"{to}_{stamp}_from-{sender}_{secrets.token_hex(4)}.txt")
    host = socket.gethostname().split(".")[0].lower()
    header = f"From: {sender}@{host}" + (f" (agent-deck {ident})" if ident else "") + f"\nTo: {to}\nUTC: {stamp}\n"
    if not subject or not clean_line(subject):
        raise MailError("no_subject", "a message needs a --subject")
    header += f"Subject: {clean_line(subject)}\n"
    data = f"{header}\n{body.rstrip()}\n".encode("utf-8")
    if len(data) > LIMIT:
        raise MailError("too_large", f"the message is {len(data)} bytes, over the 1 MiB limit; send a file path instead")
    tmp = os.path.join(d, "." + os.path.basename(final) + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
        if os.path.lexists(final):
            raise MailError("exists", f"{final} already exists")
        os.rename(tmp, final)
    except BaseException:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
        raise
    emit(write, f"{final}\n")
    try:
        age = clock() - os.stat(presence_path(d, to)).st_mtime
        if age > PRESENCE_STALE:
            print(f"agent-mail: warning: {to}'s mail was last checked {int(age // 60)} minutes ago; the message waits until it is read", file=sys.stderr)
    except FileNotFoundError:
        print(f"agent-mail: warning: no reader has checked {to}'s mail yet; the message waits until one does", file=sys.stderr)
    return 0


def main(argv):
    p = argparse.ArgumentParser(prog="agent-mail", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--dir", default=None, help="mailbox directory (default $AGENT_MAIL_DIR or ~/Mailbox)")
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("send")
    s.add_argument("--from", dest="sender", required=True)
    s.add_argument("--to", required=True)
    s.add_argument("--subject", required=True)
    s.add_argument("--id")
    s.add_argument("file", nargs="?")
    r = sub.add_parser("read")
    r.add_argument("name")
    r.add_argument("--max-bytes", type=int, default=MAX_BYTES)
    sub.add_parser("pending").add_argument("name")
    w = sub.add_parser("watch")
    w.add_argument("name")
    w.add_argument("--interval", type=float, default=15.0)
    w.add_argument("--forever", action="store_true")
    w.add_argument("--max-bytes", type=int, default=MAX_BYTES)
    w.add_argument("--parent", type=int, help="stop when this process (the session that started the watcher) is gone")
    sub.add_parser("self-test").add_argument("sections", nargs="*", metavar="SECTION")
    sub.add_parser("init")
    a = p.parse_args(argv)
    os.umask(0o077)
    try:
        return dispatch(a)
    except MailError as e:
        if e.code == "output_failed" and sys.stdout is sys.__stdout__:
            # Nothing more can reach a broken stdout; keep the exit-time flush quiet.
            with contextlib.suppress(OSError):
                sys.stdout = open(os.devnull, "w")
        with contextlib.suppress(OSError):
            print(f"agent-mail: {e.message}", file=sys.stderr, flush=True)
        return EXIT_STATUS.get(e.code, 1)


def dispatch(a):
    if a.cmd == "self-test":
        return self_test(a.sections)
    d = a.dir or default_dir()
    if a.cmd == "init":
        return cmd_init(d)
    require_mailbox(d)
    if a.cmd == "send":
        return cmd_send(check_name(a.sender), check_name(a.to), a.subject, a.id, a.file, d)
    name = check_name(a.name)
    if a.cmd == "read":
        return cmd_read(name, d, max(1000, a.max_bytes))
    if a.cmd == "pending":
        return cmd_pending(name, d)
    return cmd_watch(name, d, max(1.0, a.interval), a.forever, max(1000, a.max_bytes), parent=a.parent)


# ---- self-test ----

class TestFailed(Exception):
    pass


class T:
    """One self-test section: its checks, captures, fixtures and the injected clock."""

    def __init__(self, root):
        self.root = root
        self.checks = 0
        self._saved = {}

    def ok(self, cond, what):
        if not cond:
            raise TestFailed(what)
        self.checks += 1

    def raises(self, fn, *a, **k):
        """The MailError fn raises, or None when it returns."""
        try:
            fn(*a, **k)
        except MailError as e:
            return e
        return None

    def capture(self, fn, *a, **k):
        """(stdout, status, stderr) of fn, with a MailError shown as main shows it."""
        out, err = io.StringIO(), io.StringIO()
        code = None
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            try:
                code = fn(*a, **k)
            except SystemExit as e:
                code = e.code
            except MailError as e:
                print(f"agent-mail: {e.message}", file=sys.stderr)
                code = EXIT_STATUS.get(e.code, 1)
        return out.getvalue(), code, err.getvalue()

    def run(self, argv):
        return self.capture(main, argv)

    def box(self, name="box"):
        """A fresh mailbox holding the marker."""
        d = os.path.join(self.root, name)
        os.mkdir(d, 0o700)
        os.close(os.open(os.path.join(d, MARKER_V2), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600))
        return d

    def mk(self, path, text):
        with open(path, "wb" if isinstance(text, bytes) else "w") as f:
            f.write(text)
        return path

    def direct(self, d, to, sender, body, stamp=None):
        """Write a grammar-valid message as a peer would: a hidden file, then a rename."""
        when = utc(clock() if stamp is None else stamp, micro=True)
        name = f"{to}_{when}_from-{sender}_{secrets.token_hex(4)}.txt"
        tmp = self.mk(os.path.join(d, f".{name}.tmp"), f"From: {sender}@{HOST}\nTo: {to}\nUTC: {when}\nSubject: test\nX-Agent-Mail: 2\n\n{body}\n")
        os.rename(tmp, os.path.join(d, name))
        return os.path.join(d, name)

    def at(self, epoch):
        """Set the injected clock; None returns to the real one."""
        global _CLOCK
        _CLOCK = epoch

    def patch(self, name, value):
        """Set a module constant until the section ends."""
        self._saved.setdefault(name, globals()[name])
        globals()[name] = value

    def restore(self):
        global _CLOCK
        _CLOCK = None
        for name, value in self._saved.items():
            globals()[name] = value
        self._saved.clear()


def section_core(t):
