MSG_RE = re.compile(rf"(?P<to>{NAME_PAT})_(?P<utc>[0-9]{{8}}T[0-9]{{6}}\.[0-9]{{6}}Z)_from-(?P<from>{NAME_PAT})_(?P<uniq>[0-9a-f]{{8}})\.txt")
RESERVED = frozenset({"all", "everyone", "john", "johnw", "jwiegley", "user", "human", "operator", "owner", "admin",
