    t.patch("write_new", gated)
    twins = [threading.Thread(target=twin, daemon=True) for _ in range(2)]
    try:
        twins[0].start()
        until = time.monotonic() + 10
        while not entered and time.monotonic() < until:  # the first is writing, inside its window
            time.sleep(0.01)
        twins[1].start()
        until = time.monotonic() + 0.5
        while len(entered) < 2 and time.monotonic() < until:  # without the flock the second gets this far too
