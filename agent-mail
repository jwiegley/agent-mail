    t.ok(os.path.exists(old_in_unsubscribed), "a reader does not prune a channel it does not subscribe to")

    archive = archive_dir(d, "a")
    copy_8_days = t.mk(os.path.join(archive, "old-copy.txt"), "old\n")
    prune_archive(d, "a", os.stat(copy_8_days).st_ctime + 8 * 86400)
    copy_6_days = t.mk(os.path.join(archive, "young-copy.txt"), "young\n")
    prune_archive(d, "a", os.stat(copy_6_days).st_ctime + 6 * 86400)
    t.ok(not os.path.exists(copy_8_days) and os.path.exists(copy_6_days), "archive copies older than 7 days go and younger ones stay")
    edge = clock()
    young_post = t.post(d, "fleet", "nix", "DAYS-29.75", stamp=edge - 29.75 * 86400)
    old_post = t.post(d, "fleet", "nix", "DAYS-30.25", stamp=edge - 30.25 * 86400)
    prune_posts(d, "a", st, effective_subs(st, s, edge), edge)
    t.ok(os.path.exists(young_post) and not os.path.exists(old_post), "a post is pruned between 29.75 and 30.25 days after its stamp")
    copy_edge = t.mk(os.path.join(archive, "edge-copy.txt"), "edge\n")
    made = os.stat(copy_edge).st_ctime
    prune_archive(d, "a", made + 6.75 * 86400)
    stayed = os.path.exists(copy_edge)
    prune_archive(d, "a", made + 7.25 * 86400)
    t.ok(stayed and not os.path.exists(copy_edge), "an archive copy is pruned between 6.75 and 7.25 days after its ctime")

    old_broadcast = t.direct(d, "all", "nix", "OLD-BROADCAST", stamp=clock() - 40 * 86400)
    t.run(["--dir", d, "pending", "a"])
    t.ok(os.path.exists(old_broadcast), "pending prunes nothing")

    outside = os.path.join(t.root, "outside")
    os.mkdir(outside, 0o700)
    victim = t.post(d, "fleet", "nix", "EXPIRED", stamp=clock() - 40 * 86400)
    outside_file = t.mk(os.path.join(outside, os.path.basename(victim)), "must survive\n")
    real_listdir = os.listdir

    def swapping(target):
        entries = real_listdir(target)
        if os.path.basename(victim) in entries and not os.path.islink(os.path.join(d, "+fleet")):
            os.rename(os.path.join(d, "+fleet"), os.path.join(t.root, "fleet-moved"))
            os.symlink(outside, os.path.join(d, "+fleet"))
        return entries

    os.listdir = swapping
    try:
        prune_posts(d, "a", load_state(d, "a"), effective_subs(load_state(d, "a"), s, clock()), clock())
    finally:
        os.listdir = real_listdir
    t.ok(os.path.exists(outside_file), "a channel swapped for a symlink between listing and unlink loses nothing outside")

    # Direct mail that no reader claims goes retention.direct_days (14 by default) after its
    # stamp. Every reader prunes it at the top level, for every name but its own.
    def logged():
        try:
            with open(os.path.join(os.path.expanduser(STATE_DIR), "log"), encoding="utf-8") as f:
                return f.read()
        except FileNotFoundError:
            return ""

    now = time.time()
    t.at(now)
    db = t.box("direct")
    short = t.direct(db, "gone", "nix", "AN-HOUR-SHORT", stamp=now - 14 * 86400 + 3600)
    past = t.direct(db, "gone", "nix", "AN-HOUR-PAST", stamp=now - 14 * 86400 - 3600)
    receive(db, "c", s, sink)
    t.ok(os.path.exists(short) and not os.path.exists(past),
         "a reader prunes another name's direct mail an hour past 14 days after its stamp, and keeps it an hour short")
    t.ok(f"reader c: pruned {os.path.basename(past)}: direct mail still unclaimed 14 days after its stamp" in logged()
         and os.path.basename(short) not in logged(), "each removal is logged to the reader's log")
    three = t.mk(os.path.join(t.root, "three-days.json"), json.dumps({"retention": {"direct_days": 3}}))
    s3 = load_settings({}, {"AGENT_MAIL_CONFIG": three}, "c")
    d3 = t.box("direct-3")
    short3 = t.direct(d3, "gone", "nix", "THREE-DAYS-SHORT", stamp=now - 3 * 86400 + 3600)
    past3 = t.direct(d3, "gone", "nix", "THREE-DAYS-PAST", stamp=now - 3 * 86400 - 3600)
    receive(d3, "c", s3, sink)
    t.ok(s3.direct_days == 3 and os.path.exists(short3) and not os.path.exists(past3),
         "a retention.direct_days of 3 prunes direct mail an hour past 3 days and keeps it an hour short")

    u = t.box("untouched")
    create_channel(u, "fleet", "fleet-wide notices")
    old = now - 20 * 86400  # past the 14 days of direct mail, within the 30 of posts and broadcasts
    stamp = utc(old, micro=True)
    control = t.direct(u, "gone", "nix", "CONTROL", stamp=old)
    target = t.mk(os.path.join(t.root, "link-target.txt"), "kept\n")
    link = os.path.join(u, f"gone_{stamp}_from-nix_0000000a.txt")
    os.symlink(target, link)
    foreign = t.direct(u, "gone", "nix", "FOREIGN", stamp=old)
    hidden = [t.mk(os.path.join(u, f".gone-claimed-1-{HOSTTAG}-gone_{stamp}_from-nix_0000000b.txt"), "claimed\n"),
              t.mk(os.path.join(u, f".gone-rejected-gone_{stamp}_from-nix_0000000c.txt"), "rejected\n"),
              t.mk(os.path.join(u, f".gone_{stamp}_from-nix_0000000d.txt.tmp"), "half-written\n")]
    folder = os.path.join(u, f"gone_{stamp}_from-nix_0000000e.txt")
    os.mkdir(folder)
    post = t.post(u, "fleet", "nix", "TWENTY-DAY-POST", stamp=old)
    broadcast = t.direct(u, "all", "nix", "TWENTY-DAY-BROADCAST", stamp=old)
    os.mkdir(archive_dir(u, "gone"), 0o700)
    copy = t.mk(os.path.join(archive_dir(u, "gone"), f"gone_{stamp}_from-nix_0000000f.txt"), "an archive copy\n")
    own = t.direct(u, "c", "nix", "OWN-TWENTY-DAY-MAIL", stamp=old)
    real_stat = os.stat

    def foreign_stat(path, *a, **k):
        """os.stat, except that FOREIGN looks owned by another user."""
        st = real_stat(path, *a, **k)
        if path != os.path.basename(foreign):
            return st
        fields = list(st)
        fields[stat.ST_UID] = st.st_uid + 1
        return os.stat_result(fields)

    # The pass runs once every file in the box has settled. The clock frozen above, before
    # these files existed, is not enough where file times are coarse: ext4 under Linux 5.15
    # stamps a new file up to a tick before a clock read just before it, so the reader would
    # wait for its own mail to settle under a clock that never moves.
    t.at(max(os.lstat(os.path.join(folder, n)).st_ctime for folder, dirs, files in os.walk(u) for n in dirs + files) + SETTLE + 1)
    os.stat = foreign_stat
    try:
        out = receive(u, "c", s, sink)
    finally:
        os.stat = real_stat
    t.at(now)
    t.ok(not os.path.exists(control), "the pass prunes a regular file of ours past the window beside the others")
    t.ok(os.path.islink(link) and os.path.exists(target), "a symlink with a mail name is untouched, and so is its target")
    t.ok(os.path.exists(foreign), "direct mail owned by another user is untouched")
    t.ok(all(map(os.path.exists, hidden)), "a claim, a rejected file and a temporary file are untouched")
    t.ok(os.path.isdir(folder), "a directory with a mail name is untouched")
    t.ok(os.path.exists(post) and os.path.exists(broadcast), "a post and a broadcast past 14 days are untouched by the rule")
    t.ok(os.path.exists(copy), "an archive copy is untouched")
    t.ok("OWN-TWENTY-DAY-MAIL" in out and not os.path.exists(own), "a reader leaves its own direct mail to its claim, which delivers it")

    fut = t.direct(u, "gone", "nix", "STAMPED-A-MONTH-AHEAD", stamp=now + 30 * 86400)
    arrived = os.stat(fut).st_ctime
    prune_direct(u, "c", 14, arrived + 14 * 86400 - 3600)
    kept = os.path.exists(fut)
    prune_direct(u, "c", 14, arrived + 14 * 86400 + 3600)
    t.ok(kept and not os.path.exists(fut), "direct mail stamped more than 24 hours ahead goes 14 days after it arrived, and not before")
    stuck = t.direct(u, "gone", "nix", "CANNOT-BE-REMOVED", stamp=old)
    os.chmod(u, 0o500)
    try:
        removed = prune_direct(u, "c", 14, now)
    except OSError as e:
        removed = e
    finally:
        os.chmod(u, 0o700)
    t.ok(removed == 0 and os.path.exists(stuck) and os.path.basename(stuck) not in logged(),
         "a removal that fails with an OSError is skipped quietly, with no log line")
    ahead = t.box("ahead")
    aged = t.direct(ahead, "gone", "nix", "AHEAD-WITH-AN-OLD-MTIME", stamp=now + 30 * 86400)
    os.utime(aged, (now - 30 * 86400, now - 30 * 86400))
    prune_direct(ahead, "c", 14, now)
    t.ok(os.path.exists(aged), "a stamp over 24 hours ahead is judged by the file's ctime, which no sender can backdate, not by its mtime")
    real = t.box("real-box")
    linked = os.path.join(t.root, "linked-box")  # ~/Mailbox is such a symlink on the Positron hosts
    os.symlink(real, linked)
    create_channel(linked, "fleet", "fleet-wide notices")
    st_linked = load_state(linked, "c")
    subscribe(linked, "c", st_linked, s, "fleet", now=now)
    save_state(linked, "c", st_linked)
    through = [t.direct(linked, "gone", "nix", "DIRECT-THROUGH-A-LINK", stamp=old),
               t.direct(linked, "all", "nix", "BROADCAST-THROUGH-A-LINK", stamp=now - 40 * 86400),
               t.post(linked, "fleet", "nix", "POST-THROUGH-A-LINK", stamp=now - 40 * 86400)]
    receive(linked, "c", s, sink)
    t.ok(not any(map(os.path.exists, through)), "a reader prunes direct mail, broadcasts and posts through a mailbox that is a symlink")

    swap = t.box("swap")
    lapsed = t.direct(swap, "gone", "nix", "EXPIRED-DIRECT", stamp=old)
    elsewhere = os.path.join(t.root, "elsewhere")
    os.mkdir(elsewhere, 0o700)
    survivor = t.mk(os.path.join(elsewhere, os.path.basename(lapsed)), "must survive\n")
    moved = os.path.join(t.root, "swap-moved")

    def swapping_box(target):
        entries = real_listdir(target)
        if os.path.basename(lapsed) in entries and not os.path.islink(swap):
            os.rename(swap, moved)
            os.symlink(elsewhere, swap)
        return entries

    os.listdir = swapping_box
    try:
        prune_direct(swap, "c", 14, now)
    finally:
        os.listdir = real_listdir
    t.ok(os.path.exists(survivor) and not os.path.exists(os.path.join(moved, os.path.basename(lapsed))),
         "a mailbox swapped for a symlink between listing and unlink loses nothing outside")
    traffic_retention_checks(t)


class FakeBackend:
    """Test only: a watch backend that records registrations and returns scripted events."""
    name = "fake"
    native = True
    unavailable = None

    def __init__(self, script):
        self.script = list(script)
        self.registered, self.history = [], []
        self.waits = 0
        self.armed_before_first_scan = False
        self.last_timeout = None

    def register(self, path):
        self.history.append(path)
        if path not in self.registered:
            self.registered.append(path)
        if self.waits == 0:
            self.armed_before_first_scan = True
        return path

    def unregister(self, handle):
        if handle in self.registered:
            self.registered.remove(handle)

    def registrations(self, path):
        return self.history.count(path)

    def queue(self, kind, handle=None):
        self.script.append((kind, handle))

    def wait(self, timeout):
        self.waits += 1
        self.last_timeout = timeout
        events, self.script = self.script, []
        return events

    def close(self):
        pass


def section_waiter(t):
    d = t.box()
    extra = []
    fb = FakeBackend([])
    w = Waiter(lambda: [d] + extra, 15, "auto", backend=fb)
    t.ok(fb.registered == [d] and fb.armed_before_first_scan, "the watch is armed before the first scan")
    fb.queue("event")
    t.ok(w.wait(None) == "event" and fb.last_timeout == 15, "an event queued after the scan ends the next wait at once")
    t.ok(w.wait(clock() + 1.0) == "timeout" and abs(fb.last_timeout - 1.2) < 0.05, "a settling file shortens the wait to its settle end plus 0.2 s")
    fb.queue("overflow")
    w.wait(None)
    t.ok(w.rescan_requested, "an overflow forces a full rescan")
    d2 = os.path.join(t.root, "second")
    os.mkdir(d2, 0o700)
    extra.append(d2)
    w.wait(None)
    os.rename(d2, d2 + ".old")
    os.mkdir(d2, 0o700)
    w.wait(None)
    t.ok(fb.registrations(d2) == 2, "a re-created directory is registered again")
    fleet = create_channel(d, "fleet", "fleet-wide notices")
    extra.append(fleet)
    w.wait(None)
    t.ok(fleet in fb.registered, "a new subscription is watched on the next pass")
    extra.remove(fleet)
    w.wait(None)
    t.ok(fleet not in fb.registered, "a dropped subscription is unwatched on the next pass")
    before = fb.registrations(d)
    fb.queue("rearm", d)
    w.wait(None)
    t.ok(w.rescan_requested and fb.registrations(d) == before + 1,
         "a rearm event registers its directory again even when the inode is unchanged, as after inode reuse")
    naps = []
    w_gap = Waiter(lambda: [d], 15, "auto", backend=FakeBackend([]), sleep=naps.append)
    w_gap.impl.queue("event")
    w_gap.wait(None)
    t.ok(len(naps) == 1 and 0 < naps[0] <= 0.5, "an event right after a scan waits out the 0.5 s minimum gap between scans")

    class CountingWaiter(Waiter):
        waits = []

        def wait(self, settle_until=None):
            CountingWaiter.waits.append(settle_until)
            return "timeout"

    real_waiter = Waiter
    t.patch("Waiter", CountingWaiter)
    try:
        out, code, _ = t.capture(cmd_watch, "pi", d, 0.2, False, MAX_BYTES, 3)
    finally:
        t.patch("Waiter", real_waiter)
    t.ok(code is None and out == "" and len(CountingWaiter.waits) == 2, "between passes the claiming watch waits on the Waiter, never a plain sleep")
    t.ok(Waiter(lambda: [d], 15, "off").backend == "poll", "notify off polls only")

    class NoBackend(PollBackend):
        native = False

    t.ok(getattr(t.raises(Waiter, lambda: [d], 15, "on", backend=NoBackend()), "code", None) == "no_native_watch", "notify on fails without a native backend")
    t.ok(Waiter(lambda: [d], 15, "auto", backend=InotifyBackend(fail_errno=errno.EMFILE)).backend.startswith("poll (inotify unavailable"),
         "an inotify failure falls back to polling and says so")
    # The Linux event parser, fed through a pipe so it runs on every platform.
    ib = InotifyBackend(fail_errno=errno.EMFILE)
    r, wfd = os.pipe()
    os.set_blocking(r, False)
    ib.fd, ib.poller = r, select.poll()
    ib.poller.register(r, select.POLLIN)
    os.write(wfd, struct.pack("iIII", 1, IN_CREATE, 0, 16) + b"x.txt".ljust(16, b"\0")
             + struct.pack("iIII", -1, IN_Q_OVERFLOW, 0, 0) + struct.pack("iIII", 2, IN_IGNORED, 0, 0))
    os.close(wfd)
    t.ok(ib.wait(1) == [("event", 1), ("overflow", None), ("rearm", 2)], "inotify events are read by their fixed headers, names skipped")
    ib.close()
    if probe_backend("auto") in ("kqueue", "inotify"):  # skipped where no native backend exists
        tmp = t.mk(os.path.join(d, ".x.tmp"), "x\n")
        w = Waiter(lambda: [d], 60, "on")
        try:
            os.rename(tmp, os.path.join(d, "x.txt"))
            t0 = time.monotonic()
            t.ok(w.wait(None) == "event" and time.monotonic() - t0 < 5, "a native backend sees a rename within 5 s while polling every 60 s")
        finally:
            w.close()
        moved = os.path.join(t.root, "moved")
        os.mkdir(moved, 0o700)
        w = Waiter(lambda: [moved], 60, "on")
        try:
            os.rename(moved, moved + ".gone")
            t.ok(w.wait(None) == "event" and w.rescan_requested and moved not in w.watched, "a watched directory renamed away re-arms and asks for a rescan")
        finally:
            w.close()


