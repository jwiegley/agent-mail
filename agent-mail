def subcommands(parser, prefix=""):
    """Every leaf subcommand of an argparse parser, "channel create" included."""
    names = set()
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            for name, sub in action.choices.items():
                names |= subcommands(sub, f"{prefix}{name} ") or {f"{prefix}{name}"}
    return names


def undocumented_options(parser, doc, prefix=""):
    """Options a leaf subcommand accepts, help not suppressed, that none of its usage lines
    in the docstring's Commands section names under any of its spellings: "watch --channel"."""
    section = doc.split("\nCommands:\n", 1)[1] if "\nCommands:\n" in doc else ""
    usage = collections.defaultdict(str)
    for m in re.finditer(r"^  ([a-z][a-z-]*(?: [a-z][a-z-]*)*)(.*)$", section, re.MULTILINE):
        usage[m.group(1)] += m.group(2) + "\n"
    missing = []
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            for name, sub in action.choices.items():
                command = f"{prefix}{name}"
                if subcommands(sub):
                    missing += undocumented_options(sub, doc, f"{command} ")
                    continue
                for option in sub._actions:
                    spellings = [s for s in option.option_strings if s.startswith("--") and s != "--help"]
                    if spellings and option.help != argparse.SUPPRESS and not any(
                            re.search(rf"{re.escape(s)}(?![a-z-])", usage[command]) for s in spellings):
                        missing.append(f"{command} {spellings[0]}")
    return missing


def undescribed(parser, prefix=""):
    """Subcommands that lack a help line in their parent or a description of their own."""
    missing = []
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            helps = {a.dest: a.help for a in action._choices_actions}
            for name, sub in action.choices.items():
                if not helps.get(name) or not sub.description:
                    missing.append(f"{prefix}{name}")
                missing += undescribed(sub, f"{prefix}{name} ")
    return missing


def documented_commands(doc):
    """The commands named at the start of the lines of the docstring's Commands section."""
    section = doc.split("\nCommands:\n", 1)[1] if "\nCommands:\n" in doc else ""
    return {m.group(1) for m in re.finditer(r"^  ([a-z][a-z-]*(?: [a-z][a-z-]*)*)", section, re.MULTILINE)}


