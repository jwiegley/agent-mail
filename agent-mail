def record_files(d):
    """The names in D's send log that are named as records, sorted; [] when it has no log directory."""
    where = os.path.join(d, TRAFFIC_DIR)
    return sorted(e for e in os.listdir(where) if record_name(e)) if os.path.isdir(where) else []


def record_bytes(d, ident):
    with open(os.path.join(d, TRAFFIC_DIR, f"{ident}.json"), "rb") as f:
        return f.read()


def record_text(fields):
    """A record's line as record_send writes it, from the dict FIELDS."""
    return json.dumps(fields, ensure_ascii=False, separators=(",", ":")) + "\n"


def planted(d, to, sender, stamp, subject="a subject", via="cli", in_reply_to=None, host=None, raw=None, change=None):
    """Write a record by hand into D's log, as a peer's host would have, through a hidden name and a rename: a valid
    one for a message from SENDER to TO (a name, +CHANNEL or all) stamped STAMP, with the dict CHANGE replacing its
    fields, or the bytes RAW under that record's name. Return its id."""
    stamp_text = utc(stamp, micro=True)
    ident = f"{to.lstrip('+')}_{stamp_text}_from-{sender}_{secrets.token_hex(4)}"
    fields = {"v": 1, "utc": stamp_text, "host": host or HOST, "from": sender, "to": to, "id": ident, "subject": subject,
              "in_reply_to": in_reply_to, "via": via}
    fields.update(change or {})
    data = raw if raw is not None else record_text(fields).encode("utf-8")
    path = os.path.join(d, TRAFFIC_DIR, f".{ident}.json.tmp")
    with open(path, "wb") as f:
        f.write(data)
    os.chmod(path, 0o600)
    os.rename(path, os.path.join(d, TRAFFIC_DIR, f"{ident}.json"))
    return ident


def traffic_json(t, d, *args):
    """(the JSON object traffic prints, its status, its stderr) for the mailbox D."""
    out, code, err = t.run(["--dir", d, "traffic", "--format", "json", *args])
    return json.loads(out), code, err


def every_file(root):
    """Each path under ROOT, no symlink followed, with its mode, its mtime and, for a regular file, its bytes."""
    seen = {}
    for folder, dirs, files in os.walk(root):
        for name in dirs + files:
            path = os.path.join(folder, name)
            st = os.lstat(path)
            data = None
            if stat.S_ISREG(st.st_mode):
                with open(path, "rb") as f:
                    data = f.read()
            elif stat.S_ISLNK(st.st_mode):
                data = os.readlink(path)
            seen[path] = (st.st_mode, st.st_mtime_ns, data)
    return seen


@contextlib.contextmanager
def os_opens():
    """Within the block, os.open, the built-in open and io.open each record the path they are given (a name
    relative to a dir_fd as it is, a descriptor as its number), then open it."""
    import builtins
    opened, real = [], (os.open, builtins.open, io.open)

    def watch(fn):
        def watching(path, *a, **k):
            opened.append(path if isinstance(path, int) else os.fspath(path))
            return fn(path, *a, **k)
        return watching

    os.open, builtins.open, io.open = (watch(fn) for fn in real)
    try:
        yield opened
    finally:
        os.open, builtins.open, io.open = real


