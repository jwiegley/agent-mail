    a = planted(d, "nix", "pi", T0 - 100)
    b = planted(d, "nix", "pi", T0 - 50)
    with os_opens() as opened:
        text, n = doctor(d, None, s)
        by_doctor = len(opened)
        record_bytes(d, a)  # a control: the watcher sees the built-in open as well as os.open
    t.ok(f"send log: on, 2 records, newest {b.split('_')[1]}" in text.splitlines() and n == base_n
         and not any(isinstance(p, str) and record_name(os.path.basename(p)) for p in opened[:by_doctor])
         and opened[by_doctor:] == [os.path.join(where, f"{a}.json")],
         "doctor reports the log on with its records and newest stamp, as information, from names and lstat, opening no record; "
         "with records present and nothing wrong, its findings are those of the same mailbox without them")
    os.unlink(os.path.join(where, TRAFFIC_MARKER))
    t.ok("send log: off, 2 records left for the prune" in doctor(d, None, s)[0].splitlines(), "doctor reports the log off with the records left for the prune")
    for e in record_files(d):
        os.unlink(os.path.join(where, e))
    t.ok("send log: off" in doctor(d, None, s)[0].splitlines(), "and the log off, with nothing left, as off")

    cases = []
    linked = t.box("traffic-doctor-link")
    os.makedirs(os.path.join(linked, ".agent-mail"), 0o700)
    os.symlink(where, os.path.join(linked, TRAFFIC_DIR))
    cases.append(("a symlinked log directory", linked, "is a symlink"))
    flat = t.box("traffic-doctor-file")
    os.makedirs(os.path.join(flat, ".agent-mail"), 0o700)
    t.mk(os.path.join(flat, TRAFFIC_DIR), "")
    cases.append(("a log directory that is a file", flat, "is not a directory"))
    odd_marker = t.box("traffic-doctor-marker")
    os.makedirs(os.path.join(odd_marker, TRAFFIC_DIR, TRAFFIC_MARKER), 0o700)
    cases.append(("a marker that is not a regular file", odd_marker, "the send log's marker, is not a regular file of yours"))
    for what, name, said in (("a name that is not a record", "notes.txt", "not named as a record"),
                             ("a hard-linked record", "link", "hard-linked, never a record"),
                             ("an oversized record", "big", "over 4096 bytes, never a record"),
                             ("a symlink named as a record", "symlink", "not a regular file of yours, never a record"),
                             ("a Syncthing conflict copy", "conflict", "Syncthing conflict copy, never a record"),
                             ("a temporary file more than an hour old", "tmp", "temporary file more than an hour old")):
        box = t.box(f"traffic-doctor-case-{name.replace('.', '-')}")
        here = log_on(box)
        if name == "notes.txt":
            t.mk(os.path.join(here, name), "")
        elif name == "link":
            os.link(os.path.join(here, f"{planted(box, 'nix', 'pi', T0)}.json"), os.path.join(t.root, f"second-name-{name}"))
