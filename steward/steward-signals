def checkout_with(d, label, name, old, new, count=1):
    """The path of a copy, made in D/LABEL, of this checkout's INSTRUCTION_FILES and README_FILES that exist, with the first COUNT occurrences of OLD in the file
    NAME, one of the INSTRUCTION_FILES or one of the README_FILES by its path in a checkout, replaced by NEW (every one when COUNT is -1), and the other files as
    they are: a checkout for docs_checks to run on. That OLD is there is the caller's to check."""
    root = os.path.join(d, label)
    os.makedirs(os.path.join(root, "steward"))
    for each in INSTRUCTION_FILES:
        path = os.path.join(REPO, "steward", each)
        if os.path.exists(path):
            write(os.path.join(root, "steward"), each, read(path).replace(old, new, count) if each == name else read(path))
    for each in README_FILES:
        path = os.path.join(REPO, each)
        if os.path.exists(path):
            write(root, each, read(path).replace(old, new, count) if each == name else read(path))
    return root


