    ok(restored and len(failures) == len(DOCS_CHECKS) and all(f"docs: {check.__name__} could not go on: FileNotFoundError" in failure for check, failure in zip(DOCS_CHECKS, failures)),
       "docs: in a checkout with no CLAUDE.md, each check function adds one failure that names it and the error, the next one still runs, and ok and REPO are put back")


# agent-mail's name grammar, which two files copy and nothing else ties together (the final review, M-4): agent-mail's own NAME_PAT and this file's NAME_RE,
# from which MSG_RE is built. (Until 2026-11-05 the scanner patch was a third copy, with agent-mail's bound on a post stamped ahead; John's scanner no longer
# reads the mailbox.) Each copy is read as text from a checkout, the line that defines it found by a pattern whose group is the copy, so that a check can plant
# a copy that drifts in a scratch checkout.
GRAMMAR_COPIES = (  # (the file, its path in a checkout, the line that defines its name pattern)
    ("agent-mail", "agent-mail", r'^NAME_PAT = r"(.*)"$'),
    ("steward-signals", os.path.join("steward", "steward-signals"), r'^NAME_RE = re\.compile\(r"(.*)"\)'))


def grammar_disagreements(checkout):
    """Why the copies of GRAMMAR_COPIES in the checkout CHECKOUT do not agree, one line for each reason, or [] when they agree: a copy whose defining line is
    missing or not alone in its file, and a name pattern that differs from agent-mail's. It reads the two files and nothing else, and what it says holds no
    question mark, since a pattern's are taken out."""
    copies, wrong = {}, []
    for what, path, line in GRAMMAR_COPIES:
        found = re.findall(line, read(os.path.join(checkout, path)), re.M)
        if len(found) != 1:
            wrong.append(f"{what} has {len(found)} lines that define its name pattern, not one")
        else:
            copies[what] = found[0]
    theirs = copies.get("agent-mail")
    for what, copy in copies.items():
        if what != "agent-mail" and theirs is not None and copy != theirs:
            wrong.append(without_question_marks(f"the name pattern of {what}, {copy}, is not agent-mail's, {theirs}"))
    return wrong


def test_the_name_grammar_agrees_in_its_two_copies(d):
    found = grammar_disagreements(REPO)
    ok(found == [], f"docs: agent-mail and this helper copy agent-mail's name grammar alike (got {without_question_marks(repr(found))})")
    _, path, line = GRAMMAR_COPIES[1]
    ok(re.findall(line, read(os.path.join(REPO, path)), re.M) == [NAME_RE.pattern], "docs: the copy that the grammar check reads in this helper's text is the NAME_RE it runs with")


def test_the_grammar_check_catches_each_copy_that_drifts(d):
    files = {path: read(os.path.join(REPO, path)) for _, path, _ in GRAMMAR_COPIES}
    helper, pattern = GRAMMAR_COPIES[1][1], NAME_RE.pattern
    regressions = (  # (what, the file, the text it changes, its replacement, how a reason that grammar_disagreements must give starts)
        ("agent-mail's pattern widened to underscores", "agent-mail", f'NAME_PAT = r"{pattern}"', 'NAME_PAT = r"[a-z0-9_](?:[a-z0-9._]|-(?!-))*"', "the name pattern of "),
        ("this helper's pattern allowing a double hyphen", helper, f'NAME_RE = re.compile(r"{pattern}")', 'NAME_RE = re.compile(r"[a-z0-9](?:[a-z0-9.-])*")',
         "the name pattern of steward-signals"),
        ("a second definition of agent-mail's pattern", "agent-mail", f'NAME_PAT = r"{pattern}"\n', f'NAME_PAT = r"{pattern}"\nNAME_PAT = r"[a-z]+"\n',
         "agent-mail has 2 lines that define its name pattern"))
    for i, (what, path, old, new, reason) in enumerate(regressions):
        root = os.path.join(d, f"grammar-{i}")
        for each, text in files.items():
            os.makedirs(os.path.join(root, os.path.dirname(each)), exist_ok=True)
            write(root, each, text.replace(old, new, 1) if each == path else text)
        found = grammar_disagreements(root)
        ok(old in files[path] and any(f.startswith(reason) for f in found), f"docs: the grammar check catches {what} (got {without_question_marks(repr(found))})")


