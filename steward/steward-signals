def test_one_call_per_host(d):
    members = [Member("pipeline", "andoria-08", "claude"), Member("omlx", "hera", "pi"), Member("glm-5.2", "andoria-08", "claude"), Member("lfm3", "delphi-3bd4", "claude")]
    run = fake_run({"list": "[]", "remote andoria-08": "[]", "remote delphi-3bd4": "[]"})
    deck_rows(run, members)
    expected = [["agent-deck", "list", "--json"],
                ["agent-deck", "remote", "sessions", "andoria-08", "--json", "--with-errors"],
                ["agent-deck", "remote", "sessions", "delphi-3bd4", "--json", "--with-errors"]]
    ok(sorted(run.calls) == sorted(expected), "deck: one call for each host, with the command lines that were run for real")
    run = fake_run({"list": '[{"title":"athena","status":"idle"}]'})
    ok(deck_rows(run, [Member("athena", "athena", "claude")], hera_host="athena")["athena"]["status"] == "idle" and run.calls == [["agent-deck", "list", "--json"]], "deck: hera_host names the host that agent-deck list answers for")
    run = fake_run({})
    ok(deck_rows(run, []) == {} and run.calls == [], "deck: no members, no calls")
    rows = deck_rows(run, [Member("omlx", "", "pi")])
    ok(run.calls == [] and rows["omlx"] == {**NO_FIELDS, "host_ok": False}, "deck: a member with no host is unknown without a call, since agent-deck answers an empty remote name for every remote")


def test_unreadable_answers_are_unknown(d):
    members = [Member("omlx", "hera", "pi"), Member("pipeline", "andoria-08", "claude")]
    listing = {"sessions": [{"title": "pipeline", "status": "waiting"}], "errors": []}
    answers = (("output that is not JSON", "agent-deck: no such remote"),
               ("no output", ""),
               ("a JSON null", "null"),
               ("a JSON number", "42"),
               ("an object with no sessions", '{"errors": []}'),
               ("a null sessions list", '{"sessions": null}'),
               ("JSON nested too deep to read", "[" * 1000000),
               ("errors in the listing", json.dumps({**listing, "errors": [{"remote": "andoria-08", "error": "timed out"}]})),
               ("a failed command that printed a listing", (json.dumps(listing), 1)))
    for what, answer in answers:
        rows = deck_rows(fake_run({"list": "[]", "remote andoria-08": answer}), members)
        ok(rows["pipeline"] == {**NO_FIELDS, "host_ok": False} and rows["omlx"]["host_ok"], f"deck: {what} marks the host unknown")
    rows = deck_rows(fake_run({"remote andoria-08": json.dumps(listing)}), members)  # nothing answers list, so it fails
    ok(rows["omlx"]["host_ok"] is False and rows["pipeline"]["host_ok"] and rows["pipeline"]["status"] == "waiting", "deck: a failed local listing marks hera's members unknown, and only them")


def test_listed_says_whether_the_listing_held_the_member(d):
    members = [Member("omlx", "hera", "pi"), Member("pi", "hera", "claude"), Member("pipeline", "andoria-08", "claude")]
    rows = deck_rows(fake_run({"list": json.dumps([{"title": "omlx"}, {"title": "pipeline", "status": "idle"}]), "remote andoria-08": ("", 1)}), members)
    ok(rows["omlx"]["listed"] is True and rows["omlx"]["status"] is None, "deck: a member whose title its host's listing holds is listed, though its row says nothing more")
    ok(rows["pi"]["listed"] is False and rows["pi"]["host_ok"] is True, "deck: a member its host's listing does not hold is not listed, and pi is not pipeline")
    ok(rows["pipeline"]["listed"] is None and rows["pipeline"]["host_ok"] is False, "deck: a member of a host that did not answer is neither listed nor unlisted, whatever another host lists")


def test_a_runner_that_fails_marks_its_hosts_unknown(d):
    members = [Member("omlx", "hera", "pi"), Member("pipeline", "andoria-08", "claude")]
    for error in (OSError("no such program"), subprocess.TimeoutExpired("agent-deck", 20), RuntimeError("boom"), KeyError("x")):
        rows = deck_rows(raising(error), members)
        ok(rows == {"omlx": {**NO_FIELDS, "host_ok": False}, "pipeline": {**NO_FIELDS, "host_ok": False}}, f"deck: a run that raises {type(error).__name__} marks every host unknown, not an error")

    def answers(value):
        return lambda argv: value

    for what, value in (("no pair", None), ("a pair with no text", (None, 0)), ("a pair with a number for text", (42, 0)), ("three values", ("[]", 0, 0)), ("a string", "abc")):
        ok(all(not row["host_ok"] for row in deck_rows(answers(value), members).values()), f"deck: a run that returns {what} marks every host unknown, not an error")


