            broken_size = os.path.getsize(os.path.join(broken, "steward", "CLAUDE.md"))
            text = re.sub(r"CLAUDE\.md is about [0-9]+ KB\.", f"CLAUDE.md is about {(broken_size + 512) // 1024} KB.", text, count=1)
