    os.remove(os.path.join(cdir, "TOPIC.md"))
    refused(["ingest"], cdir, box, "steward-signals: TOPIC.md in --dir: ")
    cdir, box = traffic_scene(d)
    write(cdir, "TOPIC.md", TOPIC_WITH_TABLE.replace("| omlx | hera | pi |", "| conductor-ingest-steward | hera | claude |"))
    refused(["ingest"], cdir, box, "steward-signals: TOPIC.md: conductor-ingest-steward: the steward itself is listed as a member")
    cdir, box = traffic_scene(d)
    write(cdir, "POLICY.md", read(os.path.join(REPO, "steward", "POLICY.md")).replace("| deaf_min | 15 |", "| deaf_min | soon |"))
    refused(["ingest"], cdir, box, "steward-signals: POLICY.md: deaf_min: ")
    cdir, box = traffic_scene(d)
    os.mkdir(os.path.join(cdir, TRAFFIC_LOG))
    refused(["ingest"], cdir, box, "steward-signals: TRAFFIC.log in --dir: ")
    cdir, box = traffic_scene(d, state=None)
    os.mkdir(os.path.join(cdir, STATE_FILE))
    refused(["ingest"], cdir, box, "steward-signals: steward-state.json in --dir: ")
    cdir, _ = traffic_scene(d)
    refused(["ingest"], cdir, os.path.join(d, "no-such-mailbox"), "steward-signals: traffic: the mailbox that --mailbox names is not a directory")
    refused(["ingest"], cdir, None, "steward-signals: traffic: the agent-mail config file is not a JSON object", env={"AGENT_MAIL_CONFIG": write(d, "config.json", "{")})
    refused(["ingest"], cdir, None, "steward-signals: traffic: dir in the agent-mail config file is not a directory path",
            env={"AGENT_MAIL_CONFIG": write(d, "config.json", '{"dir": ""}')})
    cdir, box = traffic_scene(d)
    with contextlib.ExitStack() as stack:
        real_scandir = os.scandir
        stack.callback(setattr, os, "scandir", real_scandir)

        def scandir_refused(path):
            raise PermissionError(errno.EACCES, os.strerror(errno.EACCES), path)

        os.scandir = scandir_refused
        refused(["ingest"], cdir, box, f"steward-signals: traffic: the mailbox cannot be read: {os.strerror(errno.EACCES)}")


