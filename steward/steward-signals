    box = mailbox(d, top=[f"pipeline_{stamp(1)}_from-glm-5.2_aaaaaaaa.txt", f"pi_{stamp(2)}_from-nix_bbbbbbbb.txt", ".pipeline-claimed-1-x-y.txt", "pipeline.md", *not_names],
                  channel=("ingest", [f"ingest_{stamp(3)}_from-glm-5.3-flash_cccccccc.txt"]))
    e = list_entries(box, "ingest")
    ok([x.name for x in e if x.dir == "top"] == [f"pipeline_{stamp(1)}_from-glm-5.2_aaaaaaaa.txt", f"pi_{stamp(2)}_from-nix_bbbbbbbb.txt"], "census: hidden and malformed names skipped")
    ok([(x.to, x.sender) for x in e] == [("pipeline", "glm-5.2"), ("pi", "nix"), ("ingest", "glm-5.3-flash")], "census: names with dots, digits and hyphens are read whole")
    c = census(e, members_named("pipeline", "glm-5.2", "glm-5.3-flash"), "conductor-ingest-steward", ([], set()), set(), set(), NOW)
    ok(c.unread["pipeline"][0] == 1 and "pi" not in c.unread, "census: pi's mail is not pipeline's")
    # A name that only extends another, or is the start of it, is another name, whichever way a prefix would be taken.
    e = entries_named(f"pipeline_{stamp(1)}_from-nix_00000001.txt",                      # to pipeline
                      f"pipelines_{stamp(2)}_from-nix_00000002.txt",                     # to pipelines, which is not pipeline
                      f"pipeline_{stamp(3)}_from-lfm3x_00000003.txt",                    # from lfm3x, which is not lfm3
                      f"pipeline_{stamp(4)}_from-lfm_00000004.txt",                      # nor is lfm
                      f"lfm3_{stamp(5)}_from-{STEWARD}-2_00000005.txt",                  # a sender that starts with the steward's name is not the steward
                      f"lfm3_{stamp(6)}_from-conductor-ingest_00000006.txt")             # nor is one that the steward's name starts with
    c = census(e, members_named("pipeline", "lfm3"), STEWARD, ([], set()), set(), set(), NOW)
    ok(c.unread == {"pipeline": (3, 7199.0), "lfm3": (2, 7195.0)}, "census: mail to pipelines is not pipeline's, and a name that only extends a member's is no member")
    ok(c.transit_without_note == 0, "census: a sender that extends a member's name (lfm3x), or is the start of it (lfm), is not that member")
    ok(c.unmatched_own == [], "census: a sender that extends the steward's name, or is the start of it, is not the steward")


