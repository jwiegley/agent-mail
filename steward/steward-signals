def test_background_work_kinds(d):
    def bg_of(**fields):
        return row_of(**fields)["bg"]

    for task in ("sleep 600", "Sleep 5", "tail -f x", "watch -n 5 ls", "sh -c 'make'", "bash -c 'make'"):
        ok(bg_of(background_work={"task": task}) == "shell", f"deck: background work {task!r} is shell work")
    ok(bg_of(background_work={"kind": "shell", "task": "build"}) == "shell", "deck: a kind that says shell is shell work")
    ok(bg_of(background_work={"kind": "workflow", "task": "landing"}) == "tool" and bg_of(background_work={"kind": "workflow"}) == "tool"
       and bg_of(background_work={"task": "landing"}) == "tool", "deck: any other background work is tool work")
    ok(bg_of() is None and bg_of(background_work=None) is None and bg_of(background_work={}) is None and bg_of(substate="idle-at-empty-prompt") is None, "deck: a row with no background work has bg None")
    for what, work in (("a string", "sleep 5"), ("a list", ["sleep"]), ("a table with no kind or task", {"step": 3})):
        ok(bg_of(background_work=work) == "unknown", f"deck: background work that is {what} is unknown")
    ok(bg_of(substate="watching", substate_detail="1 watching \u00b7 CI") == "shell", "deck: a watching substate reads its detail, and watching is shell work")
    ok(bg_of(substate="watching") == "unknown" and bg_of(substate="background-work") == "unknown", "deck: a background substate with nothing to read is unknown")
    ok(bg_of(substate="background-work", background_work={"kind": "workflow", "task": "landing"}) == "tool", "deck: background_work is read before the substate")


def test_last_activity_is_utc(d):
    def last_activity(stamp):
        return row_of(last_activity_at=stamp)["last_activity"]

    ok(last_activity("2026-10-31T22:32:31Z") == "2026-10-31T22:32:31Z", "deck: a UTC stamp is kept")
    ok(last_activity("2026-10-31T15:39:01.595015-07:00") == "2026-10-31T22:39:01Z", "deck: an offset stamp with a fraction is read as UTC to the second")
    for odd in ("2026-10-31T22:32:31", "yesterday", "", 5, None, "0001-01-01T00:00:00+05:00"):
        ok(last_activity(odd) is None, f"deck: {odd!r} is not a stamp with a zone")


