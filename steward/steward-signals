    def configured(value):
        write(d, "agent-mail.json", value if isinstance(value, str) else json.dumps(value))

    layers = {"dir": "~/top-box", "hosts": {host: {"dir": "~/host-box"}, "elsewhere": {"dir": "~/other-box"}},
              "sessions": {STEWARD: {"dir": "~/session-box"}, "pipeline": {"dir": "~/other-box"}}}
    try:
