def fake_run(mapping):
    """A run(argv) for deck_rows that answers from MAPPING instead of calling agent-deck, and keeps each argv it was
    given in run.calls. A key is the start of the command line after "agent-deck", with "remote sessions HOST" written
    "remote HOST": "list", "remote andoria-08", "session output lfm3". Its value is the stdout, or a (stdout, returncode)
    pair. The longest key that fits answers, and a command that fits none fails with no output."""
    def run(argv):
        run.calls.append(list(argv))
        words = argv[1:]
        if words[:2] == ["remote", "sessions"]:
            words = ["remote"] + words[2:]
        line = " ".join(words)
        fits = [key for key in mapping if line == key or line.startswith(key + " ")]
        answer = mapping[max(fits, key=len)] if fits else ("", 1)
        return (answer, 0) if isinstance(answer, str) else tuple(answer)

    run.calls = []
    return run


def row_for(*sessions):
    """The Row that deck_rows gives the hera member omlx when agent-deck lists a session titled omlx for each of SESSIONS
    (dicts of fields), in that order."""
    listing = json.dumps([{"title": "omlx", **session} for session in sessions])
    return deck_rows(fake_run({"list": listing}), [Member("omlx", "hera", "pi")])["omlx"]


def row_of(**fields):
    """The Row that deck_rows gives omlx when agent-deck lists one session with FIELDS."""
    return row_for(fields)


