       and bg_of(background_work={"task": "landing"}) == "tool", "deck: any other background work is tool work")
    ok(bg_of() is None and bg_of(background_work=None) is None and bg_of(background_work={}) is None and bg_of(substate="idle-at-empty-prompt") is None, "deck: a row with no background work has bg None")
    for what, work in (("a string", "sleep 5"), ("a list", ["sleep"]), ("a table with no kind or task", {"step": 3})):
