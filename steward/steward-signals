REPO = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))  # the directory that holds steward/
# The oldest Python main runs on, as the plan has it. An older one is refused, not trusted: before 3.11, datetime.fromisoformat cannot read the Z of
# agent-deck's stamps, so every last activity would silently be unknown. The file still compiles on 3.9, so that the refusal can be printed.
MIN_PYTHON = (3, 12)
POLICY_KEYS = (
    "stale_min", "idle_min", "question_min", "nudge_gap_min", "nudges_per_item_day", "busy_stuck_h", "deaf_min",
    "offer_items", "offer_every_h", "sends_per_turn", "sends_per_hour", "ledger_kb", "log_days", "back_after_min",
    "doorbell_delay_min", "tick_active_min", "tick_idle_min", "summary_local_time", "summary_tz",
)
NUMBER_RE = re.compile(r"[0-9]+(?:\.[0-9]+)?")
MAX_DIGITS = 12  # the most digits of a number in POLICY.md and of a whole number in a metrics --set: more is no policy and no counter, and 400 would read as inf where 4301 would make int() raise
WHOLE_RE = re.compile(r"[0-9]+")
COUNT_KEYS = ("nudges_per_item_day", "offer_items", "sends_per_turn", "sends_per_hour", "log_days", "ledger_kb")  # the keys whose value counts things, so a whole number
SHOWN_CHARS = 40  # how much of a value or key from POLICY.md, or a name from TOPIC.md, a message quotes: the steward reads the message, and thousands of characters would flood it
TIME_RE = re.compile(r"(?:[01][0-9]|2[0-3]):[0-5][0-9]")
NAME_RE = re.compile(r"[a-z0-9](?:[a-z0-9.]|-(?!-))*")  # agent-mail's NAME_PAT; see grammatical
HOST_RE = re.compile(r"[a-z0-9][a-z0-9.-]{0,63}")  # a host in TOPIC.md: never a hyphen first, so agent-deck never takes it for a flag, and at most 64 characters, as a name is
HERA = "hera"  # the host that agent-deck answers for when it is run without a remote: its list and its session output
BACKGROUND_SUBSTATES = ("background-work", "watching")  # the substates agent-deck gives a session whose pane shows background work
SHELL_WORDS = ("sleep", "watch", "sh -c", "bash -c", "tail", "shell")  # in a background task's text they mark a shell command
# A message file's name: agent-mail's MSG_RE, with groups for the recipient, the stamp and the sender, and none for the hex tail. The
# first character of a name is a letter or a digit, so no hidden name (a claimed file, a marker) matches.
MSG_RE = re.compile(rf"(?P<to>{NAME_RE.pattern})_(?P<stamp>[0-9]{{8}}T[0-9]{{6}}\.[0-9]{{6}}Z)_from-(?P<sender>{NAME_RE.pattern})_[0-9a-f]{{8}}\.txt")
STAMP_RE = re.compile(r"([0-9]{4})([0-9]{2})([0-9]{2})T([0-9]{2})([0-9]{2})([0-9]{2})(?:\.([0-9]{6}))?Z")  # a file name's stamp; SENT.log's has no fraction
INTENT_WINDOW_S = 10  # how near, in seconds, an intent line's time must be to a file's stamp for the intent to account for the file
ANSI_RE = re.compile(r"\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07\x1b]*(?:\x07|\x1b\\)|[@-_])")  # a CSI sequence, an OSC sequence (ended by BEL or ST), or another escape of two characters
CUT_FOOTER_RE = re.compile(r"\u2026 output truncated to [0-9]+ tokens; full output at .+")  # what agent-deck ends a response with when it cut it to --max-tokens
CUT_SEAM = "\u2026 output omitted \u2026"  # the line that agent-deck puts between the head and the tail of a response it cut to --max-tokens
PROBE_WORDS = {True: "yes", False: "no", None: "unknown"}  # what the probe command prints for each answer of probe, and nothing else


def without_question_marks(text):
    """TEXT with every question mark taken out. Nothing the steward prints may carry one, so each message that holds text a caller typed, or a path, goes
    through here."""
    return text.replace("?", "")


def clipped(text):
    """TEXT as a message names a key or a name from a file: its first SHOWN_CHARS characters, as they are, and three dots after them when it is longer,
    so that a cell of thousands of characters does not flood the message the steward reads."""
    return text[:SHOWN_CHARS] + ("..." if len(text) > SHOWN_CHARS else "")


# ---- policy ----

class PolicyError(Exception):
    """A POLICY.md the helper refuses. .key is the key of the row that is wrong, as the file has it, and .reason says how, quoting the first SHOWN_CHARS
    characters of the value as the file has it where the value is part of the reason (a number of too many digits is counted, not quoted). Both keep any
    question mark the file holds. The message, str(e), is the file, the key (cut as clipped cuts it) and the reason with every question mark taken out,
    because nothing the steward prints may carry one."""

    def __init__(self, key, reason):
        super().__init__(without_question_marks(f"steward-signals: POLICY.md: {clipped(key)}: {reason}"))
        self.key = key
        self.reason = reason


def table_rows(lines, width):
    """The first WIDTH cells, stripped, of each row of the Markdown tables in LINES: the lines that start with "|",
    less each separator row (only dashes and colons). A row with fewer cells is padded with empty ones, so a short
    row has no value."""
    for line in lines:
        if line.lstrip().startswith("|"):
            cells = ([cell.strip() for cell in line.strip().strip("|").split("|")] + [""] * width)[:width]
            if "".join(cells).strip("-: "):
                yield cells


def policy_rows(text):
    """(key, value) for each data row of the Markdown tables in TEXT: the rows table_rows reads, less each header
    row (the cells key and value, in any case). Any other row is a data row, so one that only looks like the
    header is refused later as an unknown key."""
    for key, value in table_rows(text.splitlines(), 2):
        if (key.casefold(), value.casefold()) != ("key", "value"):
            yield key, value


def shown(text):
    """TEXT as a message from POLICY.md quotes it: its first SHOWN_CHARS characters, as repr gives them, and three dots after them when it is longer."""
    return repr(text[:SHOWN_CHARS]) + ("..." if len(text) > SHOWN_CHARS else "")


def policy_value(key, text):
    """The value of one row: the time of day for summary_local_time, a tz database name for summary_tz, a whole number above zero for each of
    COUNT_KEYS, else a number above zero. A number is written in ASCII digits, at most MAX_DIGITS of them, those on both sides of the point counted."""
    if not text:
        raise PolicyError(key, "no value")
    if key == "summary_local_time":
        if TIME_RE.fullmatch(text) is None:
            raise PolicyError(key, f"expected a time of day such as 07:30, got {shown(text)}")
        return text
    if key == "summary_tz":
        try:
            zoneinfo.ZoneInfo(text)
        except (zoneinfo.ZoneInfoNotFoundError, ValueError, OSError):
            raise PolicyError(key, f"expected a tz database name such as America/Los_Angeles, got {shown(text)}") from None
        return text
    if key in COUNT_KEYS:
        pattern, wanted = WHOLE_RE, "a whole number above zero, such as 3"
    else:
        pattern, wanted = NUMBER_RE, "a number above zero, such as 45 or 0.5"
    if pattern.fullmatch(text) is None:
        raise PolicyError(key, f"expected {wanted}, got {shown(text)}")
    digits = len(text) - text.count(".")
    if digits > MAX_DIGITS:
        raise PolicyError(key, f"expected a number of at most {MAX_DIGITS} digits, got one of {digits}")
    if float(text) == 0:
        raise PolicyError(key, f"expected {wanted}, got {shown(text)}")
    return float(text) if "." in text else int(text)


def load_policy(path):
    """The thresholds and self-caps in the POLICY.md table at PATH, by key, in POLICY_KEYS order.
    Each key must have exactly one row: a missing, unknown or repeated key, or a value its key cannot use,
    raises PolicyError, so a typo is never replaced by a default."""
    with open(path, encoding="utf-8") as f:
        text = f.read()
    policy = {}
    for key, value in policy_rows(text):
        if key not in POLICY_KEYS:
            raise PolicyError(key, "unknown key")
        if key in policy:
            raise PolicyError(key, "listed twice")
        policy[key] = policy_value(key, value)
    for key in POLICY_KEYS:
        if key not in policy:
            raise PolicyError(key, "no row for this key")
    return {key: policy[key] for key in POLICY_KEYS}


# ---- roster ----

Member = collections.namedtuple("Member", "name host harness")


class RosterError(Exception):
    """A TOPIC.md the helper refuses. .name is the text that is wrong, as the file has it (a member's name, the
    heading that is missing, or Members for a table that is not the roster's) and .reason says how. The message
    names it as clipped cuts it and leaves out any question mark, because nothing the steward prints may carry one."""

    def __init__(self, name, reason="not a valid name"):
        super().__init__(without_question_marks(f"steward-signals: TOPIC.md: {clipped(name)}: {reason}"))
        self.name = name
        self.reason = reason


def grammatical(name):
    """Whether NAME follows agent-mail's name grammar. The names agent-mail reserves are not checked here."""
    return NAME_RE.fullmatch(name) is not None and len(name) <= 64 and not name.endswith("-")


def one_table(lines):
    """The lines of the one Markdown table in LINES, the lines under the Members heading: the run of lines that start with "|". A line that starts with "|"
    after the end of that run, past a blank line or any other line, raises RosterError: a roster broken by a blank line, or followed by a second table
    under the heading, would otherwise lose the members after the break without a word."""
    table, ended = [], False
    for line in lines:
        if not line.lstrip().startswith("|"):
            ended = bool(table)
        elif ended:
            raise RosterError("Members", "a row follows the end of the table; the roster is one unbroken table, with no blank line inside it and no second table under the heading")
        else:
            table.append(line)
    return table


def section_lines(text, heading):
    """The lines of TEXT under the Markdown heading HEADING (in any case), up to the next heading or the end of the
    file; None when TEXT has no such heading."""
    found, lines = False, []
    for line in text.splitlines():
        if line.lstrip().startswith("#"):
            if found:
                break
            found = line.strip().casefold() == heading.casefold()
        elif found:
            lines.append(line)
    return lines if found else None


def load_roster(path):
    """The members in the "## Members" table of the TOPIC.md at PATH, in table order, as Member(name, host, harness).
    The roster is the one table under the one such heading (see one_table); its first row is its header, name | host |
    harness in any case, so that no cell is read in the wrong place, and a row that repeats the header is skipped. A
    name that is not an agent-mail name or is listed twice, a member with no host or with a host that HOST_RE does not
    match, a table whose header is another (or no table at all), a row after the end of the table under the heading, a
    second such heading, and a file with no such heading raise RosterError, so the steward never watches a name it
    cannot mail or a member it cannot look up, agent-deck never takes a host for a flag, no member is dropped without a
    word, and a typo in the heading is never taken for a topic with no members."""
    with open(path, encoding="utf-8") as f:
        text = f.read()
    if sum(line.strip().casefold() == "## members" for line in text.splitlines()) > 1:
        raise RosterError("## Members", "the heading is given twice; the roster is one table under one heading")
    section = section_lines(text, "## Members")
    if section is None:
        raise RosterError("## Members", "no such heading")
    rows = [tuple(row) for row in table_rows(one_table(section), 3)]
    header = ("name", "host", "harness")
    if not rows or tuple(cell.casefold() for cell in rows[0]) != header:
        raise RosterError("Members", "the table's header must be name | host | harness")
    members = []
    for name, host, harness in rows[1:]:
        if (name.casefold(), host.casefold(), harness.casefold()) == header:
            continue
        if not grammatical(name):
            raise RosterError(name)
        if not host:
            raise RosterError(name, "empty host")
        if HOST_RE.fullmatch(host) is None:
            raise RosterError(name, "the host is not a host name: lower-case letters, digits, dots and hyphens, starting with a letter or a digit, at most 64 characters")
        if any(m.name == name for m in members):
            raise RosterError(name, "listed twice")
        members.append(Member(name, host, harness))
    return members


# ---- agent-deck ----

def text_of(value):
    """VALUE when it is a non-empty string, else None."""
    return value if isinstance(value, str) and value else None


def bool_of(value):
    """VALUE when it is a bool, else None."""
    return value if isinstance(value, bool) else None


def utc_of(value):
    """The ISO 8601 stamp VALUE as UTC to the second, YYYY-MM-DDTHH:MM:SSZ: agent-deck writes Z in some rows and an
    offset in others, and the steward would read the mixed zones as different times. None when VALUE is not a stamp
    with a zone."""
    try:
        when = datetime.datetime.fromisoformat(value)
        if when.tzinfo is None:
            return None
        return when.astimezone(datetime.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    except (TypeError, ValueError, OverflowError):
        return None


def background_kind(row):
    """What background work the agent-deck session ROW shows: "shell" (which agent-deck 1.16.29 misreports, so the
    steward does not rely on it), "tool" (any other), None (none) or "unknown" (some, but nothing says what). It is
    shell when the kind says shell or the text holds one of SHELL_WORDS, the word shell among them. A shell word
    anywhere in the text counts, so a task named for one reads as shell work too, which errs on the safe side: the
    steward treats shell work as unknown. A watching substate whose detail is agent-deck's own is shell, since that
    detail starts "1 watching", which holds watch; one with no detail is unknown, as any background work is that
    nothing describes."""
    work = row.get("background_work")  # hera's rows: background_work.kind and .task
    if isinstance(work, dict) and work:
        kind, text = work.get("kind"), work.get("task")
    elif work:
        return "unknown"  # not a table of fields
    elif row.get("substate") in BACKGROUND_SUBSTATES:  # andoria-08's rows have no background_work: substate "watching" and substate_detail
        kind, text = None, row.get("substate_detail")
    else:
        return None
    kind, text = (value.casefold() if isinstance(value, str) else "" for value in (kind, text))
    if not (kind or text):
        return "unknown"
    return "shell" if "shell" in kind or any(word in text for word in SHELL_WORDS) else "tool"


def deck_sessions(run, argv):
    """The session rows (dicts) in the listing that RUN(ARGV) printed, or None when the host did not answer: the
    command failed, what it printed is not a listing (a bare array, or an object with a sessions array), the errors
    list that --with-errors adds holds anything, or RUN raised or returned what is not (stdout, returncode)."""
    try:
        out, code = run(argv)
    except Exception:  # a run does not raise, but a listing that cannot be had leaves its host unknown, never an error
        return None
    if code != 0:
        return None
    try:
        data = json.loads(out)
    except (TypeError, ValueError, RecursionError):  # stdout that is not text, not JSON, or nested too deep to read
        return None
    sessions = data.get("sessions") if isinstance(data, dict) else data
    if (isinstance(data, dict) and data.get("errors")) or not isinstance(sessions, list):
        return None
    return [row for row in sessions if isinstance(row, dict)]


def row_rank(session):
    """How well the agent-deck row SESSION shows its member, as a sort key: a row that is neither stopped nor archived
    beats one that is, and then the later last_activity beats the earlier. A stamp that cannot be read ranks last."""
    live = session.get("status") != "stopped" and session.get("archived") is not True
    return live, utc_of(session.get("last_activity_at")) or ""


def deck_rows(run, members, hera_host=HERA):
    """The agent-deck row of each member, by name: dict(status, substate, bg, last_activity, archived, listed, host_ok).
    RUN(argv) returns (stdout, returncode) and should not raise; a host whose RUN raises is one that does not answer.
    The rows are keyed host by host, not in roster order. Members on HERA_HOST are read from `agent-deck list
    --json`, the others from `agent-deck remote sessions HOST --json --with-errors`, one call for each host, and
    matched to rows by title, exactly; of several rows with one title the best by row_rank is read. listed is True
    for a member whose title its host's listing holds, whatever else the row says. A member the listing does not hold
    has listed False, host_ok true and every other field None; a host that does not answer (see deck_sessions), or
    has no name, gives each of its members host_ok false and every other field None, listed included, so a silent
    host is never read as stopped or missing members. A field a row lacks or holds in the wrong form is None, or "unknown" for
    bg; nothing raises."""
    rows = {}
    for host in dict.fromkeys(m.host for m in members):  # each host once, in roster order
        if host == hera_host:
            argv = ["agent-deck", "list", "--json"]
        else:
            argv = ["agent-deck", "remote", "sessions", host, "--json", "--with-errors"]
        sessions = deck_sessions(run, argv) if host else None  # with no host name, agent-deck would answer for every remote
        by_title = {}
        for session in sessions or []:
            title = session.get("title")
            if isinstance(title, str) and (title not in by_title or row_rank(session) > row_rank(by_title[title])):
                by_title[title] = session  # on a tie the row listed first stays
        for m in members:
            if m.host == host:
                session = by_title.get(m.name, {})
                rows[m.name] = {"status": text_of(session.get("status")), "substate": text_of(session.get("substate")), "bg": background_kind(session),
                                "last_activity": utc_of(session.get("last_activity_at")), "archived": bool_of(session.get("archived")),
                                "listed": None if sessions is None else m.name in by_title, "host_ok": sessions is not None}
    return rows


def real_run(argv):
    """The run(argv) of deck_rows and probe, for real: (stdout, returncode) of the command ARGV, whose first word is the program, as they build it
    ("agent-deck", then its arguments). It never raises: a command that cannot be started, has not finished in 20 seconds, or prints what is not UTF-8
    gives ("", 1). The stderr of the command is dropped: none of it reaches the text it returns or the stderr of this process."""
    try:
        done = subprocess.run(argv, capture_output=True, encoding="utf-8", timeout=20)
    except Exception:
        return "", 1
    return done.stdout, done.returncode


def runner_for(fixture):
    """The run(argv) the commands use: real_run, or, when FIXTURE is a path (the hidden --run-fixture, which only the self-test gives), a fake_run
    that answers as the JSON object in that file says, so that no check runs the real agent-deck. A fixture file that cannot be read, is not JSON or
    holds no JSON object raises ValueError with the reason."""
    if fixture is None:
        return real_run
    try:
        with open(fixture, encoding="utf-8") as f:
            answers = json.load(f)
    except OSError as e:
        raise ValueError(e.strerror or "it cannot be read") from None
    except (ValueError, RecursionError):  # not JSON, not UTF-8, or nested too deep to read
        raise ValueError("not valid JSON") from None
    if not isinstance(answers, dict):
        raise ValueError("not a JSON object")
    return fake_run(answers)


# ---- census ----

Entry = collections.namedtuple("Entry", "dir name to sender stamp ctime")  # dir is "top" or "channel"
Intent = collections.namedtuple("Intent", "seq utc to subject sha id")  # id is None when no sent line names the seq


def stamp_time(stamp):
    """The time of STAMP, YYYYMMDDTHHMMSS.ffffffZ in UTC (the fraction may be left out), as epoch seconds; None when STAMP is not a
    time."""
    m = STAMP_RE.fullmatch(stamp)
    if m is None:
        return None
    year, month, day, hour, minute, second, micro = (int(part or 0) for part in m.groups())
    try:
        return datetime.datetime(year, month, day, hour, minute, second, micro, tzinfo=datetime.timezone.utc).timestamp()
    except ValueError:
        return None


def parse_name(name):
    """(to, sender, stamp) from NAME, a message file's name, as agent-mail's parse_msg reads it: None unless NAME fully matches
    MSG_RE, both names are grammatical (at most 64 characters, not ending in a hyphen) and the stamp is a time."""
    m = MSG_RE.fullmatch(name)
    if m is None or not (grammatical(m["to"]) and grammatical(m["sender"])) or stamp_time(m["stamp"]) is None:
        return None
    return m["to"], m["sender"], m["stamp"]


def scan_entries(where, path):
    """The Entries (see list_entries) for the message files in the directory PATH, which WHERE, "top" or "channel", says it is,
    oldest stamp first."""
    found = []
    with os.scandir(path) as scan:
        for item in scan:
            parsed = parse_name(item.name)
            if parsed is None:
                continue
            try:
                if not item.is_file(follow_symlinks=False):  # agent-mail's reader counts regular files only
                    continue
                ctime = item.stat(follow_symlinks=False).st_ctime
            except FileNotFoundError:  # the member's reader claimed the file since the listing; any other error is raised
                continue
            found.append(Entry(where, item.name, *parsed, ctime))
    return sorted(found, key=lambda e: (e.stamp, e.name))


def list_entries(mailbox, channel):
    """The message files named in the directory MAILBOX and in its subdirectory +CHANNEL, as Entry(dir, name, to, sender, stamp,
    ctime): the top level first, then the channel, each oldest stamp first (the stamp is the writer's word; a file's ctime says when
    it arrived here). An entry is listed only as agent-mail's reader would count it: its name is a message's (see parse_name, so no
    hidden name, note or other name, no name over 64 characters or ending in a hyphen, no stamp that is not a time) and it is a
    regular file, not a symlink or a directory. Only names and metadata are read: no file is opened and no symlink is followed (a
    ctime is the entry's own, from lstat; MAILBOX itself is taken as given, since it may be a link, but a +CHANNEL that is a symlink
    is no channel, as agent-mail has it), and a file gone by the time it is asked about, claimed by its reader, is left out. A
    channel that is not a directory has no posts. Any other failure raises OSError, so that a directory or an entry that cannot be
    read is never taken for one with nothing in it."""
    entries = scan_entries("top", mailbox)
    where = os.path.join(mailbox, f"+{channel}")
    if not os.path.islink(where):
        with contextlib.suppress(FileNotFoundError, NotADirectoryError):  # no such channel
            entries += scan_entries("channel", where)
    return entries


def read_sent_log(path):
    """(intents, sent_ids) from the SENT.log at PATH, which the steward writes in two phases: `intent <seq> <UTC> <to> <subject>
    <body-sha>` before a send and `sent <seq> <id>` after it. The subject is every word between the recipient and the sha, so it may
    hold spaces. An Intent carries the id of the sent line that names its seq, or None when none does; sent_ids holds the id of every
    sent line, with or without an intent before it. A line of any other shape is skipped, a damaged byte is replaced, and a missing
    file holds nothing."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        return [], set()
    intents, sent_ids, latest = [], set(), {}  # latest: seq -> the place of its last intent in intents
    for line in lines:
        words = line.split()
        if len(words) >= 6 and words[0] == "intent":
            latest[words[1]] = len(intents)
            intents.append(Intent(words[1], words[2], words[3], " ".join(words[4:-1]), words[-1], None))
        elif len(words) == 3 and words[0] == "sent":
            sent_ids.add(words[2])
            if words[1] in latest:
                k = latest[words[1]]
                intents[k] = intents[k]._replace(id=words[2])
    return intents, sent_ids


def nudge_ids(intents):
    """The ids of the NUDGEs the steward sent: those of the INTENTS whose subject starts with NUDGE and that a sent line names."""
    return {i.id for i in intents if i.subject.startswith("NUDGE") and i.id}


def read_notes_log(path):
    """The ids in the NOTES.log at PATH, each the direct mail a NOTE named, from its lines `<UTC> <id>`. A line of any other shape is
    skipped, a damaged byte is replaced, and a missing file holds none."""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            rows = [line.split() for line in f]
    except FileNotFoundError:
        return set()
    return {row[1] for row in rows if len(row) == 2}


def entry_id(entry):
    """The message id of the Entry ENTRY: its file name without .txt."""
    return entry.name.removesuffix(".txt")


def entry_age(entry, now):
    """The seconds from the time of the Entry ENTRY's stamp to NOW; from its ctime to NOW when the stamp is not a time."""
    when = stamp_time(entry.stamp)
    return now - (entry.ctime if when is None else when)


def open_intent_times(intents):
    """The times of the INTENTS that no sent line completes, in epoch seconds, by the recipient each names; an intent whose UTC is
    not a time has none. Only such an intent can account for a file that no sent line names: a completed one is paired with its own
    file already (spec 6.12)."""
    times = {}
    for intent in intents:
        when = stamp_time(intent.utc)
        if intent.id is None and when is not None:
            times.setdefault(intent.to, []).append(when)
    return times


def announced(entry, planned):
    """Whether an intent among PLANNED (the times open_intent_times gives) names the recipient of the Entry ENTRY, a channel as
    +NAME, at a time within INTENT_WINDOW_S seconds of its stamp. An entry whose stamp is not a time has no such intent."""
    when = stamp_time(entry.stamp)
    recipient = entry.to if entry.dir == "top" else f"+{entry.to}"
    return when is not None and any(abs(t - when) <= INTENT_WINDOW_S for t in planned.get(recipient, ()))


class Census:
    """What the names in a listing show about a topic; census() makes one. Its fields:
    unread: {member name: (how many top-level files are addressed to it, the age in seconds of the oldest)}, (0, None) for a member
        with none;
    nudges_unread: [(id, age in seconds)], one for each NUDGE of the steward's still at the top level;
    unmatched_own: [id], one for each file from the steward that SENT.log does not account for;
    transit_without_note: how many top-level files from one member to another no NOTE names. Each list is in the order of the entries."""

    def __init__(self, unread, nudges_unread, unmatched_own, transit_without_note):
        self.unread = unread
        self.nudges_unread = nudges_unread
        self.unmatched_own = unmatched_own
        self.transit_without_note = transit_without_note


def census(entries, members, steward, sent, notes, nudge_ids, now):
    """The Census of ENTRIES (from list_entries) for a topic whose members are the Members MEMBERS and whose steward is the name
    STEWARD, as of NOW in epoch seconds. SENT is read_sent_log's (intents, sent_ids), NOTES read_notes_log's set of ids and
    NUDGE_IDS the set of the steward's NUDGE ids (see nudge_ids). A file's id is its name without .txt, and its age is NOW less the
    time of its stamp, or less its ctime when the stamp is not a time. Names are compared whole, never by prefix, so pi is not
    pipeline. A file from STEWARD is accounted for by a sent line that names its id, or by an intent that no sent line completes and
    that names its recipient (a channel as +NAME) within INTENT_WINDOW_S seconds of its stamp; a stamp that is not a time matches no
    intent. Only names and metadata are used: no file is opened."""
    intents, sent_ids = sent
    ages = {m.name: [] for m in members}  # the ages of the top-level files addressed to each member
    nudges_unread, unmatched_own, transit_without_note = [], [], 0
    planned = open_intent_times(intents)
    for e in entries:
        ident = entry_id(e)
        if e.dir == "top":
            if e.to in ages:
                ages[e.to].append(entry_age(e, now))
                if e.sender in ages and ident not in notes:
                    transit_without_note += 1
            if ident in nudge_ids:
                nudges_unread.append((ident, entry_age(e, now)))
        if e.sender == steward and ident not in sent_ids and not announced(e, planned):
            unmatched_own.append(ident)
    unread = {name: (len(waited), max(waited, default=None)) for name, waited in ages.items()}
    return Census(unread, nudges_unread, unmatched_own, transit_without_note)


# ---- probe ----

def probe(run, name, host):
    """Whether the member NAME, on the host HOST, is waiting on John: True when its last response ends with a question, False when it does not,
    None when that cannot be told. RUN(argv) is the runner of deck_rows. Only a member on hera is asked, since no output command for a remote member
    is verified, and only by a name that agent-mail could have given it, so that agent-deck never takes the name for a flag or, when it is empty, for
    the caller's own session. The command is the text form of `agent-deck session output NAME --max-tokens 200`; -q would ignore the cap. Its text
    is reduced here: with the ANSI escape sequences stripped, the last non-empty line decides, less the footer that agent-deck puts after a response
    it cut to the cap (a response over 200 tokens, about 800 bytes, is cut to its head and its tail around a seam, so the footer would otherwise be
    its last line). A cut response, one with the seam line of agent-deck in it, whose last line is not that footer is None: where it ends cannot be
    told. None of the text is kept or printed. A command that fails (any status but 0, the negative one that a signal gives included), or a run that
    raises, is None."""
    if host != HERA or not grammatical(name):
        return None
    try:
        out, code = run(["agent-deck", "session", "output", name, "--max-tokens", "200"])
    except Exception:  # a run does not raise, but a probe that cannot be told is unknown, never an error
        return None
    if code != 0:
        return None
    lines = [line for line in map(str.strip, ANSI_RE.sub("", out).splitlines()) if line]
    if lines and CUT_FOOTER_RE.fullmatch(lines[-1]):
        lines.pop()
    elif CUT_SEAM in lines:  # cut, and not ended by the footer that is known: where the response ends cannot be told
        return None
    # The rule is literal: a question followed by its options, or wrapped in emphasis or quotes, reads no. The steward takes no and unknown alike as no
    # evidence of a question, never as proof that the member is not waiting on John.
    return bool(lines) and lines[-1].endswith("?")


class Refusal(Exception):
    """A signals call that is refused. The message is the line it prints on stderr."""


def conductor_file(directory, name, reader):
    """READER(path) for the file NAME in the conductor directory DIRECTORY. A failure is raised as a Refusal: the reader's own message for a PolicyError or a
    RosterError, and otherwise the OS error's reason, or that the file is not UTF-8, with the file's name and not its path, which may hold a question mark."""
    try:
        return reader(os.path.join(directory, name))
    except (PolicyError, RosterError) as e:
        raise Refusal(str(e)) from None
    except OSError as e:
        raise Refusal(f"steward-signals: {name} in --dir: {e.strerror or 'cannot be read'}") from None
    except UnicodeDecodeError:
        raise Refusal(f"steward-signals: {name} in --dir: not valid UTF-8") from None


def probe_command(run, name, directory):
    """Print the one word that says whether the member NAME of the topic whose TOPIC.md is in DIRECTORY is waiting on John, yes, no or unknown (see
    probe; a name that TOPIC.md does not list is unknown), and return 0. Nothing else goes to stdout, so none of a member's text reaches the steward.
    A TOPIC.md that cannot be read is refused instead: the status is 2 and nothing goes to stdout. The reason goes to stderr in a line with no question mark:
    the roster reader's message, or, for the file itself, the OS error's reason (or that it is not UTF-8) and not the path, which may hold a question mark."""
    try:
        members = conductor_file(directory, "TOPIC.md", load_roster)
    except Refusal as e:
        print(without_question_marks(str(e)), file=sys.stderr)
        return 2
    host = next((m.host for m in members if m.name == name), None)
    print(PROBE_WORDS[probe(run, name, host)])
    return 0


# ---- metrics ----

DAY_RE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}")  # a day as YYYY-MM-DD, in ASCII digits, so that no file name holds digits of another script
KEY_RE = re.compile(r"[a-z][a-z0-9_]*(?:\.[a-z][a-z0-9_]*)*")  # a key of the metrics file: lower-case identifiers joined by dots
KEY_CHARS = frozenset("abcdefghijklmnopqrstuvwxyz0123456789_.")  # the characters a key is made of
MAX_KEY_WORDS = 5  # the most words a key may have: the steward's keys have one to three, and indented JSON grows with the square of the depth
MAX_KEY_CHARS = 100  # the most characters a key may have, the dots counted
INT_RE = re.compile(rf"-?[0-9]{{1,{MAX_DIGITS}}}")  # a --set value stored as a whole number; int() alone would take digits of other scripts, underscores and a plus sign too


def is_day(text):
    """Whether TEXT is a day that exists, written YYYY-MM-DD in ASCII digits."""
    if not isinstance(text, str) or DAY_RE.fullmatch(text) is None:
        return False
    try:
        datetime.date(int(text[:4]), int(text[5:7]), int(text[8:]))
    except ValueError:  # a month 13, a 30th of February, a year 0
        return False
    return True


def merge_counters(old, new):
    """OLD merged with NEW, two values read from JSON. Two objects merge key by key, recursively, and a key that only one of them has is kept. Two whole
    numbers (a bool is not one) give the larger. Any other pair, two values of one kind or of two kinds, gives NEW."""
    if isinstance(old, dict) and isinstance(new, dict):
        return {**old, **{key: merge_counters(old[key], value) if key in old else value for key, value in new.items()}}
    if type(old) is int and type(new) is int:
        return max(old, new)
    return new


def json_text(value):
    """VALUE as the text of a JSON file the helper writes, a metrics file or steward-state.json: indented, its keys in order, in ASCII, ending in a newline.
    ValueError for NaN or an infinity, which JSON has not, and TypeError for a value it cannot hold."""
    return json.dumps(value, indent=2, sort_keys=True, allow_nan=False) + "\n"


def read_json_object(path):
    """(the JSON object in the file at PATH, trouble): ({}, "missing") when there is no file; ({}, "damaged") when it holds no JSON object that can be read
    and written again (not UTF-8, not JSON, nested too deep to read, JSON of another kind, or holding NaN or an infinity, which json_text cannot write back);
    else (the object, None). A file that cannot be read, a directory or one without read permission, raises OSError."""
    try:
        with open(path, encoding="utf-8") as f:
            value = json.load(f)
        if not isinstance(value, dict):
            return {}, "damaged"
        json_text(value)  # a file that could not be written again is as damaged as one that could not be read, and would block every write after it
    except FileNotFoundError:
        return {}, "missing"
    except (ValueError, RecursionError):  # not UTF-8 (a UnicodeDecodeError is a ValueError), not JSON, nested too deep, or with NaN or 1e999 in it
        return {}, "damaged"
    return value, None


def replace_whole(path, text, keep_bad):
    """Write TEXT whole to a temporary file beside PATH, flush it to disk and move it over PATH, so that a reader sees the old file or the new one and never
    half of one, and PATH is never missing. When KEEP_BAD, the file at PATH is first kept whole as PATH.bad, over any older one: a second name of it, a hard
    link, is moved onto .bad before the new file is moved onto PATH. The temporary names start with a dot and end in .tmp or .tmp.link, so that no reader takes
    them for the file. Any failure raises OSError, and PATH is then where it was: whole, or the damaged file, which may by then also be kept as .bad. No
    failure that Python sees, an interrupt included, leaves a temporary name behind; a process that is killed may leave one."""
    folder, name = os.path.split(path)
    temp = tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=folder or ".", prefix=f".{name.removesuffix('.json')}.", suffix=".tmp", delete=False)
    link = temp.name + ".link"  # a second name for the damaged file, if there is one: a name that no reader takes for the file
    try:
        with temp:
            temp.write(text)
            temp.flush()
            os.fsync(temp.fileno())
        if keep_bad:
            os.link(path, link)
            os.replace(link, path + ".bad")
        os.replace(temp.name, path)
    finally:
        for name in (temp.name, link):
            with contextlib.suppress(OSError):  # a name that was moved into place, or never made, is gone already
                os.unlink(name)


def write_metrics(conductor_dir, day, data):
    """Merge the dict DATA, JSON values under text keys, into the metrics file of the day DAY, YYYY-MM-DD, which is CONDUCTOR_DIR/metrics/DAY.json, and return
    its path. merge_counters says how a value is merged, so that a counter once written is never lost. metrics/ is made when it is not there. The new file is
    written whole to a temporary file in metrics/ and flushed to disk, then moved over the day file, so that a reader sees the old file or the new one and never
    half of one, and the day file is never missing. A day file that is not a JSON object (not JSON, not UTF-8, nested too deep to read, JSON of another kind such
    as an array, or one that could not be written again, with NaN or 1e999 in it) is kept whole as DAY.json.bad, over any older one: a second name of it, a hard
    link, is moved onto .bad before the new file is moved onto the day file, and one notice, which names no directory, is printed on stderr only after that last move.
    A DAY that is not a day, a CONDUCTOR_DIR that is not an existing directory, a DATA that is not a dict, a DATA with NaN or an infinity in it (JSON has
    neither) and a merge nested too deeply to write raise ValueError with a reason that names no path, and nothing is made then; a value that JSON cannot hold,
    a set say, raises TypeError and nothing is made. Any other failure raises OSError, and the day file is then where it was: whole, or the damaged one, which
    may by then also be kept as .bad. No failure that Python sees, an interrupt included, leaves a temporary file behind, though a process that is killed may
    (replace_whole does the writing). A day file that cannot be read, a directory or a file
    without read permission, is an OSError and is not touched. Two writers at one moment may lose an update; the steward writes one at a time."""
    if not is_day(day):
        raise ValueError("the day must be a date written YYYY-MM-DD")
    if not (isinstance(conductor_dir, str) and os.path.isdir(conductor_dir)):
        raise ValueError("the conductor directory does not exist")
    if not isinstance(data, dict):
        raise ValueError("the metrics must be a dict")
    folder = os.path.join(conductor_dir, "metrics")
    path = os.path.join(folder, f"{day}.json")
    old, trouble = read_json_object(path)
    bad = trouble == "damaged"
    try:
        text = json_text(merge_counters(old, data))
    except RecursionError:  # nested too deeply for json to write indented, which Python 3.12 and older cannot do beyond about a thousand levels
        raise ValueError("the metrics are nested too deeply to write") from None
    os.makedirs(folder, exist_ok=True)
    replace_whole(path, text, bad)
    if bad:
        print(f"steward-signals: metrics: {day}.json is not a JSON object, so it is moved aside to {day}.json.bad and a fresh file is written", file=sys.stderr)
    return path


def key_problem(key):
    """Why KEY is not a metrics key (see KEY_RE), in words that quote none of it, since it may hold a question mark: the first character that no key could have
    at its place, by its place and what is wrong with it, or that the key is empty or ends in a dot, which leaves its last word empty. None for a key."""
    if not key:
        return "the key is empty"
    for place, char in enumerate(key, start=1):
        if char not in KEY_CHARS:
            return f"character {place} is not a lower-case letter, digit, underscore or dot"
        if (place == 1 or key[place - 2] == ".") and not "a" <= char <= "z":
            return f"character {place} starts a word, so it must be a lower-case letter"
    if key.endswith("."):
        return f"character {len(key)} is a dot with no word after it"
    return None


def parse_settings(settings):
    """The dict that SETTINGS, the --set arguments of the metrics command, each KEY=VALUE, describe. A value of at most MAX_DIGITS digits, with a minus sign or
    none, is an int and any other value is text. A key is lower-case identifiers (letters, digits and underscores, starting with a letter) joined by dots, and
    a.b puts its value in the object a; it has at most MAX_KEY_WORDS words and MAX_KEY_CHARS characters. Raises ValueError with the reason for an argument with
    no =, a key that is too long or not of that form, an empty value (which would replace a counter with nothing), a key given twice and a key that is both a
    value and the start of another key (a and a.b), since the order of the two would then decide what the steward meant. A key that is refused is not quoted,
    since it may hold a question mark and be long: the reason names its --set by number, and for a key that is not of that form the place of its first wrong
    character."""
    data = {}
    for number, setting in enumerate(settings, start=1):
        key, equals, value = setting.partition("=")
        if not equals:
            raise ValueError(f"--set number {number}: expected KEY=VALUE")
        words = key.count(".") + 1
        if len(key) > MAX_KEY_CHARS or words > MAX_KEY_WORDS:
            raise ValueError(f"--set number {number}: a key has at most {MAX_KEY_WORDS} words and {MAX_KEY_CHARS} characters; "
                             f"this one has {words} {'word' if words == 1 else 'words'} and {len(key)} characters")  # it has 11 characters at least
        if KEY_RE.fullmatch(key) is None:
            raise ValueError(f"--set number {number}: {key_problem(key) or 'that is not a key'}")
        if not value:
            raise ValueError(f"--set {key!r}: the value is empty")
        *parents, last = key.split(".")
        node = data
        for name in parents:
            node = node.setdefault(name, {})
            if not isinstance(node, dict):
                raise ValueError(f"--set {key!r}: {name} is also given a value, so it cannot be an object")
        if last in node:
            raise ValueError(f"--set {key!r}: " + ("it is also the start of another key" if isinstance(node[last], dict) else "it is given twice"))
        node[last] = int(value) if INT_RE.fullmatch(value) else value
    return data


def metrics_refused(reason):
    """Say on stderr, in one line with no question mark, that the metrics command is refused for REASON, and return the status 2."""
    print(without_question_marks(f"steward-signals: metrics: {reason}"), file=sys.stderr)
    return 2


def metrics_command(directory, day, settings):
    """Merge SETTINGS (see parse_settings) into the metrics file of the day DAY, today's UTC date when DAY is None, in the conductor directory DIRECTORY (see
    write_metrics), print the file's path and return 0. Anything refused, a reason from parse_settings or write_metrics or an OS error, is one line on stderr with
    no question mark and the status 2, with nothing on stdout and nothing written; so is a DIRECTORY with a question mark in its name, since the path is printed.
    An empty DAY is refused, not taken for today."""
    try:
        if "?" in directory:
            raise ValueError("--dir: the directory's name holds a question mark, which the file's path would carry to stdout")
        data = parse_settings(settings)
        path = write_metrics(directory, datetime.datetime.now(datetime.timezone.utc).date().isoformat() if day is None else day, data)
    except ValueError as e:
        return metrics_refused(e)
    except OSError as e:
        return metrics_refused(f"the metrics file cannot be used: {e.strerror or 'the system gave no reason'}")
    print(path)
    return 0


# ---- signals ----

CONFIG_PATH = "~/.config/agent-mail/config.json"  # the agent-mail config file where $AGENT_MAIL_CONFIG names none, as agent-mail has it
STATE_FILE = "steward-state.json"  # the steward's own state in its conductor directory, where the signals command keeps signals_last and nothing else
TABLE_COLUMNS = ("name", "host", "harness", "status", "substate", "bg", "last-activity", "unread(oldest)", "checked-age")
EXCEPTION_LINES = 40  # the most unmatched-own lines the text form prints: a lost SENT.log would otherwise list a month of the steward's posts into its context
STATE_WHY = {"missing": f"there is no {STATE_FILE} yet", "unset": f"{STATE_FILE} has no signals_last yet",
             "damaged": f"{STATE_FILE} is not a JSON object that can be read and written again", "not a stamp": f"signals_last in {STATE_FILE} is not a stamp",
             "in the future": f"signals_last in {STATE_FILE} is in the future"}
STATE_KEPT = {"damaged": f"it is moved aside to {STATE_FILE}.bad and a fresh one is written",  # what a write that succeeds did with a state it could not use
              "not a stamp": f"the file is kept as {STATE_FILE}.bad and written again with its other keys",
              "in the future": f"the file is kept as {STATE_FILE}.bad and written again with its other keys"}


def utc_stamp(epoch):
    """The time EPOCH, in epoch seconds, as a message id stamps it: YYYYMMDDTHHMMSS.ffffffZ, in UTC."""
    return datetime.datetime.fromtimestamp(epoch, datetime.timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")


def compact_age(seconds):
    """SECONDS as the signals table shows an age: whole minutes under an hour (0m under a minute), whole hours under a day, else whole days, each rounded down,
    with a minus sign before an age of a minute or more in the future, which a clock ahead of hera's gives."""
    sign, size = ("-", -seconds) if seconds <= -60 else ("", max(seconds, 0))
    for unit, span in (("d", 86400), ("h", 3600)):
        if size >= span:
            return f"{sign}{int(size // span)}{unit}"
    return f"{sign}{int(size // 60)}m"


def table_cell(text):
    """TEXT as a cell of the signals table: - for None; each character that is not printable ASCII, a space included, and each question mark, as an underscore,
    so that a cell is one word on one line and the table keeps one line for each member; and cut as clipped cuts it."""
    if text is None:
        return "-"
    return clipped("".join(c if "!" <= c <= "~" and c != "?" else "_" for c in text))


def member_checked(mailbox, names):
    """When each member of NAMES last read its mail, as agent-mail records it: {name: the mtime of MAILBOX/.agent-mail/members/NAME.json in epoch seconds, or
    None for no record}. agent-mail rewrites a member's record when the member reads, at most every 300 seconds. Only metadata is read and no file is opened.
    What is mirrored of agent-mail's reader is the path: a record counts only as a regular file reached through .agent-mail and members as real directories,
    so a record that is a symlink or not a file, or one under a symlink or a file, is no record. What is not: agent-mail also checks a record's owner, its
    size and its content, which the helper does not, since it reads the mtime alone. Any failure but a missing name raises OSError, so that a record that
    cannot be looked up is never taken for none."""
    times = dict.fromkeys(names)
    folder = os.path.join(mailbox, ".agent-mail", "members")
    for where in (os.path.dirname(folder), folder):
        try:
            if not stat.S_ISDIR(os.lstat(where).st_mode):
                return times
        except FileNotFoundError:
            return times
    for name in names:
        try:
            st = os.lstat(os.path.join(folder, f"{name}.json"))
        except FileNotFoundError:
            continue
        if stat.S_ISREG(st.st_mode):
            times[name] = st.st_mtime
    return times


def posts_after(entries, channel, steward, since, now):
    """How many of ENTRIES (from list_entries) are new posts to CHANNEL from others than STEWARD: those whose ctime, the time the post arrived here, lies in
    (SINCE, NOW], epoch seconds, with no lower bound when SINCE is None. A post is a file in +CHANNEL named for CHANNEL, as agent-mail counts a channel's
    posts, so a misfiled one is not counted, and the steward's own posts are not, since the count tells the steward what others posted. A post is never
    here before it arrives, so its arrival counts it once: one stamped before SINCE that arrived after it counts by its arrival, and one stamped ahead of
    hera's clock counts at its arrival and never again. The stamp and the mtime play no part. The count is advisory: a file synced again under a new
    inode counts once more, as does one whose ctime another change of its metadata moves."""
    return sum(e.dir == "channel" and e.to == channel and e.sender != steward and (since is None or e.ctime > since) and e.ctime <= now for e in entries)


def read_state(path, now):
    """(state, since, trouble) from the steward-state.json at PATH, which the steward writes too, for a call at the time NOW. STATE is the object to write again
    with a new signals_last: the file's, so that the steward's own keys are kept, or {} when there is none to keep. SINCE is the time of signals_last in epoch
    seconds, or None when there is none to use, and TROUBLE then says why (see STATE_WHY): "missing" or "damaged", as read_json_object says; "unset", an object
    with no signals_last; "not a stamp", a signals_last that stamp_time cannot read; "in the future", one later than NOW, which no earlier call can have
    written. A file that cannot be read, a directory say, raises OSError."""
    state, trouble = read_json_object(path)
    if trouble is not None:
        return state, None, trouble
    if "signals_last" not in state:
        return state, None, "unset"
    last = state["signals_last"]
    since = stamp_time(last) if isinstance(last, str) else None
    if since is None:
        return state, None, "not a stamp"
    return (state, since, None) if since <= now else (state, None, "in the future")


def short_host():
    """This host's short name, as agent-mail names it in the hosts of its config file: the host name to its first dot, in lower case."""
    return socket.gethostname().split(".")[0].lower()


def agent_mail_config():
    """The JSON object in agent-mail's config file, $AGENT_MAIL_CONFIG when that is set and not empty, else ~/.config/agent-mail/config.json, or {} when there
    is no such file. As agent-mail refuses a malformed one, a Refusal is raised for a file that cannot be read, that holds no JSON object (see
    read_json_object), or whose hosts or sessions, or one of their entries, is not an object. A key agent-mail does not know is left to agent-mail to
    refuse, so that a key a later agent-mail knows does not stop the steward."""
    try:
        data, trouble = read_json_object(os.environ.get("AGENT_MAIL_CONFIG") or os.path.expanduser(CONFIG_PATH))
    except OSError as e:
        raise Refusal(f"steward-signals: signals: the agent-mail config file cannot be read: {e.strerror or 'the system gave no reason'}") from None
    if trouble == "damaged":
        raise Refusal("steward-signals: signals: the agent-mail config file is not a JSON object")
    for group in ("hosts", "sessions"):
        entries = data.get(group, {})
        if not isinstance(entries, dict):
            raise Refusal(f"steward-signals: signals: {group} in the agent-mail config file is not a JSON object")
        for name, entry in entries.items():
            if not isinstance(entry, dict):
                raise Refusal(f"steward-signals: signals: {group}.{clipped(name)} in the agent-mail config file is not a JSON object")
    return data


def mailbox_of(given, steward):
    """(the mailbox, what names it in a refusal), in agent-mail's order for its dir setting: GIVEN, the --mailbox, when it is given, even empty; else
    $AGENT_MAIL_DIR when it is set and not empty; else the dir of sessions.STEWARD, then of hosts.<short host>, then at the top level of agent-mail's
    config file (see agent_mail_config); else ~/Mailbox. A leading ~ is expanded in each, as agent-mail expands it. A dir in the config file that is not
    a non-empty string raises Refusal, as agent-mail refuses it; so does a config file agent_mail_config refuses, when it is read."""
    if given is not None:
        return os.path.expanduser(given), "the mailbox that --mailbox names"
    if os.environ.get("AGENT_MAIL_DIR"):
        return os.path.expanduser(os.environ["AGENT_MAIL_DIR"]), "the mailbox that $AGENT_MAIL_DIR names"
    config = agent_mail_config()
    for where, layer in ((f"sessions.{steward}.", config.get("sessions", {}).get(steward, {})), (f"hosts.{short_host()}.", config.get("hosts", {}).get(short_host(), {})),
                         ("", config)):
        if "dir" in layer:
            if not (isinstance(layer["dir"], str) and layer["dir"]):
                raise Refusal(f"steward-signals: signals: {clipped(where)}dir in the agent-mail config file is not a directory path")
            return os.path.expanduser(layer["dir"]), f"the mailbox that {clipped(where)}dir in the agent-mail config file names"
    return os.path.expanduser("~/Mailbox"), "~/Mailbox"


def whole_seconds(seconds):
    """SECONDS rounded down to a whole number, or None for None."""
    return None if seconds is None else int(seconds // 1)


def signals_report(members, rows, checked, tally, posts, asked, now):
    """The report of a signals call, a dict that JSON can hold. members: by name, in the roster order of the Members MEMBERS, each member's host and harness,
    the raw fields of the row deck_rows gave it in ROWS, the age of its last activity, its unread mail from the Census TALLY as {count, oldest_age_s}, and the
    age of its member record from CHECKED (see member_checked). exceptions: TALLY's unmatched_own ids, and its nudges_unread as {id, age_s}. counts: POSTS as
    posts_since_last, and TALLY's transit_without_note. probe: {name, answer} for ASKED, a (name, probe's answer) pair, or None. An age is in whole seconds
    to NOW, rounded down, and None where there is nothing to age."""
    shown_members = {}
    for m in members:
        row, (count, oldest), last = rows[m.name], tally.unread[m.name], rows[m.name]["last_activity"]
        shown_members[m.name] = {
            "host": m.host, "harness": m.harness, "status": row["status"], "substate": row["substate"], "bg": row["bg"], "last_activity": last,
            "last_activity_age_s": None if last is None else whole_seconds(now - datetime.datetime.fromisoformat(last).timestamp()),
            "archived": row["archived"], "listed": row["listed"], "host_ok": row["host_ok"], "unread": {"count": count, "oldest_age_s": whole_seconds(oldest)},
            "checked_age_s": None if checked[m.name] is None else whole_seconds(now - checked[m.name])}
    return {"members": shown_members,
            "exceptions": {"unmatched_own": list(tally.unmatched_own), "nudges_unread": [{"id": ident, "age_s": whole_seconds(age)} for ident, age in tally.nudges_unread]},
            "counts": {"posts_since_last": posts, "transit_without_note": tally.transit_without_note},
            "probe": None if asked is None else {"name": asked[0], "answer": PROBE_WORDS[asked[1]]}}


def deck_cells(member):
    """The status, substate, bg and last-activity cells of MEMBER, one of a report's members: unknown in all four when its host could not be listed. Else the
    status is not in agent-deck for a member its host's listing does not hold, archived for an archived row, unknown for a listed row with no status it can
    read, and agent-deck's word otherwise; the others are agent-deck's words, - for none, and the age of its last activity."""
    if not member["host_ok"]:
        return ["unknown"] * 4
    if member["listed"] is False:
        status = "not in agent-deck"
    elif member["archived"] is True:
        status = "archived"
    else:
        status = "unknown" if member["status"] is None else table_cell(member["status"])
    age = member["last_activity_age_s"]
    return [status, table_cell(member["substate"]), table_cell(member["bg"]), "-" if age is None else compact_age(age)]


def render_text(report):
    """REPORT (see signals_report) as text: a header of TABLE_COLUMNS and a row for each member, the columns padded with spaces, two at least between them; then
    exceptions: and a line for each, first every nudge-unread ID AGE, then unmatched-own ID, at most EXCEPTION_LINES of those and then and N more, or
    exceptions: none; then counts: posts-since-last=N transit-without-note=N; then, when the probe was asked, probe NAME: WORD. The cap is on the unmatched
    lines alone, so it never hides an unread NUDGE behind files in the steward's name. A name and a host are printed whole, since their grammars allow nothing
    that could break a line and at most 64 characters; the other cells go through table_cell. An unread(oldest) cell is COUNT(AGE), or 0, and a checked-age is
    never for a member with no record. No line holds a question mark."""
    rows = [list(TABLE_COLUMNS)]
    for name, m in report["members"].items():
        count, oldest = m["unread"]["count"], m["unread"]["oldest_age_s"]
        rows.append([name, m["host"], table_cell(m["harness"]), *deck_cells(m), f"{count}({compact_age(oldest)})" if count else "0",
                     "never" if m["checked_age_s"] is None else compact_age(m["checked_age_s"])])
    widths = [max(len(row[i]) for row in rows) for i in range(len(TABLE_COLUMNS))]
    lines = ["  ".join(cell.ljust(width) for cell, width in zip(row, widths)).rstrip() for row in rows]
    nudges = [f"  nudge-unread {nudge['id']} {compact_age(nudge['age_s'])}" for nudge in report["exceptions"]["nudges_unread"]]
    unmatched = [f"  unmatched-own {ident}" for ident in report["exceptions"]["unmatched_own"]]
    more = [f"  and {len(unmatched) - EXCEPTION_LINES} more"] if len(unmatched) > EXCEPTION_LINES else []
    lines += ["exceptions:", *nudges, *unmatched[:EXCEPTION_LINES], *more] if nudges or unmatched else ["exceptions: none"]
    lines.append(f"counts: posts-since-last={report['counts']['posts_since_last']} transit-without-note={report['counts']['transit_without_note']}")
    if report["probe"] is not None:
        lines.append(f"probe {report['probe']['name']}: {report['probe']['answer']}")
    return without_question_marks("\n".join(lines) + "\n")


def render_json(report):
    """REPORT (see signals_report) as one JSON object on one line, in ASCII, with every question mark taken out of its strings; JSON's own syntax has none."""
    return without_question_marks(json.dumps(report, allow_nan=False)) + "\n"


def signals_command(run, channel, directory, mailbox, as_json, probe_name):
    """Print the signals of the topic whose steward keeps its files in the conductor directory DIRECTORY and whose channel is CHANNEL, as text or, when AS_JSON,
    as JSON (see render_text and render_json), with the probe's word for the member PROBE_NAME when it is given, and return 0. RUN is the runner of deck_rows
    and probe. The steward's name is conductor- and the name of DIRECTORY; MAILBOX is the --mailbox (see mailbox_of). The time of the call is written to
    DIRECTORY/steward-state.json as signals_last after the whole report is rendered and printed (see read_state for a file it cannot use, which is kept as
    .bad), and posts are counted from the signals_last before it (see posts_after); nothing else is written. The clock is read once, before the listing, and
    that time serves every age and the interval. One line on stderr says why every post was counted, what was done with a state that could not be used, or
    that the state could not be written, which leaves the status 0. A refusal is one line on stderr, the status 2, nothing on stdout and nothing written: a
    CHANNEL that is not an agent-mail name, a DIRECTORY that is not a directory or whose name makes no steward's name, a conductor file that cannot be read or
    that its reader refuses, a TOPIC.md that lists the steward itself, a PROBE_NAME that TOPIC.md does not list, an agent-mail config file that agent-mail would
    refuse, and a mailbox, channel or member record that cannot be read. A host that agent-deck does not answer for is no refusal: its members are unknown."""
    now = time.time()  # the one reading of the clock, before the listing: a post that arrives during the call has a later ctime, so the next call counts it
    entries = checked = None  # bound by the listing below, which every call that is not refused reaches
    try:
        if not grammatical(channel):
            raise Refusal("steward-signals: signals: CHANNEL is not an agent-mail name: lower-case letters, digits, dots and single hyphens, at most 64 characters, without the +")
        if not os.path.isdir(directory):
            raise Refusal("steward-signals: signals: --dir is not a directory")
        steward = "conductor-" + os.path.basename(os.path.abspath(directory))
        if not grammatical(steward):
            raise Refusal("steward-signals: signals: the steward's name, conductor- and the name of --dir, is not an agent-mail name")
        members = conductor_file(directory, "TOPIC.md", load_roster)
        if any(m.name == steward for m in members):
            raise Refusal(str(RosterError(steward, "the steward itself is listed as a member")))
        conductor_file(directory, "POLICY.md", load_policy)  # read at every turn, so that a POLICY.md the steward could not follow is refused before it acts
        sent = conductor_file(directory, "SENT.log", read_sent_log)
        notes = conductor_file(directory, "NOTES.log", read_notes_log)
        state, since, trouble = conductor_file(directory, STATE_FILE, lambda path: read_state(path, now))
        hosts = {m.name: m.host for m in members}
        if probe_name is not None and probe_name not in hosts:
            raise Refusal("steward-signals: signals: --probe names no member of TOPIC.md")
        box, which = mailbox_of(mailbox, steward)
        if not os.path.isdir(box):
            raise Refusal(f"steward-signals: signals: {which} is not a directory")
        try:
            mode = os.lstat(os.path.join(box, f"+{channel}")).st_mode
        except FileNotFoundError:
            raise Refusal(f"steward-signals: signals: the mailbox has no channel +{channel}") from None
        except OSError as e:
            raise Refusal(f"steward-signals: signals: the mailbox cannot be read: {e.strerror or 'the system gave no reason'}") from None
        if not stat.S_ISDIR(mode):  # a symlink is no channel, as agent-mail has it
            raise Refusal(f"steward-signals: signals: +{channel} in the mailbox is not a directory, so it is no channel")
        try:
            entries = list_entries(box, channel)
            checked = member_checked(box, list(hosts))
        except OSError as e:  # a mailbox or channel gone since the checks above included
            raise Refusal(f"steward-signals: signals: the mailbox cannot be read: {e.strerror or 'the system gave no reason'}") from None
    except Refusal as e:
        print(without_question_marks(str(e)), file=sys.stderr)
        return 2
    rows = deck_rows(run, members)
    asked = None if probe_name is None else (probe_name, probe(run, probe_name, hosts[probe_name]))
    tally = census(entries, members, steward, sent, notes, nudge_ids(sent[0]), now)
    report = signals_report(members, rows, checked, tally, posts_after(entries, channel, steward, since, now), asked, now)
    text = render_json(report) if as_json else render_text(report)  # rendered whole before anything is printed, and printed before the state moves
    print(text, end="", flush=True)
    said = [f"posts-since-last counts every post in +{channel} but the steward's own, since {STATE_WHY[trouble]}"] if since is None else []
    try:
        replace_whole(os.path.join(directory, STATE_FILE), json_text({**state, "signals_last": utc_stamp(now)}), trouble in STATE_KEPT)
    except OSError as e:
        said.append(f"{STATE_FILE} cannot be written ({e.strerror or 'the system gave no reason'}), so the next call counts these posts again")
    else:
        said += [STATE_KEPT[trouble]] if trouble in STATE_KEPT else []
    if said:
        print(without_question_marks("steward-signals: signals: " + "; ".join(said)), file=sys.stderr)
    return 0


# ---- self-test ----

SECTIONS = {}  # name -> function(d), in the order the sections are defined
CHECKS = 0  # checks passed so far, in every section
# Variable prefixes no section sees, besides HOME and CLAUDE_JOB_DIR. AGENT_DECK_ is on the list
# because agent-deck exports AGENT_DECK_CONDUCTOR_DIR, which is not an AGENTDECK_ name.
ISOLATED = ("AGENT_MAIL_", "AGENTDECK_", "AGENT_DECK_")


class TestFailed(Exception):
    """A check that did not hold; self_test is the only place that catches it. The message is what the check says."""


def ok(cond, what):
    """Count a passed check, or raise TestFailed naming the one that failed."""
    global CHECKS
    if not cond:
        raise TestFailed(what)
    CHECKS += 1


def raises(exc_type, fn, *args):
    """The exc_type that fn(*args) raises; a failed check when it raises none."""
    try:
        fn(*args)
    except exc_type as e:
        return e
    ok(False, f"{getattr(fn, '__name__', fn)} raised no {exc_type.__name__}")


def capture(fn, *args):
    """(stdout, status, stderr) of fn(*args); the status is its return value, or the code of the SystemExit it raised."""
    out, err = io.StringIO(), io.StringIO()
    status = None
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        try:
            status = fn(*args)
        except SystemExit as e:
            status = e.code
    return out.getvalue(), status, err.getvalue()


def write(d, name, text):
    """Write TEXT to the file NAME in directory D and return its path."""
    path = os.path.join(d, name)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)
    return path


def read(path):
    """The text of the UTF-8 file at PATH."""
    with open(path, encoding="utf-8") as f:
        return f.read()


ARABIC_INDIC, FULLWIDTH = 0x0660, 0xFF10  # the code points of the zero of two scripts whose digits int() and float() read as the ASCII ones


def digits_as(text, zero):
    """TEXT with each ASCII digit written as the digit of another script, the one whose zero is the code point ZERO. int() and float() accept such
    digits, so only a pattern can refuse them; they are built here so that the source stays ASCII."""
    return "".join(chr(zero + int(c)) if c in "0123456789" else c for c in text)


STAMP_BASE = datetime.datetime(2026, 11, 2, 20, 0, 0, tzinfo=datetime.timezone.utc)


def stamp(i):
    """A message file name's stamp that differs for each integer I: the time I seconds after 2026-11-02T20:00:00Z, as
    YYYYMMDDTHHMMSS.ffffffZ."""
    return (STAMP_BASE + datetime.timedelta(seconds=i)).strftime("%Y%m%dT%H%M%S.%fZ")


def members_named(*names):
    """A Member for each of NAMES, all on hera and running claude."""
    return [Member(name, "hera", "claude") for name in names]


def mailbox(d, top=(), channel=None, members_checked=None):
    """Build the mailbox D/mailbox afresh (one already there is removed) and return its path: an empty file for each name in TOP;
    when CHANNEL is (name, files), the directory +name with an empty file for each of files; and, for each name in MEMBERS_CHECKED
    (name -> epoch seconds), a member record .agent-mail/members/name.json whose mtime is that time. The files are empty because
    the census opens none."""
    box = os.path.join(d, "mailbox")
    if os.path.lexists(box):
        shutil.rmtree(box)
    os.makedirs(box)
    for name in top:
        write(box, name, "")
    if channel:
        name, files = channel
        where = os.path.join(box, f"+{name}")
        os.makedirs(where, exist_ok=True)
        for file in files:
            write(where, file, "")
    if members_checked:
        records = os.path.join(box, ".agent-mail", "members")
        os.makedirs(records, exist_ok=True)
        for name, epoch in members_checked.items():
            os.utime(write(records, f"{name}.json", "{}\n"), (epoch, epoch))
    return box


def entries_named(*names, channel=None, ctime=None):
    """An Entry for each message file name in NAMES, shaped as list_entries shapes one: a channel entry when the name is to CHANNEL, a
    top-level one otherwise. Its ctime is CTIME, or the time of its own stamp when CTIME is None. The name need only fit MSG_RE, so
    a check can hand the census an Entry that list_entries would refuse, such as one whose stamp is not a time."""
    entries = []
    for name in names:
        m = MSG_RE.fullmatch(name)
        entries.append(Entry("channel" if m["to"] == channel else "top", name, m["to"], m["sender"], m["stamp"],
                             stamp_time(m["stamp"]) if ctime is None else ctime))
    return entries


def section(name):
    """Register the decorated function as the self-test section NAME. It takes the section's temporary directory."""
    def register(fn):
        SECTIONS[name] = fn
        return fn
    return register


def isolated_keys():
    return [k for k in os.environ if k.startswith(ISOLATED) or k in ("CLAUDE_JOB_DIR", "HOME")]


def isolated(fn):
    """Call fn(d) in a fresh temporary directory d that is also its HOME, with no agent-mail, agent-deck
    or Claude job variable set, and restore the caller's variables after."""
    saved = {k: os.environ.pop(k) for k in isolated_keys()}
    try:
        with tempfile.TemporaryDirectory() as root:
            os.environ["HOME"] = root
            fn(root)
    finally:
        for k in isolated_keys():
            del os.environ[k]
        os.environ.update(saved)


def run_section(name):
    """Run the section NAME isolated, and return the number of checks it passed."""
    before = CHECKS
    isolated(SECTIONS[name])
    return CHECKS - before


def self_test(names=()):
    """Run the named sections, or every section, in the order they are defined. The first failed check ends the run."""
    unknown = [n for n in names if n not in SECTIONS]
    if unknown:
        print(f"steward-signals: no self-test section {unknown[0]!r}; the sections are {', '.join(SECTIONS)}", file=sys.stderr)
        return 2
    chosen = [name for name in SECTIONS if not names or name in names]  # fixed now: a check may register a section for a moment
    try:
        total = sum(run_section(name) for name in chosen)
    except TestFailed as e:
        print(f"steward-signals self-test FAILED: {e}", file=sys.stderr)
        return 1
    print(f"steward-signals self-test: {total} checks passed")
    return 0


