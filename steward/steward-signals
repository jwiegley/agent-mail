#!/usr/bin/env -S python3 -I
"""steward-signals: the read-only helper for a topic steward, and the checks on the steward's files.

A topic steward is an agent-deck conductor that watches one agent-mail channel. This helper reads
metadata only: it never opens a message file, never writes to the mailbox and never sends anything.

POLICY.md holds the steward's thresholds and self-caps as a Markdown table, | key | value | meaning |, with
one row for each key in POLICY_KEYS. A missing, unknown or repeated key, or a value its key cannot use (a
number above zero; for summary_local_time a time of day, HH:MM; for summary_tz a tz database name), is
refused with the key named; nothing falls back to a default.

Commands:
  self-test [SECTION ...]
      Run the built-in checks, each section in a fresh temporary home.
"""

import argparse
import contextlib
import io
import os
import re
import sys
import tempfile
import zoneinfo

REPO = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))  # the directory that holds steward/
POLICY_KEYS = (
    "stale_min", "idle_min", "question_min", "nudge_gap_min", "nudges_per_item_day", "busy_stuck_h", "deaf_min",
    "offer_items", "offer_every_h", "sends_per_turn", "sends_per_hour", "ledger_kb", "log_days", "back_after_min",
    "doorbell_delay_min", "tick_active_min", "tick_idle_min", "summary_local_time", "summary_tz",
)
NUMBER_RE = re.compile(r"[0-9]+(?:\.[0-9]+)?")
TIME_RE = re.compile(r"(?:[01][0-9]|2[0-3]):[0-5][0-9]")


# ---- policy ----

class PolicyError(Exception):
    """A POLICY.md the helper refuses. .key names the row that is wrong and .reason says how, both as the file has
    them. The message leaves out any question mark they hold, because nothing the steward prints may carry one."""

    def __init__(self, key, reason):
        super().__init__(f"steward-signals: POLICY.md: {key}: {reason}".replace("?", ""))
        self.key = key
        self.reason = reason


def policy_rows(text):
    """(key, value) for each data row of the Markdown tables in TEXT: the lines that start with "|", less each
    header row (the cells key and value, in any case) and each separator row. Any other row is a data row, so
    one that only looks like the header is refused later as an unknown key."""
    for line in text.splitlines():
        if line.lstrip().startswith("|"):
            cells = [cell.strip() for cell in line.strip().strip("|").split("|")] + ["", ""]  # padded: a short row has no value
            key, value = cells[0], cells[1]
            header = key.casefold() == "key" and value.casefold() == "value"
            separator = not (key + value).strip("-: ")  # only dashes and colons
            if not (header or separator):
                yield key, value


def policy_value(key, text):
    """The value of one row: the time of day for summary_local_time, a tz database name for summary_tz,
    else a number above zero."""
    if not text:
        raise PolicyError(key, "no value")
    if key == "summary_local_time":
        if TIME_RE.fullmatch(text) is None:
            raise PolicyError(key, f"expected a time of day such as 07:30, got {text!r}")
        return text
    if key == "summary_tz":
        try:
            zoneinfo.ZoneInfo(text)
        except (zoneinfo.ZoneInfoNotFoundError, ValueError, OSError):
            raise PolicyError(key, f"expected a tz database name such as America/Los_Angeles, got {text!r}") from None
        return text
    if NUMBER_RE.fullmatch(text) is None or float(text) == 0:
        raise PolicyError(key, f"expected a number above zero, such as 45 or 0.5, got {text!r}")
    return float(text) if "." in text else int(text)


def load_policy(path):
    """The thresholds and self-caps in the POLICY.md table at PATH, by key, in POLICY_KEYS order.
    Each key must have exactly one row: a missing, unknown or repeated key, or a value its key cannot use,
    raises PolicyError, so a typo is never replaced by a default."""
    with open(path, encoding="utf-8") as f:
        text = f.read()
    policy = {}
    for key, value in policy_rows(text):
        if key not in POLICY_KEYS:
            raise PolicyError(key, "unknown key")
        if key in policy:
            raise PolicyError(key, "listed twice")
        policy[key] = policy_value(key, value)
    for key in POLICY_KEYS:
        if key not in policy:
            raise PolicyError(key, "no row for this key")
    return {key: policy[key] for key in POLICY_KEYS}


# ---- self-test ----

SECTIONS = {}  # name -> function(d), in the order the sections are defined
CHECKS = 0  # checks passed so far, in every section
# Variable prefixes no section sees, besides HOME and CLAUDE_JOB_DIR. AGENT_DECK_ is on the list
# because agent-deck exports AGENT_DECK_CONDUCTOR_DIR, which is not an AGENTDECK_ name.
ISOLATED = ("AGENT_MAIL_", "AGENTDECK_", "AGENT_DECK_")


class TestFailed(Exception):
    """A check that did not hold; self_test is the only place that catches it. The message is what the check says."""


def ok(cond, what):
    """Count a passed check, or raise TestFailed naming the one that failed."""
    global CHECKS
    if not cond:
        raise TestFailed(what)
    CHECKS += 1


def raises(exc_type, fn, *args):
    """The exc_type that fn(*args) raises; a failed check when it raises none."""
    try:
        fn(*args)
    except exc_type as e:
        return e
    ok(False, f"{getattr(fn, '__name__', fn)} raised no {exc_type.__name__}")


def capture(fn, *args):
    """(stdout, status, stderr) of fn(*args); the status is its return value, or the code of the SystemExit it raised."""
    out, err = io.StringIO(), io.StringIO()
    status = None
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        try:
            status = fn(*args)
        except SystemExit as e:
            status = e.code
    return out.getvalue(), status, err.getvalue()


def write(d, name, text):
    """Write TEXT to the file NAME in directory D and return its path."""
    path = os.path.join(d, name)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)
    return path


def read(path):
    """The text of the UTF-8 file at PATH."""
    with open(path, encoding="utf-8") as f:
        return f.read()


def section(name):
    """Register the decorated function as the self-test section NAME. It takes the section's temporary directory."""
    def register(fn):
        SECTIONS[name] = fn
        return fn
    return register


def isolated_keys():
    return [k for k in os.environ if k.startswith(ISOLATED) or k in ("CLAUDE_JOB_DIR", "HOME")]


def isolated(fn):
    """Call fn(d) in a fresh temporary directory d that is also its HOME, with no agent-mail, agent-deck
    or Claude job variable set, and restore the caller's variables after."""
    saved = {k: os.environ.pop(k) for k in isolated_keys()}
    try:
        with tempfile.TemporaryDirectory() as root:
            os.environ["HOME"] = root
            fn(root)
    finally:
        for k in isolated_keys():
            del os.environ[k]
        os.environ.update(saved)


def run_section(name):
    """Run the section NAME isolated, and return the number of checks it passed."""
    before = CHECKS
    isolated(SECTIONS[name])
    return CHECKS - before


def self_test(names=()):
    """Run the named sections, or every section, in the order they are defined. The first failed check ends the run."""
    unknown = [n for n in names if n not in SECTIONS]
    if unknown:
        print(f"steward-signals: no self-test section {unknown[0]!r}; the sections are {', '.join(SECTIONS)}", file=sys.stderr)
        return 2
    chosen = [name for name in SECTIONS if not names or name in names]  # fixed now: a check may register a section for a moment
    try:
        total = sum(run_section(name) for name in chosen)
    except TestFailed as e:
        print(f"steward-signals self-test FAILED: {e}", file=sys.stderr)
        return 1
    print(f"steward-signals self-test: {total} checks passed")
    return 0


# ---- self-test section: policy ----

def test_harness_contract(d):
    before = CHECKS
    ok(True, "harness: a true check passes")
    ok(CHECKS == before + 1, "harness: a pass is counted")
    ok(str(raises(TestFailed, ok, False, "boom")) == "boom", "harness: a false check raises TestFailed naming itself")
    ok("raised no KeyError" in str(raises(TestFailed, raises, KeyError, dict)), "harness: raises fails when nothing is raised")
    ok(str(raises(TestFailed, raises, SystemExit, ok, False, "inner")) == "inner", "harness: raises does not absorb a failed check, even when it expects SystemExit")
    ok(str(raises(TestFailed, capture, ok, False, "inside")) == "inside", "harness: capture does not absorb a failed check")

    def speak(status):
        print("to stdout")
        print("to stderr", file=sys.stderr)
        return status

    ok(capture(speak, 7) == ("to stdout\n", 7, "to stderr\n"), "harness: capture returns stdout, status and stderr")
    ok(capture(sys.exit, 3)[1] == 3, "harness: capture takes the code of a SystemExit as the status")
    ok(read(write(d, "t.txt", "a\u2026b\n")) == "a\u2026b\n", "harness: write and read round-trip UTF-8")
    out, status, err = capture(main, ["self-test", "nosuch"])
    ok(status == 2 and out == "" and "no self-test section 'nosuch'" in err and "policy" in err, "harness: an unknown section is refused, naming the sections")
    SECTIONS["failing"] = lambda root: ok(False, "boom")
    try:
        failed = capture(self_test, ["failing"])
    finally:
        del SECTIONS["failing"]
    ok(failed == ("", 1, "steward-signals self-test FAILED: boom\n"), "harness: a failed check ends the self-test with status 1 and the FAILED line")
    ok(os.environ["HOME"] == d, "harness: a failed section still restores the environment")


def test_sections_are_isolated(d):
    names = ("AGENT_MAIL_DIR", "AGENTDECK_INSTANCE_ID", "AGENT_DECK_CONDUCTOR_DIR", "CLAUDE_JOB_DIR")
    os.environ.update({k: f"/real/{k}" for k in names})  # what the caller's shell may export
    seen = {}
    try:
        isolated(lambda root: seen.update(root=root, home=os.environ["HOME"], visible=[k for k in names if k in os.environ]))
        restored = all(os.environ.get(k) == f"/real/{k}" for k in names)
    finally:
        for k in names:
            os.environ.pop(k, None)
    ok(seen["visible"] == [], "harness: a section sees none of the agent-mail, agent-deck or Claude job variables")
    ok(seen["home"] == seen["root"] != d and not os.path.exists(seen["root"]), "harness: a section's HOME is its own temporary directory, removed after")
    ok(restored and os.environ["HOME"] == d, "harness: the caller's variables are restored")


def test_policy_parses_spec_values(d):
    p = load_policy(os.path.join(REPO, "steward", "POLICY.md"))
    ok(p["stale_min"] == 45 and p["idle_min"] == 20 and p["question_min"] == 30, "policy: spec thresholds")
    ok(p["nudges_per_item_day"] == 2 and p["busy_stuck_h"] == 2 and p["deaf_min"] == 15, "policy: nudge and deaf values")
    ok(p["tick_active_min"] == 15 and p["tick_idle_min"] == 60 and p["doorbell_delay_min"] == 5, "policy: ticks and delay")
    ok(p["summary_local_time"] == "07:30" and p["summary_tz"] == "America/Los_Angeles", "policy: summary time")
    ok(p["nudge_gap_min"] == 30 and p["offer_items"] == 3 and p["offer_every_h"] == 2, "policy: nudge gap and offer limits")
    ok(p["sends_per_turn"] == 6 and p["sends_per_hour"] == 20 and p["ledger_kb"] == 8 and p["log_days"] == 14 and p["back_after_min"] == 30, "policy: send caps, ledger, logs, back-after")
    ok(len(p) == 19, "policy: 19 keys")
    test = load_policy(os.path.join(REPO, "steward", "POLICY-test.md"))
    ok(type(p["stale_min"]) is int and type(test["busy_stuck_h"]) is float, "policy: whole numbers are ints, decimals floats")


def table_with(table, key, row):
    """The Markdown TABLE with the row for KEY replaced by ROW, which may be empty."""
    return "".join(row if line.startswith(f"| {key} |") else line for line in table.splitlines(True))


def test_policy_refuses_bad_values(d):
    # Each variant is written over d/POLICY.md and checked at once, before the next one replaces it.
    TABLE = read(os.path.join(REPO, "steward", "POLICY.md"))
    bad = write(d, "POLICY.md", TABLE.replace("| stale_min | 45 |", "| stale_min | forty-five |"))
    ok(raises(PolicyError, load_policy, bad).key == "stale_min", "policy: non-numeric value names its key")
    e = raises(PolicyError, load_policy, bad)
    ok(str(e) == f"steward-signals: POLICY.md: stale_min: {e.reason}" and "forty-five" in e.reason, "policy: the message names the file, the key and the reason")
    missing = write(d, "POLICY.md", table_with(TABLE, "idle_min", ""))
    ok(raises(PolicyError, load_policy, missing).key == "idle_min", "policy: missing key named")
    unknown = write(d, "POLICY.md", TABLE + "| idel_min | 20 | typo |\n")
    ok(raises(PolicyError, load_policy, unknown).key == "idel_min", "policy: unknown key named, no silent default")
    test = load_policy(os.path.join(REPO, "steward", "POLICY-test.md"))
    ok(set(test) == set(p := load_policy(os.path.join(REPO, "steward", "POLICY.md"))) and test["stale_min"] < p["stale_min"], "policy: test policy has the same keys and shorter values")
    day_zero = {"stale_min": 2, "idle_min": 1, "question_min": 1, "nudge_gap_min": 1, "busy_stuck_h": 0.1, "deaf_min": 1, "tick_active_min": 1, "tick_idle_min": 2}
    ok(all(test[k] == v for k, v in day_zero.items()), "policy: test policy has the day-zero values")
    ok(all(test[k] == p[k] for k in p if k not in day_zero), "policy: test policy leaves the rest unchanged")
    twice = write(d, "POLICY.md", TABLE + "| stale_min | 99 | again |\n")
    ok(raises(PolicyError, load_policy, twice).key == "stale_min", "policy: a key listed twice is refused, not resolved")
    for value in ("nan", "inf", "-5", "1e3", "45 min", "4,5"):
        odd = write(d, "POLICY.md", table_with(TABLE, "deaf_min", f"| deaf_min | {value} | odd |\n"))
        ok(raises(PolicyError, load_policy, odd).key == "deaf_min", f"policy: {value!r} is not a number")
    novalue = write(d, "POLICY.md", table_with(TABLE, "deaf_min", "| deaf_min |  | blank |\n"))
    e = raises(PolicyError, load_policy, novalue)
    ok(e.key == "deaf_min" and e.reason == "no value", "policy: a number key with no value is refused as having no value")
    notext = write(d, "POLICY.md", table_with(TABLE, "summary_tz", "| summary_tz |  | blank |\n"))
    e = raises(PolicyError, load_policy, notext)
    ok(e.key == "summary_tz" and e.reason == "no value", "policy: a text key with no value is refused as having no value")
    short = write(d, "POLICY.md", table_with(TABLE, "deaf_min", "| deaf_min |\n"))
    e = raises(PolicyError, load_policy, short)
    ok(e.key == "deaf_min" and e.reason == "no value", "policy: a row with no value cell is refused as having no value, not a crash")


def test_policy_header_and_stray_rows(d):
    TABLE = read(os.path.join(REPO, "steward", "POLICY.md"))
    capitalised = write(d, "POLICY.md", TABLE.replace("| key | value | meaning |", "| Key | Value | Meaning |"))
    ok(load_policy(capitalised) == load_policy(os.path.join(REPO, "steward", "POLICY.md")), "policy: a capitalised header row is still a header")
    for stray_key in ("Key", "key"):
        stray = write(d, "POLICY.md", TABLE + f"| {stray_key} | 5 | stray |\n")
        ok(raises(PolicyError, load_policy, stray).key == stray_key, f"policy: a row {stray_key!r} | 5 is refused as an unknown key, not skipped as a header")


def test_policy_checks_values(d):
    TABLE = read(os.path.join(REPO, "steward", "POLICY.md"))

    def with_value(key, value):
        """The path of a POLICY.md in which KEY has VALUE, written over d/POLICY.md and to be used at once."""
        return write(d, "POLICY.md", table_with(TABLE, key, f"| {key} | {value} | odd |\n"))

    for value in ("banana", "7:30", "24:00", "07:60", "0730", "07:30pm"):
        ok(raises(PolicyError, load_policy, with_value("summary_local_time", value)).key == "summary_local_time", f"policy: {value!r} is not a time of day")
    for value in ("00:00", "23:59"):
        ok(load_policy(with_value("summary_local_time", value))["summary_local_time"] == value, f"policy: {value} is a time of day")
    for value in ("America/Los_Angelas", "banana", "America/", "../etc/passwd"):
        ok(raises(PolicyError, load_policy, with_value("summary_tz", value)).key == "summary_tz", f"policy: {value!r} is not a tz database name")
    ok(load_policy(with_value("summary_tz", "UTC"))["summary_tz"] == "UTC", "policy: UTC is a tz database name")
    for value in ("0", "0.0", "00"):
        ok(raises(PolicyError, load_policy, with_value("tick_active_min", value)).key == "tick_active_min", f"policy: {value!r} is not above zero")
    ok(load_policy(with_value("tick_active_min", "0.5"))["tick_active_min"] == 0.5, "policy: a fraction above zero is a number")


def test_policy_message_has_no_question_mark(d):
    TABLE = read(os.path.join(REPO, "steward", "POLICY.md"))
    variants = (("a value", table_with(TABLE, "stale_min", "| stale_min | 45? | odd |\n"), "stale_min"),
                ("a key", TABLE + "| idel_min? | 20 | typo |\n", "idel_min?"),
                ("a time", table_with(TABLE, "summary_local_time", "| summary_local_time | soon? | odd |\n"), "summary_local_time"),
                ("a zone", table_with(TABLE, "summary_tz", "| summary_tz | Mars/Olympus? | odd |\n"), "summary_tz"))
    for what, text, key in variants:
        e = raises(PolicyError, load_policy, write(d, "POLICY.md", text))
        ok(e.key == key and "?" not in str(e) and key.replace("?", "") in str(e), f"policy: a question mark in {what} does not reach the message")


@section("policy")
def section_policy(d):
    test_harness_contract(d)
    test_sections_are_isolated(d)
    test_policy_parses_spec_values(d)
    test_policy_refuses_bad_values(d)
    test_policy_header_and_stray_rows(d)
    test_policy_checks_values(d)
    test_policy_message_has_no_question_mark(d)


# ---- main ----

def build_parser():
    p = argparse.ArgumentParser(prog="steward-signals", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True, metavar="COMMAND")
    st = sub.add_parser("self-test", help="run the built-in checks",
                        description="Run the built-in checks, every section or the named ones, each in a fresh temporary home "
                                    "with no agent-mail, agent-deck or Claude job variables.")
    st.add_argument("sections", nargs="*", metavar="SECTION")
    return p


def main(argv):
    a = build_parser().parse_args(argv)
    if a.cmd == "self-test":
        return self_test(a.sections)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
