def other_script_values(zero):
    """(key, value) pairs of POLICY.md that hold digits of another script, the one whose zero is the code point ZERO: all the digits of a value, and one of them
    among ASCII ones, in each place that a pattern could take by mistake."""
    def other(text):
        return digits_as(text, zero)

    return (("stale_min", other("45")), ("stale_min", "4" + other("5")), ("busy_stuck_h", other("4.5")), ("busy_stuck_h", "4." + other("5")),
            ("sends_per_hour", other("20")), ("sends_per_hour", "2" + other("0")), ("summary_local_time", other("07:30")),
            ("summary_local_time", "0" + other("7") + ":30"), ("summary_local_time", "07:3" + other("0")))


