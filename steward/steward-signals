    ok(restored and CHECKS == before and len(failures) == 3
       and failures[:2] == ["docs: CLAUDE.md has '## 9. Questions to John'", "docs: no stray question marks outside code blocks and the template"]
       and failures[2].startswith("docs: CLAUDE.md's headings of the first two levels"),
       f"docs: docs_checks lists every failure in the checkout it is given, in order, without stopping at the first or counting a check, and puts ok and REPO back (got {failures!r})")
    nothing = os.path.join(d, "nothing")
