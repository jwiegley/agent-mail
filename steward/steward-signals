def test_docs_checks_keeps_to_its_limits(d):
    went_on = []

    def expects_a_raise(_):
        raises(KeyError, dict)  # dict() raises nothing: raises reports it through ok and returns None
        went_on.append("raises returned")

    def writes(directory):
        write(directory, "x.txt", "")

    def reads_policy(_):
        went_on.append(read(os.path.join(conductor_dir(d), "POLICY.md")))

    checkout = os.path.join(d, "with-policy")
    os.makedirs(os.path.join(checkout, "steward"))
    write(os.path.join(checkout, "steward"), "POLICY.md", "the POLICY.md of the checkout given\n")
    saved, before = DOCS_CHECKS, tree(checkout)
    globals()["DOCS_CHECKS"] = (expects_a_raise, writes, reads_policy)
    try:
        failures = docs_checks(checkout)
    finally:
        globals()["DOCS_CHECKS"] = saved
    ok(failures[:1] == ["dict raised no KeyError"] and went_on[:1] == ["raises returned"], "docs: under docs_checks, raises lists its failure, returns None, and the check goes on")
    ok(len(failures) == 2 and failures[1].startswith("docs: writes could not go on: TypeError") and tree(checkout) == before,
       "docs: each check function receives None for its directory, so one that writes fails and writes nothing")
    ok(went_on[1:] == ["the POLICY.md of the checkout given\n"], "docs: conductor_dir copies the POLICY.md of the checkout that docs_checks was given")


