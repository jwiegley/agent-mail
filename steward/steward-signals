    tr = sub.add_parser("traffic", help="print a topic's traffic matters",
                        description="Print the traffic matters of the topic whose steward keeps its files in CONDUCTOR_DIR, from file names alone: for each member "
                                    f"of its TOPIC.md and each name the member has mailed, one line when some of that direct mail still waits in the mailbox's top "
                                    f"level, stamped in the last {TRAFFIC_HOURS} hours and not more than {TOPIC_ALLOWANCE_S // 60} minutes before topic_since in "
                                    "CONDUCTOR_DIR/steward-state.json, and has waited deaf_min or more by its stamp: no-record when no session has ever read mail as "
