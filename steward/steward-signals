def test_fake_run(d):
    run = fake_run({"session": "short", "session output lfm3": ["long", 0], "list": ("", 3)})
    ok(run(["agent-deck", "session", "output", "lfm3", "--max-tokens", "200"]) == ("long", 0), "deck: the longest key that fits answers, and a list value works as a pair")
    ok(run(["agent-deck", "session", "output", "pi"]) == ("short", 0), "deck: a shorter key answers what only it fits")
    ok(run(["agent-deck", "list", "--json"]) == ("", 3) and run(["agent-deck", "stop", "lfm3"]) == ("", 1), "deck: a key's code is returned, and a command that fits no key fails")
    ok(run(["agent-deck", "listing"]) == ("", 1) and len(run.calls) == 5, "deck: a key fits whole words only, and every argv is kept")


