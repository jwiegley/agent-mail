            items = list(found)
        held = items[0].is_file(follow_symlinks=False), items[0].stat(follow_symlinks=False).st_ctime, items[0].inode(), os.lstat(box).st_ino
        first = dict(calls)
        again = [raises(OSError, way) for way in (lambda: os.scandir(box), lambda: items[0].is_file(), lambda: os.stat(path), lambda: os.lstat(box))]
    ok(first == {("scandir", box): 1, ("is_file", path): 1, ("stat", path): 1, ("stat", box): 1} and held[0] is True and held[1] == os.lstat(path).st_ctime
       and held[2] == os.lstat(path).st_ino, "census: the counter counts a listing, an entry's is_file and stat, and a stat by path, each by its directory or path, "
       "and an entry answers as the real one does, other methods included")
