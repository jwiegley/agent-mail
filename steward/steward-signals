@contextlib.contextmanager
def listing_as(change):
    """Within the block, os.scandir lists a directory through CHANGE(path, found): CHANGE gets the DirEntries the real scandir found
    as a list, may change the directory, and returns the list the caller will see. It hands the census a listing in any order, or
    one that has gone out of date."""
    scandir = os.scandir

    def changed(path):
        return contextlib.nullcontext(iter(change(path, list(scandir(path)))))

    os.scandir = changed
    try:
        yield
    finally:
        os.scandir = scandir


class Unreadable:
    """A stand-in for a DirEntry whose file can be seen but whose metadata cannot be read: it answers is_file as ITEM, the real
    entry, does, and its stat raises ERROR."""

    def __init__(self, item, error):
        self.name, self.item, self.error = item.name, item, error

    def is_file(self, follow_symlinks=True):
        return self.item.is_file(follow_symlinks=follow_symlinks)

    def stat(self, follow_symlinks=True):
        raise self.error


@contextlib.contextmanager
def files_refused():
    """Within the block, each way the standard library opens a file by name (open, io.open, os.open, Path.open, Path.read_text and
    Path.read_bytes) records its arguments in the list the block gets, and raises OSError."""
    opened = []

    def refuse(*args, **kwargs):
        opened.append(args)
        raise OSError("a file was opened")

    ways = [(builtins, "open"), (io, "open"), (os, "open"), (pathlib.Path, "open"), (pathlib.Path, "read_text"), (pathlib.Path, "read_bytes")]
    own = {(owner, name): vars(owner)[name] for owner, name in ways if name in vars(owner)}  # what each owner holds itself, not by inheritance
    for owner, name in ways:
        setattr(owner, name, refuse)
    try:
        yield opened
    finally:
        for owner, name in ways:
            if (owner, name) in own:
                setattr(owner, name, own[owner, name])
            else:
                delattr(owner, name)


def test_listing_order_is_the_stamps_not_the_filesystems(d):
    names = [f"pipeline_{stamp(5)}_from-nix_00000002.txt", f"lfm3_{stamp(5)}_from-nix_00000001.txt", f"glm-5.2_{stamp(3)}_from-nix_00000003.txt",
             f"omlx_{stamp(9)}_from-nix_00000004.txt"]
    box = mailbox(d, top=names)
    expected = [names[2], names[1], names[0], names[3]]  # by stamp, and by name where the stamps are one
    forward = [x.name for x in list_entries(box, "ingest")]
    with listing_as(lambda path, found: found[::-1]):
        backward = [x.name for x in list_entries(box, "ingest")]
    ok(forward == backward == expected, "census: the order of the entries is by stamp, then name, whatever order the filesystem lists them in")


def test_list_entries_in_a_changing_mailbox(d):
    gone, kept = f"pipeline_{stamp(1)}_from-nix_00000001.txt", f"pipeline_{stamp(2)}_from-nix_00000002.txt"
    box = mailbox(d, top=[gone, kept])
    ok([x.name for x in list_entries(box, "nosuch")] == [gone, kept], "census: a channel that does not exist has no posts, and is no error")
    write(box, "+file", "")
    ok([x.name for x in list_entries(box, "file")] == [gone, kept], "census: nor is a +channel that is a file, not a directory")

    def claim(path, found):
        if os.path.lexists(os.path.join(path, gone)):
            os.remove(os.path.join(path, gone))  # the member's reader claims it before the census asks about it
        return found

    with listing_as(claim):
        names = [x.name for x in list_entries(box, "nosuch")]
    ok(names == [kept], "census: a file that is claimed after the listing is left out, not an error")


def test_the_guard_refuses_every_way_to_open_a_file(d):
    path = write(d, "any.txt", "")
    ways = {"open": lambda: open(path), "io.open": lambda: io.open(path), "os.open": lambda: os.open(path, os.O_RDONLY),
            "Path.open": lambda: pathlib.Path(path).open(), "Path.read_text": lambda: pathlib.Path(path).read_text(),
            "Path.read_bytes": lambda: pathlib.Path(path).read_bytes()}
    with files_refused() as opened:
        for name, way in ways.items():
            try:
                way()
            except OSError:
                continue
            ok(False, f"census: the guard let {name} open a file")
    ok(len(opened) == len(ways), "census: the guard refuses open, io.open, os.open, Path.open, Path.read_text and Path.read_bytes")
    ok(read(path) == "" and pathlib.Path(path).read_text() == "", "census: the guard puts every way to open a file back")


