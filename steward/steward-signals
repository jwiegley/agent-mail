def raising(error):
    """A run(argv) that raises ERROR."""
    def run(argv):
        raise error

    return run


@contextlib.contextmanager
def subprocess_as(stub):
    """Within the block, subprocess.run is STUB, so that a check which reaches real_run starts no process."""
    run = subprocess.run
    subprocess.run = stub
    try:
        yield
    finally:
        subprocess.run = run


@contextlib.contextmanager
def fd2_to(path):
    """Within the block, the file descriptor 2 of this process is the file at PATH. A child inherits it, and sys.stderr does not reach it."""
    saved = os.dup(2)
    try:
        with open(path, "wb") as f:
            os.dup2(f.fileno(), 2)
            yield
    finally:
        os.dup2(saved, 2)
        os.close(saved)


@contextlib.contextmanager
def agent_deck_refused():
    """Within the block, a start of agent-deck through subprocess.Popen is refused. Popen is the only way this file starts a process, and subprocess.run
    and the other ways of starting one that subprocess has call it; a start by another way, os.system, os.exec* or os.posix_spawn, would not be caught, and
    the file makes none. A start whose program is named agent-deck, by whatever path, is recorded in the list the block gets, as the words of its command,
    and raises OSError. A command line for a shell is split as a shell splits it, so that a quoted path with spaces in it is one word, and one that cannot be
    split, for a quote that is never closed, is read as plain words. Any other program starts as it is given."""
    started = []
    popen = subprocess.Popen

    def guarded(args, *rest, **kwargs):
        if isinstance(args, str):
            try:
                words = shlex.split(args)
            except ValueError:  # a quote that is never closed: the shell would refuse the line, but the guard reads it as plain words
                words = args.split()
        else:
            words = list(args)
        if words and os.path.basename(words[0]) == "agent-deck":
            started.append(words)
            raise OSError("agent-deck was started")
        return popen(args, *rest, **kwargs)

    subprocess.Popen = guarded
    try:
        yield started
    finally:
