def test_a_title_listed_twice_reads_as_its_best_row(d):
    stopped = {"status": "stopped", "last_activity_at": "2026-10-31T20:00:00Z"}
    archived = {"status": "idle", "archived": True, "last_activity_at": "2026-10-31T21:00:00Z"}
    running = {"status": "running", "last_activity_at": "2026-10-31T10:00:00Z"}
    for what, dead in (("stopped", stopped), ("archived", archived)):
        ok(row_for(dead, running)["status"] == "running" and row_for(running, dead)["status"] == "running", f"deck: a {what} row never hides a live one with its title, in either order")
    later = {"status": "waiting", "last_activity_at": "2026-10-31T12:00:00Z"}
    ok(row_for(running, later)["status"] == "waiting" and row_for(later, running)["status"] == "waiting", "deck: of two live rows the later last_activity wins, in either order")
    offset_later = {"status": "waiting", "last_activity_at": "2026-10-31T15:39:01-07:00"}  # 22:39:01Z: later than utc_earlier, though its digits are smaller
    utc_earlier = {"status": "running", "last_activity_at": "2026-10-31T22:32:31Z"}
    ok(row_for(utc_earlier, offset_later)["status"] == "waiting" and row_for(offset_later, utc_earlier)["status"] == "waiting", "deck: last_activity is compared as a time, not by its digits")
    ok(row_for({"status": "idle", "last_activity_at": "yesterday"}, later)["status"] == "waiting" and row_for(later, {"status": "idle"})["status"] == "waiting", "deck: a row whose last_activity cannot be read ranks last")
    ok(row_for({"status": "idle"}, {"status": "waiting"})["status"] == "idle", "deck: when nothing tells two live rows apart, the first listed stays")
    older = {"status": "stopped", "last_activity_at": "2026-10-30T20:00:00Z"}
    ok(row_for(older, stopped)["last_activity"] == "2026-10-31T20:00:00Z" and row_for(stopped, older)["last_activity"] == "2026-10-31T20:00:00Z", "deck: with no live row, the later last_activity wins")


