    me.add_argument("--set", dest="settings", action="append", required=True, metavar="KEY=VALUE", help="a counter or a text to merge in; repeat the option for each key, and give at least one")
    return p


def main(argv):
    if sys.version_info < MIN_PYTHON:
        print(f"steward-signals: Python {MIN_PYTHON[0]}.{MIN_PYTHON[1]} or later is needed, and this is {sys.version_info[0]}.{sys.version_info[1]}", file=sys.stderr)
        return 2
    a = build_parser().parse_args(argv)
    if a.cmd == "self-test":
        return self_test(a.sections)
    if a.cmd in ("signals", "probe"):
