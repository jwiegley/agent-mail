# What may follow never in front of a naming of /send in SHARED.md and HEARTBEAT_RULES.md: forward, relay or type it (forward takes an article, "never forward a
# `/send ...` line"), or run or use it.
SEND_VERBS = r"(?:forward|relay|type)(?: (?:a|an|each|every|any|the))?|run|use"


def governed_namings(text, command, verbs="run|use"):
    """The namings of COMMAND in TEXT that a never governs: each ends a list of backticked commands that "never" and one of VERBS (a pattern, "run|use" unless
    given) opens, so that a never in another clause of the sentence ("When a member never answers, run ...") forbids nothing."""
    return re.findall(rf"\bnever (?:{verbs}) (?:`[^`\n]*`(?:, or |, and |, | or | and ))*`{re.escape(command)}(?: [^`\n]*)?`", text, re.I)


