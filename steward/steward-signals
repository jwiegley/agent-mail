KEYS_HELP_WIDTH = 100  # the most columns of a line of the top-level help's list of POLICY.md keys, its indent of four included, inside the width of that paragraph


def help_description():
    """The module docstring as the top-level --help prints it: the names EXCEPTION_LINES and POLICY_KEYS, which the docstring uses since it cannot be an
    f-string, given as what they hold: the number, as the signals help gives it, and the keys, in their order and joined by commas, wrapped into lines
    indented four columns and at most KEYS_HELP_WIDTH wide, so that the list reads as a list."""
    keys = textwrap.fill(", ".join(POLICY_KEYS), width=KEYS_HELP_WIDTH, initial_indent="    ", subsequent_indent="    ")
    return (__doc__ or "").replace("EXCEPTION_LINES", str(EXCEPTION_LINES)).replace("POLICY_KEYS", keys)


def build_parser():
    p = argparse.ArgumentParser(prog="steward-signals", description=help_description(), formatter_class=argparse.RawDescriptionHelpFormatter)
