"""
LFM3_COMMAND = ["agent-deck", "session", "output", "lfm3", "--max-tokens", "200"]  # the command line that the probe of lfm3 runs
# What that command prints, as agent-deck 1.16.34 does (its source, cmd/agent-deck/session_output_cmd.go and output_budget.go, and the strings of the installed
# binary): a header, then the response. A response over the cap, 4 bytes for each token, is cut to its head and its tail around a seam, and a footer names the
# file that keeps all of it.
OUTPUT_HEADER = "Session: lfm3 (claude)\nTime: 2026-10-31T22:39:01Z\n---\n"
OUTPUT_SEAM = "\n\n\u2026 output omitted \u2026\n\n"
OUTPUT_FOOTER = "\n\n\u2026 output truncated to 200 tokens; full output at /Users/johnw/.agent-deck/output/8e1a2c/latest-response.txt\n"
WHOLE_OUTPUT = OUTPUT_HEADER + "\u23fa Done.\n\nShould I push to main?\n"
CUT_OUTPUT = (OUTPUT_HEADER + "\u23fa Converted all 14 shards of lfm3 and ran the evaluation against the held-out set. The table below is the e"
              + OUTPUT_SEAM + "ion that fixed the loader, so the numbers match the reference run.\n\nShould I push to main?" + OUTPUT_FOOTER)


def probe_text(text):
    """What probe says of lfm3, on hera, when agent-deck prints TEXT."""
    return probe(fake_run({"session output lfm3": text}), "lfm3", "hera")


def raising(error):
    """A run(argv) that raises ERROR."""
    def run(argv):
        raise error

    return run


@contextlib.contextmanager
def subprocess_as(stub):
    """Within the block, subprocess.run is STUB, so that a check which reaches real_run starts no process."""
    run = subprocess.run
    subprocess.run = stub
    try:
        yield
    finally:
        subprocess.run = run


@contextlib.contextmanager
def fd2_to(path):
    """Within the block, the file descriptor 2 of this process is the file at PATH. A child inherits it, and sys.stderr does not reach it."""
    saved = os.dup(2)
    try:
        with open(path, "wb") as f:
            os.dup2(f.fileno(), 2)
            yield
    finally:
        os.dup2(saved, 2)
        os.close(saved)


@contextlib.contextmanager
def agent_deck_refused(programs=("agent-deck",)):
    """Within the block, a start of agent-deck through subprocess.Popen is refused. Popen is the only way this file starts a process, and subprocess.run
    and the other ways of starting one that subprocess has call it; a start by another way, os.system, os.exec* or os.posix_spawn, would not be caught, and
    the file makes none. A start whose program is named agent-deck, or another of PROGRAMS, by whatever path, is recorded in the list the block gets, as
    the words of its command, and raises OSError. A command line for a shell is split as a shell splits it, so that a quoted path with spaces in it is one word, and one that cannot be
    split, for a quote that is never closed, is read as plain words. Any other program starts as it is given."""
    started = []
    popen = subprocess.Popen

    def guarded(args, *rest, **kwargs):
        if isinstance(args, str):
            try:
                words = shlex.split(args)
            except ValueError:  # a quote that is never closed: the shell would refuse the line, but the guard reads it as plain words
                words = args.split()
        else:
            words = list(args)
        if words and os.path.basename(words[0]) in programs:
            started.append(words)
            raise OSError(f"{os.path.basename(words[0])} was started")
        return popen(args, *rest, **kwargs)

    subprocess.Popen = guarded
    try:
        yield started
    finally:
        subprocess.Popen = popen


