DAY = "2026-11-03"


def conductor_in(d):
    """The path of a new, empty directory in D, so that no check sees the files of another."""
    return tempfile.mkdtemp(dir=d)


def metrics_file(c, day=DAY):
    """The path of the metrics file of DAY in the conductor directory C."""
    return os.path.join(c, "metrics", f"{day}.json")


def metrics_of(c, day=DAY):
    """The JSON object in the metrics file of DAY in the conductor directory C."""
    return json.loads(read(metrics_file(c, day)))


def set_args(c, *pairs, day=DAY):
    """The arguments of the metrics command for the conductor directory C that give DAY and each of PAIRS, "key=value", as a --set."""
    return ["metrics", "--dir", c, "--date", day] + [word for pair in pairs for word in ("--set", pair)]


def refusal_of(fn, *args):
    """The message of the ValueError that fn(*args) raises, or None when it raises none."""
    try:
        fn(*args)
    except ValueError as e:
        return str(e)
    return None


def nothing_made(c):
    """Whether the directory C holds nothing."""
    return os.listdir(c) == []


@contextlib.contextmanager
def in_directory(path):
    """Within the block, the current directory is PATH, so that a name that fell back to it would write there and not in the checkout."""
    here = os.getcwd()
    os.chdir(path)
    try:
        yield
    finally:
        os.chdir(here)


@contextlib.contextmanager
def local_zone(zone):
    """Within the block, the local time zone of this process is ZONE, a POSIX zone such as UTC-14 (14 hours east of UTC), which needs no tz database."""
    saved = os.environ.get("TZ")
    os.environ["TZ"] = zone
    time.tzset()
    try:
        yield
    finally:
        if saved is None:
            del os.environ["TZ"]
        else:
            os.environ["TZ"] = saved
        time.tzset()


@contextlib.contextmanager
def os_through(name, hook):
    """Within the block, os.NAME calls HOOK with its arguments and then, unless HOOK raises, does what it was asked to."""
    real = getattr(os, name)

    def watched(*args, **kwargs):
        hook(*args)
        return real(*args, **kwargs)

    setattr(os, name, watched)
    try:
        yield
    finally:
        setattr(os, name, real)


def replace_through(hook):
    """Within the block, os.replace calls HOOK(src, dst) and then, unless HOOK raises, moves the file as it was asked to."""
    return os_through("replace", hook)


