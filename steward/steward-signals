# ---- main ----

def build_parser():
    p = argparse.ArgumentParser(prog="steward-signals", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True, metavar="COMMAND")
    st = sub.add_parser("self-test", help="run the built-in checks",
                        description="Run the built-in checks, every section or the named ones, each in a fresh temporary home "
                                    "with no agent-mail, agent-deck or Claude job variables.")
    st.add_argument("sections", nargs="*", metavar="SECTION")
    return p


def main(argv):
    a = build_parser().parse_args(argv)
    if a.cmd == "self-test":
        return self_test(a.sections)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
