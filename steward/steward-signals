# SENT.log and NOTES.log for the end-to-end checks: neither names the steward's file to lfm3 nor the mail from glm-5.2 to pipeline, and no intent is open.
SIGNALS_SENT = "intent 1 20261101T000000Z pipeline DECISION_ingest-1 ab12\nsent 1 pipeline_20261101T000001.000000Z_from-conductor-ingest-steward_22222222\n"
SIGNALS_NOTES = "20261101T000002Z omlx_20261101T000002.000000Z_from-pipeline_33333333\n"


def conductor_dir(d, topic=TOPIC_WITH_TABLE, policy=None, sent="", notes="", name="ingest-steward"):
    """The path of a new conductor directory NAME (so the steward is conductor-NAME) in a new directory in D, holding TOPIC.md, POLICY.md (the checkout's when
    POLICY is None), SENT.log and NOTES.log with the texts given."""
    where = os.path.join(tempfile.mkdtemp(dir=d), name)
    os.mkdir(where)
    write(where, "TOPIC.md", topic)
    write(where, "POLICY.md", read(os.path.join(REPO, "steward", "POLICY.md")) if policy is None else policy)
    write(where, "SENT.log", sent)
    write(where, "NOTES.log", notes)
    return where


class Snapshot(dict):
    """What tree() saw: each path under a directory, mapped to what was there. A file is its mtime and its bytes, a symlink its target, and a directory only that
    it is one, since its mtime changes whenever a name is made or removed in it. SNAPSHOT - EARLIER is the set of paths made, changed or removed since EARLIER."""

    def __sub__(self, earlier):
        return {path for path in self.keys() | earlier.keys() if self.get(path) != earlier.get(path)}


def tree(d):
    """A Snapshot of everything under the directory D, no symlink followed."""
    seen = Snapshot()
    for root, dirs, files in os.walk(d):
        for name in dirs + files:
            path = os.path.join(root, name)
            st = os.lstat(path)
            if stat.S_ISLNK(st.st_mode):
                seen[path] = ("link", os.readlink(path))
            elif stat.S_ISDIR(st.st_mode):
                seen[path] = ("directory",)
            else:
                seen[path] = ("file", st.st_mtime_ns, pathlib.Path(path).read_bytes())
    return seen


def deck_fixture(d, answers=None):
    """The path of a --run-fixture file in D: hera lists HERA_LIST and andoria-08 lists ANDORIA_LIST, so that of TOPIC_WITH_TABLE's members pipeline is waiting,
    glm-5.2 running and omlx not in agent-deck; ANSWERS (fake_run's keys and values) are added or replace those."""
    return write(d, "deck.json", json.dumps({"list": json.dumps(HERA_LIST), "remote andoria-08": json.dumps(ANDORIA_LIST), **(answers or {})}))


def signals_scene(d):
    """The topic the end-to-end checks read, made afresh: (the conductor directory, the mailbox, the deck fixture, the stamps s1, s2 and s3). The mailbox holds
    mail from glm-5.2 to pipeline an hour old, a file in the steward's name to lfm3 that SENT.log does not account for, half an hour old, and a post to +ingest
    ten minutes old; pipeline's member record is two hours old, and the others have none."""
    now = time.time()
