@contextlib.contextmanager
def listing_as(change):
    """Within the block, os.scandir lists a directory through CHANGE(path, found): CHANGE gets the DirEntries the real scandir found
    as a list, may change the directory, and returns the list the caller will see. It hands the census a listing in any order, or
    one that has gone out of date."""
    scandir = os.scandir

    def changed(path):
        return contextlib.nullcontext(iter(change(path, list(scandir(path)))))

    os.scandir = changed
    try:
        yield
    finally:
        os.scandir = scandir


class Counted:
    """A stand-in for the DirEntry ITEM that answers is_file and stat as it does, after calling COUNT with ("is_file", its path) or ("stat", its path), and
    hands any other attribute on to ITEM uncounted. A DirEntry's own methods cannot be replaced on its type, so listing_counted lists these in its place."""

    def __init__(self, item, count):
        self.name, self.path, self.item, self.count = item.name, item.path, item, count

    def is_file(self, follow_symlinks=True):
        self.count(("is_file", self.path))
        return self.item.is_file(follow_symlinks=follow_symlinks)

    def stat(self, follow_symlinks=True):
        self.count(("stat", self.path))
        return self.item.stat(follow_symlinks=follow_symlinks)

    def __getattr__(self, name):
        return getattr(self.item, name)


@contextlib.contextmanager
def listing_counted():
    """Within the block, the calls that list a directory or read an entry's metadata are counted in the Counter the block gets: ("scandir", the directory) for
    os.scandir, whose entries are Counted stand-ins that count ("is_file", the path) and ("stat", the path), and ("stat", the path) for os.stat and os.lstat
    too, so that a stat by path counts as the entry's own does. A second call under one key raises OSError at once, after it is counted, so that a listing whose
    calls grow with the square of its entries stops at its first repeat instead of running for minutes."""
    calls, real = collections.Counter(), {name: getattr(os, name) for name in ("scandir", "stat", "lstat")}

    def count(key):
        calls[key] += 1
        if calls[key] > 1:
            raise OSError(f"{key[0]} called again for {key[1]}")

    def scandir(path="."):
        count(("scandir", os.fspath(path)))
        with real["scandir"](path) as found:
            return contextlib.nullcontext(iter([Counted(item, count) for item in found]))

    def by_path(name):
        def stat(path, *args, **kwargs):
            count(("stat", path if isinstance(path, int) else os.fspath(path)))
            return real[name](path, *args, **kwargs)
        return stat

    os.scandir, os.stat, os.lstat = scandir, by_path("stat"), by_path("lstat")
    try:
        yield calls
    finally:
        os.scandir, os.stat, os.lstat = real["scandir"], real["stat"], real["lstat"]


class Unreadable:
    """A stand-in for a DirEntry whose file can be seen but whose metadata cannot be read: it answers is_file as ITEM, the real
    entry, does, and its stat raises ERROR."""

    def __init__(self, item, error):
        self.name, self.item, self.error = item.name, item, error

    def is_file(self, follow_symlinks=True):
        return self.item.is_file(follow_symlinks=follow_symlinks)

    def stat(self, follow_symlinks=True):
        raise self.error


@contextlib.contextmanager
def files_refused():
    """Within the block, each way the standard library opens a file by name (open, io.open, os.open, Path.open, Path.read_text and
    Path.read_bytes) records its arguments in the list the block gets, and raises OSError."""
    opened = []

    def refuse(*args, **kwargs):
        opened.append(args)
        raise OSError("a file was opened")

    ways = [(builtins, "open"), (io, "open"), (os, "open"), (pathlib.Path, "open"), (pathlib.Path, "read_text"), (pathlib.Path, "read_bytes")]
    own = {(owner, name): vars(owner)[name] for owner, name in ways if name in vars(owner)}  # what each owner holds itself, not by inheritance
    for owner, name in ways:
        setattr(owner, name, refuse)
    try:
        yield opened
    finally:
        for owner, name in ways:
            if (owner, name) in own:
                setattr(owner, name, own[owner, name])
            else:
                delattr(owner, name)


