def test_harness_contract(d):
    before = CHECKS
    out, _, err = capture(ok, True, "unused")  # the call under test: a check that holds
    ok(out == "" and err == "" and CHECKS == before + 1, "harness: a true check passes in silence and is counted once")
    ok(str(raises(TestFailed, ok, False, "boom")) == "boom", "harness: a false check raises TestFailed naming itself")
    ok("raised no KeyError" in str(raises(TestFailed, raises, KeyError, dict)), "harness: raises fails when nothing is raised")
    ok(str(raises(TestFailed, raises, SystemExit, ok, False, "inner")) == "inner", "harness: raises does not absorb a failed check, even when it expects SystemExit")
    ok(str(raises(TestFailed, capture, ok, False, "inside")) == "inside", "harness: capture does not absorb a failed check")

    def speak(status):
        print("to stdout")
        print("to stderr", file=sys.stderr)
        return status

    ok(capture(speak, 7) == ("to stdout\n", 7, "to stderr\n"), "harness: capture returns stdout, status and stderr")
    ok(capture(sys.exit, 3)[1] == 3, "harness: capture takes the code of a SystemExit as the status")
    ok(read(write(d, "t.txt", "a\u2026b\n")) == "a\u2026b\n", "harness: write and read round-trip UTF-8")
    out, status, err = capture(main, ["self-test", "nosuch"])
    ok(status == 2 and out == "" and "no self-test section 'nosuch'" in err and "policy" in err, "harness: an unknown section is refused, naming the sections")
    SECTIONS["failing"] = lambda root: ok(False, "boom")
    try:
        failed = capture(self_test, ["failing"])
    finally:
        del SECTIONS["failing"]
    ok(failed == ("", 1, "steward-signals self-test FAILED: boom\n"), "harness: a failed check ends the self-test with status 1 and the FAILED line")
    ok(os.environ["HOME"] == d, "harness: a failed section still restores the environment")


def test_sections_are_isolated(d):
    names = ("AGENT_MAIL_DIR", "AGENTDECK_INSTANCE_ID", "AGENT_DECK_CONDUCTOR_DIR", "CLAUDE_JOB_DIR")
    os.environ.update({k: f"/real/{k}" for k in names})  # what the caller's shell may export
    seen = {}
    try:
        isolated(lambda root: seen.update(root=root, home=os.environ["HOME"], visible=[k for k in names if k in os.environ]))
        restored = all(os.environ.get(k) == f"/real/{k}" for k in names)
    finally:
        for k in names:
            os.environ.pop(k, None)
    ok(seen["visible"] == [], "harness: a section sees none of the agent-mail, agent-deck or Claude job variables")
    ok(seen["home"] == seen["root"] != d and not os.path.exists(seen["root"]), "harness: a section's HOME is its own temporary directory, removed after")
    ok(restored and os.environ["HOME"] == d, "harness: the caller's variables are restored")


# What a child Python runs to load this file as a module (its main block does not run), add a section that fails and one that passes, and exit with the status
# of main on the arguments after the file's path. The sections are added after loading, so that the file holds nothing that only a check uses.
LOAD_AND_RUN = """\
import importlib.machinery, importlib.util, sys
sys.dont_write_bytecode = True
loader = importlib.machinery.SourceFileLoader("steward_signals_under_test", sys.argv[1])
module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(module)
module.SECTIONS["failing"] = lambda root: module.ok(False, "boom")
module.SECTIONS["passing"] = lambda root: (module.ok(True, "one"), module.ok(True, "two"))
sys.exit(module.main(sys.argv[2:]))
"""


def run_this_file(*args, loading=False, script=None):
    """(status, stdout, stderr) of a child Python, started with -I, that runs main of the file SCRIPT (this file when it is None) on ARGS: the file run as a
    script, with its main block, or, when LOADING, loaded as a module by LOAD_AND_RUN. It starts no agent-deck, and a section it runs has a temporary home
    of its own."""
    script = os.path.realpath(__file__) if script is None else script
    argv = [sys.executable, "-I", "-c", LOAD_AND_RUN, script, *args] if loading else [sys.executable, "-I", script, *args]
    done = subprocess.run(argv, capture_output=True, encoding="utf-8", timeout=120, check=False)  # a status that is not 0 is what the checks read
    return done.returncode, done.stdout, done.stderr


def test_the_process_exits_with_the_self_tests_status(d):
    got = run_this_file("self-test", "failing", loading=True)
    ok(got == (1, "", "steward-signals self-test FAILED: boom\n"), f"harness: a failed check ends the process with status 1, the FAILED line on stderr and nothing on stdout (got {got!r})")
    got = run_this_file("self-test", "passing", loading=True)
    ok(got == (0, "steward-signals self-test: 2 checks passed\n", ""), f"harness: a run that passes ends the process with status 0 and says on stdout how many checks passed (got {got!r})")
    status, out, err = got = run_this_file("self-test", "deck")  # a real section that is small and is not this one, which would run this check again and again
    ok(status == 0 and re.fullmatch(r"steward-signals self-test: [1-9][0-9]* checks passed\n", out) is not None and err == "",
       f"harness: the file run as a script ends a real section with status 0 and the count of its checks (got {got!r})")
    status, out, err = got = run_this_file("self-test", "nosuch")
    ok(status == 2 and out == "" and "no self-test section 'nosuch'" in err, f"harness: the file run as a script ends with status 2 for a section it does not have (got {got!r})")
    status, out, err = got = run_this_file()
    ok(status == 2 and out == "" and "required" in err, f"harness: and with status 2 for no command at all (got {got!r})")


def test_the_children_run_isolated_and_leave_no_bytecode(d):
    seen = []

    def stub(argv, **kwargs):  # in place of subprocess.run, so that the check starts no process
        seen.append(argv)
        return subprocess.CompletedProcess(argv, 0, stdout="", stderr="")

    with subprocess_as(stub):
        run_this_file("self-test", "deck")
        run_this_file("self-test", "passing", loading=True)
    ok([argv[:2] for argv in seen] == [[sys.executable, "-I"]] * 2, "harness: each child Python is started with -I, so that nothing of the caller's environment or directory is on its path")
    where = tempfile.mkdtemp(dir=d)
    copy = shutil.copy(os.path.realpath(__file__), os.path.join(where, "steward-signals"))  # a copy to load, so that the checkout is not the place a stray file would show
    ok(run_this_file("self-test", "passing", loading=True, script=copy)[0] == 0 and os.listdir(where) == ["steward-signals"], "harness: the child that loads the file as a module writes no bytecode beside it")


