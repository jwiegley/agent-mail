def test_census_scales(d):
    box = mailbox(d, top=[f"glm-5.2_{stamp(i)}_from-lfm3_{i:08x}.txt" for i in range(500)], channel=("ingest", [f"ingest_{stamp(i)}_from-lfm3_{i:08x}.txt" for i in range(5000)]))
    # First the calls, which no machine's speed or load changes: a listing whose calls grow with the square of its entries fails here at its first repeat, however
    # cheap each call is, which the time bounds below, the second line, need not catch. A step that calls nothing, such as comparing names held in memory, is the
    # time bounds' alone.
    channel, listed = os.path.join(box, "+ingest"), None
    with listing_counted() as calls, contextlib.suppress(OSError):  # a call made again raises; the checks below report it
        listed = list_entries(box, "ingest")
    repeated = sorted(key for key, n in calls.items() if n > 1)
    ok(repeated == [], "census: listing 5,500 names lists a directory once and asks an entry for is_file or stat once, by the entry or by its path, so that its calls "
                       f"do not grow with the square of its entries (got {without_question_marks(repr(repeated[:3]))})")
    ok(sorted(path for what, path in calls if what == "scandir") == sorted([box, channel]), "census: and it lists the mailbox and the channel, and no other directory")
    paths = [os.path.join(box if x.dir == "top" else channel, x.name) for x in listed or ()]
    ok(len(paths) == 5500 and all(calls["is_file", path] == calls["stat", path] == 1 for path in paths), "census: and asks each of the 5,500 entries for is_file and stat")
    # CPU time, not wall time: the pin is the listing's own work, which another process's load does not change.
    e = c = posts = listing = counting = None
    with files_refused() as opened:
        with contextlib.suppress(OSError):  # an open that is refused raises; the check below reports it
            t = time.process_time(); e = list_entries(box, "ingest"); listing = time.process_time() - t
            arrived = max(x.ctime for x in e) + 1  # a time a second after the last arrival, from the files' own ctimes
            t = time.process_time()
            c = census(e, members_named("glm-5.2"), STEWARD, ([], set()), set(), set(), NOW)
            posts = posts_after(e, "ingest", STEWARD, None, arrived)
            counting = time.process_time() - t
    ok(not opened and c is not None, "census: listing and counting 5,500 names open no file")
    ok(listing < 1.0 and len(e) == 5500, "census: 5,500 names listed under a second without opening a file")
    ok(counting < 1.0 and c.unread["glm-5.2"][0] == 500 and posts == 5000, "census: and counted in under a second")


