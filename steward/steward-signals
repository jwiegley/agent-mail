def test_sent_log_edges(d):
    ok(read_sent_log(os.path.join(d, "no-such-SENT.log")) == ([], set()), "census: a missing SENT.log holds nothing")
    first = f"lfm3_{stamp(1)}_from-{STEWARD}_00000001"
    orphan = f"pipeline_{stamp(200)}_from-{STEWARD}_00000003"
    summary = f"ingest_{stamp(401)}_from-{STEWARD}_00000006"
    log = "\n".join(["",                                                               # a blank line
                     "intent 1 20261102T200000Z lfm3 NUDGE glm-5.3 no update ab12",   # a subject of several words
                     f"sent 1 {first}",
                     "intent 2 20261102T200100Z pipeline DUPLICATE_a_b cd34",         # no sent line follows it
                     f"sent 3 {orphan}",                                              # no intent line comes before it
                     "intent 4 20261102T200300Z lfm3 cd34",                           # no subject
                     "sent 4",                                                        # no id
                     "sent 5 one two",                                                # a word too many
                     "intent",
                     "gibberish about an intent and what was sent",
                     "intent 6 20261102T200400Z +ingest SUMMARY_+ingest ef56",        # a post: its recipient is +channel
                     f"sent 6 {summary}", ""])
    path = write(d, "SENT-edges.log", log)
    intents, ids = read_sent_log(path)
    ok(intents == [Intent("1", "20261102T200000Z", "lfm3", "NUDGE glm-5.3 no update", "ab12", first),
                   Intent("2", "20261102T200100Z", "pipeline", "DUPLICATE_a_b", "cd34", None),
                   Intent("6", "20261102T200400Z", "+ingest", "SUMMARY_+ingest", "ef56", summary)],
       "census: an intent's subject is the words between its recipient and its sha; lines of any other shape are skipped")
    ok(ids == {first, orphan, summary}, "census: sent_ids holds every id a sent line names, with or without an intent before it")
    again = write(d, "SENT-again.log", f"intent 9 20261102T200000Z lfm3 NUDGE_a ab12\nintent 9 20261102T200100Z lfm3 NUDGE_b cd34\nsent 9 {first}\n")
    ok([i.id for i in read_sent_log(again)[0]] == [None, first], "census: a sent line names the latest intent with its seq")
    with open(path, "wb") as f:
        f.write(b"intent 1 20261102T200000Z lfm3 NUDGE_\xff cd34\n")
    ok(len(read_sent_log(path)[0]) == 1, "census: a damaged byte in SENT.log does not stop the reader")


