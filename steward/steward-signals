    ok(read(bad) == "newer {", "metrics: an older .bad is overwritten by the file that is moved aside now")
    _, _, err = capture(write_metrics, c, DAY, {"turns": 2})
    ok(err == "" and read(bad) == "newer {" and metrics_of(c) == {"turns": 2} and sorted(os.listdir(os.path.join(c, "metrics"))) == [f"{DAY}.json", f"{DAY}.json.bad"],
       "metrics: a good file is merged in place: no notice, the .bad as it was, and no other file")


def test_the_file_is_replaced_whole(d):
    c = conductor_in(d)
    folder = os.path.join(c, "metrics")
    write_metrics(c, DAY, {"turns": 1})
    moves = []

    def watch(src, dst):
        moves.append((src, dst, read(src)))  # the text of the new file at the moment it is moved over the old one

    with replace_through(watch):
        write_metrics(c, DAY, {"turns": 2})
    ok(len(moves) == 1 and os.path.samefile(os.path.dirname(moves[0][0]), folder) and moves[0][1] == metrics_file(c) and not moves[0][0].endswith(".json"),
       "metrics: the new file is written in metrics/, under a name no reader takes for a day's file, and moved over the old one")
    ok(json.loads(moves[0][2]) == {"turns": 2} and read(metrics_file(c)) == moves[0][2], "metrics: it is whole when it is moved, so a reader sees the old file or the new one and never half of one")
    before = read(metrics_file(c))
    error = OSError(errno.ENOSPC, "No space left on device")

    def refuse(src, dst):
        raise error

    with replace_through(refuse):
        ok(raises(OSError, write_metrics, c, DAY, {"turns": 9}) is error, "metrics: a file that cannot be moved into place is an error, not a silent loss")
    ok(read(metrics_file(c)) == before and os.listdir(folder) == [f"{DAY}.json"], "metrics: and the old file is whole and no temporary file is left behind")


