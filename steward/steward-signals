def test_signals_refuses_what_it_cannot_read(d):
    def args(cdir, box, fixture, channel="ingest", *more):
        return [channel, "--dir", cdir, "--mailbox", box, "--run-fixture", fixture, *more]

    def denied(path, found):
        if path.endswith("+ingest"):
            raise PermissionError(errno.EACCES, "Permission denied")
        return found

    def no_lookup(path, *rest):
        if f"{os.sep}.agent-mail{os.sep}members{os.sep}" in path:
            raise PermissionError(errno.EACCES, "Permission denied")

    def replaced(path, make):  # PATH removed and MAKE(path) put in its place
        os.remove(path)
        make(path)

    def channel_moved(box):  # +ingest moved elsewhere, and a symlink to it in its place
        elsewhere = tempfile.mkdtemp(dir=d)
        os.rmdir(elsewhere)
        shutil.move(os.path.join(box, "+ingest"), elsewhere)
        os.symlink(elsewhere, os.path.join(box, "+ingest"))

    no_such = os.strerror(errno.ENOENT)
    not_a_name = "steward-signals: signals: CHANNEL is not an agent-mail name: lower-case letters, digits, dots and single hyphens, at most 64 characters, without the +"
    cases = (
        ("a channel in capitals", lambda c, b, f: (args(c, b, f, "Ingest"), None), not_a_name),
        ("a channel with a question mark", lambda c, b, f: (args(c, b, f, "in?gest"), None), not_a_name),
        ("a channel that is a path", lambda c, b, f: (args(c, b, f, "../ingest"), None), None),
        ("an empty channel name", lambda c, b, f: (args(c, b, f, ""), None), None),
        ("a channel the mailbox does not have", lambda c, b, f: (args(c, b, f, "nosuch"), None), "steward-signals: signals: the mailbox has no channel +nosuch"),
        ("a channel that is a symlink", lambda c, b, f: (channel_moved(b), (args(c, b, f), None))[1], "steward-signals: signals: +ingest in the mailbox is not a directory, so it is no channel"),
        ("a channel that is a file", lambda c, b, f: (shutil.rmtree(os.path.join(b, "+ingest")), write(b, "+ingest", ""), (args(c, b, f), None))[2], None),
        ("a mailbox that does not exist", lambda c, b, f: (args(c, os.path.join(d, "nowhere"), f), None), "steward-signals: signals: the mailbox that --mailbox names is not a directory"),
        ("a mailbox that is a file", lambda c, b, f: (args(c, write(d, "afile", ""), f), None), None),
        ("an empty mailbox name", lambda c, b, f: (args(c, "", f), None), "steward-signals: signals: the mailbox that --mailbox names is not a directory"),
        ("a conductor directory that does not exist", lambda c, b, f: (args(os.path.join(d, "nowhere"), b, f), None), "steward-signals: signals: --dir is not a directory"),
        ("a conductor directory that is a file", lambda c, b, f: (args(write(d, "afile", ""), b, f), None), None),
        ("an empty conductor directory name", lambda c, b, f: (args("", b, f), None), None),
        ("a conductor directory whose name makes no steward name", lambda c, b, f: (args(conductor_dir(d, name="Ingest_Steward"), b, f), None),
         "steward-signals: signals: the steward's name, conductor- and the name of --dir, is not an agent-mail name"),
        ("a steward name of 65 characters", lambda c, b, f: (args(conductor_dir(d, name="s" * 55), b, f), None), None),
        ("no TOPIC.md", lambda c, b, f: (os.remove(os.path.join(c, "TOPIC.md")), (args(c, b, f), None))[1], f"steward-signals: TOPIC.md in --dir: {no_such}"),
        ("a TOPIC.md the roster reader refuses", lambda c, b, f: (write(c, "TOPIC.md", TOPIC_WITH_TABLE.replace("glm-5.2", "Glm?5.2")), (args(c, b, f), None))[1],
         "steward-signals: TOPIC.md: Glm5.2: not a valid name"),
        ("a roster that lists the steward itself", lambda c, b, f: (write(c, "TOPIC.md", TOPIC_WITH_TABLE.replace("| omlx | hera | pi |", f"| {STEWARD} | hera | claude |")),
                                                                 (args(c, b, f), None))[1], f"steward-signals: TOPIC.md: {STEWARD}: the steward itself is listed as a member"),
        ("a TOPIC.md that is not UTF-8", lambda c, b, f: (pathlib.Path(c, "TOPIC.md").write_bytes(b"## Members\n\xff\n"), (args(c, b, f), None))[1], "steward-signals: TOPIC.md in --dir: not valid UTF-8"),
