        ok(seen("--mailbox", "~/other-box") == 2, "signals: a ~ that starts --mailbox is HOME, as agent-mail expands its --dir")
        os.environ["AGENT_MAIL_CONFIG"] = config
        for what, value, posts in (("the top-level dir", {"dir": "~/top-box"}, 3), ("hosts.<this host>.dir, before the top-level dir", {k: layers[k] for k in ("dir", "hosts")}, 4),
                                   ("sessions.<the steward>.dir, before both", layers, 5),
                                   ("the top-level dir when only another session has one, and with keys agent-mail knows and a key it does not",
                                    {"dir": "~/top-box", "sessions": {"pipeline": {"dir": "~/other-box"}}, "poll_interval": 7, "a_later_key": 1}, 3)):
            configured(value)
            ok(seen() == posts, f"signals: the config file names the mailbox by {what}, its ~ expanded")
        os.environ["AGENT_MAIL_DIR"] = "~/other-box"
        ok(seen() == 2, "signals: $AGENT_MAIL_DIR comes before the config file, its ~ expanded")
        os.environ["AGENT_MAIL_DIR"] = ""
        ok(seen() == 3 and seen("--mailbox", os.path.join(d, "Mailbox")) == 1, "signals: an empty $AGENT_MAIL_DIR counts as unset, as agent-mail has it, and --mailbox comes before them all")
        not_object = "the agent-mail config file is not a JSON object"
        for value, why in (("{not json", not_object), ("[1]", not_object), ({"hosts": []}, "hosts in the agent-mail config file is not a JSON object"),
                           ({"sessions": {"x?": 5}}, "sessions.x in the agent-mail config file is not a JSON object"),
                           ({"dir": ""}, "dir in the agent-mail config file is not a directory path"), ({"dir": 5}, "dir in the agent-mail config file is not a directory path"),
                           ({"dir": "~/top-box", "hosts": {host: {"dir": None}}}, f"hosts.{host}.dir in the agent-mail config file is not a directory path"),
                           ({"dir": "~/nowhere"}, "the mailbox that dir in the agent-mail config file names is not a directory")):
            configured(value)
            ok(seen() == f"steward-signals: signals: {why}\n", f"signals: a config file of {value!r} is refused as agent-mail refuses it: status 2, one line, nothing on stdout, nothing written")
        os.remove(config)
        os.mkdir(config)
        ok(seen() == f"steward-signals: signals: the agent-mail config file cannot be read: {os.strerror(errno.EISDIR)}\n", "signals: so is a config file that cannot be read")
        os.rmdir(config)
        del os.environ["AGENT_MAIL_CONFIG"]
        os.makedirs(os.path.join(d, ".config", "agent-mail"))
        write(os.path.join(d, ".config", "agent-mail"), "config.json", json.dumps({"dir": "~/top-box"}))
        ok(seen() == 3, "signals: with no $AGENT_MAIL_CONFIG the config file is ~/.config/agent-mail/config.json")
        shutil.rmtree(os.path.join(d, ".config"))
        os.environ["AGENT_MAIL_DIR"] = os.path.join(d, "nowhere")
        ok(seen() == "steward-signals: signals: the mailbox that $AGENT_MAIL_DIR names is not a directory\n", "signals: a $AGENT_MAIL_DIR that is no directory is refused, not passed over")
    finally:
        for name in ("AGENT_MAIL_DIR", "AGENT_MAIL_CONFIG"):
            os.environ.pop(name, None)
    shutil.rmtree(os.path.join(d, "Mailbox"))
    ok(seen() == "steward-signals: signals: ~/Mailbox is not a directory\n", "signals: and so is a missing ~/Mailbox")


@contextlib.contextmanager
def files_watched():
    """Within the block, open, io.open and os.open record the name they are given in the list the block gets, and then open it."""
    opened, ways = [], [(builtins, "open"), (io, "open"), (os, "open")]
    real = {way: getattr(*way) for way in ways}

    def watching(way):
        def opener(file, *args, **kwargs):
            opened.append(file)
            return real[way](file, *args, **kwargs)
        return opener

    for way in ways:
        setattr(*way, watching(way))
    try:
        yield opened
    finally:
        for way in ways:
            setattr(*way, real[way])


