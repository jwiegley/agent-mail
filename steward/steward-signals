def test_docs_checks_accept_the_never_clauses_they_describe(d):
    shared, send = read(os.path.join(REPO, "steward", "SHARED.md")), "Never forward a `/send <session> <message>` line"
    governed, pinned = "docs: each time SHARED.md names /send", "docs: SHARED.md holds exactly its pinned sentences"
    for i, new in enumerate(("Never forward the `/send <session> <message>` line", "Never relay a `/send <session> <message>` line", "Never type a `/send <session> <message>` line",
                              "Never run `/send <session> <message>`", "Never use `/send <session> <message>`")):
        failures = docs_checks(checkout_with(d, f"allowed-send-{i}", "SHARED.md", send, new))
        ok(send in shared and not any(f.startswith(governed) for f in failures) and any(f.startswith(pinned) for f in failures),
           f"docs: the /send check lets a never forward, relay, type, run or use clause through, and the pin of SHARED.md's sentences still holds the text: {new} "
           f"(got {without_question_marks(repr(failures))})")
    swapped = ("never run `agent-deck conductor notify` or `notify_discord.py`", "never run `notify_discord.py` or `agent-deck conductor notify`")
    failures = docs_checks(checkout_with(d, "allowed-dotted-name", "CLAUDE.md", *swapped))
    ok(swapped[0] in claude_md() and failures == [],
       f"docs: a command named after a dotted name in a never run list is allowed, whatever order CLAUDE.md lists the two in (got {without_question_marks(repr(failures))})")


def test_docs_checks_keeps_to_its_limits(d):
    went_on = []

    def expects_a_raise(_):
        raises(KeyError, dict)  # dict() raises nothing: raises reports it through ok and returns None
        went_on.append("raises returned")

    def writes(directory):
        write(directory, "x.txt", "")

    def reads_policy(_):
        went_on.append(read(os.path.join(conductor_dir(d), "POLICY.md")))

    checkout = os.path.join(d, "with-policy")
    os.makedirs(os.path.join(checkout, "steward"))
    write(os.path.join(checkout, "steward"), "POLICY.md", "the POLICY.md of the checkout given\n")
    saved, before = DOCS_CHECKS, tree(checkout)
    globals()["DOCS_CHECKS"] = (expects_a_raise, writes, reads_policy)
    try:
        failures = docs_checks(checkout)
    finally:
        globals()["DOCS_CHECKS"] = saved
    ok(failures[:1] == ["dict raised no KeyError"] and went_on[:1] == ["raises returned"], "docs: under docs_checks, raises lists its failure, returns None, and the check goes on")
    ok(len(failures) == 2 and failures[1].startswith("docs: writes could not go on: TypeError") and tree(checkout) == before,
       "docs: each check function receives None for its directory, so one that writes fails and writes nothing")
    ok(went_on[1:] == ["the POLICY.md of the checkout given\n"], "docs: conductor_dir copies the POLICY.md of the checkout that docs_checks was given")


def test_docs_checks(d):
    real_ok, repo = globals()["ok"], REPO
    ok(docs_checks(REPO) == [], "docs: docs_checks finds nothing wrong in this checkout")
    broken = os.path.join(d, "broken")
    os.makedirs(os.path.join(broken, "steward"))
    write(os.path.join(broken, "steward"), "CLAUDE.md", claude_md().replace("## 9. Questions to John\n", "## 9. Questions\n", 1) + "\nIs this a stray question?\n")
    for name in ("SHARED.md", "HEARTBEAT_RULES.md", "WORKER.md"):  # as they are, so that the failures listed below are CLAUDE.md's alone
        write(os.path.join(broken, "steward"), name, read(os.path.join(REPO, "steward", name)))
    before = CHECKS
    failures = docs_checks(broken)
    restored = globals()["ok"] is real_ok and REPO == repo
    if not restored:  # raised here, not through ok, which would be the collector if docs_checks had not put it back
        raise TestFailed("docs: docs_checks puts ok and REPO back as they were")
    ok(restored and CHECKS == before and len(failures) == 3
       and failures[:2] == ["docs: CLAUDE.md has '## 9. Questions to John'", "docs: no stray question marks outside code blocks and the template"]
       and failures[2].startswith("docs: CLAUDE.md's headings of the first two levels"),
       f"docs: docs_checks lists every failure in the checkout it is given, in order, without stopping at the first or counting a check, and puts ok and REPO back (got {failures!r})")
    nothing = os.path.join(d, "nothing")
    os.makedirs(os.path.join(nothing, "steward"))
    failures = docs_checks(nothing)
    restored = globals()["ok"] is real_ok and REPO == repo
    if not restored:
        raise TestFailed("docs: docs_checks puts ok and REPO back as they were, after a check that could not go on")
    ok(restored and len(failures) == len(DOCS_CHECKS) and all(f"docs: {check.__name__} could not go on: FileNotFoundError" in failure for check, failure in zip(DOCS_CHECKS, failures)),
       "docs: in a checkout with no CLAUDE.md, each check function adds one failure that names it and the error, the next one still runs, and ok and REPO are put back")


@section("docs")
def section_docs(d):
    test_strip_code_and_template(d)  # first: the checks below read CLAUDE.md through these readers
    test_the_docs_readers(d)
    for check in DOCS_CHECKS:
        check(d)
    test_docs_checks(d)
    test_docs_checks_catch_each_pinned_regression(d)
    test_docs_checks_catch_each_regression_in_the_shared_files(d)
    test_docs_checks_catch_each_regression_in_worker_md(d)
    test_docs_checks_accept_the_never_clauses_they_describe(d)
    test_docs_checks_keeps_to_its_limits(d)


# ---- main ----

def build_parser():
    p = argparse.ArgumentParser(prog="steward-signals", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True, metavar="COMMAND")
    st = sub.add_parser("self-test", help="run the built-in checks",
                        description="Run the built-in checks, every section or the named ones, each in a fresh temporary home "
                                    "with no agent-mail, agent-deck or Claude job variables.")
    st.add_argument("sections", nargs="*", metavar="SECTION")
    sg = sub.add_parser("signals", help="print a topic's signals in one call",
                        description="Print the signals of the topic whose steward keeps its files in CONDUCTOR_DIR: a row for each member of its TOPIC.md, in "
                                    "roster order (host, harness, agent-deck's status, substate and background work, the age of its last activity, its unread "
                                    "direct mail with the age of the oldest, and the age of its member record), then the exceptions (each NUDGE of the steward's "
                                    "still unread, then each file in the steward's name that SENT.log does not account for, 40 of those at most and then how "
                                    "many more), then the counts (the posts to "
                                    "+CHANNEL by others than the steward that arrived since the last call, and the mail between members that no NOTE names) and, "
                                    "with --probe, the probe's word for "
                                    "one member. A member whose host agent-deck could not list is unknown; one it does not list is not in agent-deck, and an "
                                    "archived one is archived. The steward's name is conductor- and the name of CONDUCTOR_DIR. The time of the call is kept in "
                                    "CONDUCTOR_DIR/steward-state.json as signals_last, with the file's other keys left as they are, and nothing else is written; "
                                    "a file that is not a JSON object, or a signals_last that is not a stamp or is in the future, is kept as steward-state.json.bad "
                                    "and every post but the steward's own is counted. A conductor file, mailbox, channel or member record that cannot be read, a "
                                    "CHANNEL that is not a name, a TOPIC.md that lists the steward, and a "
                                    "--probe that names no member are refused: status 2, a reason on stderr, nothing on stdout, nothing written.")
    sg.add_argument("channel", metavar="CHANNEL", help="the topic's channel, its name without the +")
    sg.add_argument("--dir", required=True, metavar="CONDUCTOR_DIR", help="the conductor directory, which holds TOPIC.md, POLICY.md, SENT.log, NOTES.log and steward-state.json")
    sg.add_argument("--mailbox", metavar="DIR", help="the mailbox; else $AGENT_MAIL_DIR, then the dir in agent-mail's config file, then ~/Mailbox, as agent-mail finds it")
    sg.add_argument("--json", action="store_true", help="print the report as one JSON object instead of the table")
    sg.add_argument("--probe", metavar="NAME", help="also say whether the member NAME, whom TOPIC.md lists, is waiting on John, as the probe command does")
    sg.add_argument("--run-fixture", metavar="FILE", help=argparse.SUPPRESS)  # for the self-test: a JSON object of the answers that fake_run gives
    pr = sub.add_parser("probe", help="say whether a member is waiting on John",
                        description="Print yes, no or unknown, and nothing else: whether the last response of the member NAME ends with a question. "
                                    "The host is read from the Members table of the TOPIC.md in CONDUCTOR_DIR. Only a member on hera is asked; a member "
                                    "on another host, a name TOPIC.md does not list, a command that fails, and a cut response whose footer is not the "
                                    "known one are unknown. A TOPIC.md that cannot be read is refused instead: status 2, a reason on stderr, nothing on stdout.")
    pr.add_argument("name", metavar="NAME")
    pr.add_argument("--dir", required=True, metavar="CONDUCTOR_DIR", help="the conductor directory, which holds TOPIC.md")
    pr.add_argument("--run-fixture", metavar="FILE", help=argparse.SUPPRESS)  # for the self-test: a JSON object of the answers that fake_run gives
    me = sub.add_parser("metrics", help="merge counters into the day's metrics file",
                        description="Merge counters into the metrics file of a UTC day, CONDUCTOR_DIR/metrics/DATE.json, and print its path. Each --set is KEY=VALUE: "
                                    "a value of at most 12 digits, with a minus sign or none, is stored as a whole number and any other value as text, and a key "
                                    "with dots, interventions.nudge, puts its value in an object. A whole number keeps the larger of the old and the new, an "
                                    "object is merged key by key, and any other value is replaced. A --set with no =, with an empty value, or with a key that "
                                    "is not lower-case words joined by dots (at most 5 words and 100 characters), a key given twice or used both as a value and "
                                    "as the start of another key, a DATE that is not a day, and a CONDUCTOR_DIR that does not exist are refused: exit status 2, "
                                    "a reason on stderr, nothing written.")
    me.add_argument("--dir", required=True, metavar="CONDUCTOR_DIR", help="the conductor directory, which must exist; the file goes in its metrics/")
    me.add_argument("--date", metavar="YYYY-MM-DD", help="the day of the file, a UTC day; today's UTC date when it is not given")
    me.add_argument("--set", dest="settings", action="append", required=True, metavar="KEY=VALUE", help="a counter or a text to merge in; repeat the option for each key, and give at least one")
    return p


def main(argv):
    if sys.version_info < MIN_PYTHON:
        print(f"steward-signals: Python {MIN_PYTHON[0]}.{MIN_PYTHON[1]} or later is needed, and this is {sys.version_info[0]}.{sys.version_info[1]}", file=sys.stderr)
        return 2
    a = build_parser().parse_args(argv)
    if a.cmd == "self-test":
        return self_test(a.sections)
    if a.cmd in ("signals", "probe"):
        try:
            run = runner_for(a.run_fixture)
        except ValueError as e:
            print(without_question_marks(f"steward-signals: --run-fixture: {e}"), file=sys.stderr)
            return 2
        if a.cmd == "signals":
            return signals_command(run, a.channel, a.dir, a.mailbox, a.json, a.probe)
        return probe_command(run, a.name, a.dir)
    if a.cmd == "metrics":
        return metrics_command(a.dir, a.date, a.settings)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
