def test_roster_message_quotes_at_most_40_characters_of_a_name(d):
    for what, name in (("letters", "g" * 5000), ("letters and question marks", "g?" * 2500)):
        e = raises(RosterError, load_roster, write(d, "TOPIC.md", TOPIC_WITH_TABLE.replace("glm-5.2", name)))
        ok(e.name == name and str(e) == f"steward-signals: TOPIC.md: {name[:40].replace('?', '')}...: not a valid name",
           f"roster: a name of 5000 characters ({what}) is kept whole in .name and cut to its first 40 characters, three dots after them, in the message")
    e = raises(RosterError, load_roster, write(d, "TOPIC.md", TOPIC_WITH_TABLE.replace("glm-5.2", "g" * 65)))
    ok(str(e) == f"steward-signals: TOPIC.md: {'g' * 40}...: not a valid name", "roster: a name just over 64 characters is cut at 40 too")
    e = raises(RosterError, load_roster, write(d, "TOPIC.md", TOPIC_WITH_TABLE.replace("glm-5.2", "G" * 40)))
    ok(str(e) == f"steward-signals: TOPIC.md: {'G' * 40}: not a valid name", "roster: a name of 40 characters is quoted whole, with no dots")


def test_roster_refuses_a_host_agent_deck_could_misread(d):
    def hosted(host):
        return write(d, "TOPIC.md", TOPIC_WITH_TABLE.replace("| omlx | hera | pi |", f"| omlx | {host} | pi |"))

    reason = "the host is not a host name: lower-case letters, digits, dots and hyphens, starting with a letter or a digit, at most 64 characters"
    for bad in ("-x", "--help", "-", "Hera", "andoria 08", "hera?", ".hera", "_hera", "hera_2", "hera/x", "hera;ls", "h" + chr(0xE9) + "ra", "hera" + chr(0xFF10)):
        e = raises(RosterError, load_roster, hosted(bad))
        ok(e.name == "omlx" and str(e) == f"steward-signals: TOPIC.md: omlx: {reason}", f"roster: the host {bad!r} is refused, naming its member, so that agent-deck never takes it for a flag")
    for good in ("hera", "andoria-08", "delphi-3bd4", "host.local", "10.0.0.1", "x", "0"):
        ok(load_roster(hosted(good))[1].host == good, f"roster: {good!r} is a host")
    ok(load_roster(hosted("h" * 64))[1].host == "h" * 64, "roster: a host of 64 characters is a host, as a name of 64 characters is a name")
    e = raises(RosterError, load_roster, hosted("h" * 65))
    ok(e.name == "omlx" and str(e) == f"steward-signals: TOPIC.md: omlx: {reason}", "roster: a host of 65 characters is refused, naming its member, where a name of 65 is, so that no column grows without bound")


def test_roster_refuses_a_table_whose_header_is_another(d):
    header = "| name | host | harness |"
    why = "steward-signals: TOPIC.md: Members: the table's header must be name | host | harness"
    no_header = TOPIC_WITH_TABLE.replace(header + "\n|------|------|---------|\n", "")
    for what, text in (("other words", TOPIC_WITH_TABLE.replace(header, "| member | host | harness |")),
                       ("its columns in another order", TOPIC_WITH_TABLE.replace(header, "| host | name | harness |")),
                       ("a column missing", TOPIC_WITH_TABLE.replace(header, "| name | host |")),
                       ("no header row, so that the first member's row is read as the header", no_header),
                       ("no table at all", "## Members\nThe members are pipeline, omlx and glm-5.2.\n"),
                       ("nothing under the heading", "## Members\n")):
        e = raises(RosterError, load_roster, write(d, "TOPIC.md", text))
        ok(e.name == "Members" and str(e) == why, f"roster: a Members table with {what} is refused, not read with its cells in the wrong places")
    ok(no_header != TOPIC_WITH_TABLE, "roster: the check above removed the header row")


def test_roster_refuses_a_row_after_its_table(d):
    why = ("steward-signals: TOPIC.md: Members: a row follows the end of the table; the roster is one unbroken table, with no blank line inside it and no second "
           "table under the heading")
    cases = [("a blank line inside it", TOPIC_WITH_TABLE.replace("| omlx | hera | pi |\n", "\n| omlx | hera | pi |\n"))]
    for what, later in (("the same header", "| Name | Host | Harness |\n|---|---|---|\n| lfm3 | hera | claude |\n"),
                        ("another header", "| host | name | harness |\n|---|---|---|\n| hera | lfm3 | claude |\n"),
                        ("no header", "| lfm3 | hera | claude |\n")):
        cases.append((f"a second table after it under the heading, with {what}", TOPIC_WITH_TABLE.replace("\n## History", f"\nFormer members:\n\n{later}\n## History")))
    for what, text in cases:
        e = raises(RosterError, load_roster, write(d, "TOPIC.md", text))
        ok(text != TOPIC_WITH_TABLE and e.name == "Members" and str(e) == why,
           f"roster: a Members table with {what} is refused in one line, so that no member after the break is dropped without a word")
    twice = TOPIC_WITH_TABLE + "\n## Members\n| name | host | harness |\n|---|---|---|\n| lfm3 | hera | claude |\n"
    e = raises(RosterError, load_roster, write(d, "TOPIC.md", twice))
    ok(e.name == "## Members" and str(e) == "steward-signals: TOPIC.md: ## Members: the heading is given twice; the roster is one table under one heading",
       "roster: a second Members heading is refused in one line, so that the members under it are not dropped without a word")
    for what, before in (("a blank line", "One row for each member:\n\n"), ("no blank line", "One row for each member:\n")):
        around = TOPIC_WITH_TABLE.replace("## Members\n", f"## Members\n{before}").replace("\n## History", "\nThe roster is complete.\n\n## History")
        ok(around != TOPIC_WITH_TABLE and [m.name for m in load_roster(write(d, "TOPIC.md", around))] == ["pipeline", "omlx", "glm-5.2"],
           f"roster: text before the table, with {what} between, and text after it, and the tables under the next heading, are no rows of it and are not refused")


def test_roster_skips_its_header_repeated_inside_the_table(d):
