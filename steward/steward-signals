# What may follow never in front of a naming of /send in SHARED.md and HEARTBEAT_RULES.md: forward, relay or type it (forward takes an article, "never forward a
# `/send ...` line"), or run or use it.
SEND_VERBS = r"(?:forward|relay|type)(?: (?:a|an|each|every|any|the))?|run|use"


def governed_namings(text, command, verbs="run|use"):
    """The namings of COMMAND in TEXT that a never governs: each ends a list of backticked commands that "never" and one of VERBS (a pattern, "run|use" unless
    given) opens, so that a never in another clause of the sentence ("When a member never answers, run ...") forbids nothing."""
    return re.findall(rf"\bnever (?:{verbs}) (?:`[^`\n]*`(?:, or |, and |, | or | and ))*`{re.escape(command)}(?: [^`\n]*)?`", text, re.I)


def test_claude_md_names_the_forbidden_commands_only_in_never_sentences(d):
    t = claude_md()
    for command in NEVER_COMMANDS:
        # A never that belongs to another clause of the line ("When a member never answers, run ...") forbids nothing, so a naming counts only when it ends a list of
        # commands that a never run or never use opens, which governed_namings tells whatever dots a name holds (notify_discord.py): said is those namings, and
        # there must be one.
        said = governed_namings(t, command)
        stray = re.search(rf"^(?!.*never).*{re.escape(command)}", t, re.M | re.I)
        ok(said and not stray, f"docs: CLAUDE.md names {command} in a sentence that says never, and on no line that does not say it")
        ok(len(said) == len(re.findall(re.escape(command), t, re.I)),
           f"docs: each time CLAUDE.md names {command}, a never run or never use governs it, not a never in another clause of the sentence")


