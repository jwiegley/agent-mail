def test_the_guard_refuses_every_way_to_start_agent_deck(d):
    bin_dir = os.path.join(d, "a directory with spaces")  # as a $TMPDIR may give: a path that is quoted in a command line is one word of it, not several
    os.mkdir(bin_dir)
    stand_in = write(bin_dir, "agent-deck", f"#!{sys.executable}\n")  # a program of that name that does nothing, so that a guard that fails starts this and not the real one
    os.chmod(stand_in, 0o755)
    ways = {"subprocess.run": lambda: subprocess.run([stand_in]), "subprocess.Popen": lambda: subprocess.Popen([stand_in]).wait(),
            "subprocess.check_output": lambda: subprocess.check_output([stand_in]), "a command line for a shell": lambda: subprocess.run(shlex.join([stand_in, "list"]), shell=True),
            "a command line for a shell that does not parse": lambda: subprocess.run("agent-deck 'unclosed", shell=True)}
    run, popen = subprocess.run, subprocess.Popen
    with agent_deck_refused() as started:
        for name, way in ways.items():
            try:
                way()
            except OSError:
                continue
            ok(False, f"probe: the guard let {name} start agent-deck")
        ok(subprocess.run([sys.executable, "-I", "-c", "pass"]).returncode == 0, "probe: the guard lets another program start")
    ok(started == [[stand_in], [stand_in], [stand_in], [stand_in, "list"], ["agent-deck", "'unclosed"]],
       "probe: the guard refuses subprocess.run, subprocess.Popen, subprocess.check_output and a shell command line, and records each as the words of its command: a quoted path with spaces in it is "
       "one word, and a line the shell could not parse is read as plain words")
    ok(subprocess.run is run and subprocess.Popen is popen, "probe: the guard puts every way to start a process back")


