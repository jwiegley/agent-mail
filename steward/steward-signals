INSTRUCTION_FILES = ("CLAUDE.md", "SHARED.md", "HEARTBEAT_RULES.md", "WORKER.md")  # the files under steward/ that the docs checks read


def checkout_with(d, label, name, old, new, count=1):
    """The path of a copy, made in D/LABEL, of this checkout's INSTRUCTION_FILES that exist, with the first COUNT occurrences of OLD in the file NAME replaced by
    NEW (every one when COUNT is -1): a checkout for docs_checks to run on. That OLD is there is the caller's to check."""
    root = os.path.join(d, label)
    os.makedirs(os.path.join(root, "steward"))
    for each in INSTRUCTION_FILES:
        path = os.path.join(REPO, "steward", each)
        if os.path.exists(path):
            write(os.path.join(root, "steward"), each, read(path).replace(old, new, count) if each == name else read(path))
    return root


