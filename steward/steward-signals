def traffic(cdir, box, *more):
    """(stdout, status, stderr) of the traffic command for +ingest with the conductor directory CDIR and the mailbox BOX, and MORE, with an agent-mail that
    has no traffic command (a fixture), so that the report is the one made from file names alone."""
    fixture = os.path.join(os.path.dirname(cdir), "no-traffic.json")  # written by traffic_scene, so that a check of what a call writes sees none of it
    if not os.path.exists(fixture):
        write(os.path.dirname(cdir), "no-traffic.json", json.dumps({"agent-mail traffic": ["", 2]}))
    return capture(main, ["traffic", "ingest", "--dir", cdir, "--mailbox", box, "--run-fixture", fixture, *more])


def ago(seconds, to, sender="glm-5.2", tail="aaaaaaaa"):
    """The name of a message from SENDER to TO stamped SECONDS before now."""
    return f"{to}_{utc_stamp(time.time() - seconds)}_from-{sender}_{tail}.txt"


def without_stamps(text):
    """TEXT less every stamp, YYYYMMDDTHHMMSSZ with or without a fraction, and less the name of TRAFFIC.log, the one word of the helper's own that has
    capitals: what is left holds a capital letter only if one came from elsewhere."""
    return re.sub(r"[0-9]{8}T[0-9]{6}(?:\.[0-9]{6})?Z", "", text).replace(TRAFFIC_LOG, "")


