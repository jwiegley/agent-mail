def test_an_entry_that_cannot_be_read_is_an_error_not_a_gap(d):
    names = [f"ingest_{stamp(i)}_from-nix_0000000{i}.txt" for i in (1, 2, 3)]
    box = mailbox(d, top=[f"pipeline_{stamp(9)}_from-nix_00000009.txt"], channel=("ingest", names))
    channel = os.path.join(box, "+ingest")
    for where, what in ((box, "the top level"), (channel, "a channel")):
        for error in (PermissionError(errno.EACCES, "Permission denied"), OSError(errno.EIO, "Input/output error"), OSError(errno.ESTALE, "Stale file handle")):
            with listing_as(lambda path, found: [Unreadable(item, error) if path == where else item for item in found]):
                ok(raises(OSError, list_entries, box, "ingest") is error, f"census: errno {error.errno} on an entry's metadata in {what} is raised, not taken for a file its reader claimed")
    error = PermissionError(errno.EACCES, "Permission denied")
    for where, what in ((box, "the mailbox"), (channel, "a channel directory")):
        def cannot_list(path, found):
            if path == where:
                raise error
            return found

        with listing_as(cannot_list):
            ok(raises(OSError, list_entries, box, "ingest") is error, f"census: {what} that cannot be listed raises its error, not an empty listing")
    os.chmod(channel, 0o444)  # the three names can be listed but not looked up
    try:
        try:
            os.lstat(os.path.join(channel, names[0]))
            enforced = False  # the user is root, or the filesystem ignores the mode
        except PermissionError:
            enforced = True
        ok(not enforced or isinstance(raises(PermissionError, list_entries, box, "ingest"), PermissionError),
           "census: a channel directory whose posts cannot be looked up raises PermissionError instead of having no posts (where the filesystem enforces the mode)")
    finally:
        os.chmod(channel, 0o755)


