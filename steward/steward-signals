    missing = os.path.join(d, "nowhere")
    c2 = conductor_in(d)
    for what, where in (("a conductor directory that does not exist", missing), ("one that is a file", write(d, "afile", "")), ("an empty name", ""), ("None", None)):
        with in_directory(c2):  # a name that fell back to the current directory would write here
            reason = refusal_of(write_metrics, where, DAY, {"turns": 1})
        ok(bool(reason) and "?" not in reason and d not in reason, f"metrics: {what} is refused, with a reason that names no path")
    ok(not os.path.exists(missing) and nothing_made(c2), "metrics: nothing was made for a conductor directory that is refused, not even the one that did not exist")
    for what, data in (("a list", []), ("None", None), ("a string", "turns"), ("a number", 3), ("a list of pairs", [("turns", 1)])):
        reason = refusal_of(write_metrics, c2, DAY, data)
        ok(bool(reason) and "?" not in reason and nothing_made(c2), f"metrics: data that is {what} is refused, and nothing is made")


def test_a_file_that_is_not_a_json_object_is_moved_aside(d):
    cases = {"text that is not JSON": b"{not json", "an empty file": b"", "an object that stops short": b'{"turns": 3, "inter', "an array": b"[1, 2]", "a number": b"3",
             "null": b"null", "a string": b'"text"', "bytes that are not UTF-8": bytes([0xFF, 0xFE, 0x7B, 0x7D]), "JSON nested too deep to read": b"[" * 1000000,
             "two objects": b'{"turns": 3} {"turns": 4}'}
    for what, content in cases.items():
        c = conductor_in(d)
        os.makedirs(os.path.join(c, "metrics"))
        pathlib.Path(metrics_file(c)).write_bytes(content)
        out, _, err = capture(write_metrics, c, DAY, {"turns": 1})
        ok(metrics_of(c) == {"turns": 1} and pathlib.Path(metrics_file(c) + ".bad").read_bytes() == content,
           f"metrics: {what} is moved aside whole to .bad, and the fresh file holds the new data alone")
        ok(err.count("\n") == 1 and "moved aside" in err and "?" not in err and c not in err and out == "",
           f"metrics: and that is said once on stderr, in one line with no question mark and no path ({what})")
    c = conductor_in(d)
    os.makedirs(os.path.join(c, "metrics"))
