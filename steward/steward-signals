        calls.clear()
        with replace_through(fail_one):
            out, status, err = capture(main, set_args(c, "turns=1"))
        ok((out, status, err) == ("", 2, "steward-signals: metrics: the metrics file cannot be used: Input/output error\n") and pathlib.Path(day).read_bytes() == DAMAGED,
           f"metrics: and the command, when {what} fails, refuses in one line and claims neither a moved-aside file nor a fresh one")


def test_the_damaged_file_is_not_touched_until_the_new_one_is_written_and_flushed(d):
    c, folder, day, bad = damaged_day(d)
    error = OSError(errno.ENOSPC, "No space left on device")

    def full(fd):
        raise error

    with os_through("fsync", full):
        out, status, err = capture(main, set_args(c, "turns=1"))
    ok((out, status) == ("", 2) and err.count("\n") == 1 and pathlib.Path(day).read_bytes() == DAMAGED and os.listdir(folder) == [f"{DAY}.json"],
       "metrics: when the new file cannot be flushed to disk, the damaged file is still the day file, with no .bad, no temporary file and no notice")
