def test_traffic_words_slugs_and_matching(d):
    names = {"glm-5.2", "lfm3"}
    ok(subject_words("Re: GLM-5.3 FP8, can you please evaluate glm-5.2's v2.4. build (#3258) -- a b " + "x" * 25, names) == {"glm-5.3", "fp8", "evaluate", "v2.4", "build", "3258"},
       "traffic: a subject's words are lower-cased, split outside [a-z0-9.-], stripped of end dots and hyphens, 2 to 24 characters, names in agent-mail's grammar, "
       "and neither a member's name, a post verb nor a stop word")
    ok(distinctive({"glm-5.3", "fp8", "evaluate", "v2.4", "build", "3258"}) == {"glm-5.3", "fp8", "v2.4", "3258"} and work_classes({"build", "evaluate"}) == ["evaluate", "build"],
       "traffic: a distinctive word holds a digit, a dot or a hyphen, and the work classes come from the fixed list, in its order")
    row = lambda subject: Row(0.0, "hera", "lfm3", "pi", "pi_20261106T000000.000000Z_from-lfm3_00000000", subject, None, "mcp", "direct")
    ok(matching(row("evaluate glm-5.3"), row("bench glm-5.3 now"), names) == ("evaluate", ["glm-5.3"])
       and matching(row("glm-5.3 fp8 v2.4 docs"), row("notes on v2.4 fp8 glm-5.3"), names) == ("-", ["fp8", "glm-5.3", "v2.4"])
       and matching(row("glm-5.3 docs"), row("glm-5.3 thoughts"), names) is None and matching(row("evaluate the model"), row("evaluate it"), names) is None,
       "traffic: two subjects match on a shared work class and a shared distinctive word, or on three distinctive words, and not on one word or a class alone")
    found = matching(row("evaluate zz-9 aa-1 mm-5 qq-7 bb-2"), row("evaluate bb-2 qq-7 mm-5 aa-1 zz-9"), names)
    ok(found == ("evaluate", ["aa-1", "bb-2", "mm-5", "qq-7"]), "traffic: the shared words are printed sorted, at most four of them")
    ok(slug_of("glm53-fp8: shard 3") == "glm53-fp8" and slug_of("CLAIM glm53-fp8: evaluate") == "glm53-fp8" and slug_of("DROP t1") == "t1"
       and slug_of("please see glm53-fp8: x") is None and slug_of("Glm: x") is None and slug_of("NOTE: nothing") is None,
       "traffic: a slug is the one a subject starts with, `<slug>:` or `<VERB> <slug>`, in WORKER.md's grammar, and no other word")
    ok(slug_of("re: shard 3") is None and slug_of("fwd: shard 3") is None and slug_of("done: shard 3") is None and slug_of("NOTE re: x") is None
       and slug_of("urgent: shard 3") == "urgent",
       "traffic: a stop word or a post verb is never a slug, so that re: and fwd: give none")
    good = log_row("pi", "lfm3", 60, "fine")
    forged = [dict(good, **{"from": "pipeline"}), dict(good, to="nix"), dict(good, utc="20261101T000000.000000Z"), dict(good, host="Hera"), dict(good, via="web"),
              dict(good, in_reply_to="nope"), {**good, "extra": 1}, {k: v for k, v in good.items() if k != "via"}, dict(good, subject=5), "a row", None]
    ok([r.id for r in log_rows({"rows": [good, *forged]})] == [good["id"]] and log_rows({"rows": "x"}) == [] and log_rows({}) == [],
       "traffic: a row of the log that does not hold exactly its eight fields of the right kinds, agreeing with its id, is left out")


