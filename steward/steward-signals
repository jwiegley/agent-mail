def test_real_run_contract(d):
    def child(code):  # a Python child that prints cafe, with its accent, as UTF-8 bytes and exits with CODE
        return [sys.executable, "-I", "-c", f"import sys; sys.stdout.buffer.write(b'caf\\xc3\\xa9\\n'); sys.exit({code})"]

    ok(real_run(child(0)) == ("caf\u00e9\n", 0), "run: the argv is run as it is given, its first word the program, and gives the output decoded as UTF-8 and the status")
    ok(real_run(child(3)) == ("caf\u00e9\n", 3), "run: a command that fails gives its own status and output")
    ok(real_run([os.path.join(d, "no-such-program")]) == ("", 1), "run: a command that cannot be started gives no output and status 1, not an error")
    ok(real_run([sys.executable, "-I", "-c", "import sys; sys.stdout.buffer.write(b'\\xff\\n')"]) == ("", 1), "run: output that is not UTF-8 gives no output and status 1, not an error")
    marker = "STDERR-MARKER-31c9"
    with fd2_to(os.path.join(d, "fd2.txt")):
        result = real_run([sys.executable, "-I", "-c", f"import sys; print('out'); print('{marker}', file=sys.stderr)"])
    ok(result == ("out\n", 0) and marker not in read(os.path.join(d, "fd2.txt")), "run: a command's stderr is neither in the text it returns nor on this process's stderr")

    def too_slow(argv, **kwargs):
        too_slow.timeout = kwargs.get("timeout")
        raise subprocess.TimeoutExpired(argv, too_slow.timeout)

    with subprocess_as(too_slow):
        ok(real_run(["agent-deck", "list", "--json"]) == ("", 1) and too_slow.timeout == 20, "run: a command that has not finished in 20 seconds gives no output and status 1")


