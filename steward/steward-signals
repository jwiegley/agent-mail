def test_census_scales(d):
    box = mailbox(d, top=[f"glm-5.2_{stamp(i)}_from-lfm3_{i:08x}.txt" for i in range(500)], channel=("ingest", [f"ingest_{stamp(i)}_from-lfm3_{i:08x}.txt" for i in range(5000)]))
    # CPU time, not wall time: the pin is the listing's own work, which another process's load does not change.
    e = c = posts = listing = counting = None
    with files_refused() as opened:
        with contextlib.suppress(OSError):  # an open that is refused raises; the check below reports it
            t = time.process_time(); e = list_entries(box, "ingest"); listing = time.process_time() - t
            arrived = max(x.ctime for x in e) + 1  # a time a second after the last arrival, from the files' own ctimes
            t = time.process_time()
            c = census(e, members_named("glm-5.2"), STEWARD, ([], set()), set(), set(), NOW)
            posts = posts_after(e, "ingest", STEWARD, None, arrived)
            counting = time.process_time() - t
    ok(not opened and c is not None, "census: listing and counting 5,500 names open no file")
    ok(listing < 1.0 and len(e) == 5500, "census: 5,500 names listed under a second without opening a file")
    ok(counting < 1.0 and c.unread["glm-5.2"][0] == 500 and posts == 5000, "census: and counted in under a second")


