def test_signals_counts_each_post_once_by_its_arrival(d):
    cdir, box, fixture, _ = signals_scene(d)
    channel = os.path.join(box, "+ingest")
    write(channel, f"ingest_{utc_stamp(time.time() - 300)}_from-{STEWARD}_00000009.txt", "")  # a post of the steward's own
    before = time.time()
    out, status, err = signals(cdir, box, fixture)
    after = time.time()
    last = state_of(cdir)["signals_last"]
    ok(status == 0 and "posts-since-last=1" in out and list(state_of(cdir)) == ["signals_last"],
       "signals: the first call counts every post but the steward's own, and steward-state.json then holds signals_last")
    ok(re.fullmatch(r"[0-9]{8}T[0-9]{6}\.[0-9]{6}Z", last) is not None and before - 0.001 <= stamp_time(last) <= after, "signals: signals_last is the time of the call, stamped as a message id is")
    ok(err == "steward-signals: signals: posts-since-last counts every post in +ingest but the steward's own, since there is no steward-state.json yet\n", "signals: a first call says so, in one line")
    # The posts below arrive in a mailbox of their own, so that the posts above, which may share their second where a ctime has a resolution of one second,
    # play no part. The mark (signals_last) and the time of each call are then taken from the posts' own ctimes, a second or more outside them, never from a
    # clock read beside them, so that every post below arrives inside the interval of the call that should count it, and only the rules leave any out.
    box = mailbox(d, channel=("ingest", []))
    channel, base = os.path.join(box, "+ingest"), time.time()
    late = f"ingest_{utc_stamp(base - 3600)}_from-pipeline_0000000a.txt"  # stamped an hour before the mark, as by a sync that lags or a clock behind hera's
    ahead = utc_stamp(base + 3600)  # the stamp of a post an hour ahead of hera's clock
    arrivals = [os.path.join(channel, name) for name in (late, f"ingest_{ahead}_from-omlx_0000000b.txt",
                                                         f"ingest_{utc_stamp(base + 1)}_from-{STEWARD}_0000000c.txt",    # the steward's own
                                                         f"other_{utc_stamp(base + 1)}_from-pipeline_0000000d.txt")]    # misfiled: named for another channel
    arrivals.append(os.path.join(box, f"ingest_{utc_stamp(base + 1)}_from-pipeline_0000000e.txt"))  # direct mail, though named for the channel
    for path in arrivals:
        write(os.path.dirname(path), os.path.basename(path), "")  # each arrives now, after the mark
    os.utime(arrivals[0], (946684800, 946684800))  # an old mtime, which counts for nothing
    ctimes = [os.lstat(path).st_ctime for path in arrivals]  # read after the utime, which moves a ctime too
    mark, now = min(ctimes) - 1, max(ctimes) + 1
    write(cdir, "steward-state.json", json.dumps({"signals_last": utc_stamp(mark)}))
    with time_as(lambda: now):
        out, status, err = signals(cdir, box, fixture)
    ok(status == 0 and "posts-since-last=2" in out and err == "",
       "signals: a post counts when it arrived after signals_last: one stamped an hour before the mark and synced after it, and one stamped an hour ahead of "
       "hera's clock; not the steward's own, a misfiled file or direct mail")
    with time_as(lambda: now + 1):
        ok("posts-since-last=0" in signals(cdir, box, fixture)[0], "signals: none of them counts again at the next call")
    with time_as(lambda: stamp_time(ahead) + 60):  # a later call, once hera's clock has passed the stamp of the post stamped ahead
        ok("posts-since-last=0" in signals(cdir, box, fixture)[0], "signals: nor at a later call whose time has passed the stamp of the post stamped ahead: its arrival counted it once")


def test_posts_count_by_arrival_in_the_half_open_interval(d):
    arrived = entries_named(f"ingest_{stamp(0)}_from-pipeline_00000001.txt", channel="ingest", ctime=1000.0)  # stamped in 2026, arrived at 1000 s after the epoch
    for since, now, count, what in ((999.0, 1000.0, 1, "a post that arrived at the end of the interval counts"), (None, 1000.0, 1, "with no start, as at a first call, too"),
