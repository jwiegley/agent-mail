def test_metrics_refuses_what_it_cannot_carry_out(d):
    c = conductor_in(d)
    missing = os.path.join(d, "nowhere?")  # a name with a question mark, which no message may carry
    question = os.path.join(d, "what?")  # a directory that exists, whose path the command would print
    os.mkdir(question)
    cases = (("a --set with no =", set_args(c, "turns")), ("a --set with no = and a question mark", set_args(c, "turns?")), ("a key with a question mark", set_args(c, "tur?ns=1")),
             ("a date that is not a day", set_args(c, "turns=1", day="2026-13-01")), ("a date in words", set_args(c, "turns=1", day="tomorrow")),
             ("a date of one-digit parts", set_args(c, "turns=1", day="2026-11-3")), ("an empty date", set_args(c, "turns=1", day="")),
             ("a conductor directory that does not exist", set_args(missing, "turns=1")), ("a conductor directory that is a file", set_args(write(d, "afile", ""), "turns=1")),
             ("an empty conductor directory name", set_args("", "turns=1")), ("a conductor directory with a question mark in its name", set_args(question, "turns=1")))
    for what, argv in cases:
        with in_directory(c):
            out, status, err = capture(main, argv)
        ok(status == 2 and out == "" and err.count("\n") == 1 and err.startswith("steward-signals: metrics: ") and "?" not in err,
           f"metrics: {what} is refused: status 2, one line on stderr with no question mark, nothing on stdout")
    ok(nothing_made(c) and os.listdir(question) == [], "metrics: and nothing was written for any of them")


def test_runs_add_up_the_day(d):
    c = conductor_in(d)
    capture(main, set_args(c, "turns=5", "interventions.nudge=2"))
