        # A never that belongs to another clause of the line ("When a member never answers, run ...") forbids nothing, so a naming counts only when it ends a list of
        # commands that a never run or never use opens, which governed_namings tells whatever dots a name holds (notify_discord.py): said is those namings, and
        # there must be one.
        said = governed_namings(t, command)
        stray = re.search(rf"^(?!.*never).*{re.escape(command)}", t, re.M | re.I)
        ok(said and not stray, f"docs: CLAUDE.md names {command} in a sentence that says never, and on no line that does not say it")
        ok(len(said) == len(re.findall(re.escape(command), t, re.I)),
           f"docs: each time CLAUDE.md names {command}, a never run or never use governs it, not a never in another clause of the sentence")


