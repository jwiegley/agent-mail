def test_the_day_defaults_to_the_local_date(d):
    days = {}
    for zone in ("UTC-14", "UTC+11"):  # 25 hours apart, so that their dates differ at any time and the date in UTC cannot be the local date of both
        with local_zone(zone):
            c = conductor_in(d)
            before = datetime.date.today().isoformat()
            out, status, err = capture(main, ["metrics", "--dir", c, "--set", "turns=1"])
            after = datetime.date.today().isoformat()  # the run may straddle midnight
            days[zone] = before
            ok(status == 0 and out in (metrics_file(c, before) + "\n", metrics_file(c, after) + "\n") and err == "", f"metrics: --date is the local date when it is not given (zone {zone})")
    ok(days["UTC-14"] != days["UTC+11"], "metrics: the two zones are on different dates, so a day taken from UTC would fail one of the checks above")


def test_a_merge_too_deep_for_json_to_write_is_refused(d):
    c = conductor_in(d)
    write_metrics(c, DAY, {"turns": 1})
    folder, before = os.path.join(c, "metrics"), read(metrics_file(c))
    dumps = json.dumps

    def overflow(*args, **kwargs):  # what json.dumps does with an object nested more deeply than this Python can write indented
        raise RecursionError("maximum recursion depth exceeded")

    json.dumps = overflow
    try:
        reason = refusal_of(write_metrics, c, DAY, {"turns": 2})
        out, status, err = capture(main, set_args(c, "turns=2"))
    finally:
        json.dumps = dumps
    ok(bool(reason) and "?" not in reason and read(metrics_file(c)) == before and os.listdir(folder) == [f"{DAY}.json"],
       "metrics: a merge that json cannot write is refused with a reason, and the old file is left whole with no temporary file")
    ok(out == "" and status == 2 and err.count("\n") == 1 and "?" not in err and "Traceback" not in err, "metrics: the command refuses it: status 2, one line on stderr, nothing on stdout")


def test_a_file_the_system_refuses_is_an_error_not_a_loss(d):
    c = conductor_in(d)
    write(c, "metrics", "a file where the directory should be")
    ok(isinstance(raises(OSError, write_metrics, c, DAY, {"turns": 1}), OSError), "metrics: a metrics that is a file is an OSError, not a ValueError and not a silent loss")
    ok(capture(main, set_args(c, "turns=1")) == ("", 2, f"steward-signals: metrics: the metrics file cannot be used: {os.strerror(errno.ENOTDIR)}\n"),
       "metrics: the command refuses it with the system's reason, no path, and nothing on stdout")
    ok(read(os.path.join(c, "metrics")) == "a file where the directory should be", "metrics: and leaves it as it was")
    c = conductor_in(d)
    os.makedirs(metrics_file(c))  # a directory where the day's file should be
    ok(capture(main, set_args(c, "turns=1")) == ("", 2, f"steward-signals: metrics: the metrics file cannot be used: {os.strerror(errno.EISDIR)}\n") and os.path.isdir(metrics_file(c)),
       "metrics: a day's file that is a directory is refused the same way, and left as it was")
    c = conductor_in(d)
    write_metrics(c, DAY, {"turns": 1})
    folder, before = os.path.join(c, "metrics"), read(metrics_file(c))
    os.chmod(folder, 0o555)
    try:
        try:
            tempfile.TemporaryFile(dir=folder).close()  # made and removed at once when the mode is not enforced, as for root
            enforced = False
        except PermissionError:
            enforced = True
        if enforced:
            ok(isinstance(raises(PermissionError, write_metrics, c, DAY, {"turns": 2}), PermissionError) and read(metrics_file(c)) == before and os.listdir(folder) == [f"{DAY}.json"],
               "metrics: a metrics/ that cannot be written to is a PermissionError, with the old file whole and no temporary file")
            ok(capture(main, set_args(c, "turns=2")) == ("", 2, f"steward-signals: metrics: the metrics file cannot be used: {os.strerror(errno.EACCES)}\n"),
               "metrics: the command refuses it with the system's reason")
    finally:
        os.chmod(folder, 0o755)


