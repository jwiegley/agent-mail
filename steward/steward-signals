@contextlib.contextmanager
def time_as(clock):
    """Within the block, time.time is CLOCK."""
    real = time.time
    time.time = clock
    try:
        yield
    finally:
        time.time = real


def test_signals_takes_the_time_once_before_the_listing(d):
    cdir, box, fixture, (s1, _, s3) = signals_scene(d)
    os.remove(os.path.join(box, "+ingest", f"ingest_{s3}_from-pipeline_cccccccc.txt"))  # the channel's only post is then the one that arrives below
    base = time.time()
    write(cdir, "steward-state.json", json.dumps({"signals_last": utc_stamp(base - 10)}))
    late = f"ingest_{utc_stamp(base - 3600)}_from-omlx_0000000f.txt"  # stamped an hour ago, as by a clock or a sync that lags
    where = os.path.join(box, "+ingest", late)

    def arrive(path, found):
        if path.endswith("+ingest") and not os.path.exists(where):
            write(path, late, "")  # it arrives after the listing, and after the time the call took
        return found

    def arrival_clock():  # the time as hera keeps it: base - 9 until the post has arrived, 8 seconds or more before its ctime; then a second after that ctime
        return os.lstat(where).st_ctime + 1 if os.path.lexists(where) else base - 9

    with listing_as(arrive), time_as(arrival_clock):
        ok("posts-since-last=0" in signals(cdir, box, fixture)[0], "signals: a post that arrives after the listing is not counted by that call")
    with time_as(arrival_clock):
        ok("posts-since-last=1" in signals(cdir, box, fixture)[0], "signals: the next call counts it by its arrival, since the time was taken before the listing")
    fake, readings = time.time() + 86400, []

    def clock():  # a day ahead, and an hour later at each reading after the first
        readings.append(fake)
        return fake + 3600 * (len(readings) - 1)

    with time_as(clock):
        out = signals(cdir, box, fixture, "--json")[0]
    pipeline = json.loads(out)["members"]["pipeline"]
    record = os.stat(os.path.join(box, ".agent-mail", "members", "pipeline.json")).st_mtime
    deck = datetime.datetime(2026, 10, 31, 22, 29, 7, tzinfo=datetime.timezone.utc).timestamp()  # pipeline's last activity in ANDORIA_LIST
    ok(pipeline["checked_age_s"] == int((fake - record) // 1) and pipeline["last_activity_age_s"] == int((fake - deck) // 1)
       and pipeline["unread"]["oldest_age_s"] == int((fake - stamp_time(s1)) // 1) and state_of(cdir)["signals_last"] == utc_stamp(fake),
       "signals: every age and signals_last come from the one time the call took")


