def test_own_files_match_intents_by_recipient_and_time(d):
    sent = read_sent_log(write(d, "SENT.log", "intent 1 20261102T200000Z lfm3 NUDGE_a ab12\nintent 2 20261102T200100Z +ingest SUMMARY_x cd34\n"))

    def own(to, when, tail):
        return f"{to}_{when}_from-{STEWARD}_{tail}.txt"

    def ids(*names):
        return [name.removesuffix(".txt") for name in names]

    direct = [own("lfm3", stamp(10), "00000001"),     # exactly 10 s after the intent to lfm3: within it
              own("lfm3", stamp(-5), "00000002"),     # 5 s before it: within it too
              own("lfm3", stamp(11), "00000003"),     # 11 s after it: not
              own("lfm3-2", stamp(1), "00000004"),    # lfm3's intent is not lfm3-2's
              own("lfm", stamp(1), "00000005"),       # nor lfm's
              own("ingest", stamp(61), "00000006")]   # nor mail to ingest's: the intent names +ingest
    posts = [own("ingest", stamp(61), "00000007"),    # 1 s after the intent for +ingest: within it
             own("ingest", stamp(100), "00000008")]   # 40 s after it: not
    c = census(entries_named(*direct) + entries_named(*posts, channel="ingest"), CENSUS_MEMBERS, STEWARD, sent, set(), set(), NOW)
    ok(c.unmatched_own == ids(*direct[2:], posts[1]), "census: an intent matches by whole recipient (+channel for a post) and by time, 10 s either way")
    elsewhere = [f"lfm3_{stamp(500)}_from-{STEWARD}-2_00000009.txt",  # a sender that only starts with the steward's name
                 f"lfm3_{stamp(600)}_from-nix_0000000a.txt"]          # another sender
    accounted = own("pipeline", stamp(700), "0000000b")               # no intent, but a sent line names it
    c = census(entries_named(accounted, *elsewhere), CENSUS_MEMBERS, STEWARD, ([], set(ids(accounted))), set(), set(), NOW)
    ok(c.unmatched_own == [], "census: a file from another sender, or one a sent line names, is not disputed")
    odd = own("lfm3", "20261340T250000.000000Z", "0000000c")  # an Entry made by hand: list_entries lists no such name
    c = census(entries_named(odd, ctime=STAMP_BASE.timestamp()), CENSUS_MEMBERS, STEWARD, sent, set(), set(), NOW)
    ok(c.unmatched_own == ids(odd), "census: an Entry whose stamp is not a time matches no intent, whatever its ctime")


