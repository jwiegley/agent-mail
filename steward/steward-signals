def test_roster_reads_only_its_table(d):
    members = load_roster(write(d, "TOPIC.md", TOPIC_WITH_TABLE))
    ok(members == [Member("pipeline", "andoria-08", "claude"), Member("omlx", "hera", "pi"), Member("glm-5.2", "andoria-08", "claude")], "roster: each member has its host and harness")
    before = "# +ingest\n| Not A Name | x | y |\n" + TOPIC_WITH_TABLE
    ok(load_roster(write(d, "TOPIC.md", before)) == members, "roster: a table before the Members heading is not read, nor is the one after it")
    capitalised = TOPIC_WITH_TABLE.replace("## Members", "## members").replace("| name | host | harness |", "| Name | Host | Harness |")
    ok(load_roster(write(d, "TOPIC.md", capitalised)) == members, "roster: the heading and the header row may be in any case")
    extra = TOPIC_WITH_TABLE.replace("| name | host | harness |", "| name | host | harness | notes |").replace("| omlx | hera | pi |", "| omlx | hera | pi | Pi loop |")
    ok(load_roster(write(d, "TOPIC.md", extra)) == members, "roster: cells after the third are ignored")
    aligned = TOPIC_WITH_TABLE.replace("|------|------|---------|", "|:-----|:----:|--------:|")
    ok(aligned != TOPIC_WITH_TABLE and load_roster(write(d, "TOPIC.md", aligned)) == members, "roster: a colon-aligned separator row is not a member")
    last = TOPIC_WITH_TABLE[:TOPIC_WITH_TABLE.index("## History")].rstrip("\n")  # the table ends the file, with no newline
    ok(load_roster(write(d, "TOPIC.md", last)) == members, "roster: the table may end the file")
    ok(load_roster(write(d, "TOPIC.md", "## Members\n| name | host | harness |\n|---|---|---|\n")) == [], "roster: a table with no rows is a roster with no members")


def test_roster_name_grammar(d):
    def named(name):
        return write(d, "TOPIC.md", TOPIC_WITH_TABLE.replace("glm-5.2", name))

    for bad in ("Pi", "a_b", "x-", "x--y", "-x", ".x", "a" * 65, "glm 5.2", ""):
        ok(raises(RosterError, load_roster, named(bad)).name == bad, f"roster: {bad!r} is not an agent-mail name")
    for good in ("pi", "glm-5.2", "dsv41f", "a.b", "a" * 64):
        ok(load_roster(named(good))[2].name == good, f"roster: {good!r} is an agent-mail name")


def test_roster_refuses_what_it_cannot_read(d):
    e = raises(RosterError, load_roster, write(d, "TOPIC.md", TOPIC_WITH_TABLE.replace("## Members", "## Member")))
    ok(e.name == "## Members" and str(e) == "steward-signals: TOPIC.md: ## Members: no such heading", "roster: a file with no Members heading is refused, not read as no members")
    twice = write(d, "TOPIC.md", TOPIC_WITH_TABLE.replace("| omlx | hera | pi |", "| pipeline | hera | pi |"))
    e = raises(RosterError, load_roster, twice)
    ok(e.name == "pipeline" and str(e) == "steward-signals: TOPIC.md: pipeline: listed twice", "roster: a name listed twice is refused, not resolved")
    nohost = write(d, "TOPIC.md", TOPIC_WITH_TABLE.replace("| omlx | hera | pi |", "| omlx |  | pi |"))
    e = raises(RosterError, load_roster, nohost)
    ok(e.name == "omlx" and str(e) == "steward-signals: TOPIC.md: omlx: empty host", "roster: a member with no host is refused")
    ok(raises(RosterError, load_roster, write(d, "TOPIC.md", TOPIC_WITH_TABLE.replace("| omlx | hera | pi |", "| omlx |"))).name == "omlx", "roster: so is a row that ends before its host cell")


