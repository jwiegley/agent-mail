                             + r" channels=(?:\+[a-z0-9.-]+:[0-9]+,)*\+[a-z0-9.-]+:[0-9]+", lines[2])):
        problems.append("the counts")
    if not re.fullmatch(r"heard: (?:none|[a-z0-9.-]+ [0-9]{8}T[0-9]{6}Z(?:, [a-z0-9.-]+ [0-9]{8}T[0-9]{6}Z)*)", lines[3]):
        problems.append("the heard line")
    seen = []
    for line in lines[4:-1]:
        if line.endswith(":") or line.endswith(": none"):
            heading = line.split(":")[0]
            seen.append(heading)
            continue
        found = re.fullmatch(SAMPLE_LINES.get(heading, "^$"), line.removeprefix("  ")) if line.startswith("  ") else None
        named = found.groupdict() if found else {}
        if (found is None or (named.get("sender") and f"_from-{named['sender']}_" not in named["id"])  # the names a line gives are its id's
                or (named.get("to") and not named["id"].startswith(f"{named['to']}_"))):
            problems.append(line)
    if seen != list(SAMPLE_LINES) or not re.fullmatch(rf"handled: [0-9]+ in {re.escape(TRAFFIC_LOG)}", lines[-1]):
        problems.append("the lists or the handled line")
    return problems


