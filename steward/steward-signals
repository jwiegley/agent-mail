# The commands the steward never runs (spec 4, 5.3, 6.5 and 6.6), which an instruction file names only in a sentence that says never, so that no sentence can be
# read as telling the steward to run one.
NEVER_COMMANDS = ("agent-deck session send", "agent-deck launch", "agent-deck session stop", "agent-deck session restart", "agent-deck session set-parent",
                  "agent-deck inbox drain", "notify_discord.py", "agent-deck session output", "agent-deck conductor notify")
SHARED_PARTS = ("auto-respond", "/send", "session control", "NEED", "state.json", "task-log.md")  # the parts of the shared conductor text that do not apply (spec 6.4)
FENCE_RE = re.compile(r"\s*(`{3,}|~{3,})")  # a line that opens a fenced code block: three backticks or tildes or more, after any indentation


def fenced_parts(text):
    """TEXT cut into its parts, in order and none empty, as (fenced, part) pairs: each fenced code block whole, its fence lines included, as (True, block),
    and the prose between as (False, prose). A block opens with a line of three backticks or tildes or more, after any indentation and before any info
    string (a backtick fence with a backtick after it on the line opens an inline span instead), and runs to the first line of the same character, at least
    as many of it and nothing else. A fence that is never closed opens no block, so that what follows it stays prose."""
    lines, parts, prose, i = text.splitlines(keepends=True), [], [], 0
    while i < len(lines):
        opening = FENCE_RE.match(lines[i])
        if opening and not (opening[1][0] == "`" and "`" in lines[i][opening.end():]):
            closing = re.compile(rf"\s*{re.escape(opening[1][0])}{{{len(opening[1])},}}\s*")
            end = next((j for j in range(i + 1, len(lines)) if closing.fullmatch(lines[j])), None)
            if end is not None:
                parts += [(False, "".join(prose)), (True, "".join(lines[i:end + 1]))]
                prose, i = [], end + 1
                continue
        prose.append(lines[i])
        i += 1
    return [part for part in parts + [(False, "".join(prose))] if part[1]]


def strip_code_and_template(text):
    """TEXT less its fenced code blocks (see fenced_parts) and less each copy of QUESTION_TEMPLATE: the prose of an instruction file, where no question mark
    may stand, since the question line is the one line holding one that the steward prints."""
    return "".join(part for fenced, part in fenced_parts(text) if not fenced).replace(QUESTION_TEMPLATE, "")


def sentences(text):
    """The sentences of TEXT's prose (see strip_code_and_template), each stripped: cut after a full stop or a semicolon and the spaces that follow it, and at
    each line end, so that a table row or a list item ends a sentence too."""
    return [s.strip() for s in re.split(r"(?<=[.;]) +|\n+", strip_code_and_template(text)) if s.strip()]


def claude_section(text, number):
    """Section NUMBER of the CLAUDE.md in TEXT: from its heading, the line that starts "## NUMBER. ", to the next numbered heading of that level or the
    end, so that a heading inside a template block does not end it; "" when there is no such heading."""
    found = re.search(rf"^## {number}\. .*?(?=^## [0-9]+\. |\Z)", text, re.M | re.S)
    return found[0] if found else ""


def docs_checks(repo_dir):
    """The failures of the checks in DOCS_CHECKS, run on the instruction files of the checkout REPO_DIR, the directory that holds steward/: the text of each
    check that does not hold, in the order they run, or [] when every one holds. Unlike a self-test run, which ends at the first failure, this runs them all:
    while it runs, REPO is REPO_DIR and ok lists a failed check instead of raising it, and counts nothing; both are put back however it ends. A check function
    that cannot go on, for a file that is missing or a heading that a split needs, adds one failure that names it and the error, and the next one runs. It
    writes nothing: each check function is given None for its directory, so that one which tried to write would fail rather than write in the checkout."""
    failures = []

    def listed(cond, what):
        if not cond:
            failures.append(what)

    saved = {name: globals()[name] for name in ("ok", "REPO")}
    globals().update(ok=listed, REPO=repo_dir)
    try:
        for check in DOCS_CHECKS:
            try:
                check(None)
            except Exception as e:  # the check could not go on; the rest still run
                failures.append(f"docs: {check.__name__} could not go on: {type(e).__name__}: {e}")
    finally:
        globals().update(saved)
    return failures


