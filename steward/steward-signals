def keys_list_lines(help_text):
    """The lines of HELP_TEXT that hold nothing but POLICY.md keys and the commas between them, under an indent of four: the top-level help's list of keys."""
    return [line for line in help_text.splitlines() if re.fullmatch(r" {4}[a-z_]+(?:, [a-z_]+)*,?", line)]


def keys_read_as_a_list(help_text):
    """Whether HELP_TEXT gives the POLICY.md keys as a list: more than one line of them, each at most KEYS_HELP_WIDTH wide, that hold every key in order."""
    lines = keys_list_lines(help_text)
    return len(lines) > 1 and all(len(line) <= KEYS_HELP_WIDTH for line in lines) and " ".join(line.strip() for line in lines) == ", ".join(POLICY_KEYS)


def test_the_help_gives_the_policy_keys_themselves(d):
    keys = ", ".join(POLICY_KEYS)
    raw = capture(main, ["--help"])[0]
