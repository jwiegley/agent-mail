def iso_at(epoch):
    """The time EPOCH as agent-deck writes last_activity_at, ISO 8601 with an offset."""
    return datetime.datetime.fromtimestamp(epoch, datetime.timezone.utc).isoformat()


def table_scene(d):
    """A topic whose ages are known to the minute: (the conductor directory, the mailbox, the deck fixture, the id of the steward's file that SENT.log does
    not account for, the id of its NUDGE to glm-5.2). pipeline is waiting with a watcher, last active 45 minutes ago, with mail from glm-5.2 an hour old and a
    member record two hours old; omlx is archived, last active three days ago; glm-5.2 is running a workflow, last active three hours ago, with the NUDGE
    unread for 20 minutes; and the steward's file to lfm3 is half an hour old."""
    now, dot = time.time(), chr(0xB7)
    nudge, stray = f"glm-5.2_{utc_stamp(now - 1200)}_from-{STEWARD}_0000000a", f"lfm3_{utc_stamp(now - 1800)}_from-{STEWARD}_0000000b"
    fixture = write(d, "table.json", json.dumps({
        "list": json.dumps([{"title": "omlx", "status": "idle", "archived": True, "last_activity_at": iso_at(now - 3 * 86400)}]),
        "remote andoria-08": json.dumps({"sessions": [
            {"title": "pipeline", "status": "waiting", "substate": "watching", "archived": False, "last_activity_at": iso_at(now - 2700), "substate_detail": f"1 watching {dot} CI"},
            {"title": "glm-5.2", "status": "running", "substate": "background-work", "archived": False, "last_activity_at": iso_at(now - 10800), "substate_detail": f"workflow y 4/5 {dot} 3h"}],
            "errors": []})}))
    cdir = conductor_dir(d, sent=f"intent 1 {utc_stamp(now - 1201)[:15]}Z glm-5.2 NUDGE_glm-5.2-idle ab12\nsent 1 {nudge}\n")
    box = mailbox(d, top=[f"pipeline_{utc_stamp(now - 3600)}_from-glm-5.2_00000001.txt", f"{nudge}.txt", f"{stray}.txt"],
                  channel=("ingest", [f"ingest_{utc_stamp(now - 60)}_from-pipeline_00000002.txt"]), members_checked={"pipeline": now - 7200})
    return cdir, box, fixture, stray, nudge


def cells(line):
    """The cells of a line of the signals table: the runs of text that two spaces or more keep apart."""
    return re.split(r"  +", line.rstrip())


def starts(line):
    """Where each cell of a line of the signals table starts."""
    return [m.start() for m in re.finditer(r"(?:^|(?<=  ))\S", line)]


