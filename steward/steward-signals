LOG_HOSTS = {"lfm3": "delphi-3bd4", "kimi-linear": "andoria-08", "glm-5.2": "andoria-08", "muse-spark": "delphi-3bd4", "pipeline": "andoria-08",
             "conductor-ingest-steward": "hera", "pi": "hera", "nix": "hera"}


def log_row(to, sender, ago_s, subject, reply=None, host=None, via="mcp", now=None, tail=None):
    """A row of agent-mail's traffic report: a message from SENDER to TO (a name, +CHANNEL or all) stamped AGO_S seconds before NOW (the clock when
    None), from SENDER's host in LOG_HOSTS unless HOST is given."""
    stamp_text = utc_stamp((time.time() if now is None else now) - ago_s)
    ident = f"{to.removeprefix('+')}_{stamp_text}_from-{sender}_{tail or os.urandom(4).hex()}"
    return {"utc": stamp_text, "host": host or LOG_HOSTS.get(sender, "hera"), "from": sender, "to": to, "id": ident, "subject": subject,
            "in_reply_to": reply, "via": via}


def log_json(rows, senders=None, on=True, v=1, **more):
    """agent-mail's traffic --format json for ROWS: SENDERS by name (each recording since the start of time unless given), every row's host listed."""
    names = sorted({r["from"] for r in rows} | set(senders or {}))
    given = senders or {}
    listed = [{"name": n, "mcp": 1, "cli": 0, "unrecorded": 0, "newest_unrecorded": None,
               "recording_since": given.get(n, "20000101T000000.000000Z")} for n in names]
    hosts = sorted({r["host"] for r in rows})
    return json.dumps({"v": v, "agent_mail": "2.4.0", "on": on, "since": "x", "until": "y",
                       "hosts": [{"host": h, "rows": 1, "first": "", "last": "", "mcp": 1, "cli": 0} for h in hosts], "silent_hosts": [],
                       "senders": listed, "skipped": {}, "rows": rows, **more})


def log_scene(d, rows, senders=None, top=(), records=("pipeline", "lfm3", "kimi-linear", "glm-5.2", "muse-spark"), log=None, answer=None, ledger=None,
              state='{"topic_since": "20261101T000000Z"}\n'):
    """(conductor dir, mailbox, fixture) of a traffic call whose agent-mail answers log_json(ROWS, SENDERS), or ANSWER (stdout, status) when given."""
    cdir, box = traffic_scene(d, top=top, records=records, state=state, log=log)
    write(cdir, "TOPIC.md", LOG_TOPIC)
    if ledger is not None:
        write(cdir, "LEDGER.md", ledger)
    fixture = write(d, f"am-{os.urandom(4).hex()}.json", json.dumps({"agent-mail traffic": answer if answer is not None else log_json(rows, senders)}))
    return cdir, box, fixture


def traffic_with(cdir, box, fixture, *more):
    return capture(main, ["traffic", "ingest", "--dir", cdir, "--mailbox", box, "--run-fixture", fixture, *more])


