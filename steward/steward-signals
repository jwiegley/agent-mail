        ("a NOTES.log that is a directory", lambda c, b, f: (replaced(os.path.join(c, "NOTES.log"), os.mkdir), (args(c, b, f), None))[1], None),
        ("a steward-state.json that is a directory", lambda c, b, f: (replaced(os.path.join(c, "steward-state.json"), os.mkdir), (args(c, b, f), None))[1],
         f"steward-signals: steward-state.json in --dir: {os.strerror(errno.EISDIR)}"),
        ("a probe of a name TOPIC.md does not list", lambda c, b, f: (args(c, b, f, "ingest", "--probe", "lfm3"), None), "steward-signals: signals: --probe names no member of TOPIC.md"),
        ("a channel that cannot be listed", lambda c, b, f: (args(c, b, f), listing_as(denied)), "steward-signals: signals: the mailbox cannot be read: Permission denied"),
        ("member records that cannot be looked up", lambda c, b, f: (args(c, b, f), os_through("lstat", no_lookup)), "steward-signals: signals: the mailbox cannot be read: Permission denied"))
    for what, prepare, reason in cases:
        cdir, box, fixture, _ = signals_scene(d)
        write(cdir, "steward-state.json", json.dumps({"signals_last": "20261101T000000.000000Z"}))
