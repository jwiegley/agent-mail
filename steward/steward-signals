TRAFFIC_NOW = STAMP_BASE.timestamp() + 7200  # 2026-11-02T22:00:00Z: stamp(0) is two hours old then
DEAF_S = 15 * 60  # POLICY.md's deaf_min, in seconds


def mail_named(to, i, sender="lfm3", tail="aaaaaaaa"):
    """The file name of a message from SENDER to TO stamped stamp(I), with the hex tail TAIL."""
    return f"{to}_{stamp(i)}_from-{sender}_{tail}.txt"


def unread_of(names, recorded=(), handled=(), since=None, now=TRAFFIC_NOW, deaf_s=DEAF_S):
    """unread_matters for the files NAMES (a channel entry when a name is to ingest) and CENSUS_MEMBERS, as of NOW, with a member record for each name in
    RECORDED and none for any other, the (id, matter) pairs HANDLED, and the topic started at SINCE (two days before STAMP_BASE when None)."""
    entries = entries_named(*names, channel="ingest")
    asked = {e.to for e in entries} | {m.name for m in CENSUS_MEMBERS}
    return unread_matters(entries, CENSUS_MEMBERS, {name: 1.0 if name in recorded else None for name in asked}, set(handled), deaf_s,
                          STAMP_BASE.timestamp() - 2 * 86400 if since is None else since, now)


def mail_id(name):
    """The id of the message file NAME: its name without .txt."""
    return name.removesuffix(".txt")


