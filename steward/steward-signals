DAMAGED = b"{damaged"


def damaged_day(d):
    """A new conductor directory whose day file holds DAMAGED, and the paths of the directory's metrics/, of the day file and of the .bad file."""
    c = conductor_in(d)
    folder = os.path.join(c, "metrics")
    os.makedirs(folder)
    pathlib.Path(metrics_file(c)).write_bytes(DAMAGED)
    return c, folder, metrics_file(c), metrics_file(c) + ".bad"


def test_a_damaged_file_is_kept_as_bad_and_the_day_file_is_never_missing(d):
    c, folder, day, bad = damaged_day(d)
    inode = os.stat(day).st_ino
    seen = []

    def watch(src, dst):
        seen.append((src, dst, os.path.exists(day), sys.stderr.getvalue()))  # at the moment of each move: whether the day file is there, and what stderr holds

    with replace_through(watch):
        out, _, err = capture(write_metrics, c, DAY, {"turns": 1})
    ok([move[2] for move in seen] == [True, True], "metrics: the day file is there at the moment of each of the two moves, so a reader never finds it missing")
    ok(len(seen) == 2 and seen[0][1] == bad and seen[0][0] != day and os.path.dirname(seen[0][0]) == folder, "metrics: the first move puts a second name of the damaged file onto .bad, and does not move the day file itself")
    ok(seen[1][1] == day and os.path.dirname(seen[1][0]) == folder and not seen[1][0].endswith(".json"), "metrics: the last move, of the new file onto the day file, is the only change to the day file's name")
    ok([move[3] for move in seen] == ["", ""], "metrics: nothing is said before the last move")
    ok(err.count("\n") == 1 and "moved aside" in err and "?" not in err and out == "", "metrics: after it, one line says so")
    ok(pathlib.Path(bad).read_bytes() == DAMAGED and metrics_of(c) == {"turns": 1} and sorted(os.listdir(folder)) == [f"{DAY}.json", f"{DAY}.json.bad"],
       "metrics: the damaged file is kept whole as .bad, the day file holds the new data, and no other file is left")
    ok(os.stat(bad).st_ino == inode, "metrics: .bad is the damaged file itself, under a second name (a hard link), and not a copy of it")


def test_a_move_that_fails_leaves_the_damaged_file_where_it_was_and_says_nothing_of_a_fresh_one(d):
    error = OSError(errno.EIO, "Input/output error")
    for which, what in ((2, "the last move, of the new file onto the day file"), (1, "the first move, of the damaged file's second name onto .bad")):
        c, folder, day, bad = damaged_day(d)
        calls = []

        def fail_one(src, dst):
            calls.append(dst)
            if len(calls) == which:
                raise error

        with replace_through(fail_one):
            ok(raises(OSError, write_metrics, c, DAY, {"turns": 1}) is error, f"metrics: a failure of {what} is raised")
