def test_set_keys_are_dotted_lower_case_identifiers(d):
    def under(m, key):
        for part in key.split("."):
            m = m[part]
        return m

    for key in ("turns", "a", "last_post", "interventions.nudge", "a.b.c.d", "p50", "notice_delay.p50", "x_1", "a_.b_"):
        c = conductor_in(d)
        out, status, err = capture(main, set_args(c, f"{key}=1"))
        ok(status == 0 and under(metrics_of(c), key) == 1, f"metrics: {key!r} is a key")
    for key in ("Turns", "tURNS", "1turns", "_turns", "a-b", "a b", "a..b", ".a", "a.", "a.1b", "a._b", "", ".", "a.B", "a/b", "a\n", " a", "turns ",
                digits_as("a1", ARABIC_INDIC), digits_as("a1", FULLWIDTH)):
        c = conductor_in(d)
        out, status, err = capture(main, set_args(c, f"{key}=1"))
        ok(status == 2 and out == "" and err.count("\n") == 1 and "?" not in err and nothing_made(c), f"metrics: {key!r} is not a key, so it is refused and nothing is written")


