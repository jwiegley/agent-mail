def test_signals_caps_the_exception_lines(d):
    cdir, now = conductor_dir(d), time.time()
    for count, more in ((45, ["  and 5 more"]), (40, [])):
        strays = [f"lfm3_{utc_stamp(now - 100 - i)}_from-{STEWARD}_{i:08x}" for i in range(count)]
        box = mailbox(d, top=[f"{s}.txt" for s in strays], channel=("ingest", []))
        lines = signals(cdir, box, deck_fixture(d))[0].splitlines()
        listed = lines[lines.index("exceptions:") + 1:-1]
        ok(len(listed) == 40 + len(more) and all(line.startswith("  unmatched-own ") for line in listed[:40]) and listed[40:] == more,
           f"signals: of {count} exceptions, 40 lines are printed, then one line says how many more when there are more")
        ok(len(json.loads(signals(cdir, box, deck_fixture(d), "--json")[0])["exceptions"]["unmatched_own"]) == count, f"signals: the JSON form lists all {count}")
    nudges = [f"lfm3_{utc_stamp(now - 1200 - i)}_from-{STEWARD}_{0xa0 + i:08x}" for i in range(2)]
    cdir = conductor_dir(d, sent="".join(f"intent {i} {utc_stamp(now - 1201 - i)[:15]}Z lfm3 NUDGE_lfm3-idle ab12\nsent {i} {n}\n" for i, n in enumerate(nudges, start=1)))
    strays = [f"lfm3_{utc_stamp(now - 100 - i)}_from-{STEWARD}_{i:08x}" for i in range(45)]
    lines = signals(cdir, mailbox(d, top=[f"{s}.txt" for s in strays + nudges], channel=("ingest", [])), deck_fixture(d))[0].splitlines()
    listed = lines[lines.index("exceptions:") + 1:-1]
    ok(all(line.startswith("  nudge-unread ") for line in listed[:2]) and {line.split()[1] for line in listed[:2]} == set(nudges)
       and all(line.startswith("  unmatched-own ") for line in listed[2:42]) and listed[42:] == ["  and 5 more"],
       f"signals: the NUDGEs unread come first and the cap never hides one: 2 of them, then 40 of 45 files SENT.log does not account for, then how many more (got {listed[:3]!r} ... {listed[-2:]!r})")


