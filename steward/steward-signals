        try:
            out, status, err = capture(main, ["traffic", *args, "--dir", cdir, *([] if box is None else ["--mailbox", box])])
        finally:
            for k, v in saved.items():
                os.environ.pop(k) if v is None else os.environ.update({k: v})
        ok(out == "" and status == 2 and err.startswith(starts) and err.count("\n") == 1 and "?" not in err, f"traffic: refused, {starts} (got {err!r})")

    cdir, box = traffic_scene(d)
