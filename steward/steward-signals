    ok(keys in top and "POLICY_KEYS" not in top,
       "signals: the top-level help gives the keys of POLICY.md themselves, in their order and joined by commas, where the docstring names POLICY_KEYS")
    ok(keys_read_as_a_list(raw),
       f"signals: the top-level help gives the keys as a list, on lines indented four columns and at most {KEYS_HELP_WIDTH} wide, not as one long line")
    # The regressions, from John's decision 26 (2026-11-02) and the fix round's Minor 8: a copy of this file whose help leaves the name as it stands, and one
    # whose help gives the keys on one long line. As in the check above, each search string is built in two pieces, so that it never stands whole in these
    # lines, and it is found exactly once.
    source = read(os.path.realpath(__file__))
    bare = '.replace("POLICY' + '_KEYS", keys)'
    status, out, _ = run_this_file("--help", script=write(tempfile.mkdtemp(dir=d), "steward-signals", source.replace(bare, "")))
    shown = " ".join(out.split())
    ok(source.count(bare) == 1 and status == 0 and "POLICY_KEYS" in shown and keys not in shown,
       "signals: a copy of this file whose top-level help gives the bare name POLICY_KEYS fails the first check")
    unwrapped = 'textwrap' + '.fill(", ".join(POLICY_KEYS), width=KEYS_HELP_WIDTH, initial_indent="    ", subsequent_indent="    ")'
    status, out, _ = run_this_file("--help", script=write(tempfile.mkdtemp(dir=d), "steward-signals", source.replace(unwrapped, '", ".join(POLICY_KEYS)')))
    ok(source.count(unwrapped) == 1 and status == 0 and keys in " ".join(out.split()) and not keys_read_as_a_list(out),
       "signals: a copy of this file whose top-level help gives the keys on one long line fails the second check")


