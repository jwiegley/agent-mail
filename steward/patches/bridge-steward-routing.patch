+def conductor_for_reply(replied_text: str, conductor_names: list[str]) -> str | None:
+    """Return the conductor whose page a reply answers, or None.
+
+    REPLIED_TEXT is the text of the message replied to.  The director's
+    scanner pages what it finds in a session's pane as ``NEED(<where>): ...``
+    after a mention of the user, <where> being ``local/<session title>`` for
+    a session on this host, so a page that starts
+    ``NEED(local/conductor-<name>)`` for a known conductor <name> belongs to
+    that conductor.  The name in an ``@name`` mention holds no ``@`` or
+    ``<``, so the pattern has one way to read any text and takes linear time.
+    """
+    page = re.match(r"(?:\s*(?:<@!?\d+>|@[^\s@<]+))*\s*NEED\(local/conductor-([^)\s]+)\)", replied_text)
+    if page and page.group(1) in conductor_names:
+        return page.group(1)
+    return None
+
