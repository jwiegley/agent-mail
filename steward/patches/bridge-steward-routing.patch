+    async def conductor_replied_to(message: discord.Message, conductor_names: list[str]) -> str | None:
+        """Return the conductor whose page MESSAGE replies to, or None.
+
+        A page is this bot's own message, since the director's scanner posts
+        with the bridge's token; conductor_for_reply reads its text.
+        """
+        reference = getattr(message, "reference", None)
+        reference_id = getattr(reference, "message_id", None)
+        if not reference_id or not bot.user:
+            return None
+        referenced = getattr(reference, "resolved", None)
+        if not isinstance(referenced, discord.Message):
+            try:
+                referenced = await message.channel.fetch_message(reference_id)
+            except Exception as e:
+                log.warning(
+                    "Failed to resolve Discord reply target %d: %s",
+                    reference_id, e,
+                )
+                return None
+        if referenced.author.id != bot.user.id:
+            return None
+        return conductor_for_reply(referenced.content or "", conductor_names)
+
