+STEWARD_STAMP = re.compile(r"[0-9]{8}T[0-9]{6}(?:\.[0-9]{6})?Z")
+# agent-mail's name grammar; a name is also at most 64 characters and does not end in "-".
+MAIL_NAME = r"[a-z0-9](?:[a-z0-9.]|-(?!-))*"
+MAIL_FUTURE = 24 * 3600  # agent-mail never delivers a post stamped further ahead of its clock than this
+
+
+def steward_status_alerts(now: float, conductor_root: str, mailbox: str | None = None,
+                          errors: list | None = None) -> list[dict]:
+    """Attention items for agent-mail topic stewards whose STATUS went stale.
+
+    Each ``<conductor_root>/*-steward/STATUS`` holds one line that its steward
+    rewrites every turn: ``<UTC> tick=<min> open=<n> active=<n>
+    waiting-john=<n> last-post=<UTC> doorbell=<ok|missing>``.  The file is
+    stale once its mtime is more than two ticks old, and a stale file needs
+    attention while ``open`` is above zero or while the steward's channel
+    holds a post stamped after ``last-post``.  The detail carries only the
+    line's own stamp, tick and open count, so it stays the same all through a
+    stale episode and deliver_attention pages it once; the steward's next
+    write starts a new text.  Only a regular file named exactly STATUS counts,
+    so a closed topic, which renames it STATUS-final-<date>, pages nothing,
+    and a STATUS line out of this form is skipped.  A steward whose STATUS,
+    TOPIC.md or channel cannot be read goes into ERRORS, the pass's error
+    list, and the other stewards are still checked; a file gone since the
+    listing, as when a closing steward renames STATUS, is passed over.
+    """
+    mailbox_dir = MAILBOX_DIR if mailbox is None else Path(mailbox)
+    alerts = []
+    for directory in sorted(path for path in Path(conductor_root).glob("*-steward") if path.is_dir()):
+        try:
+            alert = steward_status_alert(now, directory, mailbox_dir)
+        except FileNotFoundError:
+            continue
+        except (OSError, ValueError) as exc:
+            if errors is not None:
+                errors.append({"where": f"steward/conductor-{directory.name}", "error": str(exc)})
+            continue
+        if alert:
+            alerts.append(alert)
+    return alerts
+
+
+def steward_status_alert(now: float, directory: Path, mailbox: Path) -> dict | None:
+    """The attention item for the steward in DIRECTORY, or None (see steward_status_alerts)."""
+    status = directory / "STATUS"
+    words = steward_file_text(status).partition("\n")[0].split()
+    mtime = status.stat().st_mtime  # after the read, so a STATUS rewritten meanwhile reads as fresh
+    fields = dict(word.split("=", 1) for word in words[1:] if "=" in word)
+    tick, count = fields.get("tick", ""), fields.get("open", "")
+    if not (words and STEWARD_STAMP.fullmatch(words[0])
+            and re.fullmatch(r"[0-9]{1,6}", tick) and re.fullmatch(r"[0-9]{1,6}", count)
+            and int(tick) > 0):
+        return None
+    if now - mtime <= 2 * int(tick) * 60:
+        return None
+    if int(count) == 0 and not steward_channel_has_post_after(
+            directory, fields.get("last-post", ""), mailbox, now):
+        return None
+    return {
+        "where": "steward",
+        "kind": "steward",
+        "detail": f"conductor-{directory.name} STATUS unchanged since {words[0]} "
+                  f"(tick {int(tick)}m, {int(count)} open)",
+    }
+
+
+def steward_file_text(path: Path, limit: int = 4096) -> str:
+    """At most LIMIT characters of PATH, a file a steward writes, which must be a regular file in UTF-8.
+
+    A FIFO is never opened, since that would wait for a writer and hold up the
+    pass.  A missing file raises FileNotFoundError, and any other trouble
+    raises OSError or ValueError with a message that names the file.
+    """
+    # One stat, so a file that appears between two looks is never reported as not regular.
+    if not stat.S_ISREG(path.stat().st_mode):
+        raise OSError(f"{path.name} is not a regular file")
+    try:
+        with path.open(encoding="utf-8") as handle:
+            return handle.read(limit)
+    except UnicodeDecodeError as exc:
+        raise ValueError(f"{path.name} is not UTF-8 ({exc.reason} at byte {exc.start})") from None
+
+
+def steward_channel_has_post_after(directory: Path, last_post: str, mailbox: Path, now: float) -> bool:
+    """Whether the channel a steward's TOPIC.md names holds a post stamped after LAST_POST.
+
+    The channel is named by TOPIC.md's first line that is not blank,
+    ``# +<channel>``.  Its posts are the files that agent-mail names
+    ``<channel>_<UTC>_from-<sender>_<hex8>.txt``, the channel without its
+    plus sign, in ``<mailbox>/+<channel>/``.  They are known by name alone,
+    as agent-mail's reader would count them: no message file is opened, and
+    a sender outside agent-mail's grammar, a stamp that is no time and a stamp
+    more than a day after NOW never count.  Stamps compare to the second, the
+    form STATUS writes, so the post that ``last-post`` names never counts as
+    newer than itself.  A channel with no directory has no posts.
+    """
+    if not STEWARD_STAMP.fullmatch(last_post):
+        return False
+    text = steward_file_text(directory / "TOPIC.md")
+    heading = next((line.strip() for line in text.splitlines() if line.strip()), "")
+    named = re.fullmatch(rf"# \+({MAIL_NAME})", heading)
+    if not named:
+        return False
+    channel = named.group(1)
+    try:
+        names = [path.name for path in (mailbox / f"+{channel}").iterdir()]
+    except (FileNotFoundError, NotADirectoryError):
+        return False
+    post = re.compile(rf"{re.escape(channel)}_(?P<stamp>[0-9]{{8}}T[0-9]{{6}}\.[0-9]{{6}})Z"
+                      rf"_from-(?P<sender>{MAIL_NAME})_[0-9a-f]{{8}}\.txt")
+    for name in names:
+        found = post.fullmatch(name)
+        if (not found or found["stamp"][:15] <= last_post[:15]
+                or len(found["sender"]) > 64 or found["sender"].endswith("-")):
+            continue
+        try:
+            stamped = datetime.strptime(found["stamp"], "%Y%m%dT%H%M%S.%f").replace(tzinfo=ZoneInfo("UTC"))
+        except ValueError:
+            continue
+        if stamped.timestamp() <= now + MAIL_FUTURE:
+            return True
+    return False
+
