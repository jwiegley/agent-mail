+def trim_trailing_spaces(text: str) -> str:
+    """TEXT, a pane captured with ``tmux capture-pane -J``, less the spaces at each line's end.
+
+    -J joins the lines that tmux wrapped at the pane's edge, so that a line
+    longer than the pane, such as a question, is read whole.  Unlike a
+    capture without it, it also keeps the spaces that a program wrote at a
+    line's end, which Claude Code's rows carry.  Those would widen the gaps
+    that SAFE_PATTERNS bound between the words of an error that a line break
+    parts, so they go, as a capture without -J drops them: every check reads
+    the lines it read before, a line that tmux wrapped joined.
+    """
+    return re.sub(r" +$", "", text, flags=re.M)
 
 
