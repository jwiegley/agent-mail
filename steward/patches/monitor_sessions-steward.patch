+def is_tool_call_bullet(line: str) -> bool:
+    """Whether a cleaned pane line is Claude's bullet for a tool call.
+
+    A built-in tool call reads ``⏺ Name(...``; an MCP tool call reads
+    ``⏺ <server> - <tool> (MCP)(...``, such as ``⏺ agent-mail - receive
+    (MCP)(...``, or ends at ``(MCP)`` when the call has no arguments.  Claude
+    Code shows a tool's title, which may be words, in place of its name when
+    the server gives one.  What the call returns is tool payload, not a
+    question.
+    """
+    return bool(re.match(r"^[⏺●]\s+(?:\S+\(|.+? - .+? \(MCP\)(?:\(|$))", line))
+
